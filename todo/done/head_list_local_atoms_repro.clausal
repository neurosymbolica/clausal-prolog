# Repro for: a bare LIST in a clause head, built from atoms declared in the SAME
# module, succeeds but never binds the caller's variable.
#
# Run: cd /workspace/clausal-bug-fix \
#      && python -m clausal.testing todo/done/head_list_local_atoms_repro.clausal
#
# Expected (the bug): the four "local atoms" list tests FAIL; every control passes.
#
# NOTE the failure mode. It is NOT "no solutions" — the query SUCCEEDS and hands
# back an UNBOUND variable. `ground/1` is therefore the assertion that separates
# the bug from the controls; `==` cannot be used (a list is not evaluable) and
# `is` would BIND the unbound variable and mask the defect.

-module(head_list_local_atoms_repro, [a, b, rr, kk, f, unk(A0)])
-import_from(formalize_lib, [met, unmet])

# --- THE BUG: top-level head list of LOCALLY-DECLARED atoms, proved via get/3 ---
local2(P, [a, b]) <- (get(P, rr, True))
Test("2-element list of local atoms")     <- (local2({rr: True}, B), ground(B))

local1(P, [a]) <- (get(P, rr, True))
Test("1-element list of local atoms")     <- (local1({rr: True}, B), ground(B))

# the same failure through a helper — the get/3 need not be in this clause's body
helper(P) <- (get(P, rr, True))
via_helper(P, [a, b]) <- (helper(P))
Test("local list, get/3 behind a helper") <- (via_helper({rr: True}, B), ground(B))

# a different key/value shape, to show it is not about `rr` or `True` specifically
local_kk(P, [a, b]) <- (get(P, kk, 1))
Test("local list, integer-valued key")    <- (local_kk({kk: 1}, B), ground(B))

# --- CONTROL 1: identical clause, atoms IMPORTED instead of declared here -> OK ---
imported2(P, [met, unmet]) <- (get(P, rr, True))
Test("list of IMPORTED atoms")            <- (imported2({rr: True}, B), ground(B))

# --- CONTROL 2: a bare local atom, not wrapped in a list -> OK ---
bare(P, a) <- (get(P, rr, True))
Test("bare local atom, no list")          <- (bare({rr: True}, B), ground(B))

# --- CONTROL 3: local atoms nested inside a COMPOUND, not a bare list -> OK ---
nested(P, unk([a, b])) <- (get(P, rr, True))
Test("local list nested in a compound")   <- (nested({rr: True}, B), ground(B))

# --- CONTROL 4: same head list, but the body does NOT use get/3 -> OK ---
noget(P, [a, b]) <- (P == P)
Test("local list, body without get/3")    <- (noget({rr: True}, B), ground(B))

# --- CONTROL 5: get/3 with a VARIABLE third argument, compared after -> OK ---
getvar(P, [a, b]) <- (get(P, rr, V), V is True)
Test("local list, get/3 third arg a var") <- (getvar({rr: True}, B), ground(B))

# --- CONTROL 6: plain fact (no neck) with a local-atom list -> OK ---
factlist(f, [a, b]),
Test("local list in a bare FACT")         <- (factlist(f, B), ground(B))
