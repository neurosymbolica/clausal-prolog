# Repro (RESOLVED 2026-06-26) — the bug was a mis-named lambda head variable,
# NOT imported predicates.
#
# `St` is not a logic variable ("St".isupper() is False), so the arrow head
# `(ID, P, St, C)` is not recognized as lambda params and the `<-` is parsed as a
# `Predicate` rule literal instead of a `Lambda`.  Passing that raw AST node to
# call_goal used to raise a raw Python TypeError:
#   node_class.<locals>.__call__() takes from 1 to 3 positional arguments but 7 were given
# It now raises a proper, catchable Clausal error: error(type_error(callable, _)).
#
# Run from /workspace/clausify/kit (so formalize_lib resolves):
#   cd /workspace/clausal && source venv/bin/activate
#   cd /workspace/clausify/kit && python -m clausal.testing \
#       /workspace/clausal/todo/done/callgoal_imported_lambda_repro.clausal
-import_from(formalize_lib, [check_gte, attr, unmet])

requirement("age_gte_18", PROFILE, STATUS, "cite_age") <- (
    check_gte(PROFILE, "age", 18, "age_gte_18", STATUS))

# CONTROL (local body, no import in lambda) -- passes:
loc(K, V) <- (K is "a", V is 1)
Test("control: call_goal local 2-arg") <- (call_goal(((K, V) <- loc(K, V)), "a", X), X == 1)

# FIXED: the mis-named-head case (`St`) is now a clean, catchable Clausal error
# instead of a Python TypeError.  catch/3 proves the goal is no longer a crash.
Test("fixed: mis-named lambda head -> type_error(callable)") <- (
    catch(
        call_goal(((ID, P, St, C) <- requirement(ID, P, St, C)),
                  "age_gte_18", [attr("age", 10)], _S, _),
        error(type_error("callable", _), _),
        True))

# CORRECTED: with an ALL-CAPS head var (ST), it is a real lambda and succeeds:
Test("corrected: ALL-CAPS head var -> real lambda") <- (
    call_goal(((ID, P, ST, C) <- requirement(ID, P, ST, C)),
              "age_gte_18", [attr("age", 10)], S, _),
    S is unmet("age_gte_18"))
