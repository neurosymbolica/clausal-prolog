-import_from(sympy, [Collect, Cancel, Apart, Together,
                             Degree, Coeffs, Roots, SymEqual])

# ── Collect/3 ────────────────────────────────────────────────────────────────

test("collect by x") <- (
    Collect(X**2 + 2*X + X*Y, X, R),
    R == X**2 + X*(Y + 2)
)  # nv

test("collect constant") <- (
    Collect(3*X + 2*X, X, R),
    R == 5*X
)  # nv

# ── Cancel/2 ─────────────────────────────────────────────────────────────────

test("cancel common factor") <- (
    Cancel((X**2 - 1) / (X - 1), R),
    R == X + 1
)  # nv

test("cancel already simple") <- (
    Cancel(X + 1, R),
    R == X + 1
)  # nv

# ── Apart/2,3 ────────────────────────────────────────────────────────────────

test("apart simple") <- (
    Apart(1 / (X**2 - 1), R),
    R == 1/(2*(X - 1)) - 1/(2*(X + 1))
)  # nv

test("apart explicit var") <- (
    Apart(1 / (X**2 - 1), X, R),
    R == 1/(2*(X - 1)) - 1/(2*(X + 1))
)  # nv

# ── Together/2 ───────────────────────────────────────────────────────────────

test("together fractions") <- (
    Together(1/X + 1/Y, R),
    R == (X + Y) / (X * Y)
)  # nv

test("together single") <- (
    Together(1/X, R),
    R == 1/X
)  # nv

# ── Degree/2,3 ───────────────────────────────────────────────────────────────

test("degree cubic") <- (
    Degree(X**3 + 2*X + 1, X, D),
    D == 3
)  # nv

test("degree quadratic") <- (
    Degree(X**2 + Y_UNUSED*X, X, D),
    D == 2
)  # nv

# ── Coeffs/3 ─────────────────────────────────────────────────────────────────

test("coeffs quadratic") <- (
    Coeffs(X**2 + 3*X + 5, X, C),
    C == [1, 3, 5]
)  # nv

test("coeffs cubic") <- (
    Coeffs(2*X**3 - X + 7, X, C),
    C == [2, 0, -1, 7]
)  # nv

# ── Roots/3 ──────────────────────────────────────────────────────────────────

test("roots quadratic") <- (
    Roots(X**2 - 4, X, PAIR),
    ROOT is ++PAIR[0],
    MULT is ++PAIR[1],
    ROOT == 2,
    MULT == 1
)  # nv

test("roots repeated") <- (
    Roots(X**2 - 2*X + 1, X, PAIR),
    ROOT is ++PAIR[0],
    MULT is ++PAIR[1],
    ROOT == 1,
    MULT == 2
)  # nv
