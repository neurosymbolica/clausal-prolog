-double_quotes(atom)
-import_from(sympy, [sum_, product, binomial, sym_equal])

# ── sum_/5 ──────────────────────────────────────────────────────────────

test("sum of i from 1 to N") <- (
    sum_(I, I, 1, N, R),
    R == N*(N + 1)/2
)  # nv

test("sum of i^2 from 1 to 5") <- (
    sum_(I**2, I, 1, 5, R),
    R == 55
)  # nv

test("sum of constants") <- (
    sum_(3, I_UNUSED, 1, N, R),
    R == 3*N
)  # nv

# ── product/5 ─────────────────────────────────────────────────────────────

test("product 1 to 5") <- (
    product(I, I, 1, 5, R),
    R == 120
)  # nv

test("product symbolic") <- (
    product(X, X, 1, N_UNUSED, R),
    S is ++str(R),
    ++("factorial" in S)
)  # nv

# ── binomial/3 ───────────────────────────────────────────────────────────────

test("binomial 5 choose 2") <- (
    binomial(5, 2, R),
    R == 10
)  # nv

test("binomial 10 choose 0") <- (
    binomial(10, 0, R),
    R == 1
)  # nv

test("binomial 10 choose 10") <- (
    binomial(10, 10, R),
    R == 1
)  # nv

test("binomial symbolic") <- (
    binomial(N, 2, R),
    R == N*(N - 1)/2
)  # nv
