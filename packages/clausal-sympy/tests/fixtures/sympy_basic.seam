-double_quotes(atom)
-import_from(sympy, [simplify, expand, factor, solve, solve_all,
                             diff, integrate, limit, series, subs,
                             free_vars, sym_equal, sym_str, inf,
                             sym, sympy_term])

# SymPy integration — native Clausal terms. No sym(), no ++() for math.
# Compare symbolic results with sym_equal/2: == in a goal is arithmetic and
# raises domain_error(clpz_expression, _) on a SymPy result.

# ── simplify/2 ───────────────────────────────────────────────────────────────

test("simplify cancellation") <- simplify(X**2 + 2*X + 1 - (X + 1)**2, 0)  # nv

test("simplify fraction") <- (
    simplify((X**2 - 1) / (X - 1), R),
    sym_equal(R, X + 1)
)  # nv

# ── expand/2 ─────────────────────────────────────────────────────────────────

test("expand square") <- (
    expand((X + 1)**2, R),
    sym_equal(R, X**2 + 2*X + 1)
)  # nv

test("expand product") <- (
    expand((X + 1) * (X - 1), R),
    sym_equal(R, X**2 - 1)
)  # nv

test("expand cube") <- (
    expand((X + 1)**3, R),
    sym_equal(R, X**3 + 3*X**2 + 3*X + 1)
)  # nv

# ── factor/2 ─────────────────────────────────────────────────────────────────

test("factor diff of squares") <- (
    factor(X**2 - 1, R),
    sym_equal(R, (X - 1) * (X + 1))
)  # nv

test("factor quadratic") <- (
    factor(X**2 + 5*X + 6, R),
    sym_equal(R, (X + 2) * (X + 3))
)  # nv

# ── solve/3: nondeterministic ────────────────────────────────────────────────

test("solve linear") <- (
    solve(2*X - 6, X, S),
    S == 3
)  # nv

test("solve quadratic +2") <- (
    solve(X**2 - 4, X, S),
    S == 2
)  # nv

test("solve quadratic -2") <- (
    solve(X**2 - 4, X, S),
    S == -2
)  # nv

# ── solve_all/3 ───────────────────────────────────────────────────────────────

test("solve all quadratic") <- (
    solve_all(X**2 - 9, X, SOLS),
    S is ++sorted(SOLS),
    S == [-3, 3]
)  # nv

test("solve all cubic") <- (
    solve_all(X**3 - X, X, SOLS),
    S is ++sorted(SOLS),
    S == [-1, 0, 1]
)  # nv

# ── diff/2,3 ─────────────────────────────────────────────────────────────────

test("diff power rule") <- (
    diff(X**3, X, R),
    sym_equal(R, 3*X**2)
)  # nv

test("diff constant") <- (
    diff(5*X**0, X, R),
    R == 0
)  # nv

test("diff sum") <- (
    diff(X**2 + 3*X + 1, X, R),
    sym_equal(R, 2*X + 3)
)  # nv

test("diff partial") <- (
    diff(X*Y + X**2, X, R),
    sym_equal(R, Y + 2*X)
)  # nv

# ── integrate/2,3 ────────────────────────────────────────────────────────────

test("integrate power") <- (
    integrate(X**2, X, R),
    sym_equal(R, X**3 / 3)
)  # nv

test("integrate sum") <- (
    integrate(3*X**2 + 2*X, X, R),
    sym_equal(R, X**3 + X**2)
)  # nv

# ── limit/4 ──────────────────────────────────────────────────────────────────

test("limit x→0 of x+1") <- (
    limit(X + 1, X, 0, R),
    R == 1
)  # nv

test("limit 1/x at inf") <- (
    limit(1/X, X, inf, R),
    R == 0
)  # nv

# ── series/4 ─────────────────────────────────────────────────────────────────

test("series 1/(1-x) to 4") <- (
    series(1/(1-X), X, 4, R),
    sym_equal(R, 1 + X + X**2 + X**3)
)  # nv

# ── sym_equal/2 still works for explicit use ─────────────────────────────────

test("sym_equal reflexive") <- (
    sym_equal(
        X**2 + 1,
        1 + X**2
    )
)  # nv
test("sym_equal nontrivial") <- (
    sym_equal(
        (X + 1)**2 - X**2,
        2*X + 1
    )
)  # nv

# ── == is arithmetic: it raises domain_error(clpz_expression, _) on a SymPy
#    result; sym_equal/2 compares symbolically ─────────────────────────────

test("== reorder") <- (
    expand(X*Y, R),
    sym_equal(R, Y*X)
)  # nv

# ── sym_str/2 — readable string output ───────────────────────────────────────

test("sym_str constant") <- (
    sym_str(42, S),
    S == "42"
)  # nv

test("sym_str expression") <- (
    sym_str(X_UNUSED**2 + 1, S),
    ++("**2" in S)
)  # nv

# ── Chaining — pipe results between predicates ──────────────────────────────

test("expand then factor roundtrip") <- (
    expand((X + 2) * (X + 3), EXP),
    factor(EXP, F),
    sym_equal(F, (X + 2) * (X + 3))
)  # nv

test("diff then integrate roundtrip") <- (
    diff(X**4, X, D),
    integrate(D, X, I),
    sym_equal(I, X**4)
)  # nv

test("solve then verify") <- (
    solve(X**2 - 16, X, S),
    V is ++(S**2),
    V == 16
)  # nv

# ── Multivariate ────────────────────────────────────────────────────────────

test("expand multivar") <- (
    expand((X + Y)**2, R),
    sym_equal(R, X**2 + 2*X*Y + Y**2)
)  # nv

# ── sym/2 still works when you want named symbols ──────────────────────────

test("sym named") <- (
    sym("x", X),
    EXPR is ++(X**2 + 1),
    S is ++str(EXPR),
    S == "x**2 + 1"
)  # nv

# ── free_vars/2 ───────────────────────────────────────────────────────────────

test("free vars none") <- (
    free_vars(42, V),
    V == []
)  # nv
