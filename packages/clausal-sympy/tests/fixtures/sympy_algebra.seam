-double_quotes(atom)
-import_from(sympy, [collect, cancel, apart, together,
                             degree, coeffs, roots, sym_equal])

# ── collect/3 ────────────────────────────────────────────────────────────────

test("collect by x") <- (
    collect(X**2 + 2*X + X*Y, X, R),
    sym_equal(R, X**2 + X*(Y + 2))
)  # nv

test("collect constant") <- (
    collect(3*X + 2*X, X, R),
    sym_equal(R, 5*X)
)  # nv

# ── cancel/2 ─────────────────────────────────────────────────────────────────

test("cancel common factor") <- (
    cancel((X**2 - 1) / (X - 1), R),
    sym_equal(R, X + 1)
)  # nv

test("cancel already simple") <- (
    cancel(X + 1, R),
    sym_equal(R, X + 1)
)  # nv

# ── apart/2,3 ────────────────────────────────────────────────────────────────

test("apart simple") <- (
    apart(1 / (X**2 - 1), R),
    sym_equal(R, 1/(2*(X - 1)) - 1/(2*(X + 1)))
)  # nv

test("apart explicit var") <- (
    apart(1 / (X**2 - 1), X, R),
    sym_equal(R, 1/(2*(X - 1)) - 1/(2*(X + 1)))
)  # nv

# ── together/2 ───────────────────────────────────────────────────────────────

test("together fractions") <- (
    together(1/X + 1/Y, R),
    sym_equal(R, (X + Y) / (X * Y))
)  # nv

test("together single") <- (
    together(1/X, R),
    sym_equal(R, 1/X)
)  # nv

# ── degree/2,3 ───────────────────────────────────────────────────────────────

test("degree cubic") <- (
    degree(X**3 + 2*X + 1, X, D),
    D == 3
)  # nv

test("degree quadratic") <- (
    degree(X**2 + Y_UNUSED*X, X, D),
    D == 2
)  # nv

# ── coeffs/3 ─────────────────────────────────────────────────────────────────

test("coeffs quadratic") <- (
    coeffs(X**2 + 3*X + 5, X, C),
    C == [1, 3, 5]
)  # nv

test("coeffs cubic") <- (
    coeffs(2*X**3 - X + 7, X, C),
    C == [2, 0, -1, 7]
)  # nv

# ── roots/3 ──────────────────────────────────────────────────────────────────

test("roots quadratic") <- (
    roots(X**2 - 4, X, PAIR),
    ROOT is ++PAIR[0],
    MULT is ++PAIR[1],
    ROOT == 2,
    MULT == 1
)  # nv

test("roots repeated") <- (
    roots(X**2 - 2*X + 1, X, PAIR),
    ROOT is ++PAIR[0],
    MULT is ++PAIR[1],
    ROOT == 1,
    MULT == 2
)  # nv
