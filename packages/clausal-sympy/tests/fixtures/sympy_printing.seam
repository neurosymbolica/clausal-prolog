-import_from(sympy, [latex, pretty, sym])

# ── latex/2 ──────────────────────────────────────────────────────────────────

test("latex simple") <- (
    latex(X_UNUSED**2 + 1, S),
    ++("x^{2}" in S)
)  # nv

test("latex fraction") <- (
    latex(1 / X_UNUSED, S),
    ++("frac" in S)
)  # nv

test("latex integer") <- (
    latex(42, S),
    S == "42"
)  # nv

# ── pretty/2 ─────────────────────────────────────────────────────────────────

test("pretty integer") <- (
    pretty(42, S),
    S == "42"
)  # nv

test("pretty expression") <- (
    pretty(X_UNUSED**2, S),
    ++("2" in S)
)  # nv
