-double_quotes(atom)
-import_from(sympy, [Latex, Pretty, Sym])

# ── Latex/2 ──────────────────────────────────────────────────────────────────

test("latex simple") <- (
    Latex(X_UNUSED**2 + 1, S),
    ++("x^{2}" in S)
)  # nv

test("latex fraction") <- (
    Latex(1 / X_UNUSED, S),
    ++("frac" in S)
)  # nv

test("latex integer") <- (
    Latex(42, S),
    S == "42"
)  # nv

# ── Pretty/2 ─────────────────────────────────────────────────────────────────

test("pretty integer") <- (
    Pretty(42, S),
    S == "42"
)  # nv

test("pretty expression") <- (
    Pretty(X_UNUSED**2, S),
    ++("2" in S)
)  # nv
