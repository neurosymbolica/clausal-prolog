# Companion tests for docs/sympy.md display snippets.

-import_from(sympy, [simplify, expand, factor, solve, solve_all,
                             diff, integrate, limit, series, subs,
                             free_vars, sym_equal, sym_str, sym, sympy_term,
                             collect, cancel, apart, together,
                             degree, coeffs, roots,
                             trig_simp, expand_trig,
                             is_prime, next_prime, factor_int, divisors,
                             gcd, lcm,
                             sum_, product, binomial,
                             latex, pretty,
                             sin, cos, exp, log, sqrt, inf, pi])

# ── Symbolic equality via == ────────────────────────────────────────────────

test("symbolic equality via ==") <- (
    diff(X**3, X, R),
    sym_equal(R, 3*X**2)
)  # nv

# ── Chaining ────────────────────────────────────────────────────────────────

test("chaining diff integrate") <- (
    diff(X**4, X, D),
    integrate(D, X, I),
    sym_equal(I, X**4)
)  # nv

# ── simplify/2 ──────────────────────────────────────────────────────────────

test("simplify cancellation") <- simplify(X**2 + 2*X + 1 - (X + 1)**2, 0)  # nv

test("simplify fraction") <- (
    simplify((X**2 - 1) / (X - 1), R),
    sym_equal(R, X + 1)
)  # nv

# ── expand/2 ────────────────────────────────────────────────────────────────

test("expand square") <- (
    expand((X + 1)**2, R),
    sym_equal(R, X**2 + 2*X + 1)
)  # nv

test("expand multivar") <- (
    expand((X + Y)**2, R),
    sym_equal(R, X**2 + 2*X*Y + Y**2)
)  # nv

# ── factor/2 ────────────────────────────────────────────────────────────────

test("factor diff of squares") <- (
    factor(X**2 - 1, R),
    sym_equal(R, (X - 1) * (X + 1))
)  # nv

test("factor quadratic") <- (
    factor(X**2 + 5*X + 6, R),
    sym_equal(R, (X + 2) * (X + 3))
)  # nv

# ── solve/3 ─────────────────────────────────────────────────────────────────

test("solve linear") <- (
    solve(2*X - 6, X, S),
    S == 3
)  # nv

test("solve quadratic") <- (
    solve(X**2 - 4, X, S),
    S == 2
)  # nv

# ── solve_all/3 ──────────────────────────────────────────────────────────────

test("solve all quadratic") <- (
    solve_all(X**2 - 9, X, SOLS),
    S is ++sorted(SOLS),
    S == [-3, 3]
)  # nv

# ── diff/2,3 ────────────────────────────────────────────────────────────────

test("diff power rule") <- (
    diff(X**3, X, R),
    sym_equal(R, 3*X**2)
)  # nv

test("diff sin") <- (
    diff(sin(X), X, R),
    R == cos(X)
)  # nv

test("diff partial") <- (
    diff(X*Y + X**2, X, R),
    sym_equal(R, Y + 2*X)
)  # nv

# ── integrate/2,3 ───────────────────────────────────────────────────────────

test("integrate power") <- (
    integrate(X**2, X, R),
    sym_equal(R, X**3 / 3)
)  # nv

test("integrate cos") <- (
    integrate(cos(X), X, R),
    R == sin(X)
)  # nv

# ── limit/4 ─────────────────────────────────────────────────────────────────

test("limit x+1 at 0") <- (
    limit(X + 1, X, 0, R),
    R == 1
)  # nv

test("limit 1/x at inf") <- (
    limit(1/X, X, inf, R),
    R == 0
)  # nv

test("limit sinx/x at 0") <- (
    limit(sin(X)/X, X, 0, R),
    R == 1
)  # nv

# ── series/4 ────────────────────────────────────────────────────────────────

test("series 1/(1-x) to 4") <- (
    series(1/(1-X), X, 4, R),
    sym_equal(R, 1 + X + X**2 + X**3)
)  # nv

# ── collect/3 ───────────────────────────────────────────────────────────────

test("collect by x") <- (
    collect(X**2 + 2*X + X*Y, X, R),
    sym_equal(R, X**2 + X*(Y + 2))
)  # nv

# ── cancel/2 ────────────────────────────────────────────────────────────────

test("cancel common factor") <- (
    cancel((X**2 - 1) / (X - 1), R),
    sym_equal(R, X + 1)
)  # nv

# ── apart/2 ─────────────────────────────────────────────────────────────────

test("apart simple") <- (
    apart(1 / (X**2 - 1), R),
    sym_equal(R, 1/(2*(X - 1)) - 1/(2*(X + 1)))
)  # nv

# ── together/2 ──────────────────────────────────────────────────────────────

test("together fractions") <- (
    together(1/X + 1/Y, R),
    sym_equal(R, (X + Y) / (X * Y))
)  # nv

# ── degree/3 ────────────────────────────────────────────────────────────────

test("degree cubic") <- (
    degree(X**3 + 2*X + 1, X, D),
    D == 3
)  # nv

# ── coeffs/3 ────────────────────────────────────────────────────────────────

test("coeffs cubic") <- (
    coeffs(2*X**3 - X + 7, X, C),
    C == [2, 0, -1, 7]
)  # nv

# ── roots/3 ─────────────────────────────────────────────────────────────────

test("roots repeated") <- (
    roots(X**2 - 2*X + 1, X, PAIR),
    ROOT is ++PAIR[0],
    MULT is ++PAIR[1],
    ROOT == 1,
    MULT == 2
)  # nv

# ── trig_simp/2 ──────────────────────────────────────────────────────────────

test("trig simp pythagorean") <- (
    trig_simp(sin(X)**2 + cos(X)**2, R),
    R == 1
)  # nv

test("trig simp double angle") <- (
    trig_simp(2 * sin(X) * cos(X), R),
    R == sin(2*X)
)  # nv

# ── expand_trig/2 ────────────────────────────────────────────────────────────

test("expand trig sum") <- (
    expand_trig(sin(X + Y), R),
    sym_equal(R, sin(X)*cos(Y) + sin(Y)*cos(X))
)  # nv

# ── is_prime/1 ───────────────────────────────────────────────────────────────

test("is prime 7") <- is_prime(7)  # nv
test("not prime 4") <- (not is_prime(4))  # nv

# ── next_prime/2 ─────────────────────────────────────────────────────────────

test("next prime after 7") <- (
    next_prime(7, P),
    P == 11
)  # nv

# ── factor_int/2 ─────────────────────────────────────────────────────────────

test("factor 360") <- (
    factor_int(360, F),
    F is {2: 3, 3: 2, 5: 1}
)  # nv

# ── divisors/2 ──────────────────────────────────────────────────────────────

test("divisors 12") <- (
    divisors(12, D),
    D == [1, 2, 3, 4, 6, 12]
)  # nv

# ── gcd/3, lcm/3 ───────────────────────────────────────────────────────────

test("gcd integers") <- (
    gcd(12, 8, R),
    R == 4
)  # nv

test("gcd polynomials") <- (
    gcd(X**2 - 1, X - 1, R),
    sym_equal(R, X - 1)
)  # nv

test("lcm integers") <- (
    lcm(4, 6, R),
    R == 12
)  # nv

# ── sum_/5 ──────────────────────────────────────────────────────────────────

test("sum of i from 1 to N") <- (
    sum_(I, I, 1, N, R),
    sym_equal(R, N*(N + 1)/2)
)  # nv

test("sum of i^2 from 1 to 5") <- (
    sum_(I**2, I, 1, 5, R),
    R == 55
)  # nv

# ── product/5 ───────────────────────────────────────────────────────────────

test("product 1 to 5") <- (
    product(I, I, 1, 5, R),
    R == 120
)  # nv

# ── binomial/3 ──────────────────────────────────────────────────────────────

test("binomial 5 choose 2") <- (
    binomial(5, 2, R),
    R == 10
)  # nv

test("binomial symbolic") <- (
    binomial(N, 2, R),
    sym_equal(R, N*(N - 1)/2)
)  # nv

# ── latex/2 ─────────────────────────────────────────────────────────────────

test("latex expression") <- (
    latex(X_UNUSED**2 + 1, S),
    ++("x^{2}" in S)
)  # nv

# ── pretty/2 ────────────────────────────────────────────────────────────────

test("pretty expression") <- (
    pretty(X_UNUSED**2, S),
    ++("2" in S)
)  # nv

# ── subs/3 ──────────────────────────────────────────────────────────────────

test("subs dict") <- (
    subs(X**2 + 1, ++{X: 3}, R),
    R == 10
)  # nv

# ── free_vars/2 ──────────────────────────────────────────────────────────────

test("free vars none") <- (
    free_vars(42, V),
    V == []
)  # nv

# ── sym_str/2 ────────────────────────────────────────────────────────────────

test("sym str constant") <- (
    sym_str(42, S),
    S == "42"
)  # nv

# ── sym_equal/2 ──────────────────────────────────────────────────────────────

test("sym equal reflexive") <- sym_equal(X**2 + 1, 1 + X**2)  # nv

test("sym equal nontrivial") <- sym_equal((X + 1)**2 - X**2, 2*X + 1)  # nv

# ── sym/2 ───────────────────────────────────────────────────────────────────

test("sym named") <- (
    sym("x", X),
    EXPR is ++(X**2 + 1),
    S is ++str(EXPR),
    S == 'x**2 + 1'   # the ++ escape: a Python str is an ATOM
)  # nv

# ── Math functions ──────────────────────────────────────────────────────────

test("diff sin cos") <- (
    diff(sin(X), X, R),
    R == cos(X)
)  # nv

test("simplify exp log") <- (
    simplify(exp(log(X)), R),
    sym_equal(R, X)
)  # nv

# ── Constants ───────────────────────────────────────────────────────────────

test("limit with inf") <- (
    limit(1/X, X, inf, R),
    R == 0
)  # nv
