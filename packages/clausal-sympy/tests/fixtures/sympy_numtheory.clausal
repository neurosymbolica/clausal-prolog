-double_quotes(atom)
-import_from(sympy, [is_prime, next_prime, factor_int, divisors,
                             gcd, lcm])

# ── is_prime/1 ────────────────────────────────────────────────────────────────

test("is prime 7") <- is_prime(7)  # nv
test("is prime 11") <- is_prime(11)  # nv
test("not prime 4") <- (not is_prime(4))  # nv
test("not prime 1") <- (not is_prime(1))  # nv

# ── next_prime/2 ──────────────────────────────────────────────────────────────

test("next prime after 7") <- (
    next_prime(7, P),
    P == 11
)  # nv

test("next prime after 10") <- (
    next_prime(10, P),
    P == 11
)  # nv

test("next prime after 1") <- (
    next_prime(1, P),
    P == 2
)  # nv

# ── factor_int/2 ──────────────────────────────────────────────────────────────

test("factor 12") <- (
    factor_int(12, F),
    F is {2: 2, 3: 1}
)  # nv

test("factor prime") <- (
    factor_int(13, F),
    F is {13: 1}
)  # nv

test("factor 360") <- (
    factor_int(360, F),
    F is {2: 3, 3: 2, 5: 1}
)  # nv

# ── divisors/2 ───────────────────────────────────────────────────────────────

test("divisors 12") <- (
    divisors(12, D),
    D == [1, 2, 3, 4, 6, 12]
)  # nv

test("divisors prime") <- (
    divisors(7, D),
    D == [1, 7]
)  # nv

# ── gcd/3 ─────────────────────────────────────────────────────────────────

test("gcd integers") <- (
    gcd(12, 8, R),
    R == 4
)  # nv

test("gcd polynomials") <- (
    gcd(X**2 - 1, X - 1, R),
    R == X - 1
)  # nv

# ── lcm/3 ─────────────────────────────────────────────────────────────────

test("lcm integers") <- (
    lcm(4, 6, R),
    R == 12
)  # nv

test("lcm polynomials") <- (
    lcm(X - 1, X + 1, R),
    R == X**2 - 1
)  # nv
