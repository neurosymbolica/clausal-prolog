-import_from(provenance, [bottom_up_, solve, recover, boolean, add_mult_prob])

-module(provenance_reach, [
    edge(SRC, DST),
    path(SRC, DST),
])

bottom_up_(edge)
bottom_up_(path)

path(SRC, DST) <- edge(SRC, DST)

path(SRC, DST) <- (
    edge(SRC, MID),
    path(MID, DST),
)


# ── Single-rule reachability ──────────────────────────────────────────

test("direct edge under boolean") <- (
    FACTS is [
        (edge("a", "b"), True),
        (edge("b", "c"), True),
    ],
    solve(boolean, FACTS, path("a", "b"), R),
    R == [(path("a", "b"), True)]
)


# ── Transitive closure ────────────────────────────────────────────────

test("transitive closure under boolean") <- (
    FACTS is [
        (edge("a", "b"), True),
        (edge("b", "c"), True),
        (edge("c", "d"), True),
    ],
    solve(boolean, FACTS, path("a", "d"), R),
    R == [(path("a", "d"), True)]
)

test("multiple answers from one start node") <- (
    FACTS is [
        (edge("a", "b"), True),
        (edge("b", "c"), True),
        (edge("c", "d"), True),
    ],
    solve(boolean, FACTS, path("a", DST_UNUSED), R),
    length(R, 3)
)

test("disconnected nodes yield no path") <- (
    FACTS is [
        (edge("a", "b"), True),
        (edge("c", "d"), True),
    ],
    solve(boolean, FACTS, path("a", "d"), []),
)


# ── Cycles ────────────────────────────────────────────────────────────

test("cycle does not blow up the fixpoint — set semantics") <- (
    FACTS is [
        (edge("a", "b"), True),
        (edge("b", "a"), True),
    ],
    solve(boolean, FACTS, path("a", DST_UNUSED), R),
    length(R, 2)
)


# ── Multiple disconnected components ──────────────────────────────────

test("multiple starts: pairs from two disjoint components") <- (
    FACTS is [
        (edge(0, 1), True),
        (edge(1, 2), True),
        (edge(10, 11), True),
    ],
    solve(boolean, FACTS, path(SRC_UNUSED, DST_UNUSED), R),
    length(R, 4)
)


# ── Goal binding modes ────────────────────────────────────────────────

test("goal with both args bound — single match") <- (
    FACTS is [
        (edge(0, 1), True),
        (edge(1, 2), True),
    ],
    solve(boolean, FACTS, path(0, 2), [(_, True)])
)

test("goal with no matching path returns []") <- (
    FACTS is [
        (edge(0, 1), True),
        (edge(1, 2), True),
    ],
    solve(boolean, FACTS, path(0, 99), [])
)


# ── Empty input handling ──────────────────────────────────────────────

test("no facts, no answers") <- (
    solve(boolean, [], path("a", "b"), [])
)

test("facts-only relation queried on input predicate") <- (
    FACTS is [
        (edge("a", "b"), True),
        (edge("b", "c"), True),
    ],
    solve(boolean, FACTS, edge(SRC_UNUSED, DST_UNUSED), R),
    length(R, 2)
)


# ── Tag merging via semiring.add ──────────────────────────────────────

test("duplicate facts merge: True ∨ True = True, single tuple") <- (
    FACTS is [
        (edge("a", "b"), True),
        (edge("a", "b"), True),
        (edge("a", "b"), True),
    ],
    solve(boolean, FACTS, edge(SRC_UNUSED, DST_UNUSED), R),
    length(R, 1)
)


# ── recover/3 — the boundary identity for boolean ─────────────────────

test("recover/3 on boolean is identity") <- (
    recover(boolean, True, OUT),
    OUT == True
)

test("recover/3 on boolean preserves False") <- (
    recover(boolean, False, OUT),
    OUT == False
)


# ── add_mult_prob through the engine ──────────────────────────────────

test("add_mult_prob: two-hop = product of edge probabilities") <- (
    # 0.7 * 0.5 = 0.35
    FACTS is [
        (edge("a", "b"), 0.7),
        (edge("b", "c"), 0.5),
    ],
    solve(add_mult_prob, FACTS, path("a", "c"), [(_, P)]),
    P > 0.3499999999,
    P < 0.3500000001,
)

test("add_mult_prob: alternative paths combine via noisy-OR") <- (
    # path a→b→d (0.6 * 0.6 = 0.36) and a→c→d (0.5 * 0.4 = 0.20).
    # noisy_or(0.36, 0.20) = 0.36 + 0.20 - 0.36*0.20 = 0.488.
    FACTS is [
        (edge("a", "b"), 0.6),
        (edge("b", "d"), 0.6),
        (edge("a", "c"), 0.5),
        (edge("c", "d"), 0.4),
    ],
    solve(add_mult_prob, FACTS, path("a", "d"), [(_, P)]),
    P > 0.4879999999,
    P < 0.4880000001,
)

test("add_mult_prob: zero-prob input is pruned by discard threshold") <- (
    FACTS is [
        (edge("a", "b"), 0.0),
        (edge("b", "c"), 0.5),
    ],
    solve(add_mult_prob, FACTS, path("a", "c"), [])
)
