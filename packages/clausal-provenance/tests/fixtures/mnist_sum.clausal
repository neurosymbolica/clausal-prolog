-import_from(provenance, [bottom_up_, solve, boolean, add_mult_prob])

-module(mnist_sum, [
    digit(IMAGE_ID, VALUE),
    sum_digits(IMAGE_A, IMAGE_B, TOTAL),
])

# digit and sum_digits both flow through the bottom-up engine: digit is
# the data layer (perception-model output, supplied as tagged facts);
# sum_digits is the rule layer.
bottom_up_(digit)
bottom_up_(sum_digits)

sum_digits(IMG_A, IMG_B, TOTAL) <- (
    digit(IMG_A, A),
    digit(IMG_B, B),
    TOTAL == A + B,
)


# ── Tests under the boolean semiring ────────────────────────────────

test("boolean: digit-pair sum") <- (
    FACTS is [
        (digit(0, 3), True),
        (digit(1, 5), True),
    ],
    solve(boolean, FACTS, sum_digits(0, 1, T), R),
    T == 8,
    R == [(sum_digits(0, 1, 8), True)]
)

test("boolean: enumerate possible sums when value uncertain") <- (
    FACTS is [
        (digit(0, 3), True),
        (digit(0, 4), True),
        (digit(1, 5), True),
    ],
    solve(boolean, FACTS, sum_digits(0, 1, T_UNUSED), R),
    length(R, 2)
)


# ── test under add_mult_prob ────────────────────────────────────────

test("add_mult_prob: confident pair multiplies cleanly") <- (
    FACTS is [
        (digit(0, 3), 0.7),
        (digit(1, 5), 0.9),
    ],
    solve(add_mult_prob, FACTS, sum_digits(0, 1, 8), R),
    R == [(sum_digits(0, 1, 8), 0.63)]
)
