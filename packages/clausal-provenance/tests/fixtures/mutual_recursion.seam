-double_quotes(atom)
-import_from(provenance, [bottom_up_, solve, boolean])

-module(mutual_recursion, [
    pred(N, M),       # N's predecessor is M (N = M + 1)
    zero(X),
    even(X),
    odd(X),
])

bottom_up_(pred)
bottom_up_(zero)
bottom_up_(even)
bottom_up_(odd)

# Mutual recursion across two predicates: SCC analysis must place even
# and odd in one stratum.
even(X) <- zero(X)
odd(N) <- (pred(N, M), even(M))
even(N) <- (pred(N, M), odd(M))


test("mutual recursion across two predicates: even") <- (
    FACTS is [
        (zero(0), True),
        (pred(1, 0), True), (pred(2, 1), True), (pred(3, 2), True),
        (pred(4, 3), True), (pred(5, 4), True),
    ],
    solve(boolean, FACTS, even(X_UNUSED), R),
    length(R, 3)
)

test("mutual recursion across two predicates: odd") <- (
    FACTS is [
        (zero(0), True),
        (pred(1, 0), True), (pred(2, 1), True), (pred(3, 2), True),
        (pred(4, 3), True), (pred(5, 4), True),
    ],
    solve(boolean, FACTS, odd(X_UNUSED), R),
    length(R, 3)
)

test("mutual recursion: even(4) is derived") <- (
    FACTS is [
        (zero(0), True),
        (pred(1, 0), True), (pred(2, 1), True), (pred(3, 2), True),
        (pred(4, 3), True),
    ],
    solve(boolean, FACTS, even(4), [(_, True)])
)

test("mutual recursion: odd(2) is not derived") <- (
    FACTS is [
        (zero(0), True),
        (pred(1, 0), True), (pred(2, 1), True),
    ],
    solve(boolean, FACTS, odd(2), [])
)
