# Companion tests for docs/yaml.md display snippets.

-import_from(yaml, [Read, write, ReadAll, WriteAll, Get])

# ── Read ─────────────────────────────────────────────────────────────────────

Test("parse mapping") <- (
    Read("name: alice\nage: 30", D),
    Get(D, "name", "alice"),
    Get(D, "age", 30)
)  # nv

Test("parse list") <- (
    Read("[1, 2, 3]", D),
    D == [1, 2, 3]
)  # nv

# ── ReadAll ──────────────────────────────────────────────────────────────────

Test("multi doc") <- (
    ReadAll("a: 1\n---\nb: 2", DOCS),
    LEN is ++len(DOCS),
    LEN == 2
)  # nv

# ── write ────────────────────────────────────────────────────────────────────

Test("serialize roundtrip") <- (
    DATA is ++{"x": 1, "y": 2},
    write(DATA, S),
    Read(S, D),
    Get(D, "x", 1)
)  # nv

# ── Get (nested) ─────────────────────────────────────────────────────────────

Test("nested access") <- (
    Read("items:\n  - name: first\n  - name: second", D),
    Get(D, ["items", 1, "name"], "second")
)  # nv
