# Companion tests for docs/yaml.md display snippets.

-import_from(yaml, [read, write, read_all, write_all, get])

# ── read ─────────────────────────────────────────────────────────────────────

test("parse mapping") <- (
    read("name: alice\nage: 30", D),
    get(D, "name", "alice"),
    get(D, "age", 30)
)  # nv

test("parse list") <- (
    read("[1, 2, 3]", D),
    D == [1, 2, 3]
)  # nv

# ── read_all ──────────────────────────────────────────────────────────────────

test("multi doc") <- (
    read_all("a: 1\n---\nb: 2", DOCS),
    LEN is ++len(DOCS),
    LEN == 2
)  # nv

# ── write ────────────────────────────────────────────────────────────────────

test("serialize roundtrip") <- (
    DATA is ++{"x": 1, "y": 2},
    write(DATA, S),
    read(S, D),
    get(D, "x", 1)
)  # nv

# ── get (nested) ─────────────────────────────────────────────────────────────

test("nested access") <- (
    read("items:\n  - name: first\n  - name: second", D),
    get(D, ["items", 1, "name"], "second")
)  # nv
