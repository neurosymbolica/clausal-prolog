# Companion tests for docs/torch_nn.md signature blocks.
-import_module(torch)
-import_from(torch_nn, [parameter, named_parameter, module,
                            named_module, child, named_child,
                            layer, activation, loss_fn, optimizer_type,
                            scheduler_type])

# --- parameter ---

test("parameter count for Linear") <- (
    MODEL is torch.nn.Linear(10, 5),
    findall(P, parameter(MODEL, P), PS),
    length(PS, 2)
)  # nv

# --- named_parameter ---

test("named_parameter enumerates weight and bias") <- (
    MODEL is torch.nn.Linear(10, 5),
    findall(NAME, named_parameter(MODEL, NAME, _), NAMES),
    in_("weight", NAMES),
    in_("bias", NAMES)
)  # nv

# --- named_module ---

test("named_module includes self and children") <- (
    MODEL is torch.nn.Sequential(
        torch.nn.Linear(10, 5),
        torch.nn.ReLU(),
        torch.nn.Linear(5, 2)
    ),
    findall(N, named_module(MODEL, N, _), NAMES),
    in_("", NAMES),
    in_("0", NAMES),
    in_("1", NAMES),
    in_("2", NAMES)
)  # nv

# --- named_child ---

test("named_child names") <- (
    MODEL is torch.nn.Sequential(
        torch.nn.Linear(10, 5),
        torch.nn.ReLU()
    ),
    findall(N, named_child(MODEL, N, _), NAMES),
    in_("0", NAMES),
    in_("1", NAMES)
)  # nv

# --- layer registry ---

test("layer enumerates known types") <- (
    findall(N, layer(N, _), NS),
    in_("Linear", NS),
    in_("Conv2d", NS),
    in_("LSTM", NS)
)  # nv

# --- optimizer_type registry ---

test("optimizer_type enumerates Adam and SGD") <- (
    findall(N, optimizer_type(N, _), NS),
    in_("Adam", NS),
    in_("SGD", NS)
)  # nv

# --- scheduler_type registry ---

test("scheduler_type enumerates known types") <- (
    findall(N, scheduler_type(N, _), NS),
    in_("StepLR", NS),
    in_("CosineAnnealingLR", NS)
)  # nv
