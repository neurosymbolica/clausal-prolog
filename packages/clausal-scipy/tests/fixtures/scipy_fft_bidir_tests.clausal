# ── real_fft (arity-2) ───────────────────────────────────────────────────

# forward
test("rfft forward") <- (
    X is ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    real_fft(X, R),
    EXPECTED is ++(__import__('scipy.fft', fromlist=['rfft']).rfft([1.0, 2.0, 3.0, 4.0])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(R - EXPECTED))),
    DIFF < 1e-10)  # nv

# backward
test("rfft backward") <- (
    SPEC is ++(__import__('scipy.fft', fromlist=['rfft']).rfft([1.0, 2.0, 3.0, 4.0])),
    real_fft(X2, SPEC),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        X2 - __import__('numpy').array([1.0, 2.0, 3.0, 4.0])))),
    DIFF < 1e-10)  # nv

# both unbound
test("rfft both unbound fails") <- (not real_fft(_, _))  # nv

# round-trip
test("rfft round-trip") <- (
    X is ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    real_fft(X, R),
    real_fft(X2, R),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)  # nv

# arity-3 with N
test("rfft arity-3 forward") <- (
    X is ++(__import__('numpy').array([1.0, 2.0])),
    real_fft(X, 4, R),
    EXPECTED is ++(__import__('scipy.fft', fromlist=['rfft']).rfft([1.0, 2.0], n=4)),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(R - EXPECTED))),
    DIFF < 1e-10)  # nv

test("rfft arity-3 round-trip") <- (
    X is ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    real_fft(X, 4, R),
    real_fft(X2, 4, R),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)  # nv

# ── discrete_cosine_transform ──────────────────────────────────────────────

# forward
test("dct forward") <- (
    X is ++(__import__('numpy').array([1.0, 2.0, 1.0])),
    discrete_cosine_transform(X, C),
    EXPECTED is ++(__import__('scipy.fft', fromlist=['dct']).dct([1.0, 2.0, 1.0])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(C - EXPECTED))),
    DIFF < 1e-10)  # nv

# backward
test("dct backward") <- (
    COEFFS is ++(__import__('scipy.fft', fromlist=['dct']).dct([1.0, 2.0, 1.0])),
    discrete_cosine_transform(X2, COEFFS),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        X2 - __import__('numpy').array([1.0, 2.0, 1.0])))),
    DIFF < 1e-10)  # nv

# both unbound
test("dct both unbound fails") <- (not discrete_cosine_transform(_, _))  # nv

# round-trip
test("dct round-trip") <- (
    X is ++(__import__('numpy').array([1.0, 2.0, 1.0])),
    discrete_cosine_transform(X, C),
    discrete_cosine_transform(X2, C),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)  # nv

# arity-3 with type
test("dct arity-3 type 2 round-trip") <- (
    X is ++(__import__('numpy').array([1.0, 2.0, 3.0])),
    discrete_cosine_transform(X, 2, C),
    discrete_cosine_transform(X2, 2, C),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)  # nv

