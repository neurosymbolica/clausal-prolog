# ── fft_shift ─────────────────────────────────────────────────────────────

# forward
test("fftshift forward") <- (
    X is ++(__import__('numpy').array([0.0, 1.0, 2.0, 3.0])),
    fft_shift(X, S),
    EXPECTED is ++(__import__('scipy.fft', fromlist=['fftshift']).fftshift([0.0, 1.0, 2.0, 3.0])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(S - EXPECTED))),
    DIFF < 1e-10)  # nv

# backward
test("fftshift backward") <- (
    SHIFTED is ++(__import__('scipy.fft', fromlist=['fftshift']).fftshift([0.0, 1.0, 2.0, 3.0])),
    fft_shift(X2, SHIFTED),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        X2 - __import__('numpy').array([0.0, 1.0, 2.0, 3.0])))),
    DIFF < 1e-10)  # nv

# both unbound
test("fftshift both unbound fails") <- (not fft_shift(_, _))  # nv

# round-trip
test("fftshift round-trip") <- (
    X is ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    fft_shift(X, S),
    fft_shift(X2, S),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)  # nv
