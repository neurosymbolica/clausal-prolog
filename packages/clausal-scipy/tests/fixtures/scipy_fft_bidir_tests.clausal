    SPEC is ++(__import__('scipy.fft', fromlist=['fftn']).fftn([[1.0, 2.0], [3.0, 4.0]])),
    fft_transformnd(RECOVERED, SPEC),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        __import__('numpy').real(RECOVERED) - __import__('numpy').array([[1.0, 2.0], [3.0, 4.0]])))),
    DIFF < 1e-10)  # nv

# both unbound
test("fftnd both unbound fails") <- (not fft_transformnd(_, _))  # nv

