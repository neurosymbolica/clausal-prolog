# Companion tests for docs/scipy_signal.md signature blocks.
-double_quotes(atom)
-import_from(scipy_signal, [convolve, correlate, butterworth, resample])

test("convolve exists") <- (
    convolve([1.0, 2.0, 3.0], [0.0, 1.0, 0.5], R),
    nonvar(R))  # nv

test("butterworth exists") <- (
    butterworth(4, 0.2, "low", R),
    nonvar(R))  # nv
