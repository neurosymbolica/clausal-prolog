# Companion tests for docs/scipy_sparse.md signature blocks.
-double_quotes(atom)
-import_from(scipy_sparse, [make_csr, make_eye, to_dense, shape, nonzero_count, free])

test("makecsr exists") <- (
    DATA is [1.0, 2.0, 3.0],
    IDX is [0, 1, 2],
    PTR is [0, 1, 2, 3],
    make_csr(DATA, IDX, PTR, H),
    nonzero_count(H, NNZ),
    NNZ == 3,
    free(H))  # nv

test("makeeye exists") <- (
    make_eye(3, H),
    nonzero_count(H, N),
    N == 3,
    free(H))  # nv
