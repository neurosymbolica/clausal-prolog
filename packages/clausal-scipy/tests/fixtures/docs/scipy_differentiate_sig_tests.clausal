# Companion tests for docs/scipy_differentiate.md signature blocks.
-double_quotes(atom)
-import_from(scipy_differentiate, [derivative, jacobian, ResultGet])

test("derivative exists") <- (
    derivative(++(lambda x: x**2), 3.0, R),
    ResultGet(R, "df", DF),
    DIFF is ++(abs(DF - 6.0)),
    DIFF < 1e-8)  # nv

test("jacobian exists") <- (
    jacobian(++(lambda x: [x[0]**2, x[1]**2]), ++([1.0, 2.0]), R),
    ResultGet(R, "df", _))  # nv
