# Companion tests for docs/scipy_optimize.md signature blocks.
-double_quotes(atom)
-import_from(scipy_optimize, [minimize, root_scalar, result_get])

test("minimize exists") <- (
    minimize(++(lambda x: float(x[0]**2)), [3.0], R),
    result_get(R, "x", X),
    ABS is ++(abs(float(X[0]))),
    ABS < 1e-4)  # nv

test("root scalar exists") <- (
    root_scalar(++(lambda x: x**2 - 4.0), "bisect", [1.0, 3.0], R),
    result_get(R, "root", ROOT),
    DIFF is ++(abs(float(ROOT) - 2.0)),
    DIFF < 1e-6)  # nv
