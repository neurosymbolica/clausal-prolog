# Companion tests for docs/scipy_fft.md signature blocks.
-double_quotes(atom)
-import_from(scipy_fft, [FFTransform, RealFFT, fft_frequencies])

test("fft exists") <- (
    FFTransform([1.0, 1.0, 1.0, 1.0], R),
    DC is ++(abs(complex(R[0]))),
    ++(abs(DC - 4.0)) < 1e-10)  # nv

test("real fft exists") <- (
    RealFFT([1.0, 0.0, 1.0, 0.0], R),
    nonvar(R))  # nv

test("fft frequencies exists") <- (
    fft_frequencies(4, 1.0, R),
    nonvar(R))  # nv
