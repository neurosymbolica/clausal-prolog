# Companion tests for docs/scipy_special.md signature blocks.
-double_quotes(atom)
-import_from(scipy_special, [gamma, erf, erf_complement, factorial, comb])

test("gamma exists") <- (
    gamma(5.0, V),
    DIFF is ++(abs(V - 24.0)),
    DIFF < 1e-10)  # nv

test("erf exists") <- (
    erf(0.0, V),
    ++(abs(V)) < 1e-10)  # nv

test("factorial exists") <- (
    factorial(5, V),
    V is ++(float(V)),
    ++(abs(V - 120.0)) < 1e-10)  # nv
