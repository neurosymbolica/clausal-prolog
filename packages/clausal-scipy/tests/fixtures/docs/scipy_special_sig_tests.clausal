# Companion tests for docs/scipy_special.md signature blocks.
-import_from(scipy_special, [Gamma, Erf, ErfComplement, Factorial, Comb])

test("gamma exists") <- (
    Gamma(5.0, V),
    DIFF is ++(abs(V - 24.0)),
    DIFF < 1e-10)  # nv

test("erf exists") <- (
    Erf(0.0, V),
    ++(abs(V)) < 1e-10)  # nv

test("factorial exists") <- (
    Factorial(5, V),
    V is ++(float(V)),
    ++(abs(V - 120.0)) < 1e-10)  # nv
