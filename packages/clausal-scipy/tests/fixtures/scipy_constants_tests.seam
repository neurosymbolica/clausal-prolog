-double_quotes(atom)
-import_from(scipy_constants, [
    SpeedOfLight, PlanckConstant, ReducedPlanckConstant,
    GravitationalConstant, AvogadroConstant, BoltzmannConstant,
    ElementaryCharge, ElectronMass, ProtonMass,
    ElectronVolt, StandardAtmosphere,
    Pi, Kilo, Mega, Giga])

-import_from(py.units, [
    metre, kilogram, second, ampere, kelvin, mole,
    joule, pascal, coulomb, newton])

# ── Speed of light ────────────────────────────────────────────────────────

test("speed of light exact value") <- (SpeedOfLight == 299792458(metre/second))  # nv

test("speed of light units") <- has_units(SpeedOfLight, metre/second)  # nv

# ── Planck constant ───────────────────────────────────────────────────────

test("planck constant units") <- has_units(PlanckConstant, joule * second)  # nv

test("planck constant magnitude") <- (
    PlanckConstant > 6.626e-34(joule * second),
    PlanckConstant < 6.627e-34(joule * second)
)  # nv

# ── Reduced Planck constant ───────────────────────────────────────────────

test("reduced planck constant units") <- has_units(ReducedPlanckConstant, joule * second)  # nv

test("reduced planck constant magnitude") <- (
    ReducedPlanckConstant > 1.054e-34(joule * second),
    ReducedPlanckConstant < 1.055e-34(joule * second)
)  # nv

test("hbar equals h over two pi") <- (
    eval_(PlanckConstant / (2 * Pi), HBAR_COMPUTED),
    ReducedPlanckConstant == HBAR_COMPUTED
)  # nv

# ── Gravitational constant ────────────────────────────────────────────────

test("gravitational constant units") <- (has_units(GravitationalConstant, newton * metre**2 / kilogram**2))  # nv

test("gravitational constant magnitude") <- (
    GravitationalConstant > 6.674e-11(newton * metre**2 / kilogram**2),
    GravitationalConstant < 6.675e-11(newton * metre**2 / kilogram**2)
)  # nv

# ── Avogadro constant ─────────────────────────────────────────────────────

test("avogadro constant units") <- (has_units(AvogadroConstant, mole**-1))  # nv

test("avogadro constant magnitude") <- (
    AvogadroConstant > 6.022e23(mole**-1),
    AvogadroConstant < 6.023e23(mole**-1)
)  # nv

# ── Boltzmann constant ────────────────────────────────────────────────────

test("boltzmann constant units") <- has_units(BoltzmannConstant, joule / kelvin)  # nv

test("boltzmann constant magnitude") <- (
    BoltzmannConstant > 1.380e-23(joule / kelvin),
    BoltzmannConstant < 1.381e-23(joule / kelvin)
)  # nv

# ── Elementary charge ─────────────────────────────────────────────────────

test("elementary charge units") <- has_units(ElementaryCharge, coulomb)  # nv

test("elementary charge magnitude") <- (
    ElementaryCharge > 1.602e-19(coulomb),
    ElementaryCharge < 1.603e-19(coulomb)
)  # nv

# ── Electron and proton masses ────────────────────────────────────────────

test("electron mass units") <- has_units(ElectronMass, kilogram)  # nv

test("electron mass magnitude") <- (
    ElectronMass > 9.109e-31(kilogram),
    ElectronMass < 9.110e-31(kilogram)
)  # nv

test("proton mass units") <- has_units(ProtonMass, kilogram)  # nv

test("proton heavier than electron") <- (
    eval_(ProtonMass / ElectronMass, RATIO),
    RATIO > 1836
)  # nv

# ── Electron volt ─────────────────────────────────────────────────────────

test("electron volt units") <- has_units(ElectronVolt, joule)  # nv

test("electron volt magnitude") <- (
    ElectronVolt > 1.602e-19(joule),
    ElectronVolt < 1.603e-19(joule)
)  # nv

# ── Standard atmosphere ───────────────────────────────────────────────────

test("standard atmosphere units") <- has_units(StandardAtmosphere, pascal)  # nv

test("standard atmosphere exact value") <- (StandardAtmosphere == 101325(pascal))  # nv

# ── SI prefix factors (dimensionless) ─────────────────────────────────────

test("si kilo") <- (Kilo == 1000.0)  # nv

test("si mega") <- (Mega == 1000000.0)  # nv

test("si giga") <- (Giga == 1000000000.0)  # nv

test("si prefixes consistent") <- (
    GIGA is 1000 * Mega,
    GIGA == Giga
)  # nv
