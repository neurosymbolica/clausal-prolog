-double_quotes(atom)
-import_from(scipy_integrate, [quad, trapezoid, cumulative_trapezoid, simpson, result_get])

# no units on x - plain fast path (verify existing behaviour is preserved)
test("trapezoid plain arrays returns plain") <- (
    trapezoid([1.0, 2.0, 3.0], RESULT),
    DIFF is ++(abs(float(RESULT) - 4.0)),
    DIFF < 1.0e-10)  # nv

test("quad no units fast path") <- (
    quad(++(lambda x: x), 0.0, 1.0, RESULT),
    result_get(RESULT, 'value', V),
    DIFF is ++(abs(float(V) - 0.5)),
    DIFF < 1.0e-9)  # nv
