-import_from(spacy, [LoadModel, UnloadModel, CurrentModel, Process, Token, TokenText, TokenList, Pos, Tag, Lemma, Dep, Head, Shape, IsAlpha, IsStop, Entity, EntityList, Sentence, SentenceList, Similarity, NounChunk])

# spaCy predicates — basic tests

# ── Setup helper ─────────────────────────────────────────────────────────────

setup(DOC) <- (LoadModel("en_core_web_sm", "test") and Process("test", "Apple is looking at buying U.K. startup for $1 billion.", DOC))

# ── Model management ────────────────────────────────────────────────────────

test("load model") <- LoadModel("en_core_web_sm", "basic")  # nv
test("load model idempotent") <- (LoadModel("en_core_web_sm", "basic") and LoadModel("en_core_web_sm", "basic"))  # nv
test("current model") <- (LoadModel("en_core_web_sm", "cm") and CurrentModel("cm"))  # nv

# ── Token iteration ─────────────────────────────────────────────────────────

test("token iteration") <- (setup(DOC) and Token(DOC, TOK) and TokenText(TOK, "Apple"))  # nv

test("token by index") <- (setup(DOC) and Token(DOC, 0, TOK) and TokenText(TOK, "Apple"))  # nv

test("token list") <- (setup(DOC) and TokenList(DOC, TOKS) and FIRST is ++TOKS[0] and T is ++FIRST["text"] and T == "Apple")  # nv

# ── Annotations ─────────────────────────────────────────────────────────────

test("pos tag") <- (setup(DOC) and Token(DOC, 0, TOK) and Pos(TOK, P) and P == "PROPN")  # nv

test("lemma") <- (setup(DOC) and Token(DOC, 2, TOK) and Lemma(TOK, L) and L == "look")  # nv

test("dep label") <- (setup(DOC) and Token(DOC, 0, TOK) and Dep(TOK, D) and D == "nsubj")  # nv

test("shape") <- (setup(DOC) and Token(DOC, 0, TOK) and Shape(TOK, S) and S == "Xxxxx")  # nv

test("is alpha") <- (setup(DOC) and Token(DOC, 0, TOK) and IsAlpha(TOK))  # nv

# ── NER ─────────────────────────────────────────────────────────────────────

test("entity iteration") <- (setup(DOC) and Entity(DOC, E) and T is ++E["text"] and T == "Apple")  # nv

test("entity by label") <- (setup(DOC) and Entity(DOC, "ORG", E) and T is ++E["text"] and T == "Apple")  # nv

test("entity list") <- (setup(DOC) and EntityList(DOC, ENTS) and FIRST is ++ENTS[0] and T is ++FIRST["text"] and T == "Apple")  # nv

# ── Sentences ───────────────────────────────────────────────────────────────

test("sentence iteration") <- (setup(DOC) and Sentence(DOC, S) and S == "Apple is looking at buying U.K. startup for $1 billion.")  # nv

test("sentence list") <- (setup(DOC) and SentenceList(DOC, SENTS) and FIRST is ++SENTS[0] and FIRST == "Apple is looking at buying U.K. startup for $1 billion.")  # nv

# ── Noun chunks ─────────────────────────────────────────────────────────────

test("noun chunk") <- (setup(DOC) and NounChunk(DOC, C) and T is ++C["text"] and T == "Apple")  # nv
