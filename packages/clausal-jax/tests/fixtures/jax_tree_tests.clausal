-import_from(jax, [array, shape, element_count])
-import_from(jax_tree, [
    leaf, leaf_with_path,
    tree_flatten, tree_structure, tree_leaves_list,
    all_leaves, treedef_is_leaf,
    tree_map, tree_map_n, tree_reduce,
    keystr
])

# --- leaf enumeration ---

Test("leaf enumerates flat list") <- (
    TREE is [1.0, 2.0, 3.0],
    findall(L, leaf(TREE, L), LS),
    LS == [1.0, 2.0, 3.0]
)  # nv

Test("leaf enumerates nested dict") <- (
    TREE is {"a": [1.0, 2.0], "b": (3.0, 4.0)},
    findall(L, leaf(TREE, L), LS),
    length(LS, 4)
)  # nv

Test("leaf on a single value") <- (
    TREE is 42.0,
    findall(L, leaf(TREE, L), LS),
    LS == [42.0]
)  # nv

Test("leaf on empty list has no leaves") <- (
    TREE is [],
    findall(L, leaf(TREE, L), LS),
    LS == []
)  # nv

Test("leaf on empty dict has no leaves") <- (
    TREE is {},
    findall(L, leaf(TREE, L), LS),
    LS == []
)  # nv

# --- leaf_with_path ---

Test("leaf_with_path on flat list yields index paths") <- (
    TREE is [10.0, 20.0],
    findall(P-L, leaf_with_path(TREE, P, L), PAIRS),
    length(PAIRS, 2)
)  # nv

Test("leaf_with_path exposes dict key") <- (
    TREE is {"a": 1.0},
    leaf_with_path(TREE, (("key", "a"),), 1.0)
)  # nv

Test("leaf_with_path on nested dict yields correct depth") <- (
    TREE is {"a": [1.0, 2.0]},
    findall(P, leaf_with_path(TREE, P, _L), PS),
    length(PS, 2)
)  # nv

Test("leaf_with_path dict path then list index") <- (
    TREE is {"a": [1.0, 2.0]},
    leaf_with_path(TREE, (("key", "a"), ("index", 1)), 2.0)
)  # nv

# --- tree_flatten (bijective) ---

Test("tree_flatten forward count") <- (
    TREE is {"a": [1.0, 2.0], "b": 3.0},
    tree_flatten(TREE, _TREEDEF, LEAVES),
    length(LEAVES, 3)
)  # nv

Test("tree_flatten roundtrip dict") <- (
    TREE is {"a": [1.0, 2.0], "b": 3.0},
    tree_flatten(TREE, TREEDEF, LEAVES),
    tree_flatten(REBUILT, TREEDEF, LEAVES),
    REBUILT == TREE
)  # nv

Test("tree_flatten roundtrip list") <- (
    TREE is [1.0, 2.0, 3.0],
    tree_flatten(TREE, TREEDEF, LEAVES),
    tree_flatten(REBUILT, TREEDEF, LEAVES),
    REBUILT == TREE
)  # nv

Test("unflatten with modified leaves") <- (
    TREE is {"a": [1.0, 2.0], "b": 3.0},
    tree_flatten(TREE, TREEDEF, LEAVES),
    MODIFIED is ++[l * 10 for l in LEAVES],
    tree_flatten(NEW_TREE, TREEDEF, MODIFIED),
    leaf(NEW_TREE, 10.0)
)  # nv

Test("tree_flatten on single value") <- (
    tree_flatten(42.0, _TREEDEF, LEAVES),
    LEAVES == [42.0]
)  # nv

# --- structure queries ---

Test("tree_structure returns PyTreeDef") <- (
    TREE is {"a": 1.0, "b": 2.0},
    tree_structure(TREE, TD),
    tree_flatten(TREE, TD2, _LEAVES),
    TD == TD2
)  # nv

Test("tree_leaves_list flat list") <- (
    TREE is [1.0, 2.0, 3.0],
    tree_leaves_list(TREE, LEAVES),
    LEAVES == [1.0, 2.0, 3.0]
)  # nv

Test("tree_leaves_list nested") <- (
    TREE is {"a": [1.0, 2.0], "b": 3.0},
    tree_leaves_list(TREE, LEAVES),
    length(LEAVES, 3)
)  # nv

Test("all_leaves accepts flat list of leaves") <- (
    all_leaves([1.0, 2.0, 3.0])
)  # nv

Test("all_leaves rejects nested list") <- (
    not all_leaves([[1.0], 2.0])
)  # nv

Test("treedef_is_leaf on scalar flatten") <- (
    tree_flatten(42.0, TD, _LS),
    treedef_is_leaf(TD)
)  # nv

Test("treedef_is_leaf false on list flatten") <- (
    TREE is [1.0, 2.0],
    tree_flatten(TREE, TD, _LS),
    not treedef_is_leaf(TD)
)  # nv

# --- mapping ---

Test("tree_map doubles leaves") <- (
    TREE is {"a": 1.0, "b": 2.0},
    F is ++(lambda x: x * 2),
    tree_map(F, TREE, DOUBLED),
    tree_leaves_list(DOUBLED, LS),
    LS == [2.0, 4.0]
)  # nv

Test("tree_map preserves structure") <- (
    TREE is {"a": [1.0, 2.0], "b": 3.0},
    F is ++(lambda x: x + 1),
    tree_map(F, TREE, MAPPED),
    tree_structure(TREE, TD1),
    tree_structure(MAPPED, TD2),
    TD1 == TD2
)  # nv

Test("tree_map_n adds leaves of two trees") <- (
    T1 is {"a": 1.0, "b": 2.0},
    T2 is {"a": 10.0, "b": 20.0},
    F is ++(lambda x, y: x + y),
    tree_map_n(F, [T1, T2], R),
    tree_leaves_list(R, LS),
    LS == [11.0, 22.0]
)  # nv

# --- reducing ---

Test("tree_reduce sums leaves") <- (
    TREE is {"a": 1.0, "b": 2.0, "c": 3.0},
    F is ++(lambda acc, x: acc + x),
    tree_reduce(F, TREE, 0.0, TOTAL),
    TOTAL == 6.0
)  # nv

Test("tree_reduce with max and init") <- (
    TREE is [1.0, 5.0, 3.0],
    F is ++(lambda acc, x: max(acc, x)),
    tree_reduce(F, TREE, 0.0, PEAK),
    PEAK == 5.0
)  # nv

Test("tree_reduce counts leaves") <- (
    TREE is {"a": [1.0, 2.0], "b": 3.0},
    F is ++(lambda acc, _x: acc + 1),
    tree_reduce(F, TREE, 0, COUNT),
    COUNT == 3
)  # nv

# --- key-path rendering ---

Test("keystr renders dict + index path") <- (
    keystr((("key", "a"), ("index", 0)), S),
    S == "['a'][0]"
)  # nv

Test("keystr on empty path") <- (
    keystr((), S),
    S == ""
)  # nv

# --- showcase: findall pattern over pytree ---

Test("findall scalar leaves greater than 2") <- (
    TREE is {"a": 1.0, "b": [2.0, 3.0, 4.0]},
    findall(L, (leaf(TREE, L), L > 2.0), BIG),
    length(BIG, 2)
)  # nv
