-import_from(jax, [
    array, zeros, arange, shape, array_list,
    concatenate, stacked,
    partition, array_split, hsplit, vsplit, dsplit,
    tile, repeat, flip, roll, pad
])

# --- partition (bidirectional split + concatenate) ---

Test("partition forward into 3 equal parts") <- (
    arange(0, 6, A),
    partition(A, 3, LS),
    length(LS, 3)
)  # nv

Test("partition forward produces correct pieces") <- (
    arange(0, 6, A),
    partition(A, 3, [P0, P1, P2]),
    array_list(P0, [0, 1]),
    array_list(P1, [2, 3]),
    array_list(P2, [4, 5])
)  # nv

Test("partition forward into 1 returns list of 1") <- (
    arange(0, 4, A),
    partition(A, 1, LS),
    length(LS, 1)
)  # nv

Test("partition forward by indices") <- (
    arange(0, 10, A),
    partition(A, [3, 7], [P0, P1, P2]),
    array_list(P0, [0, 1, 2]),
    array_list(P1, [3, 4, 5, 6]),
    array_list(P2, [7, 8, 9])
)  # nv

# Backward direction: given LS, partition concatenates to recover A.
Test("partition backward concatenates pieces") <- (
    array([0, 1], P0),
    array([2, 3], P1),
    array([4, 5], P2),
    partition(A, 3, [P0, P1, P2]),
    array_list(A, [0, 1, 2, 3, 4, 5])
)  # nv

Test("partition backward along axis 1") <- (
    array([[1, 2], [5, 6]], L),
    array([[3, 4], [7, 8]], R),
    partition(A, 2, 1, [L, R]),
    array_list(A, [[1, 2, 3, 4], [5, 6, 7, 8]])
)  # nv

Test("partition roundtrip") <- (
    arange(0, 6, A),
    partition(A, 3, LS),
    partition(A2, 3, LS),
    array_list(A, L),
    array_list(A2, L)
)  # nv

Test("partition forward along axis 1") <- (
    zeros([3, 4], M),
    partition(M, 2, 1, LS),
    length(LS, 2)
)  # nv

# --- array_split (tolerates uneven) ---

Test("array_split uneven") <- (
    arange(0, 7, A),
    array_split(A, 3, LS),
    length(LS, 3)
)  # nv

Test("array_split even matches split") <- (
    arange(0, 6, A),
    array_split(A, 3, LS),
    length(LS, 3)
)  # nv

Test("array_split along axis") <- (
    zeros([3, 5], M),
    array_split(M, 2, 1, LS),
    length(LS, 2)
)  # nv

# --- hsplit / vsplit / dsplit ---

Test("hsplit 2x4 into 2") <- (
    arange(0, 8, A),
    array_list(A, _),
    hsplit(A, 2, LS),
    length(LS, 2)
)  # nv

Test("hsplit on 2x4 matrix splits columns") <- (
    array([[0, 1, 2, 3], [4, 5, 6, 7]], M),
    hsplit(M, 2, [L, R]),
    array_list(L, [[0, 1], [4, 5]]),
    array_list(R, [[2, 3], [6, 7]])
)  # nv

Test("vsplit on 4x2 matrix splits rows") <- (
    array([[0, 1], [2, 3], [4, 5], [6, 7]], M),
    vsplit(M, 2, [T, B]),
    array_list(T, [[0, 1], [2, 3]]),
    array_list(B, [[4, 5], [6, 7]])
)  # nv

Test("dsplit on 2x3x4 into 2") <- (
    zeros([2, 3, 4], M),
    dsplit(M, 2, LS),
    length(LS, 2)
)  # nv

# --- tile ---

Test("tile 1d") <- (
    array([1, 2], A),
    tile(A, [3], R),
    array_list(R, [1, 2, 1, 2, 1, 2])
)  # nv

Test("tile by 1 is identity") <- (
    array([1, 2, 3], A),
    tile(A, [1], R),
    array_list(R, [1, 2, 3])
)  # nv

Test("tile with int reps") <- (
    array([1, 2], A),
    tile(A, 3, R),
    array_list(R, [1, 2, 1, 2, 1, 2])
)  # nv

Test("tile 2d with 2-tuple reps") <- (
    array([[1, 2], [3, 4]], A),
    tile(A, [2, 3], R),
    shape(R, [4, 6])
)  # nv

# --- repeat ---

Test("repeat each element twice") <- (
    array([1, 2, 3], A),
    repeat(A, 2, 0, R),
    array_list(R, [1, 1, 2, 2, 3, 3])
)  # nv

Test("repeat along axis 0 of 2d") <- (
    array([[1, 2], [3, 4]], A),
    repeat(A, 2, 0, R),
    array_list(R, [[1, 2], [1, 2], [3, 4], [3, 4]])
)  # nv

Test("repeat along axis 1 of 2d") <- (
    array([[1, 2], [3, 4]], A),
    repeat(A, 2, 1, R),
    array_list(R, [[1, 1, 2, 2], [3, 3, 4, 4]])
)  # nv

# --- flip ---

Test("flip along axis 0") <- (
    array([[1, 2], [3, 4]], A),
    flip(A, 0, R),
    array_list(R, [[3, 4], [1, 2]])
)  # nv

Test("flip along axis 1") <- (
    array([[1, 2], [3, 4]], A),
    flip(A, 1, R),
    array_list(R, [[2, 1], [4, 3]])
)  # nv

Test("flip 1d reverses") <- (
    array([1, 2, 3, 4], A),
    flip(A, 0, R),
    array_list(R, [4, 3, 2, 1])
)  # nv

Test("flip multiple axes via tuple") <- (
    array([[1, 2], [3, 4]], A),
    flip(A, (0, 1), R),
    array_list(R, [[4, 3], [2, 1]])
)  # nv

Test("flip no axis reverses all dims") <- (
    array([[1, 2, 3], [4, 5, 6]], A),
    flip(A, R),
    array_list(R, [[6, 5, 4], [3, 2, 1]])
)  # nv

Test("flip no axis on 1d") <- (
    array([1, 2, 3, 4], A),
    flip(A, R),
    array_list(R, [4, 3, 2, 1])
)  # nv

# --- roll ---

Test("roll 1d by 1") <- (
    array([1, 2, 3, 4], A),
    roll(A, 1, R),
    array_list(R, [4, 1, 2, 3])
)  # nv

Test("roll 1d by 2") <- (
    array([1, 2, 3, 4], A),
    roll(A, 2, R),
    array_list(R, [3, 4, 1, 2])
)  # nv

Test("roll by 0 is identity") <- (
    array([1, 2, 3], A),
    roll(A, 0, R),
    array_list(R, [1, 2, 3])
)  # nv

Test("roll with axis") <- (
    array([[1, 2, 3], [4, 5, 6]], A),
    roll(A, 1, 0, R),
    array_list(R, [[4, 5, 6], [1, 2, 3]])
)  # nv

# roll/3 without axis flattens the array, rolls, then reshapes back.
# This differs from roll/4 which rolls along a specific axis.
Test("roll no axis on 2d flattens and reshapes") <- (
    array([[0, 1, 2], [3, 4, 5]], A),
    roll(A, 1, R),
    array_list(R, [[5, 0, 1], [2, 3, 4]])
)  # nv

Test("roll along axis 1") <- (
    array([[1, 2, 3], [4, 5, 6]], A),
    roll(A, 1, 1, R),
    array_list(R, [[3, 1, 2], [6, 4, 5]])
)  # nv

# --- stacked backward (subsumes the old unstack) ---

Test("stacked backward along axis 0") <- (
    array([[1, 2], [3, 4], [5, 6]], A),
    stacked(LS, 0, A),
    length(LS, 3)
)  # nv

Test("stacked backward produces correct slices") <- (
    array([[1, 2], [3, 4], [5, 6]], A),
    stacked([R0, R1, R2], 0, A),
    array_list(R0, [1, 2]),
    array_list(R1, [3, 4]),
    array_list(R2, [5, 6])
)  # nv

Test("stacked backward along axis 1") <- (
    array([[1, 2], [3, 4]], A),
    stacked(LS, 1, A),
    length(LS, 2)
)  # nv

# --- pad ---

Test("pad 1d constant default") <- (
    array([1, 2, 3], A),
    pad(A, [1, 2], R),
    array_list(R, [0, 1, 2, 3, 0, 0])
)  # nv

Test("pad 1d constant explicit mode") <- (
    array([1, 2, 3], A),
    pad(A, [1, 2], "constant", R),
    array_list(R, [0, 1, 2, 3, 0, 0])
)  # nv

Test("pad 1d edge mode") <- (
    array([1, 2, 3], A),
    pad(A, [1, 2], "edge", R),
    array_list(R, [1, 1, 2, 3, 3, 3])
)  # nv

Test("pad 2d with per-axis widths") <- (
    array([[1, 2], [3, 4]], A),
    pad(A, [[1, 0], [0, 2]], R),
    shape(R, [3, 4])
)  # nv

Test("pad reflects") <- (
    array([1, 2, 3, 4], A),
    pad(A, [2, 2], "reflect", R),
    array_list(R, [3, 2, 1, 2, 3, 4, 3, 2])
)  # nv
