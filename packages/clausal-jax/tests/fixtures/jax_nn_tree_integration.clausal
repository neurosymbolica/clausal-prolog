-import_module(jax)
-import_from(jax_random, [key, split_key])
-import_from(jax_nn, [initializer, init_array])
-import_from(jax_tree, [
    leaf, tree_structure, tree_leaves_list,
    tree_map, tree_reduce
])

# Phase 9 (pytrees) + Phase 10 (initializers) composition tests.
# Docs/jax_nn.md promises that initialising a parameter pytree is
# "just composition"; these tests make that claim verifiable.

test("init a two-layer param pytree") <- (
    initializer("glorot_uniform", F),
    key(0, K),
    split_key(K, 2, [K1, K2]),
    init_array(F, K1, [10, 5], W1),
    init_array(F, K2, [5, 3], W2),
    PARAMS is {"layer1": {"w": W1}, "layer2": {"w": W2}},
    findall(L, leaf(PARAMS, L), LEAVES),
    length(LEAVES, 2)
)  # nv

test("tree_map preserves structure over an init'd param pytree") <- (
    initializer("zeros", F),
    key(0, K),
    split_key(K, 2, [K1, K2]),
    init_array(F, K1, [3], W1),
    init_array(F, K2, [2], W2),
    PARAMS is {"a": W1, "b": W2},
    ADD_ONE is ++(lambda w: w + 1.0),
    tree_map(ADD_ONE, PARAMS, MAPPED),
    tree_structure(PARAMS, TD1),
    tree_structure(MAPPED, TD2),
    TD1 == TD2
)  # nv

test("tree_reduce sums element counts across param leaves") <- (
    initializer("zeros", F),
    key(0, K),
    split_key(K, 2, [K1, K2]),
    init_array(F, K1, [10, 5], W1),
    init_array(F, K2, [5, 3], W2),
    PARAMS is {"layer1": W1, "layer2": W2},
    ADD_COUNT is ++(lambda acc, w: acc + w.size),
    tree_reduce(ADD_COUNT, PARAMS, 0, TOTAL),
    TOTAL == 65
)  # nv

test("tree_leaves_list preserves leaf order by dict key") <- (
    initializer("zeros", F),
    key(0, K),
    split_key(K, 2, [K1, K2]),
    init_array(F, K1, [3], W1),
    init_array(F, K2, [2], W2),
    PARAMS is {"a": W1, "b": W2},
    tree_leaves_list(PARAMS, LEAVES),
    length(LEAVES, 2)
)  # nv
