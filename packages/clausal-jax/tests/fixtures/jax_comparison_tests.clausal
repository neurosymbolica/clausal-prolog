-import_from(jax, [
    array, zeros, ones, shape, array_list,
    eq, ne, gt, lt, ge, le, equal, array_equal, allclose,
    logical_and, logical_or, logical_not, logical_xor,
    any, all,
    where, masked_select, take, put_along_axis,
    float32, int32
])

# --- Element-wise comparisons ---

test("eq element-wise") <- (
    array([1, 2, 3], A),
    array([1, 5, 3], B),
    eq(A, B, C),
    array_list(C, [True, False, True])
)  # nv

test("ne element-wise") <- (
    array([1, 2, 3], A),
    array([1, 5, 3], B),
    ne(A, B, C),
    array_list(C, [False, True, False])
)  # nv

test("gt element-wise") <- (
    array([1.0, 2.0, 3.0], A),
    array([2.0, 2.0, 2.0], B),
    gt(A, B, C),
    array_list(C, [False, False, True])
)  # nv

test("lt element-wise") <- (
    array([1.0, 2.0, 3.0], A),
    array([2.0, 2.0, 2.0], B),
    lt(A, B, C),
    array_list(C, [True, False, False])
)  # nv

test("ge element-wise") <- (
    array([1.0, 2.0, 3.0], A),
    array([2.0, 2.0, 2.0], B),
    ge(A, B, C),
    array_list(C, [False, True, True])
)  # nv

test("le element-wise") <- (
    array([1.0, 2.0, 3.0], A),
    array([2.0, 2.0, 2.0], B),
    le(A, B, C),
    array_list(C, [True, True, False])
)  # nv

# --- Check predicates: equal, array_equal, allclose ---

test("equal check succeeds") <- (
    array([1.0, 2.0, 3.0], A),
    array([1.0, 2.0, 3.0], B),
    equal(A, B)
)  # nv

test("equal check fails") <- (
    array([1.0, 2.0, 3.0], A),
    array([1.0, 2.0, 4.0], B),
    not(equal(A, B))
)  # nv

test("equal check fails on different shapes") <- (
    array([1.0, 2.0], A),
    array([1.0, 2.0, 3.0], B),
    not(equal(A, B))
)  # nv

test("array_equal succeeds") <- (
    array([[1, 2], [3, 4]], A),
    array([[1, 2], [3, 4]], B),
    array_equal(A, B)
)  # nv

test("array_equal fails") <- (
    array([[1, 2], [3, 4]], A),
    array([[1, 2], [3, 5]], B),
    not(array_equal(A, B))
)  # nv

test("allclose within tolerance") <- (
    array([1.0, 2.0], A),
    array([1.0000001, 2.0], B),
    allclose(A, B)
)  # nv

test("allclose fails outside tolerance") <- (
    array([1.0, 2.0], A),
    array([1.1, 2.0], B),
    not(allclose(A, B))
)  # nv

test("allclose with explicit tolerances succeeds") <- (
    array([1.0, 2.0], A),
    array([1.05, 2.05], B),
    allclose(A, B, 0.1, 0.0)
)  # nv

test("allclose with explicit tolerances fails") <- (
    array([1.0, 2.0], A),
    array([1.2, 2.2], B),
    not(allclose(A, B, 0.01, 0.0))
)  # nv

# --- Logical operations ---

test("logical_and") <- (
    array([True, True, False, False], A),
    array([True, False, True, False], B),
    logical_and(A, B, C),
    array_list(C, [True, False, False, False])
)  # nv

test("logical_or") <- (
    array([True, True, False, False], A),
    array([True, False, True, False], B),
    logical_or(A, B, C),
    array_list(C, [True, True, True, False])
)  # nv

test("logical_not") <- (
    array([True, False, True], A),
    logical_not(A, B),
    array_list(B, [False, True, False])
)  # nv

test("logical_xor") <- (
    array([True, True, False, False], A),
    array([True, False, True, False], B),
    logical_xor(A, B, C),
    array_list(C, [False, True, True, False])
)  # nv

# --- any / all check predicates ---

test("any true") <- (
    array([False, False, True], A),
    any(A)
)  # nv

test("any fails when all false") <- (
    array([False, False, False], A),
    not(any(A))
)  # nv

test("all true") <- (
    array([True, True, True], A),
    all(A)
)  # nv

test("all fails with false") <- (
    array([True, False, True], A),
    not(all(A))
)  # nv

test("any with axis") <- (
    array([[False, True], [False, False]], A),
    any(A, 1)
)  # nv

test("all with axis") <- (
    array([[True, True], [True, True]], A),
    all(A, 0)
)  # nv

# --- Selection ---

test("where selects") <- (
    array([True, False, True], COND),
    array([10, 20, 30], X),
    array([1, 2, 3], Y),
    where(COND, X, Y, R),
    array_list(R, [10, 2, 30])
)  # nv

test("where broadcasts scalar branches") <- (
    array([True, False, True, False], COND),
    where(COND, 1, 0, R),
    array_list(R, [1, 0, 1, 0])
)  # nv

test("masked_select") <- (
    array([1, 2, 3, 4, 5], A),
    array([True, False, True, False, True], MASK),
    masked_select(A, MASK, R),
    array_list(R, [1, 3, 5])
)  # nv

test("masked_select non-contiguous mask") <- (
    array([10, 20, 30, 40, 50, 60], A),
    array([False, True, True, False, True, False], MASK),
    masked_select(A, MASK, R),
    array_list(R, [20, 30, 50])
)  # nv

test("take along axis 0") <- (
    array([[1, 2], [3, 4], [5, 6]], A),
    array([0, 2], IDX),
    take(A, IDX, 0, R),
    shape(R, [2, 2]),
    array_list(R, [[1, 2], [5, 6]])
)  # nv

test("take along axis 1") <- (
    array([[1, 2, 3], [4, 5, 6]], A),
    array([2, 0], IDX),
    take(A, IDX, 1, R),
    array_list(R, [[3, 1], [6, 4]])
)  # nv

test("put_along_axis scatter") <- (
    zeros([3, 3], A),
    array([[1], [2], [0]], IDX),
    array([[7.0], [8.0], [9.0]], VAL),
    put_along_axis(A, IDX, VAL, 1, R),
    array_list(R, [[0.0, 7.0, 0.0], [0.0, 0.0, 8.0], [9.0, 0.0, 0.0]])
)  # nv
