# Companion tests for docs/sklearn.md display snippets.

-import_from(sklearn, [Est, Dataset, Fitted, Split, LoadDataset, Fit, Predict,
                       Score, Algorithm, Learned, MakeDataset, SplitData,
                       Pipeline, CrossValScore])

# ── Algorithm registry ───────────────────────────────────────────────────────

test("random_forest is classifier") <- Algorithm("random_forest", "classifier")  # nv

test("pca is transformer") <- Algorithm("pca", "transformer")  # nv

# ── Data loading ─────────────────────────────────────────────────────────────

test("load iris") <- (
    LoadDataset("iris", D),
    D is ("Dataset", _, _)
)  # nv

test("make synthetic") <- (
    MakeDataset("classification",
                {"n_samples": 50, "n_features": 4, "random_state": 42},
                D),
    D is ("Dataset", _, _)
)  # nv

# ── Fit and predict ──────────────────────────────────────────────────────────

test("fit and predict") <- (
    LoadDataset("iris", D),
    Fit(Est("random_forest", {"n_estimators": 10, "random_state": 42}), D, F),
    D is ("Dataset", X, _),
    Predict(F, X, PREDS),
    nonvar(PREDS)
)  # nv

# ── Score ────────────────────────────────────────────────────────────────────

test("score") <- (
    LoadDataset("iris", D),
    Fit(Est("random_forest", {"n_estimators": 10, "random_state": 42}), D, F),
    Score(F, D, S),
    S > 0.8
)  # nv

# ── Learned attributes ───────────────────────────────────────────────────────

test("feature importances") <- (
    LoadDataset("iris", D),
    Fit(Est("random_forest", {"n_estimators": 10, "random_state": 42}), D, F),
    Learned(F, "feature_importances", FI),
    nonvar(FI)
)  # nv
