-double_quotes(atom)
-import_from(sklearn, [est, dataset, fitted, load_dataset, fit, predict,
                       score, metric, cross_val_score, cross_validate,
                       confusion_matrix, predict_proba, split_data, kfold])

# ── metric/4: classification metrics ────────────────────────────────

test("accuracy metric") <- (
    load_dataset("iris", DATASET),
    fit(est("random_forest", {"n_estimators": 10, "random_state": 42}), DATASET, FITTED),
    DATASET is ("dataset", X, Y),
    predict(FITTED, X, PREDS),
    metric("accuracy", Y, PREDS, SCORE),
    SCORE > 0.8
)  # nv

# ── score/4 with explicit metric ─────────────────────────────────────

test("score with accuracy metric") <- (
    load_dataset("iris", DATASET),
    fit(est("logistic_regression", {"max_iter": 200}), DATASET, FITTED),
    score(FITTED, DATASET, "accuracy", SCORE),
    SCORE > 0.5
)  # nv

# ── Regression metrics ───────────────────────────────────────────────

test("r2 metric on diabetes") <- (
    load_dataset("diabetes", DATASET),
    fit(est("ridge", {}), DATASET, FITTED),
    DATASET is ("dataset", X, Y),
    predict(FITTED, X, PREDS),
    metric("r2", Y, PREDS, SCORE_UNUSED)
)  # nv

test("mse metric on diabetes") <- (
    load_dataset("diabetes", DATASET),
    fit(est("ridge", {}), DATASET, FITTED),
    DATASET is ("dataset", X, Y),
    predict(FITTED, X, PREDS),
    metric("mse", Y, PREDS, SCORE),
    SCORE > 0.0
)  # nv

# ── cross_val_score ────────────────────────────────────────────────────

test("cross val score on iris") <- (
    load_dataset("iris", DATASET),
    cross_val_score(est("logistic_regression", {"max_iter": 200}),
                  DATASET, kfold(3), SCORES_UNUSED)
)  # nv

test("cross val score with metric") <- (
    load_dataset("iris", DATASET),
    cross_val_score(est("logistic_regression", {"max_iter": 200}),
                  DATASET, kfold(3), "accuracy", SCORES_UNUSED)
)  # nv

# ── cross_validate ────────────────────────────────────────────────────

test("cross validate multiple metrics") <- (
    load_dataset("iris", DATASET),
    cross_validate(est("logistic_regression", {"max_iter": 200}),
                  DATASET, kfold(3), ["accuracy", "f1_weighted"], RESULTS_UNUSED)
)  # nv

# ── confusion_matrix ──────────────────────────────────────────────────

test("confusion matrix on iris") <- (
    load_dataset("iris", DATASET),
    fit(est("random_forest", {"n_estimators": 10, "random_state": 42}), DATASET, FITTED),
    DATASET is ("dataset", X, Y),
    predict(FITTED, X, PREDS),
    confusion_matrix(Y, PREDS, MATRIX_UNUSED)
)  # nv
