# The seam twin of s2/native/s2lib/shapes.seam, importing the twin facts
# (slice 2 exit).
-module(shapes, [area/2, scaled/2, kinds/1])
-import_from(s2tw.facts, [base/1, pair/2])
-private([sq(side), rect(w, h)])

area(sq(S), A) <- (A == S * S)
area(rect(W, H), A) <- (A == W * H)

scaled(X, Y) <- (base(B), Y == X * B)

kinds(K) <- pair(K, _)
