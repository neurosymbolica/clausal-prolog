# The hand-written seam twin of s4_exit.pl (slice 4's exit test): the same
# case(Name, L) rows, written as a seam author writes them.  library(reif)'s
# if_/3 takes a CLOSURE (called with one more argument, the truth value);
# the seam's if_ takes a GOAL, so a closure condition is written out as the
# reified call, the must_be/2 check and if_ on the truth value, and reif's
# (',')/3 and (;)/3 conditions as nested if_.  test_l3_s4_exit.py compares
# every row with the native front end's and with Scryer's.
-import_from(clausal.stdlib.reif, [memberd_t, tfilter, tpartition, tmember,
                                   tmember_t, cond_t])
-private([a, b, c, d, y, n, ok, yes, no, err, foo, z, boolean, bad_t,
          bad2_t, my(e), error(f, c)])

p(1, a),
p(2, a),
p(3, b),

add(X, A0, A) <- (A == A0 + X)
add2(X, Y, A0, A) <- (A == A0 + X * Y)
add3(X, Y, Z, A0, A) <- (A == A0 + X + Y + Z)
sum3(A, B, C) <- (C == A + B)
sum4(A, B, C, D) <- (D == A + B + C)
sum5(A, B, C, D, E) <- (E == A + B + C + D)
sum6(A, B, C, D, E, F) <- (F == A + B + C + D + E)
two(1),
two(2),

# D40: a user-defined true/N and false/N (N >= 1).
true(X) <- (X is 1)
false(X, Y) <- (Y == X + 1)

# library(reif)'s (=)/3 and dif/3 as closures: a seam closure names a
# predicate in scope, and these two are engine builtins.
eqr(X, Y, T) <- '='(X, Y, T)
neq(X, Y, T) <- dif(X, Y, T)

bad_t(_),
bad2_t(foo),

case('c01_setof_caret', L) <- findall(S, setof(X, Y ^ p(X, Y), S), L)
case('c02_bagof_groups', L) <- findall('-'(Y, S), bagof(X, p(X, Y), S), L)
case('c03_findall4', L) <- findall(R, findall(X, member(X, [1, 2]), R, [3]), L)
case('c04_forall', L) <- findall(R, (member(R, [yes, no]),
                                   forall(member(X, [1, 2]), X > 0),
                                   '=='(R, yes)), L)
case('c05_forall_fails', L) <- findall(ok, forall(member(X, [1, 2]),
                                                once(X > 1)), L)
case('c06_once', L) <- findall(X, once(member(X, [a, b])), L)
case('c07_catch_throw', L) <- findall(E, catch(throw(my(err)), E, True), L)
case('c08_maplist2', L) <- findall('-'(X, Y), maplist(two, [X, Y]), L)
case('c09_maplist3', L) <- findall(R, maplist(add(1), [1, 2], R), L)
case('c10_maplist4to7', L) <- findall(
    '-'('-'('-'(R3, R4), R5), R6),
    (maplist(sum3, [1, 2], [10, 20], R3),
     maplist(sum4, [1], [2], [3], R4),
     maplist(sum5, [1], [2], [3], [4], R5),
     maplist(sum6, [1], [2], [3], [4], [5], R6)), L)
case('c11_foldl4to6', L) <- findall(
    '-'('-'(S4, S5), S6),
    (foldl(add, [1, 2, 3], 0, S4),
     foldl(add2, [1, 2], [3, 4], 0, S5),
     foldl(add3, [1], [2], [3], 0, S6)), L)
case('c12_dif', L) <- findall(X, (dif(X, a), member(X, [a, b, c])), L)
case('c13_naf', L) <- findall(X, (member(X, [1, 2, 3]), not X is 2), L)
case('c14_if_eq', L) <- findall('-'(X, R), (if_(X is a, R is y, R is n),
                                          member(X, [a, b])), L)
case('c15_if_dif', L) <- findall('-'(X, R), (if_(X is a, R is n, R is y),
                                           member(X, [a, b])), L)
case('c16_if_and', L) <- findall(
    '-'('-'(X, Y), R),
    (if_(X is a, if_(Y is b, R is y, R is n), R is n),
     member(X, [a, c]), member(Y, [b, d])), L)
case('c17_if_or', L) <- findall(
    '-'('-'(X, Y), R),
    (if_(X is a, R is y, if_(Y is b, R is y, R is n)),
     member(X, [a, c]), member(Y, [b, d])), L)
case('c18_if_closure', L) <- findall(
    '-'(E, R),
    (member(E, [a, c]), memberd_t(E, [a, b], T), must_be(boolean, T),
     if_(T is True, R is y, R is n)), L)
case('c19_memberd_t_true', L) <- findall(ok, memberd_t(b, [a, b], True), L)
case('c20_memberd_t_enum', L) <- findall('-'(X, T), (memberd_t(X, [a, b], T),
                                                   member(X, [a, b, c])), L)
case('c21_tfilter', L) <- findall(
    '-'('-'(X, Y), ES),
    (tfilter(eqr(a), [X, Y], ES), member(X, [a, b]), member(Y, [a, b])), L)
case('c22_tfilter_dif', L) <- findall(FS, tfilter(neq(a), [a, b, a, c], FS), L)
case('c23_tpartition', L) <- findall('-'(TS, FS),
                                   tpartition(eqr(a), [a, b, a, c], TS, FS), L)
case('c24_tmember', L) <- findall(ok, tmember(eqr(b), [a, b]), L)
case('c25_tmember_t', L) <- findall(T, (member(E, [b, z]),
                                      tmember_t(eqr(E), [a, b], T)), L)
case('c26_cond_t', L) <- findall('-'(X, T), (cond_t(eqr(X, a), True, T),
                                           member(X, [a, b])), L)
case('c27_eq3_dif3_order', L) <- findall('-'(T1, T2),
                                       ('='(_, a, T1), dif(_, a, T2)), L)
case('c28_if_errors', L) <- findall(
    F,
    (member(G, [bad_t, bad2_t]),
     catch((call(G, T), must_be(boolean, T), if_(T is True, True, True)),
           error(F, _), True)), L)
case('c29_truth_data', L) <- findall(X, (X is true or X is false), L)
case('c30_user_true_n', L) <- findall('-'('-'(A, B), C),
                                    (true(A), call(true, B), false(1, C)), L)
case('c31_memberchk', L) <- findall(X, memberchk(X, [a, b]), L)
case('c32_findall_backdoor', L) <- findall(X, (member(X, [1, 2]),
                                             findall(_, X > 1, [])), L)
case('c33_naf_as_data', L) <- findall(R, (G is (not False), call(G),
                                        R is ok), L)
