# "Phenomenon A": import a 0-arity vocabulary atom, then define a same-named
# PREDICATE.  The first clause's guarded class block
# re-mints impord_qd over the import, and every later clause must bind against
# that re-minted class.
-private([a, b])
-module(impord_atom_then_pred, [impord_atp_lookup(KEY, VALUE)])
-import_from(tests.fixtures.impord_atomvocab, [impord_qd])

impord_qd(a, 1),
impord_qd(b, 2),

impord_atp_lookup(K, V) <- impord_qd(K, V)
