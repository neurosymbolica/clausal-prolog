-double_quotes(atom)
-table(path/2)

edge(1, 2),
edge(2, 3),
edge(3, 1),

path(X, Y) <- edge(X, Y)
path(X, Y) <- (
    edge(X, Z),
    path(Z, Y)
)

# check_path/2: a tabled predicate and its WFS negation as two exclusive
# alternatives.  (It was an if_ with path(1, X) as the condition; if_/3 now
# requires a reifiable condition, ruling 2026-10-01, and path/2 is a plain
# goal.  For a bound X the answers are the same.)
check_path(X, RESULT) <- ((path(1, X), RESULT is "reachable") or (not path(1, X), RESULT is "unreachable"))


test("path 1 to 2") <- path(1, 2)  # nv
test("path 1 to 3") <- path(1, 3)  # nv
test("check reachable 2") <- (check_path(2, RESULT), RESULT == "reachable")  # nv
test("check unreachable 99") <- (check_path(99, RESULT), RESULT == "unreachable")  # nv
