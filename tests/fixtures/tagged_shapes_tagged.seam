# Parity fixture (cell half) for the Phase 2 bridge's now-removed
# ``-tagged_terms`` experiment.  P3-2 made cells the unconditional compiled
# representation, so this file and its plain (tagged_shapes.seam) sibling
# compile identically now — kept as a byte-identical pair (module name
# aside) as an old-vs-new regression anchor: the two are queried with the
# same goal set in tests/test_tagged_terms.py and their answers compared
# through the representation normalizer.
#
# Self-contained by design: every functor it constructs or matches is
# declared here.  (Compound data crossing a module boundary is fine post-P3-1
# / R5 — functors are global by spelling — this fixture just doesn't need
# it.)
-double_quotes(atom)
-allow_singletons
-module(tagged_shapes_tagged, [
    point(X, Y),
    circle(C, R),
    seg(A, B, C),
    nil,
    kind(S, K),
    depth(T, D),
    mk(N, T),
    pair_up(A, B, P),
])

# Multi-clause dispatch discriminating on functor name AND arity.
kind(point(_X, _Y), "pt"),
kind(circle(_C, _R), "circ"),
kind(seg(_A, _B, _C), "seg3"),
kind(nil, "empty"),
kind(42, "num"),
kind("s", "str"),

# Recursive construction + recursive destructuring of the same functor.
mk(0, nil),
mk(N, point(N, T)) <- (
    N > 0,
    N1 == N - 1,
    mk(N1, T)
)

depth(nil, 0),
depth(point(_H, T), D) <- (
    depth(T, D1),
    D == D1 + 1
)

pair_up(A, B, seg(A, B, nil)),
