# Tests for arithmetic predicates: between/3, succ/2, plus/3, abs_/2, max_/3, min_/3

# between/3: enumerate integers in a range
in_range(LOW, HIGH, X) <- between(LOW, HIGH, X)

# between/3: check mode
check_between(LOW, HIGH, X) <- between(LOW, HIGH, X)

# succ/2: Y = X + 1
successor(X, Y) <- succ(X, Y)
predecessor(Y, X) <- succ(X, Y)

# plus/3: Z = X + Y; any two determine the third
add_nums(X, Y, Z) <- plus(X, Y, Z)
diff(Z, X, Y) <- plus(X, Y, Z)

# count_to/1: collects integers from 1 to N using findall + between
count_to(N, NUMBERS) <- (
    findall(X, between(1, N, X), NUMBERS)
)

Test("between 1 to 3") <- (findall(X, between(1, 3, X), ELEMENTS), ELEMENTS == [1, 2, 3])  # v
Test("succ forward") <- (succ(3, Y), Y == 4)  # v
Test("succ backward") <- (succ(X, 5), X == 4)  # v
Test("plus forward") <- (plus(2, 3, Z), Z == 5)  # v
Test("plus backward lhs") <- (plus(X, 3, 7), X == 4)  # v
Test("plus backward rhs") <- (plus(2, X, 7), X == 5)  # v
Test("abs positive") <- (abs_(5, RESULT), RESULT == 5)  # v
Test("abs negative") <- (abs_(-3, RESULT), RESULT == 3)  # v
Test("max basic") <- (max_(3, 5, RESULT), RESULT == 5)  # v
Test("min basic") <- (min_(3, 5, RESULT), RESULT == 3)  # v
Test("count to 3") <- (count_to(3, NUMBERS), NUMBERS == [1, 2, 3])  # v
Test("in range") <- in_range(1, 5, 3)  # v
Test("successor") <- (successor(4, Y), Y == 5)  # v
Test("predecessor") <- (predecessor(5, X), X == 4)  # v
