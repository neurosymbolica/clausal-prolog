# Tests for arithmetic predicates: between/3, succ/2, plus/3, abs_/2, max_/3, min_/3

# between/3: enumerate integers in a range
InRange(LOW, HIGH, X) <- between(LOW, HIGH, X)

# between/3: check mode
CheckBetween(LOW, HIGH, X) <- between(LOW, HIGH, X)

# succ/2: Y = X + 1
Successor(X, Y) <- succ(X, Y)
Predecessor(Y, X) <- succ(X, Y)

# plus/3: Z = X + Y; any two determine the third
AddNums(X, Y, Z) <- plus(X, Y, Z)
Diff(Z, X, Y) <- plus(X, Y, Z)

# CountTo/1: collects integers from 1 to N using findall + between
CountTo(N, NUMBERS) <- (
    findall(X, between(1, N, X), NUMBERS)
)

Test("between 1 to 3") <- (findall(X, between(1, 3, X), ELEMENTS), ELEMENTS == [1, 2, 3])  # nv
Test("succ forward") <- (succ(3, Y), Y == 4)  # nv
Test("succ backward") <- (succ(X, 5), X == 4)  # nv
Test("plus forward") <- (plus(2, 3, Z), Z == 5)  # nv
Test("plus backward") <- (plus(X, 3, 7), X == 4)  # nv
Test("abs positive") <- (abs_(5, RESULT), RESULT == 5)  # nv
Test("abs negative") <- (abs_(-3, RESULT), RESULT == 3)  # nv
Test("max basic") <- (max_(3, 5, RESULT), RESULT == 5)  # nv
Test("min basic") <- (min_(3, 5, RESULT), RESULT == 3)  # nv
Test("count to 3") <- (CountTo(3, NUMBERS), NUMBERS == [1, 2, 3])  # nv
Test("in range") <- InRange(1, 5, 3)  # nv
Test("successor") <- (Successor(4, Y), Y == 5)  # nv
Test("predecessor") <- (Predecessor(5, X), X == 4)  # nv
