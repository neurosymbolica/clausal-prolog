# catch/3 across the trampoline seam.
#
# Every clause here puts the *raising* goal in a separate predicate, so the
# callee runs as a sub-generator driven by the trampoline rather than inline in
# the catch frame.  The compiled catch frame's ``except Exception`` only ever
# sees what the trampoline driver throws back into it, so these cases pin that
# the driver routes ordinary Python exceptions — not just LogicException —
# through the ``catcher`` chain.
#
# Asserted from tests/test_catch_trampolined.py; the Test clauses below are the
# surface-level half.
-module(catch_trampolined, [
    raise_value_error(X),
    catch_from_callee(E),
    catch_inline(E),
    catch_wrong_catcher(R),
    inner_catches(R),
    outer_catches(R),
    undefined_in_callee(X),
    catch_undefined_name(E),
    halt_in_callee(),
    catch_halt(E),
    counted(N),
    catch_multi(N),
    throw_in_callee(X),
    catch_throw(E),
    catch_from_callee_via_once(E),
    catch_from_callee_via_findall(ES),
    catch_throw_via_once(E),
    catch_then_fail(TAG),
    naf_over_catch(R),
    catch_from_callee_via_lambda(E),
    recovery_raises(R),
    outer_catches_a_raising_recovery(E),
    cond_absorbs(R),
    ite_cond_catch(R),
    cond_declines(R),
    ite_cond_decline(R),
    ite_cond_raw(R),
    ite_multi(N),
])
-import_from(catch_tramp_sibling, [art_9])
-allow_singletons
-private([ground_a])

# ── the raising callee ──────────────────────────────────────────────────────
# int("nope") raises a plain ValueError: no LogicException, and nothing the
# compiler can see coming.
raise_value_error(X) <- (X is ++(int("nope"))),

# ── the bug: catch/3 around a trampolined callee ────────────────────────────
catch_from_callee(E) <- (catch(raise_value_error(_X), E, true)),

# ── the control: the same exception raised inline in the catch frame ────────
catch_inline(E) <- (catch((_X is ++(int("nope"))), E, true)),

# ── a catcher that cannot match must let the exception through ──────────────
catch_wrong_catcher(R) <- (catch(raise_value_error(_X), "no_such_error", R is "recovered")),

# ── nested catch across two predicates ──────────────────────────────────────
# The inner catcher is an atom, so it never unifies with the ValueError term;
# the inner handler re-raises and the OUTER one must see it.
inner_declines(R) <- (catch(raise_value_error(_X), "no_such_error", R is "inner")),
outer_catches(R) <- (catch(inner_declines(R), _E, R is "outer")),

# The inner catcher is a variable, so the inner handler absorbs it and the
# outer recovery must NOT run.
inner_absorbs(R) <- (catch(raise_value_error(_X), _E, R is "inner")),
inner_catches(R) <- (catch(inner_absorbs(R), _E2, R is "outer")),

# ── the original repro: an undefined name in a trampolined callee ───────────
undefined_in_callee(X) <- (X == {ground_a: cite(art_9)}),
catch_undefined_name(E) <- (catch(undefined_in_callee(_X), E, true)),

# ── halt/1 raises SystemExit, a BaseException — catch/3 must NOT absorb it ──
halt_in_callee() <- (halt(3)),
catch_halt(E) <- (catch(halt_in_callee(), E, true)),

# ── a callee with several solutions, none of which raise ────────────────────
counted(1),
counted(2),
counted(3),
catch_multi(N) <- (catch(counted(N), _E, true)),

# ── the same seam reached from a SHALLOW driver ─────────────────────────────
# once/1, findall/3, `not` and lambda bodies compile shallow and reach a
# trampoline-mode callee through runtime/tramp_call.py's mini-trampoline.  That
# driver is a fourth copy of the same loop, so a catch/3 *inside* the
# trampolined predicate needs its exceptions routed there too — this held for
# throw/1 as well, which the main drivers had always routed.
throw_in_callee(_X) <- (throw("boom")),
catch_throw(E) <- (catch(throw_in_callee(_X), E, true)),

catch_from_callee_via_once(E) <- (once(catch_from_callee(E))),
catch_from_callee_via_findall(ES) <- (findall(E, catch_from_callee(E), ES)),
catch_throw_via_once(E) <- (once(catch_throw(E))),

# `not` and a goal lambda are the two remaining tramp_call drivers.  The inner
# catch/3 ABSORBS the ValueError, so catch_from_callee succeeds and each of
# these must simply FAIL (`not` over a success) or succeed with the bound term —
# never raise.  Unrouted, the exception escapes the mini-trampoline instead.
catch_then_fail(TAG) <- (TAG is "t", catch(raise_value_error(_X), _E, "a" == "b")),
naf_over_catch(R) <- (not catch_then_fail(_T), R is "absorbed_then_failed"),
catch_from_callee_via_lambda(E) <- (call_goal((() <- catch_from_callee(E)))),

# ── an exception raised by the RECOVERY goal itself ─────────────────────────
# The handler absorbs the ValueError and then raises a fresh one from its own
# frame.  That is unwind_to_catcher's "throw() raised a NEW routable
# exception" path: keep walking from THIS frame's catcher, so the outer
# catch/3 sees the second exception, not the first.
recovery_raises(R) <- (catch(raise_value_error(_X), _E, R is ++(int("also_nope")))),
outer_catches_a_raising_recovery(E) <- (catch(recovery_raises(_R), E, true)),

Test("an inner catch/3 absorbs it; the outer recovery does not run") <- (
    inner_catches(R),
    R == "inner",
)

Test("an inner catch/3 that declines hands it to the outer one") <- (
    outer_catches(R),
    R == "outer",
)

Test("catch/3 around a many-solution callee still yields every solution") <- (
    findall(N, catch_multi(N), NS),
    NS == [1, 2, 3],
)

# ── the SEVENTH copy: the general-ITE condition driver ──────────────────────
# if_/3 with a non-reifiable (user-predicate) condition compiles to a
# mini-trampoline that drives the condition sub-generator.  Emitted inline it
# had no exception routing at all, so a catch/3 inside the CONDITION was
# inert — the ValueError walked out of the whole construct (confirmed
# 2026-08-26).  These pin the routed behaviour plus the two controls that
# must not change: a declining/absent handler still lets the error escape,
# and the then-branch still runs once per condition solution.
cond_absorbs(R) <- (catch(raise_value_error(_X), _E, R is "absorbed")),
ite_cond_catch(R) <- (if_(cond_absorbs(_C), R is "then", R is "else")),

cond_declines(R) <- (catch(raise_value_error(_X), "no_such_error", R is "nope")),
ite_cond_decline(R) <- (if_(cond_declines(_C), R is "then", R is "else")),

ite_cond_raw(R) <- (if_(raise_value_error(_X), R is "then", R is "else")),

ite_multi(N) <- (if_(counted(N), true, N == 0)),
