# clausal: no-collect
# Imports BOTH of gate_vocab's exports and defines a clause for each, in the
# order that matters: the legal one (gv_free is clause-free, so implementing it
# downstream is the blessed idiom) comes FIRST, the refused one second.  The
# mutation gate must therefore refuse this load BEFORE writing anything at all
# -- the property the deleted step-3c pre-pass carried, and the one this
# fixture exists to pin.
-module(gate_rival, [gate_rival_go(STATUS)])
-import_from(tests.fixtures.gate_vocab, [gv_free, gv_owned])
-private([blue, teal])

gv_free(blue),
gv_owned(teal),

gate_rival_go(S) <- gv_free(S)
