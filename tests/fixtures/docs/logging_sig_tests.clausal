-double_quotes(chars)
# Companion tests for docs/logging.md display snippets.

-import_from(py.logging, [
    get_logger, debug, info, warning, error, critical,
    set_level, get_level, is_enabled_for, log,
    add_handler, remove_handler,
    stream_handler, set_formatter
])

# ── Logger management ────────────────────────────────────────────────────────

Test("get logger named") <- get_logger("test.doc.named", _)  # nv

Test("get logger default") <- get_logger(_)  # nv

Test("set and get level") <- (
    get_logger("test.doc.level", L),
    set_level(L, "debug"),
    get_level(L, LEVEL),
    LEVEL == "DEBUG"
)  # nv

Test("is enabled for") <- (
    get_logger("test.doc.enabled", L),
    set_level(L, "debug"),
    is_enabled_for(L, "debug")
)  # nv

# ── Logging predicates ───────────────────────────────────────────────────────

Test("debug succeeds") <- (
    get_logger("test.doc.debug", L),
    set_level(L, "debug"),
    debug(L, "test message")
)  # nv

Test("info succeeds") <- (
    get_logger("test.doc.info", L),
    info(L, "test message")
)  # nv

Test("warning succeeds") <- (
    get_logger("test.doc.warn", L),
    warning(L, "test message")
)  # nv

Test("error succeeds") <- (
    get_logger("test.doc.err", L),
    error(L, "test message")
)  # nv

Test("critical succeeds") <- (
    get_logger("test.doc.crit", L),
    critical(L, "test message")
)  # nv

Test("log at level") <- (
    get_logger("test.doc.log", L),
    log(L, "info", "test message")
)  # nv

# ── Handler management ───────────────────────────────────────────────────────

Test("stream handler") <- (
    stream_handler("stderr", H),
    nonvar(H)
)  # nv

Test("set formatter") <- (
    stream_handler("stderr", H),
    set_formatter(H, "%(message)s")
)  # nv

Test("add and remove handler") <- (
    get_logger("test.doc.handler", L),
    stream_handler("stderr", H),
    add_handler(L, H),
    remove_handler(L, H)
)  # nv
