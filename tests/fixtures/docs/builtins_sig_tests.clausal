# Companion tests for docs/builtins.md signature blocks.
# Validates that documented predicates exist and accept the documented arities.

# ── Control Flow ─────────────────────────────────────────────────────────────

Test("once exists") <- once(1 == 1)

Test("not exists") <- (not (1 == 2))

Test("If exists") <- If(1 == 1, (1 == 1), (1 == 2))

Test("catch/3 exists") <- catch((1 == 1), _, (1 == 1))

# ── Coroutining ──────────────────────────────────────────────────────────────

Test("freeze exists") <- (
    freeze(X, X > 0),
    X is 5
)

# ── Meta-Predicates ──────────────────────────────────────────────────────────

Test("findall exists") <- (
    findall(X, in_(X, [1, 2, 3]), BAG),
    BAG == [1, 2, 3]
)

Test("bagof exists") <- (
    bagof(X, in_(X, [1, 2]), BAG),
    BAG == [1, 2]
)

Test("forall exists") <- forall(in_(X, [1, 2, 3]), number(X))

Test("count_all exists") <- (
    count_all(in_(_, [1, 2, 3]), N),
    N == 3
)

# ── Time & Statistics ────────────────────────────────────────────────────────

Test("current_time exists") <- current_time(_)

Test("statistics exists") <- statistics("wall_time", _)

# ── Higher-Order Call ────────────────────────────────────────────────────────

Test("call exists") <- call(number, 1)

# ── DCG ──────────────────────────────────────────────────────────────────────

greet_dcg >> (["hi"])

Test("phrase/2 exists") <- phrase(greet_dcg, ["hi"])

# ── Term Inspection ──────────────────────────────────────────────────────────

Test("functor exists") <- (
    functor("hello", NAME, ARITY),
    NAME == "hello",
    ARITY == 0
)

Test("arg exists") <- (
    arg(1, [10, 20, 30], V),
    V == 10
)

Test("copy_term exists") <- copy_term([X, Y], [A, B])

Test("term_variables exists") <- (
    term_variables([X, 1, Y], VARS),
    length(VARS, 2)
)

Test("gensym exists") <- gensym("test_", _)

# ── Runtime Database ─────────────────────────────────────────────────────────

-dynamic(DbFact/1)

DbFact("initial"),

Test("assertz/retract exist") <- (
    assertz(DbFact("added")),
    DbFact("added"),
    retract(DbFact("added"))
)

# ── Attributed Variables ─────────────────────────────────────────────────────

Test("put_attr/get_attr exist") <- (
    put_attr(V, "my_key", 42),
    get_attr(V, "my_key", VAL),
    VAL == 42
)

Test("attvar exists") <- (
    put_attr(V, "k", 1),
    attvar(V)
)

# ── Constraint Predicates ────────────────────────────────────────────────────

Test("dif exists") <- dif(1, 2)

Test("eq reified exists") <- (
    eq(1, 1, T),
    T == True
)

Test("dif_t reified exists") <- (
    dif_t(1, 2, T),
    T == True
)

# ── CLP(Z) ───────────────────────────────────────────────────────────────────

Test("in_domain exists") <- (
    in_domain(X, 1, 5),
    label([X]),
    X == 1
)

Test("all_different exists") <- (
    in_domain([A, B], 1, 2),
    all_different([A, B]),
    label([A, B]),
    A == 1
)

Test("element exists") <- (
    element(2, [10, 20, 30], V),
    V == 20
)

# ── CLP(B) ───────────────────────────────────────────────────────────────────

Test("sat exists") <- sat(X | ~X)

Test("taut exists") <- taut(X | ~X, T)

Test("sat_count exists") <- sat_count(X | ~X, N)

# ── Type Checks ──────────────────────────────────────────────────────────────

Test("var exists") <- var(_)
Test("nonvar exists") <- nonvar(42)
Test("atom exists") <- (not atom(42))
Test("is_str exists") <- is_str("hello")
Test("number exists") <- number(42)
Test("integer exists") <- integer(42)
Test("float_ exists") <- float_(3.14)
Test("compound exists") <- (not compound(42))
Test("is_list exists") <- is_list([1, 2, 3])
Test("ground exists") <- ground(42)

# ── Dict and Set Predicates ──────────────────────────────────────────────────

Test("is_dict exists") <- is_dict({})
Test("dict_get exists") <- dict_get("a", {"a": 1}, 1)
Test("dict_put exists") <- dict_put("b", 2, {"a": 1}, _)
Test("dict_merge exists") <- dict_merge({"a": 1}, {"b": 2}, _)
Test("dict_keys exists") <- dict_keys({"x": 1}, ["x"])
Test("dict_pairs exists") <- dict_pairs({"a": 1}, [["a", 1]])
Test("is_set exists") <- is_set({1, 2, 3})
Test("set_union exists") <- set_union({1}, {2}, _)
Test("set_subset exists") <- set_subset({1}, {1, 2})
Test("gen_set exists") <- gen_set(1, {1, 2, 3})
Test("gen_dict exists") <- gen_dict("a", {"a": 1}, 1)

# ── Arithmetic ───────────────────────────────────────────────────────────────

Test("between exists") <- between(1, 3, 2)

Test("succ exists") <- (
    succ(4, Y),
    Y == 5
)

Test("plus exists") <- (
    plus(2, 3, Z),
    Z == 5
)

Test("abs_ exists") <- (
    abs_(-5, Y),
    Y == 5
)

Test("max_ exists") <- (
    max_(3, 7, Z),
    Z == 7
)

Test("min_ exists") <- (
    min_(3, 7, Z),
    Z == 3
)

Test("gcd exists") <- (
    gcd(12, 8, G),
    G == 4
)

Test("divmod_ exists") <- (
    divmod_(7, 3, Q, R),
    Q == 2,
    R == 1
)

# ── List Predicates ──────────────────────────────────────────────────────────

Test("in_ exists") <- in_(2, [1, 2, 3])

Test("append exists") <- (
    append([1], [2, 3], L),
    L == [1, 2, 3]
)

Test("length exists") <- (
    length([1, 2, 3], N),
    N == 3
)

Test("last exists") <- (
    last([1, 2, 3], E),
    E == 3
)

Test("reverse exists") <- (
    reverse([1, 2, 3], R),
    R == [3, 2, 1]
)

Test("flatten exists") <- (
    flatten([[1, 2], [3]], F),
    F == [1, 2, 3]
)

Test("sort exists") <- (
    sort([3, 1, 2], S),
    S == [1, 2, 3]
)

Test("select exists") <- select(2, [1, 2, 3], [1, 3])

Test("take exists") <- (
    take(2, [1, 2, 3], T),
    T == [1, 2]
)

Test("drop exists") <- (
    drop(1, [1, 2, 3], D),
    D == [2, 3]
)

Test("zip_ exists") <- (
    zip_([1, 2], ["a", "b"], P),
    P == [[1, "a"], [2, "b"]]
)

Test("numlist exists") <- (
    numlist(1, 3, L),
    L == [1, 2, 3]
)

Test("same_length exists") <- same_length([1, 2], [3, 4])

Test("transpose exists") <- (
    transpose([[1, 2], [3, 4]], T),
    T == [[1, 3], [2, 4]]
)

Test("sum_list exists") <- (
    sum_list([1, 2, 3], S),
    S == 6
)

Test("pairs_keys_values exists") <- (
    pairs_keys_values(P, [1, 2], ["a", "b"]),
    P == [[1, "a"], [2, "b"]]
)

# ── Higher-Order List Predicates ─────────────────────────────────────────────

Test("maplist/2 exists") <- maplist(number, [1, 2, 3])

Test("maplist/3 exists") <- (
    maplist(succ, [1, 2], YS),
    YS == [2, 3]
)

Test("include exists") <- (
    include(integer, [1, "a", 2], R),
    R == [1, 2]
)

Test("exclude exists") <- (
    exclude(integer, [1, "a", 2], R),
    R == ["a"]
)

Test("foldl exists") <- (
    foldl(plus, [1, 2, 3], 0, S),
    S == 6
)

Test("take_while exists") <- (
    take_while(integer, [1, 2, "a", 3], P),
    P == [1, 2]
)

Test("drop_while exists") <- (
    drop_while(integer, [1, 2, "a", 3], S),
    S == ["a", 3]
)

# ── Character/String ─────────────────────────────────────────────────────────

Test("char_code exists") <- (
    char_code("A", C),
    C == 65
)

Test("upcase_atom exists") <- (
    upcase_atom("hello", U),
    U == "HELLO"
)

Test("downcase_atom exists") <- (
    downcase_atom("HELLO", D),
    D == "hello"
)

Test("atom_length exists") <- (
    atom_length("hello", N),
    N == 5
)

Test("atom_chars exists") <- (
    atom_chars("hi", CS),
    CS == ["h", "i"]
)

Test("atom_concat exists") <- (
    atom_concat("he", "llo", R),
    R == "hello"
)

Test("number_chars exists") <- number_chars(42, ["4", "2"])

# ── I/O ──────────────────────────────────────────────────────────────────────

Test("write_to_string exists") <- (
    write_to_string(42, S),
    is_str(S)
)

Test("term_to_string exists") <- (
    term_to_string(42, S),
    is_str(S)
)

# ── Logging (log module) ─────────────────────────────────────────────────────

-import_from(log, [GetLogger, Debug, Info, SetLevel, GetLevel])

Test("log: GetLogger exists") <- GetLogger("builtins_sig_test", _)

Test("log: SetLevel/GetLevel exist") <- (
    GetLogger("builtins_sig_level", L),
    SetLevel(L, "warning"),
    GetLevel(L, LVL),
    LVL == "WARNING"
)

# ── Date & Time (date_time module) ───────────────────────────────────────────

-import_from(date_time, [Now, Today, Date, Time, DateTime, TimeDelta,
    DateAdd, DateDiff, FormatDate, DayOfWeek])

Test("date_time: Now exists") <- Now(_)
Test("date_time: Today exists") <- Today(_)

Test("date_time: Date exists") <- (
    Date(2024, 1, 15, D),
    FormatDate(D, "%Y-%m-%d", S),
    S == "2024-01-15"
)

Test("date_time: DayOfWeek exists") <- (
    Date(2024, 1, 15, D),
    DayOfWeek(D, W),
    integer(W)
)

# ── YAML (yaml_module module) ────────────────────────────────────────────────

-import_from(yaml_module, [Read, Get])

Test("yaml: Read exists") <- (
    Read("x: 1", DATA),
    Get(DATA, "x", 1)
)
