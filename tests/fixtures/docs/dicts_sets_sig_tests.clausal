# Companion tests for docs/dicts_sets.md signature blocks.

Test("dict operations") <- (
    is_dict({"a": 1}),
    dict_get("a", {"a": 1}, 1),
    dict_put("b", 2, {"a": 1}, D),
    dict_keys(D, K),
    length(K, 2)
)

Test("set operations") <- (
    is_set({1, 2, 3}),
    set_union({1}, {2}, U),
    set_subset({1}, U)
)
