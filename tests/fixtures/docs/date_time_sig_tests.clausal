# Companion tests for docs/date_time.md display snippets.

-import_from(date_time, [Now, NowUTC, Today, Date, Time, DateTime,
                         TimeDelta, DateAdd, DateSub, DateDiff, DaysBetween,
                         FormatDate, ParseDate, DateOf, DayOfWeek])

# ── Now/Today ────────────────────────────────────────────────────────────────

Test("now") <- Now(_)  # nv
Test("now utc") <- NowUTC(_)  # nv
Test("today") <- Today(_)  # nv

# ── Date ─────────────────────────────────────────────────────────────────────

Test("date construct") <- Date(2026, 3, 16, _)  # nv

Test("date decompose") <- (
    Date(2026, 3, 16, D),
    Date(Y, M, DAY, D),
    Y == 2026,
    M == 3,
    DAY == 16
)  # nv

# ── Time ─────────────────────────────────────────────────────────────────────

Test("time construct") <- Time(14, 30, 0, _)  # nv

Test("time decompose") <- (
    Time(14, 30, 0, T),
    Time(H, M, S, T),
    H == 14,
    M == 30,
    S == 0
)  # nv

# ── DateTime ─────────────────────────────────────────────────────────────────

Test("datetime construct") <- DateTime(2026, 3, 16, 14, 30, 0, _)  # nv

# ── TimeDelta ────────────────────────────────────────────────────────────────

Test("timedelta construct") <- TimeDelta(7, 0, _)  # nv

# ── Arithmetic ───────────────────────────────────────────────────────────────

Test("date add") <- (
    Date(2026, 3, 16, D),
    TimeDelta(7, 0, TD),
    DateAdd(D, TD, R),
    Date(2026, 3, 23, R)
)  # nv

Test("date sub") <- (
    Date(2026, 3, 23, D),
    TimeDelta(7, 0, TD),
    DateSub(D, TD, R),
    Date(2026, 3, 16, R)
)  # nv

Test("date diff") <- (
    Date(2026, 3, 23, D1),
    Date(2026, 3, 16, D2),
    DateDiff(D1, D2, TD),
    TimeDelta(7, 0, TD)
)  # nv

# ── Format/Parse ─────────────────────────────────────────────────────────────

Test("format date") <- (
    Date(2026, 3, 16, D),
    FormatDate(D, "%Y-%m-%d", S),
    S == "2026-03-16"
)  # nv

Test("parse date") <- (
    ParseDate("2026-03-16", "%Y-%m-%d", DT),
    nonvar(DT)
)  # nv

# ── DateOf (datetime → date, no ++DT.date()) ──────────────────────────────────

Test("date of datetime") <- (
    DateTime(2026, 3, 16, 14, 30, 0, DT),
    DateOf(DT, D),
    Date(2026, 3, 16, D)
)  # nv

Test("date of inverse midnight") <- (
    Date(2026, 3, 16, D),
    DateOf(DT, D),
    DateTime(2026, 3, 16, 0, 0, 0, DT)
)  # vn

# ── DaysBetween (direct integer day count) ────────────────────────────────────

Test("days between") <- (
    Date(2026, 3, 23, A),
    Date(2026, 3, 16, B),
    DaysBetween(A, B, N),
    N == 7
)  # nnv

# Schengen-style "parse ISO → date → diff" with no ++ Python escapes.
Test("parse iso to date diff no escapes") <- (
    ParseDate("2026-03-23", "%Y-%m-%d", DT_A),
    ParseDate("2026-03-16", "%Y-%m-%d", DT_B),
    DateOf(DT_A, A),
    DateOf(DT_B, B),
    DaysBetween(A, B, N),
    N == 7
)  # nv

# ── DayOfWeek ────────────────────────────────────────────────────────────────

Test("day of week") <- (
    Date(2026, 3, 16, D),
    DayOfWeek(D, DOW),
    number(DOW)
)  # nv
