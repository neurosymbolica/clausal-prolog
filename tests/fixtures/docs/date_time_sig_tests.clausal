# Companion tests for docs/date_time.md display snippets.

-import_from(date_time, [now, now_utc, today, date, time, datetime,
                         timedelta, date_add, date_sub, date_diff, days_between,
                         datetime_string, date_of, weekday])

# ── now/today ────────────────────────────────────────────────────────────────

Test("now") <- now(_)  # nv
Test("now utc") <- now_utc(_)  # nv
Test("today") <- today(_)  # nv

# ── date ─────────────────────────────────────────────────────────────────────

Test("date construct") <- date(2026, 3, 16, _)  # nv

Test("date decompose") <- (
    date(2026, 3, 16, D),
    date(Y, M, DAY, D),
    Y == 2026,
    M == 3,
    DAY == 16
)  # nv

# ── time ─────────────────────────────────────────────────────────────────────

Test("time construct") <- time(14, 30, 0, _)  # nv

Test("time decompose") <- (
    time(14, 30, 0, T),
    time(H, M, S, T),
    H == 14,
    M == 30,
    S == 0
)  # nv

# ── datetime ─────────────────────────────────────────────────────────────────

Test("datetime construct") <- datetime(2026, 3, 16, 14, 30, 0, _)  # nv

# ── timedelta ────────────────────────────────────────────────────────────────

Test("timedelta construct") <- timedelta(7, 0, _)  # nv

# ── Arithmetic ───────────────────────────────────────────────────────────────

Test("date add") <- (
    date(2026, 3, 16, D),
    timedelta(7, 0, TD),
    date_add(D, TD, R),
    date(2026, 3, 23, R)
)  # nv

Test("date sub") <- (
    date(2026, 3, 23, D),
    timedelta(7, 0, TD),
    date_sub(D, TD, R),
    date(2026, 3, 16, R)
)  # nv

Test("date diff") <- (
    date(2026, 3, 23, D1),
    date(2026, 3, 16, D2),
    date_diff(D1, D2, TD),
    timedelta(7, 0, TD)
)  # nv

# ── datetime_string ───────────────────────────────────────────────────────────

Test("format date") <- (
    date(2026, 3, 16, D),
    datetime_string(D, S, "%Y-%m-%d"),
    S == "2026-03-16"
)  # nv

Test("parse date") <- (
    datetime_string(DT, "2026-03-16", "%Y-%m-%d"),
    nonvar(DT)
)  # vn

# ── date_of (datetime → date, no ++DT.date()) ─────────────────────────────────

Test("date of datetime") <- (
    datetime(2026, 3, 16, 14, 30, 0, DT),
    date_of(DT, D),
    date(2026, 3, 16, D)
)  # nv

Test("date of inverse midnight") <- (
    date(2026, 3, 16, D),
    date_of(DT, D),
    datetime(2026, 3, 16, 0, 0, 0, DT)
)  # vn

# ── days_between (direct integer day count) ───────────────────────────────────

Test("days between") <- (
    date(2026, 3, 23, A),
    date(2026, 3, 16, B),
    days_between(A, B, N),
    N == 7
)  # nnv

# Schengen-style "parse ISO → date → diff" with no ++ Python escapes.
Test("parse iso to date diff no escapes") <- (
    datetime_string(DT_A, "2026-03-23", "%Y-%m-%d"),
    datetime_string(DT_B, "2026-03-16", "%Y-%m-%d"),
    date_of(DT_A, A),
    date_of(DT_B, B),
    days_between(A, B, N),
    N == 7
)  # vn

# ── weekday ──────────────────────────────────────────────────────────────────

Test("day of week") <- (
    date(2026, 3, 16, D),
    weekday(D, DOW),
    number(DOW)
)  # nv
