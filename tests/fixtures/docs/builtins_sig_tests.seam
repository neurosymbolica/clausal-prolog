-double_quotes(chars)
-private([pair_probe(A, B)])
# Companion tests for docs/builtins.md signature blocks.
# Validates that documented predicates exist and accept the documented arities.

# ── Control Flow ─────────────────────────────────────────────────────────────

test("once exists") <- once(1 == 1)  # nv

test("not exists") <- (not (1 == 2))  # nv

test("if_ exists") <- if_(1 == 1, (1 == 1), (1 == 2))  # nv

test("catch/3 exists") <- catch((1 == 1), _, (1 == 1))  # nv

# ── Coroutining ──────────────────────────────────────────────────────────────

test("freeze exists") <- (
    freeze(X, X > 0),
    X is 5
)  # nv

# ── Meta-Predicates ──────────────────────────────────────────────────────────

test("findall exists") <- (
    findall(X, in_(X, [1, 2, 3]), BAG),
    BAG == [1, 2, 3]
)  # nv

test("bagof exists") <- (
    bagof(X, in_(X, [1, 2]), BAG),
    BAG == [1, 2]
)  # nv

test("forall exists") <- forall(in_(X, [1, 2, 3]), number(X))  # nv

test("count_all exists") <- (
    count_all(in_(_, [1, 2, 3]), N),
    N == 3
)  # nv

# ── Time & Statistics ────────────────────────────────────────────────────────

test("current_time exists") <- current_time(_)  # nv

test("statistics exists") <- statistics('wall_time', _)  # nv

# ── Higher-Order Call ────────────────────────────────────────────────────────

test("call exists") <- call(number, 1)  # nv

# ── DCG ──────────────────────────────────────────────────────────────────────

greet_dcg >> (["hi"])

test("phrase/2 exists") <- phrase(greet_dcg, ["hi"])  # nv

# ── Term Inspection ──────────────────────────────────────────────────────────

test("functor exists") <- (
    # THE FLIP (2026-09-06-atoms-as-cells-strings §6.4): a STRING is the
    # list of its char atoms, so it decomposes as one -- functor '.'/2,
    # the ISO cons-cell reading (F089, audit 2026-06-13).  P3-1 Task 5 had
    # retired that because a str was then an atom.
    functor("hello", NAME, ARITY),
    NAME is '.',
    ARITY == 2
)  # nv

test("arg exists") <- (
    arg(1, [10, 20, 30], V),
    V == 10
)  # nv

test("copy_term exists") <- copy_term([X_UNUSED, Y_UNUSED], [A_UNUSED, B_UNUSED])  # nv

test("term_variables exists") <- (
    term_variables([X_UNUSED, 1, Y_UNUSED], VARS),
    length(VARS, 2)
)  # nv

test("gensym exists") <- gensym('test_', _)  # nv

# ── Runtime Database ─────────────────────────────────────────────────────────

-dynamic(db_fact/1)

db_fact("initial"),

test("assertz/retract exist") <- (
    assertz(db_fact("added")),
    db_fact("added"),
    retract(db_fact("added"))
)  # nv

# ── Attributed Variables ─────────────────────────────────────────────────────

# THE FLIP (spec §6.4): an attribute Key is a NAME, so it is an ATOM —
# single-quoted here because this file is in `-double_quotes(chars)` mode,
# where "my_key" would be a STRING and put_attr/3 refuses it.
test("put_attr/get_attr exist") <- (
    put_attr(V, 'my_key', 42),
    get_attr(V, 'my_key', VAL),
    VAL == 42
)  # nv

test("attvar exists") <- (
    put_attr(V, 'k', 1),
    attvar(V)
)  # nv

# ── Constraint Predicates ────────────────────────────────────────────────────

test("dif exists") <- dif(1, 2)  # nv

test("eq reified exists") <- (
    eq(1, 1, T),
    T == True
)  # nv

test("dif_t reified exists") <- (
    dif_t(1, 2, T),
    T == True
)  # nv

# ── CLP(Z) ───────────────────────────────────────────────────────────────────

test("in_domain exists") <- (
    in_domain(X, 1, 5),
    label([X]),
    X == 1
)  # nv

test("all_different exists") <- (
    in_domain([A, B], 1, 2),
    all_different([A, B]),
    label([A, B]),
    A == 1
)  # nv

test("element exists") <- (
    element(2, [10, 20, 30], V),
    V == 20
)  # nv

# ── CLP(B) ───────────────────────────────────────────────────────────────────

test("sat exists") <- sat(X | ~X)  # nv

test("taut exists") <- taut(X | ~X, T_UNUSED)  # nv

test("sat_count exists") <- sat_count(X | ~X, N_UNUSED)  # nv

# ── Type Checks ──────────────────────────────────────────────────────────────

test("var exists") <- var(_)  # nv
test("nonvar exists") <- nonvar(42)  # nv
test("atom exists") <- (not atom(42))  # nv
test("is_str exists") <- is_str("hello")  # nv
test("string/1 is the same test as is_str/1") <- (
    string("hello"), is_str("hello"),
    not string(42)
)  # nv
test("atomic/1 takes atoms and numbers, not strings") <- (
    atomic('hello'), atomic(42),
    not atomic("hello"),
    not atomic(pair_probe(1, 2))
)  # nv
test("number exists") <- number(42)  # nv
test("integer exists") <- integer(42)  # nv
test("float_ exists") <- float_(3.14)  # nv
test("compound exists") <- (not compound(42))  # nv
test("is_list exists") <- is_list([1, 2, 3])  # nv
test("ground exists") <- ground(42)  # nv

# ── Dict and Set Predicates ──────────────────────────────────────────────────

test("is_dict exists") <- is_dict({})  # nv
test("dict_get exists") <- dict_get("a", {"a": 1}, 1)  # nv
test("dict_put exists") <- dict_put("b", 2, {"a": 1}, _)  # nv
test("dict_merge exists") <- dict_merge({"a": 1}, {"b": 2}, _)  # nv
test("dict_keys exists") <- dict_keys({"x": 1}, ["x"])  # nv
test("dict_pairs exists") <- dict_pairs({"a": 1}, ['-'("a", 1)])  # nv
test("is_set exists") <- is_set({1, 2, 3})  # nv
test("set_union exists") <- set_union({1}, {2}, _)  # nv
test("set_subset exists") <- set_subset({1}, {1, 2})  # nv
test("gen_set exists") <- gen_set(1, {1, 2, 3})  # nv
test("gen_dict exists") <- gen_dict("a", {"a": 1}, 1)  # nv

# ── Arithmetic ───────────────────────────────────────────────────────────────

test("between exists") <- between(1, 3, 2)  # nv

test("succ exists") <- (
    succ(4, Y),
    Y == 5
)  # nv

test("plus exists") <- (
    plus(2, 3, Z),
    Z == 5
)  # nv

test("abs_ exists") <- (
    abs_(-5, Y),
    Y == 5
)  # nv

test("max_ exists") <- (
    max_(3, 7, Z),
    Z == 7
)  # nv

test("min_ exists") <- (
    min_(3, 7, Z),
    Z == 3
)  # nv

test("gcd exists") <- (
    gcd(12, 8, G),
    G == 4
)  # nv

test("divmod_ exists") <- (
    divmod_(7, 3, Q, R),
    Q == 2,
    R == 1
)  # nv

# ── List Predicates ──────────────────────────────────────────────────────────

test("in_ exists") <- in_(2, [1, 2, 3])  # nv

test("append exists") <- (
    append([1], [2, 3], L),
    L == [1, 2, 3]
)  # nv

test("length exists") <- (
    length([1, 2, 3], N),
    N == 3
)  # nv

test("last exists") <- (
    last([1, 2, 3], E),
    E == 3
)  # nv

test("reverse exists") <- (
    reverse([1, 2, 3], R),
    R == [3, 2, 1]
)  # nv

test("flatten exists") <- (
    flatten([[1, 2], [3]], F),
    F == [1, 2, 3]
)  # nv

test("sort exists") <- (
    sort([3, 1, 2], S),
    S == [1, 2, 3]
)  # nv

test("select exists") <- select(2, [1, 2, 3], [1, 3])  # nv

test("take exists") <- (
    take(2, [1, 2, 3], T),
    T == [1, 2]
)  # nv

test("drop exists") <- (
    drop(1, [1, 2, 3], D),
    D == [2, 3]
)  # nv

test("zip_ exists") <- (
    zip_([1, 2], ["a", "b"], P),
    P == ['-'(1, "a"), '-'(2, "b")]
)  # nv

test("numlist exists") <- (
    numlist(1, 3, L),
    L == [1, 2, 3]
)  # nv

test("same_length exists") <- same_length([1, 2], [3, 4])  # nv

test("transpose exists") <- (
    transpose([[1, 2], [3, 4]], T),
    T == [[1, 3], [2, 4]]
)  # nv

test("sum_list exists") <- (
    sum_list([1, 2, 3], S),
    S == 6
)  # nv

test("pairs_keys_values exists") <- (
    pairs_keys_values(P, [1, 2], ["a", "b"]),
    P == ['-'(1, "a"), '-'(2, "b")]
)  # nv

# ── Higher-Order List Predicates ─────────────────────────────────────────────

test("maplist/2 exists") <- maplist(number, [1, 2, 3])  # nv

test("maplist/3 exists") <- (
    maplist(succ, [1, 2], YS),
    YS == [2, 3]
)  # nv

test("include exists") <- (
    include(integer, [1, "a", 2], R),
    R == [1, 2]
)  # nv

test("exclude exists") <- (
    exclude(integer, [1, "a", 2], R),
    R == ["a"]
)  # nv

test("foldl exists") <- (
    foldl(plus, [1, 2, 3], 0, S),
    S == 6
)  # nv

test("take_while exists") <- (
    take_while(integer, [1, 2, "a", 3], P),
    P == [1, 2]
)  # nv

test("drop_while exists") <- (
    drop_while(integer, [1, 2, "a", 3], S),
    S == ["a", 3]
)  # nv

# ── Character/String ─────────────────────────────────────────────────────────

test("char_code exists") <- (
    char_code('A', C),
    C == 65
)  # nv

test("upcase_atom exists") <- (
    upcase_atom('hello', U),
    U is 'HELLO'
)  # nv

test("downcase_atom exists") <- (
    downcase_atom('HELLO', D),
    D is 'hello'
)  # nv

test("atom_length exists") <- (
    atom_length('hello', N),
    N == 5
)  # nv

test("atom_chars exists") <- (
    atom_chars('hi', CS),
    CS is ['h', 'i']
)  # nv

test("atom_concat exists") <- (
    atom_concat('he', 'llo', R),
    R is 'hello'
)  # nv

test("number_chars exists") <- number_chars(42, ['4', '2'])  # nv

# ── I/O ──────────────────────────────────────────────────────────────────────

test("write_to_string exists") <- (
    write_to_string(42, S),
    is_str(S)
)  # nv

test("term_to_string exists") <- (
    term_to_string(42, S),
    is_str(S)
)  # nv

# The three string forms are the three writer FAMILIES (docs/builtins.md,
# docs/io.md): write_to_string is ISO (unquoted, a string spells itself out
# and there is no space after a comma), write_text_to_string is the Clausal
# TEXT family, term_to_string is the Clausal DISPLAY family (quoted).
test("write_to_string is the ISO family") <- (
    write_to_string('a b', S),
    S == "a b"
)  # nv

test("write_to_string spells a string out, with no comma spacing") <- (
    write_to_string("ab", S),
    S == "[a,b]",
    write_to_string([1, 2], S2),
    S2 == "[1,2]"
)  # nv

test("write_text_to_string is the text family") <- (
    write_text_to_string("ab", S),
    S == "ab"
)  # nv

test("term_to_string is the quoted family") <- (
    term_to_string('a b', S),
    S == "'a b'"
)  # nv

test("term_to_string keeps a string's quotes") <- (
    term_to_string("hello", S),
    S == "\"hello\""
)  # nv

test("writeq/1 exists") <- writeq('a b')  # nv

test("write_canonical/1 spells the cons view") <- write_canonical("hi")  # nv

# ── The chars family takes ATOMS (docs/builtins.md Character/String) ─────────

test("atom_length on an atom") <- atom_length('hello', 5)  # nv

test("atom_length on a string is an error") <- catch(
    atom_length("hello", _),
    error(type_error('atom', "hello"), _),
    (1 == 1)
)  # nv

test("char_code on a string is an error") <- catch(
    char_code("a", _),
    error(type_error('character', "a"), _),
    (1 == 1)
)  # nv

test("atom_chars bridges atom and text") <- (
    atom_chars('hello', CS2),
    CS2 is "hello",
    atom_chars(A2, "hello"),
    A2 is 'hello'
)  # nv

test("atom_concat gives an atom") <- (
    atom_concat('he', 'llo', X2),
    X2 is 'hello',
    atom(X2)
)  # nv

test("upcase_atom gives an atom") <- (
    upcase_atom('hello', U2),
    U2 is 'HELLO'
)  # nv

test("number_chars answers char atoms") <- (
    number_chars(42, NCS),
    NCS is ['4', '2'],
    number_chars(N2, "10"),
    N2 == 10
)  # nv

test("list predicates do the string work") <- (
    length("hello", 5),
    append("he", "llo", "hello")
)  # nv

# ── functor/3 and unpack/2 speak ATOMS (docs/builtins.md Term Inspection) ────

test("functor decomposes to an atom name") <- (
    functor(pair_probe(1, 2), FN, FA),
    FN is 'pair_probe',
    atom(FN),
    FA == 2
)  # nv

test("functor on an atom is arity 0") <- (
    functor('bar', FN2, FA2),
    FN2 is 'bar',
    FA2 == 0
)  # nv

test("functor on a list is the cons view") <- (
    functor([1, 2], LN, LA),
    LN is '.',
    LA == 2,
    functor([], EN, EA),
    EN is '[]',
    EA == 0
)  # nv

# Cell-ness, actually pinned: the term functor/3 builds must unify with a
# SOURCE-WRITTEN pair_probe(A, B), which compiles to the cell
# ("pair_probe", A, B) because pair_probe/2 is a declared DATA FUNCTOR (a
# field-carrying -private entry with no clauses).
test("functor constructs a cell") <- (
    functor(T3, 'pair_probe', 2),
    T3 is pair_probe(_A_UNUSED, _B_UNUSED),
    functor(T3, N3, A3),
    N3 is 'pair_probe',
    A3 == 2
)  # nv

test("unpack constructs the same cell") <- (
    unpack(T6, ['pair_probe', 1, 2]),
    T6 is pair_probe(1, 2)
)  # nv

test("functor refuses a string name") <- catch(
    functor(_, "foo", 1),
    error(type_error('atomic', "foo"), _),
    (1 == 1)
)  # nv

test("unpack decomposes with an atom head") <- (
    unpack(pair_probe(1, 2), UL),
    UL is ['pair_probe', 1, 2]
)  # nv

test("unpack sees a string as its cons view") <- (
    unpack("abc", SL),
    SL is ['.', 'a', "bc"]
)  # nv

test("unpack builds the engine list shapes") <- (
    unpack(T4, ['.', 'a', "bc"]),
    T4 == "abc",
    string(T4),
    unpack(T5, ['.', 1, [2]]),
    T5 == [1, 2],
    is_list(T5)
)  # nv

test("unpack refuses a string name") <- catch(
    unpack(_, ["foo", 1]),
    error(type_error('atom', "foo"), _),
    (1 == 1)
)  # nv

test("arg answers virtually on a string") <- (
    arg(2, "hello", AT),
    AT == "ello",
    string(AT)
)  # nv

# ── Logging (log module) ─────────────────────────────────────────────────────

-import_from(log, [get_logger, debug, info, set_level, get_level])

test("log: get_logger exists") <- get_logger("builtins_sig_test", _)  # nv

test("log: set_level/get_level exist") <- (
    get_logger("builtins_sig_level", L),
    set_level(L, "warning"),
    get_level(L, LVL),
    LVL == 'WARNING'
)  # nv

# ── Date & Time (date_time module) ───────────────────────────────────────────

-import_from(date_time, [now, today, date, time, datetime, timedelta,
    date_add, date_diff, datetime_string, weekday])

test("date_time: now exists") <- now(_)  # nv
test("date_time: today exists") <- today(_)  # nv

test("date_time: date exists") <- (
    D is date(2024, 1, 15),
    datetime_string(D, S, "%Y-%m-%d"),
    S == "2024-01-15"
)  # nv

test("date_time: weekday exists") <- (
    D is date(2024, 1, 15),
    weekday(D, W),
    integer(W)
)  # nv
