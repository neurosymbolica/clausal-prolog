% Companion tests for docs/clpq.md: each program section of
% clpq_sigs.txt, as shown, with the answers its comments state.
% (entailed_1 is the seam spelling and is not repeated here.)
:- use_module(library(clpq)).

% int_int_produces_fraction
test("evaluation: float division") :-
    X is 7 / 2, X == 3.5,
    Y is 6 / 2, Y == 3.0.

test("evaluation: rdiv is exact") :-
    X is rdiv(7, 2), X =:= 7 rdiv 2, \+ integer(X),
    Y is rdiv(6, 2), Y == 3.

test("evaluation: zero divisor") :-
    catch(_ is 1 / 0, E, true),
    E == error(evaluation_error(zero_divisor), (/)/2).

% int_int_produces_fraction_ex2
third(X) :- {X = 1/3}.
three_halves(X) :- {X = 6/2}.
sum_half(X, Y) :- {X + Y = 1/2}.
thirds(X) :- {X = 1/3 + 1/3 + 1/3}.

test("constraint: 1/3 is exact") :-
    third(X), Q is rdiv(1, 3), X == Q.

test("constraint: 6/2 is an integer") :-
    three_halves(X), X == 3.

test("constraint: posted, then bound") :-
    sum_half(X, Y), X = 0, Q is rdiv(1, 2), Y == Q.

test("constraint: thirds sum to 1") :-
    thirds(X), X == 1.

% rational_1, in_q_3
test("rational/1 and in_q/3") :-
    rational(_),
    rational([_, _, _]),
    in_q(X, 0, 10), {X = 10},
    rational(Y), {0 =< Y, Y =< 10}, \+ {Y = 11},
    in_q([_, _, _], 0, 10).

% maximize_2_and_minimize_2 (and dispatch_table: the same lp/3)
lp(X, Y, OBJ) :-
    in_q([X, Y], 0, 1000),
    {2*X + Y =< 16, X + 2*Y =< 11, X + 3*Y =< 15},
    maximize(30*X + 50*Y, OBJ).

test("lp: X = 7, Y = 2, OBJ = 310") :-
    lp(X, Y, OBJ), X == 7, Y == 2, OBJ == 310.

% sup_2_and_inf_2
bounds(X, LO, HI) :-
    in_q(X, 0, 100),
    {X =< 10, X >= 3},
    inf(X, LO),
    sup(X, HI).

test("bounds: LO = 3, HI = 10, X unbound") :-
    bounds(X, LO, HI), LO == 3, HI == 10, var(X).

% int_minimize_3
int_min(X, COST) :-
    in_q(X, 0, 10),
    {X >= 3/2},
    int_minimize([X], X, COST).

resource_min(X, Y, Z, COST) :-
    in_q([X, Y, Z], 0, 100),
    {X >= Y + Z, Y >= 2, Z >= 2},
    int_minimize([X, Y, Z], X, COST).

% The solver decides whether int_minimize/3 binds the variables: legacy
% binds them to the optimum; the clp(q,r) 1.3.3 port (CLAUSAL_CLPQ=holzbaur)
% binds COST alone, as bb_inf/3 does there. Its prolog flags name the port.
clpq_port :-
    current_prolog_flag(F, _),
    F == clpq_max_nodes.

bound_at_optimum(VS, OPT) :-
    \+ clpq_port,
    VS == OPT.
bound_at_optimum(VS, _) :-
    clpq_port,
    maplist(var, VS).

test("int_min: X = 2, COST = 2") :-
    int_min(X, COST),
    COST == 2,
    bound_at_optimum([X], [2]).

test("resource_min: X = 4, Y = 2, Z = 2, COST = 4") :-
    resource_min(X, Y, Z, COST),
    COST == 4,
    bound_at_optimum([X, Y, Z], [4, 2, 2]).

test("bb_inf/3 is int_minimize/3") :-
    in_q(X, 0, 10),
    {X >= 3/2},
    bb_inf([X], X, COST),
    COST == 2,
    bound_at_optimum([X], [2]).

% dump_q_2
show_constraints(X, Y, CS) :-
    in_q([X, Y], 0, 100),
    {2*X + Y =< 16, X + 2*Y =< 11},
    dump_q([X, Y], CS).

% legacy keeps all six input bounds; the port's projection drops the
% redundant ones and keeps four.
projection_length(6) :-
    \+ clpq_port.
projection_length(4) :-
    clpq_port.

test("dump_q: a list of atoms") :-
    show_constraints(_, _, CS),
    projection_length(N),
    length(CS, N),
    maplist(atom, CS).

% linear_equalities, _ex2, _ex3
two_var(X, Y) :-
    in_q([X, Y], 0, 10),
    {X + Y = 10, X = 3}.

three_var(X, Y, Z) :-
    in_q([X, Y, Z], -100, 100),
    {X + Y + Z = 6, X - Y = 2, Y - Z = 1}.

rational_coeffs(X, Y) :-
    in_q([X, Y], -10, 10),
    {1/2 * X + 1/3 * Y = 1, Y = 0}.

test("two_var: X = 3, Y = 7") :-
    two_var(X, Y), X == 3, Y == 7.

test("three_var: 11/3, 5/3, 2/3") :-
    three_var(X, Y, Z),
    X =:= 11 rdiv 3, Y =:= 5 rdiv 3, Z =:= 2 rdiv 3.

test("rational_coeffs: X = 2, Y = 0") :-
    rational_coeffs(X, Y), X == 2, Y == 0.

% linear_inequalities, _ex2
feasible(X, Y) :-
    in_q([X, Y], 0, 100),
    {X + Y =< 8, X =< 5, Y =< 6}.

infeasible(X) :-
    in_q(X, 0, 10),
    {X >= 6, X =< 4}.

test("feasible") :-
    feasible(_, _).

test("infeasible", fail) :-
    infeasible(_).

% optimization
scheduling(X, Y, COST) :-
    in_q([X, Y], 0, 100),
    {X + Y >= 10,
     2*X + Y =< 30,
     X + 3*Y =< 40},
    minimize(5*X + 3*Y, COST).

test("scheduling: COST = 30") :-
    scheduling(X, Y, COST), X == 0, Y == 10, COST == 30.

% fd_q_coexistence
mixed(X, Y) :-
    in_domain(X, 1, 10),
    in_q(Y, 0, 10),
    {X + Y = 10},
    {Y = 7}.

test("mixed: X = 3") :-
    mixed(X, Y), X == 3, Y == 7.

% dispatch_table_ex2
choice(X) :-
    in_q(X, 0, 10),
    {X = 5}.
choice(X) :-
    in_q(X, 0, 10),
    {X = 3}.

test("choice: each branch its own constraints") :-
    findall(X, choice(X), XS), XS == [5, 3].
