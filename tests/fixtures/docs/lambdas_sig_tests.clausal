# Companion tests for docs/lambdas.md display snippets.

Test("call_goal single arg") <- call_goal((X <- (X > 0)), 5)

Test("call_goal two args") <- (
    call_goal(((X, Y) <- (Y == X * 2)), 5, R),
    R == 10
)

Test("maplist with number") <- maplist(number, [1, 2, 3])

Test("include with integer") <- (
    include(integer, [1, "a", 2, "b", 3], IS),
    IS == [1, 2, 3]
)
