# Companion tests for docs/exceptions.md signature blocks.

test("throw/catch exist") <- (
    catch(
        throw("test_error"),
        ERR,
        ERR == "test_error"
    )
)  # nv

test("catch_recover exists") <- (
    catch_recover(
        throw("err"),
        _,
        (1 == 1)
    )
)  # nv
