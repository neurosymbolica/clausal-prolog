# Companion tests for docs/specialization.md signature blocks.
-double_quotes(atom)

-import_from(clausal.examples.metainterpreters, [solve_count])

natnum_program(PROGRAM) <- (
    PROGRAM is [
        [["natnum", 0], []],
        [["natnum", ["s", X]], [["natnum", X]]]
    ]
)

-specialize(solve_count, natnum_program, alias=solve_count_natnum)

test("count natnum(s(s(0)))") <- solve_count_natnum([["natnum", ["s", ["s", 0]]]], 3)  # nv
