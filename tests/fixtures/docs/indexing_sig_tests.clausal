# Companion tests for docs/indexing.md signature blocks.

# --- color_query_modes ---
-double_quotes(atom)

color("red",    "warm"),
color("blue",   "cool"),
color("green",  "cool"),
color("yellow", "warm"),
color("white",  "neutral")

test("color first arg ground") <- color("red", TEMP_UNUSED)  # nv
test("color second arg ground") <- color(NAME_UNUSED, "warm")  # nv
