# Companion tests for docs/term_expansion.md display snippets.

# Identity expansion: items pass through unchanged
TermExpansion(ITEM, ITEM, STATE, STATE) <- True

color("red"),
color("green"),

Test("identity passthrough red") <- color("red")
Test("identity passthrough green") <- color("green")

# Regex auto-binding via goal expansion
-import_from(regex, [Match])

Test("regex auto-bind year") <- (
    Match(r"(?P<YEAR>\d{4})-\d{2}", "2026-03"),
    YEAR == "2026"
)
