-double_quotes(chars)
# Companion tests for docs/term_expansion.md display snippets that stay seam.
# (The identity-expansion tests are in term_expansion_sig_tests.clausal.)

# Regex auto-binding via goal expansion, a seam feature: in a .clausal file
# library(re)'s match/2 does not bind named groups. The group name resolves
# to a HEAD argument (YEAR of year_of/2); binding a group named only in the
# body is a separate, deferred capability (A10-F005).
-import_from(regex, [match])

# -allow_singletons: YEAR is a regex named-group name (?P<YEAR>...) referenced
# only via the group-name string inside the pattern, invisible to the
# singleton lint's ast.Name-based occurrence count.
-allow_singletons

year_of(S, YEAR) <- match(r"(?P<YEAR>\d{4})-\d{2}", S)

test("regex auto-bind year") <- (
    year_of("2026-03", Y),
    Y == "2026"
)  # nv
