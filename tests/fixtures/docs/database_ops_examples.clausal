# Doc snippet fixtures for docs/database_ops.md

# --8<-- [start:quick_example]
-dynamic(color/1)

color('red'),
color('blue'),

test("assert and query") <- (
    assertz(color('green')),
    color('green')
)  # nv
# --8<-- [end:quick_example]

# --8<-- [start:dynamic_directive]
-dynamic(counter/1)
-dynamic(cache/2)
# --8<-- [end:dynamic_directive]

# --8<-- [start:assertz_example]
-dynamic(fact/1)

fact('init'),

test("assert") <- (
    assertz(fact(42)),
    fact(42)
)  # nv
# --8<-- [end:assertz_example]

# --8<-- [start:asserta_example]
-dynamic(priority/1)

priority('low'),

test("assert first") <- (
    asserta(priority('high')),
    priority('high')
)  # nv
# --8<-- [end:asserta_example]

# --8<-- [start:retract_example]
-dynamic(item/1)

item('a'),
item('b'),
item('c'),

test("retract") <- (
    retract(item('b')),
    (not item('b')),
    item('a'),
    item('c')
)  # nv
# --8<-- [end:retract_example]

# --8<-- [start:retract_pattern]
-dynamic(pair/2)

pair('x', 1),
pair('y', 2),
pair('z', 3),

test("retract by pattern") <- (
    retract(pair('y', _)),
    (not pair('y', 2))
)  # nv
# --8<-- [end:retract_pattern]

# --8<-- [start:abolish_table_example]
-table(memo_fib/2)

memo_fib(0, 0),
memo_fib(1, 1),

test("clear") <- abolish_table('memo_fib', 2)  # nv
# --8<-- [end:abolish_table_example]
# --8<-- [start:declare_first]
-dynamic(seen/1)
-private([error(formal, context), permission_error(action, type, culprit),
          modify, static_procedure])

stable(1),

test("a dynamic predicate accepts assertz") <- (
    assertz(seen('x')),
    seen('x')
)

test("a static predicate refuses it") <- (
    catch(assertz(stable(2)), E, True),
    E is error(permission_error(modify, static_procedure, '/'('stable', 1)), '/'('assertz', 1))
)
# --8<-- [end:declare_first]

# --8<-- [start:memoization_recipe]
-dynamic(fib_cache/2)

fib(N, F) <- fib_cache(N, F)
fib(N, F) <- (
    not fib_cache(N, _),
    fib_compute(N, F),
    assertz(fib_cache(N, F))
)

fib_compute(0, 0),
fib_compute(1, 1),
fib_compute(N, F) <- (
    N > 1,
    N1 == N - 1,
    N2 == N - 2,
    fib(N1, F1),
    fib(N2, F2),
    F == F1 + F2
)

test("memoized fib") <- (fib(30, F), F == 832040, fib_cache(30, 832040))
# --8<-- [end:memoization_recipe]

# --8<-- [start:counter_recipe]
-dynamic(ctr/1)

ctr(0),

increment(NEW) <- (
    retract(ctr(OLD)),
    NEW == OLD + 1,
    assertz(ctr(NEW))
)

test("counter") <- (
    increment(1),
    increment(2),
    ctr(2)
)
# --8<-- [end:counter_recipe]

# --8<-- [start:collect_recipe]
-dynamic(result/1)

collect_evens(LIST) <- (
    in_(X, LIST),
    X % 2 == 0,
    assertz(result(X)),
    False
)
collect_evens(_),

test("collect") <- (collect_evens([1, 2, 3, 4]), findall(X, result(X), [2, 4]))
# --8<-- [end:collect_recipe]
