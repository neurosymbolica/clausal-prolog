-double_quotes(chars)
# Doc snippet fixtures for docs/keyword_preds.md

# Shared fact for keyword predicate examples
point(x=1, y=2, z=3),

# --8<-- [start:quick_example]
test("vary") <- (
    vary({"y": 99}, point(1, 2, 3), RESULT),
    RESULT == point(1, 99, 3)
)  # nv
# --8<-- [end:quick_example]

# --8<-- [start:vary_examples]
test("change one field") <- (
    vary({"x": 100}, point(1, 2, 3), R),
    R == point(100, 2, 3)
)  # nv

test("change multiple") <- (
    vary({"x": 10, "z": 30}, point(1, 2, 3), R),
    R == point(10, 2, 30)
)  # nv
# --8<-- [end:vary_examples]

# --8<-- [start:unbound_keys_examples]
# A field name is an ATOM (spec §6.4), so the keys are `y`/`z`, not the
# strings "y"/"z" — this file is in `-double_quotes(chars)` mode.
test("unbound") <- (
    unbound_keys(point(1, Y_UNUSED, Z_UNUSED), KEYS),
    in_('y', KEYS),
    in_('z', KEYS),
    length(KEYS, 2)
)  # nv

test("fully bound") <- unbound_keys(point(1, 2, 3), [])  # nv
# --8<-- [end:unbound_keys_examples]

# --8<-- [start:signature_example]
# The name position speaks atoms in AND out (spec §6.4).
test("signature") <- (
    signature('point', 3, NAMES),
    NAMES == ['x', 'y', 'z']
)  # nv
# --8<-- [end:signature_example]
