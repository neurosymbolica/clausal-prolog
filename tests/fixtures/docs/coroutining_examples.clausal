# Doc snippet fixtures for docs/coroutining.md

# --8<-- [start:supported_conditions]
# equivalent to freeze(X, Goal)
-double_quotes(atom)
test("when isbound") <- (
    when(nonvar(X), Y is X),
    X is 42,
    Y is 42
)  # nv

# Conjunction: fire when both X and Y are bound
test("when conjunction") <- (
    when((nonvar(X), nonvar(Y)), R is "done"),
    X is 1,
    Y is 2,
    R is "done"
)  # nv

# ground: fire when term is fully ground
test("when ground") <- (
    when(ground([X, Y]), R is "all ground"),
    X is 1,
    Y is 2,
    R is "all ground"
)  # nv
# --8<-- [end:supported_conditions]

# --8<-- [start:setup_call_cleanup_3_ex2]
# Basic pattern: open/use/close
process_file(PATH, RESULT) <- setup_call_cleanup(
    HANDLE is ++open(PATH),
    (DATA is ++HANDLE.read(), RESULT is DATA),
    ++HANDLE.close()
)

# Call fails — Cleanup still runs, overall fails
test("scc call fails") <- (
    not setup_call_cleanup(
        S_UNUSED is 1,
        in_(X_UNUSED, []),
        C_UNUSED is 3
    )
)  # nv
# --8<-- [end:setup_call_cleanup_3_ex2]

# --8<-- [start:call_nth_2_ex2]
# Get the 3rd member
test("third") <- (
    call_nth(in_(X, [10, 20, 30, 40, 50]), 3),
    X is 30
)  # nv

# N exceeds available solutions — fails
test("too few") <- (
    not call_nth(in_(X_UNUSED, [1, 2]), 5)
)  # nv
# --8<-- [end:call_nth_2_ex2]

# --8<-- [start:count_all_2_ex2]
# Count members
test("count") <- (
    count_all(in_(X_UNUSED, ["a", "b", "c", "d"]), N),
    N is 4
)  # nv

# No solutions — 0
test("empty") <- (
    count_all(in_(X_UNUSED, []), N),
    N is 0
)  # nv

# With filter
test("filtered") <- (
    count_all((in_(X, [1, 2, 3, 4, 5]), X > 3), N),
    N is 2
)  # nv
# --8<-- [end:count_all_2_ex2]

# --8<-- [start:nesting_inside_meta_predicates]
# findall wrapping call_nth
test("findall+callnth") <- (
    findall(X, call_nth(in_(X, [10, 20, 30]), 2), BAG),
    BAG is [20]
)  # nv

# catch wrapping call_nth with bad N
test("catch+callnth") <- (
    catch(
        call_nth(in_(X_UNUSED, [1, 2, 3]), 0),
        _,
        R is "caught"
    ),
    R is "caught"
)  # nv

# freeze inside findall
test("findall+freeze") <- (
    findall(
        Y,
        (freeze(X, Y is X), X is 99),
        BAG
    ),
    BAG is [99]
)  # nv

# count_all inside findall
test("findall+countall") <- (
    findall(
        N,
        count_all(in_(X_UNUSED, ["a", "b", "c"]), N),
        BAG
    ),
    BAG is [3]
)  # nv
# --8<-- [end:nesting_inside_meta_predicates]
