# Companion tests for docs/meta_predicates.md display snippets.

Test("filter_map exists") <- (
    filter_map(((X, Y) <- (X > 0, Y == X * 2)), [3, -1, 5], RS),
    RS == [6, 10]
)

Test("findall inline") <- (
    findall(SQ, (in_(X, [1, 2, 3]), SQ == X * X), SQS),
    SQS == [1, 4, 9]
)

Test("include with lambda") <- (
    include((X <- (X > 0)), [-1, 2, -3, 4], PS),
    PS == [2, 4]
)
