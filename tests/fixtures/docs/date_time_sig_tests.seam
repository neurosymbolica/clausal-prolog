-double_quotes(chars)
# Companion tests for docs/date_time.md display snippets.

-import_from(date_time, [now, now_utc, today, date, time, datetime,
                         timedelta, date_add, date_sub, date_diff, days_between,
                         datetime_string, date_of, weekday, timestamp,
                         datetime_string_iso, date_string_iso])

# ── now/today ────────────────────────────────────────────────────────────────

test("now") <- now(_)  # nv
test("now utc") <- now_utc(_)  # nv
test("today") <- today(_)  # nv

# ── date ─────────────────────────────────────────────────────────────────────

test("date construct") <- (_D_UNUSED is date(2026, 3, 16))  # nv

test("date decompose") <- (
    D is date(2026, 3, 16),
    date(Y, M, DAY) is D,
    Y == 2026,
    M == 3,
    DAY == 16
)  # nv

# ── time ─────────────────────────────────────────────────────────────────────

test("time construct") <- time(14, 30, 0, _)  # nv

test("time decompose") <- (
    time(14, 30, 0, T),
    time(H, M, S, T),
    H == 14,
    M == 30,
    S == 0
)  # nv

# ── datetime ─────────────────────────────────────────────────────────────────

test("datetime construct") <- datetime(2026, 3, 16, 14, 30, 0, _)  # nv

# ── timedelta ────────────────────────────────────────────────────────────────

test("timedelta construct") <- timedelta(7, 0, _)  # nv

# ── Arithmetic ───────────────────────────────────────────────────────────────

test("date add") <- (
    D is date(2026, 3, 16),
    timedelta(7, 0, TD),
    date_add(D, TD, R),
    R is date(2026, 3, 23)
)  # nv

test("date sub") <- (
    D is date(2026, 3, 23),
    timedelta(7, 0, TD),
    date_sub(D, TD, R),
    R is date(2026, 3, 16)
)  # nv

test("date diff") <- (
    D1 is date(2026, 3, 23),
    D2 is date(2026, 3, 16),
    date_diff(D1, D2, TD),
    timedelta(7, 0, TD)
)  # nv

# ── datetime_string ───────────────────────────────────────────────────────────

test("format date") <- (
    D is date(2026, 3, 16),
    datetime_string(D, S, "%Y-%m-%d"),
    S == "2026-03-16"
)  # nv

test("parse date") <- (
    datetime_string(DT, "2026-03-16", "%Y-%m-%d"),
    nonvar(DT)
)  # vn

# ── date_of (datetime → date, no ++DT.date()) ─────────────────────────────────

test("date of datetime") <- (
    datetime(2026, 3, 16, 14, 30, 0, DT),
    date_of(DT, D),
    D is date(2026, 3, 16)
)  # nv

test("date of inverse midnight") <- (
    D is date(2026, 3, 16),
    date_of(DT, D),
    datetime(2026, 3, 16, 0, 0, 0, DT)
)  # vn

# ── days_between (direct integer day count) ───────────────────────────────────

test("days between") <- (
    A is date(2026, 3, 23),
    B is date(2026, 3, 16),
    days_between(A, B, N),
    N == 7
)  # nnv

# Rolling-window-style "parse ISO → date → diff" with no ++ Python escapes.
test("parse iso to date diff no escapes") <- (
    datetime_string(DT_A, "2026-03-23", "%Y-%m-%d"),
    datetime_string(DT_B, "2026-03-16", "%Y-%m-%d"),
    date_of(DT_A, A),
    date_of(DT_B, B),
    days_between(A, B, N),
    N == 7
)  # vn

# ── weekday ──────────────────────────────────────────────────────────────────

test("day of week") <- (
    D is date(2026, 3, 16),
    weekday(D, DOW),
    number(DOW)
)  # nv

# ── timestamp ─────────────────────────────────────────────────────────────────

test("timestamp roundtrip") <- (
    datetime(2026, 3, 16, 12, 0, 0, DT),
    timestamp(DT, TS),
    timestamp(DT2, TS),
    DT == DT2
)  # nv

# ── ISO-8601 helpers ──────────────────────────────────────────────────────────

test("datetime iso roundtrip") <- (
    datetime(2026, 3, 16, 14, 30, 0, DT),
    datetime_string_iso(DT, S),
    datetime_string_iso(DT2, S),
    DT == DT2
)  # nv

test("date iso roundtrip") <- (
    D is date(2026, 3, 16),
    date_string_iso(D, S),
    date_string_iso(D2, S),
    D == D2
)  # nv
