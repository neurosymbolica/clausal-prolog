# Companion tests for docs/term_inspection.md display snippets.

Test("gensym generates unique") <- (
    gensym("test_doc_", A1),
    gensym("test_doc_", A2),
    dif(A1, A2)
)  # nv

# F088/F089 (audit 2026-06-13): unpack follows ISO cons-cell — a
# non-empty str decomposes as [".", head, tail].
Test("unpack decompose") <- unpack("hello", [".", "h", "ello"])  # nv

Test("numbervars") <- (
    numbervars([X, Y, Z], 0, END),
    END == 3
)  # nv
