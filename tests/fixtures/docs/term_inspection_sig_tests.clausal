# Companion tests for docs/term_inspection.md display snippets.

Test("gensym generates unique") <- (
    gensym("test_doc_", A1),
    gensym("test_doc_", A2),
    dif(A1, A2)
)  # nv

# P3-1 Task 5 (§1b/R2): the str~char-list cons rule is retired -- a
# non-empty str is its own atom (arity 0), so unpack gives [self]
# (formerly ISO cons-cell on str: F088/F089, audit 2026-06-13, decomposing
# as [".", head, tail]).
Test("unpack decompose") <- unpack("hello", ["hello"])  # nv

Test("numbervars") <- (
    numbervars([X_UNUSED, Y_UNUSED, Z_UNUSED], 0, END),
    END == 3
)  # nv
