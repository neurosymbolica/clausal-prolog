# Companion tests for docs/tutorial_parallel_clausal.md signature blocks.

# --- pure_predicates ---

append([], YS, YS),
append([H, *XS], YS, [H, *ZS]) <- append(XS, YS, ZS)

Member(X, [X, *_]),
Member(X, [_, *T]) <- Member(X, T)

Factorial(0, 1),
Factorial(N, F) <- (
    N > 0,
    N1 == N - 1,
    Factorial(N1, F1),
    F == N * F1
)

Test("append works") <- (append([1], [2, 3], R), R is [1, 2, 3])  # nv
Test("member works") <- Member(2, [1, 2, 3])  # nv
Test("factorial works") <- (Factorial(5, F), F is 120)  # nv

# --- dynamic_predicates ---

-dynamic(counter/1)

counter(0),
counter(1),
counter(2)

Test("counter exists") <- counter(0)  # nv

# --- correctness_tests ---

MyAppend([], YS, YS),
MyAppend([H, *XS], YS, [H, *ZS]) <- MyAppend(XS, YS, ZS)

Test("append nil") <- (MyAppend([], [1, 2], R), R is [1, 2])  # nv
Test("append cons") <- (MyAppend([1], [2, 3], R), R is [1, 2, 3])  # nv
