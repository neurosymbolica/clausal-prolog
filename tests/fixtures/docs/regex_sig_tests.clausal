-double_quotes(chars)
# Companion tests for docs/regex.md display snippets.

-import_from(regex, [match, search, replace, split])

Test("match exists") <- match(r"\d+", "123")  # nv
Test("search exists") <- search(r"\d+", "abc123")  # nv
Test("replace exists") <- (replace(r"\s+", " ", "a  b", R), R == "a b")  # nv
Test("split exists") <- (split(r",", "a,b,c", F), F == ["a", "b", "c"])  # nv
