# Companion tests for docs/torch.md signature blocks.
# Validates that documented predicates exist and accept the documented arities.

-import_from(py.torch, [
    tensor, zeros, ones, randn, arange, linspace, full, eye,
    shape, dtype, device, dim, element_count, requires_gradient,
    is_contiguous,
    matmul, add, mul, cat, stack, sum, mean, max, min,
    clamp, abs, softmax, relu,
    reshape, squeeze, unsqueeze, flatten, unflatten,
    transpose, permute, contiguous,
    split, chunk, unbind, narrow, expand, repeat, tile,
    flip, roll,
    tensor_numpy, tensor_list,
    float32, float64, int32,
    dtype_info,
    det, inv, solve, svd, cholesky, qr,
    norm, matrix_rank, pinv, cross, dot,
    fft_transform, real_fft, fft_shift,
    fft_frequencies, real_fft_frequencies,
    eq, ne, gt, lt, ge, le, equal, allclose,
    logical_and, logical_or, logical_xor, logical_not,
    where, masked_select, index_select, gather, scatter,
    einsum,
    logarithm, sine, cosine, tangent,
    sqrt, pow, atan2, sinh, cosh, tanh,
    sigmoid, log_softmax,
    floor, ceil, round, sign,
    cumsum, cumprod,
    zeros_like, ones_like, full_like, empty,
    rand, randint, logspace, diag,
    sub, div, neg,
    median, std, var,
    argmin, argmax, sort, argsort, topk,
    nonzero, unique
])

# -- Creation --

Test("tensor exists") <- (
    tensor([1.0, 2.0, 3.0], T),
    shape(T, [3])
)  # nv

Test("zeros exists") <- (
    zeros([2, 3], T),
    shape(T, [2, 3])
)  # nv

Test("ones exists") <- (
    ones([2, 3], T),
    shape(T, [2, 3])
)  # nv

Test("randn exists") <- (
    randn([3, 4], T),
    shape(T, [3, 4])
)  # nv

Test("arange exists") <- (
    arange(5, T),
    shape(T, [5])
)  # nv

Test("linspace exists") <- (
    linspace(0.0, 1.0, 5, T),
    shape(T, [5])
)  # nv

Test("full exists") <- (
    full([2, 3], 7.0, T),
    shape(T, [2, 3])
)  # nv

Test("eye exists") <- (
    eye(3, T),
    shape(T, [3, 3])
)  # nv

# -- Properties --

Test("shape exists") <- (
    zeros([3, 4, 5], T),
    shape(T, [3, 4, 5])
)  # nv

Test("dtype exists") <- (
    zeros([2], T),
    dtype(T, float32)
)  # nv

Test("device exists") <- (
    zeros([2], T),
    device(T, "cpu")
)  # nv

Test("dim exists") <- (
    zeros([2, 3], T),
    dim(T, 2)
)  # nv

Test("element_count exists") <- (
    zeros([2, 3], T),
    element_count(T, 6)
)  # nv

Test("is_contiguous exists") <- (
    zeros([2, 3], T),
    is_contiguous(T)
)  # nv

# -- Math --

Test("matmul exists") <- (
    zeros([2, 3], A),
    zeros([3, 4], B),
    matmul(A, B, C),
    shape(C, [2, 4])
)  # nv

Test("add exists") <- (
    tensor([1.0, 2.0], A),
    tensor([3.0, 4.0], B),
    add(A, B, C),
    shape(C, [2])
)  # nv

Test("cat exists") <- (
    zeros([2, 3], A),
    ones([2, 3], B),
    cat([A, B], 0, C),
    shape(C, [4, 3])
)  # nv

Test("sum exists") <- (
    tensor([1.0, 2.0, 3.0], T),
    sum(T, S),
    nonvar(S)
)  # nv

Test("relu exists") <- (
    tensor([-1.0, 0.0, 1.0], T),
    relu(T, T2),
    tensor_list(T2, [0.0, 0.0, 1.0])
)  # nv

Test("softmax exists") <- (
    tensor([1.0, 2.0, 3.0], T),
    softmax(T, 0, T2),
    shape(T2, [3])
)  # nv

# -- Shape --

Test("reshape exists") <- (
    arange(6, T),
    reshape(T, [2, 3], T2),
    shape(T2, [2, 3])
)  # nv

Test("squeeze exists") <- (
    zeros([3, 1, 4], T),
    squeeze(T, 1, T2),
    shape(T2, [3, 4])
)  # nv

Test("unsqueeze exists") <- (
    zeros([3, 4], T),
    unsqueeze(T, 1, T2),
    shape(T2, [3, 1, 4])
)  # nv

Test("flatten exists") <- (
    zeros([2, 3, 4], T),
    flatten(T, T2),
    shape(T2, [24])
)  # nv

Test("transpose exists") <- (
    zeros([2, 3], T),
    transpose(T, 0, 1, T2),
    shape(T2, [3, 2])
)  # nv

Test("split exists") <- (
    tensor([1.0, 2.0, 3.0, 4.0], T),
    split(T, 2, PARTS),
    length(PARTS, 2)
)  # nv

Test("flip exists") <- (
    tensor([1.0, 2.0, 3.0], T),
    flip(T, [0], F),
    tensor_list(F, [3.0, 2.0, 1.0])
)  # nv

# -- Conversions --

Test("tensor_list exists") <- (
    tensor([1.0, 2.0, 3.0], T),
    tensor_list(T, L),
    L == [1.0, 2.0, 3.0]
)  # nv

# -- Linear Algebra --

Test("det exists") <- (
    eye(2, A),
    det(A, D),
    nonvar(D)
)  # nv

Test("inv exists") <- (
    eye(3, I),
    inv(I, B),
    shape(B, [3, 3])
)  # nv

Test("norm exists") <- (
    tensor([3.0, 4.0], A),
    norm(A, N),
    nonvar(N)
)  # nv

# -- FFT --

Test("fft_transform exists") <- (
    tensor([1.0, 2.0, 3.0, 4.0], T),
    fft_transform(T, F),
    shape(F, [4])
)  # nv

# -- Comparisons --

Test("eq exists") <- (
    tensor([1.0, 2.0], A),
    tensor([1.0, 3.0], B),
    eq(A, B, C),
    shape(C, [2])
)  # nv

Test("equal exists") <- (
    tensor([1.0, 2.0], A),
    tensor([1.0, 2.0], B),
    equal(A, B)
)  # nv

# -- Selection --

Test("where exists") <- (
    tensor([1.0, 2.0], X),
    tensor([10.0, 20.0], Y),
    gt(X, Y, COND),
    where(COND, X, Y, R),
    shape(R, [2])
)  # nv

# -- Einsum --

Test("einsum exists") <- (
    tensor([[1.0, 2.0], [3.0, 4.0]], A),
    tensor([[5.0, 6.0], [7.0, 8.0]], B),
    einsum("ij,jk->ik", [A, B], C),
    shape(C, [2, 2])
)  # nv

# -- Advanced Math --

Test("sqrt exists") <- (
    tensor([4.0, 9.0], T),
    sqrt(T, R),
    nonvar(R)
)  # nv

Test("sigmoid exists") <- (
    tensor([0.0], T),
    sigmoid(T, R),
    nonvar(R)
)  # nv

# -- Creation Variants --

Test("zeros_like exists") <- (
    tensor([1.0, 2.0], T),
    zeros_like(T, Z),
    shape(Z, [2])
)  # nv

Test("rand exists") <- (
    rand([3, 4], T),
    shape(T, [3, 4])
)  # nv

Test("diag exists") <- (
    tensor([1.0, 2.0, 3.0], V),
    diag(V, M),
    shape(M, [3, 3])
)  # nv

# -- Arithmetic Gaps --

Test("sub exists") <- (
    tensor([5.0, 3.0], A),
    tensor([2.0, 1.0], B),
    sub(A, B, C),
    nonvar(C)
)  # nv

Test("neg exists") <- (
    tensor([1.0, -2.0], T),
    neg(T, R),
    nonvar(R)
)  # nv

# -- Stats/Selection --

Test("sort exists") <- (
    tensor([3.0, 1.0, 2.0], T),
    sort(T, RESULT),
    nonvar(RESULT)
)  # nv

Test("unique exists") <- (
    tensor([3.0, 1.0, 2.0, 1.0], T),
    unique(T, U),
    nonvar(U)
)  # nv
