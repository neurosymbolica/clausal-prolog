# Companion tests for docs/torch.md display snippets.

-import_from(py.torch, [
    tensor, zeros, ones, randn, arange, linspace, full, eye,
    shape, dtype, device,
    reshape, transpose, squeeze, unsqueeze, cat, stack,
    add, sub, mul, matmul,
    relu, softmax, sigmoid,
    tensor_list, tensor_numpy,
    float32, int64
])

# ── Creation ─────────────────────────────────────────────────────────────────

Test("tensor") <- (tensor([1.0, 2.0, 3.0], T), shape(T, [3]))

Test("zeros") <- (zeros([2, 3], T), shape(T, [2, 3]))

Test("ones") <- (ones([3], T), shape(T, [3]))

Test("arange") <- (arange(0, 5, 1, T), shape(T, [5]))

Test("eye") <- (eye(3, T), shape(T, [3, 3]))

# ── Shape ops ────────────────────────────────────────────────────────────────

Test("reshape") <- (
    tensor([1.0, 2.0, 3.0, 4.0], T),
    reshape(T, [2, 2], R),
    shape(R, [2, 2])
)

Test("squeeze") <- (
    ones([1, 3, 1], T),
    squeeze(T, R),
    shape(R, [3])
)

# ── Math ─────────────────────────────────────────────────────────────────────

Test("add") <- (
    tensor([1.0, 2.0], A),
    tensor([3.0, 4.0], B),
    add(A, B, C),
    shape(C, [2])
)

Test("matmul") <- (
    tensor([[1.0, 2.0], [3.0, 4.0]], A),
    tensor([[5.0], [6.0]], B),
    matmul(A, B, C),
    shape(C, [2, 1])
)

# ── Activation ───────────────────────────────────────────────────────────────

Test("relu") <- (
    tensor([-1.0, 0.0, 1.0], T),
    relu(T, R),
    tensor_list(R, L),
    L == [0.0, 0.0, 1.0]
)

# ── Conversion ───────────────────────────────────────────────────────────────

Test("tensor_list roundtrip") <- (
    tensor([1.0, 2.0, 3.0], T),
    tensor_list(T, L),
    L == [1.0, 2.0, 3.0]
)
