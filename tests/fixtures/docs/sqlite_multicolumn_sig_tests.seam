-double_quotes(chars)
# Companion test for docs/sqlite.md: a multi-column row is a tuple, which
# only a seam tuple pattern takes apart (Clausal Prolog has no term that
# unifies with it), so this test stays in seam syntax.

-import_from(sqlite, [connect, exec, query])

test("text is a string in single- and multi-column rows") <- (
    connect(":memory:", "doc_test_txt_mc"),
    exec("doc_test_txt_mc", "CREATE TABLE users (name TEXT, age INTEGER)"),
    exec("doc_test_txt_mc", "INSERT INTO users VALUES ('alice', 30)"),
    query("doc_test_txt_mc", "SELECT name, age FROM users", (NAME, AGE)),
    string(NAME), NAME is "alice", AGE is 30,
    query("doc_test_txt_mc", "SELECT name FROM users", ONE),
    string(ONE), ONE is "alice"
)  # nv
