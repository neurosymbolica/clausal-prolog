-double_quotes(chars)
# Doc snippet fixtures for docs/strings_as_lists.md

# --8<-- [start:unification]
# THE FLIP (2026-09-06-atoms-as-cells-strings §6.2): a string IS the list
# of its char atoms, so it unifies with that list — the rule P3-1 Task 5
# retired (because a str was then an ATOM, and an atom is not a list) is
# back, and the doc these snippets illustrate is true again.  This module
# reads "..." as a string (-double_quotes(chars) above); the list elements
# are char atoms, which is what a string's elements are.
Test("string equals its char list") <- ("abc" is ['a', 'b', 'c'])  # nv
Test("with vars unifies") <- ("abc" is [X_UNUSED, Y_UNUSED, Z_UNUSED])  # nv
Test("partial unifies") <- ("hello" is ['h', 'e', X_UNUSED, Y_UNUSED, 'o'])  # nv
# --8<-- [end:unification]

# --8<-- [start:empty_string]
# THE FLIP: "" and [] are one term again (spec §5.1) — the empty string is
# the empty list.
Test("empty unifies") <- ("" is [])  # nv
# --8<-- [end:empty_string]

# --8<-- [start:pattern_matching]
starts_with([*PREFIX, *_], PREFIX),
ends_with([*_, *SUFFIX], SUFFIX),
contains([*_, X, *_], X),

Test("prefix") <- starts_with("hello", "hel")  # nv
Test("suffix") <- ends_with("hello", "lo")  # nv
# ``contains(S, X)`` picks one ELEMENT out of the sequence, and an element
# of a string is a CHAR ATOM — ``'l'``, not the one-element string "l".
Test("contains l") <- contains("hello", 'l')  # nv
# --8<-- [end:pattern_matching]

# --8<-- [start:append_examples]
Test("concat") <- append("hel", "lo", "hello")  # nv
Test("prefix match") <- (append("hel", X, "hello"), X == "lo")  # nv
Test("suffix match") <- (append(X, "lo", "hello"), X == "hel")  # nv
# --8<-- [end:append_examples]

# --8<-- [start:length_example]
Test("length") <- length("hello", 5)  # nv
# --8<-- [end:length_example]

# --8<-- [start:member_examples]
Test("member") <- in_('e', "hello")  # nv
Test("enumerate") <- (
    findall(C, in_(C, "abc"), CHARS),
    CHARS is ['a', 'b', 'c']
)  # nv
# --8<-- [end:member_examples]

# --8<-- [start:reverse_example]
Test("reverse") <- reverse("hello", "olleh")  # nv
# --8<-- [end:reverse_example]

# --8<-- [start:take_drop_split]
Test("take") <- take(3, "hello", "hel")  # nv
Test("drop") <- drop(3, "hello", "lo")  # nv
Test("split") <- split_at(3, "hello", "hel", "lo")  # nv
# --8<-- [end:take_drop_split]

# --8<-- [start:list_item_example]
Test("index") <- (list_item(1, "hello", C), C is 'e')  # nv
# --8<-- [end:list_item_example]

# --8<-- [start:type_checking]
Test("is_chars string") <- is_chars("hello")  # nv
Test("is_chars list") <- is_chars([1, 2, 3])  # nv
# Audit 2026-05-25 (F080): is_list/1 is now polymorphic over list
# and str — a str is a character sequence, so is_list("hello")
# agrees with maplist/length/append/reverse/member/take/drop/etc.
Test("is_list string succeeds") <- is_list("hello")  # nv
Test("is_str list fails") <- (not is_str([1, 2, 3]))  # nv
# --8<-- [end:type_checking]
