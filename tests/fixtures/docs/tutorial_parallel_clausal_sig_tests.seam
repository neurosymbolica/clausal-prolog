# Companion tests for docs/tutorial_parallel_clausal.md signature blocks.

# --- pure_predicates ---

append([], YS, YS),
append([H, *XS], YS, [H, *ZS]) <- append(XS, YS, ZS)

member(X, [X, *_]),
member(X, [_, *T]) <- member(X, T)

factorial(0, 1),
factorial(N, F) <- (
    N > 0,
    N1 == N - 1,
    factorial(N1, F1),
    F == N * F1
)

test("append works") <- (append([1], [2, 3], R), R is [1, 2, 3])  # nv
test("member works") <- member(2, [1, 2, 3])  # nv
test("factorial works") <- (factorial(5, F), F is 120)  # nv

# --- dynamic_predicates ---

-dynamic(counter/1)

counter(0),
counter(1),
counter(2)

test("counter exists") <- counter(0)  # nv

# --- correctness_tests ---

my_append([], YS, YS),
my_append([H, *XS], YS, [H, *ZS]) <- my_append(XS, YS, ZS)

test("append nil") <- (my_append([], [1, 2], R), R is [1, 2])  # nv
test("append cons") <- (my_append([1], [2, 3], R), R is [1, 2, 3])  # nv
