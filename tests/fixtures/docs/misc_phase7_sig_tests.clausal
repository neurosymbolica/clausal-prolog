# Companion tests for miscellaneous Phase 7 doc files.

# ── wfs ──────────────────────────────────────────────────────────────────────
-double_quotes(atom)

test("tabling exists") <- (
    findall(X, in_(X, [1, 2, 3]), BAG),
    length(BAG, 3)
)  # nv

# ── dcg ──────────────────────────────────────────────────────────────────────

test("dcg phrase works") <- (
    findall(X, in_(X, [1]), BAG),
    BAG == [1]
)  # nv

# ── reified if ───────────────────────────────────────────────────────────────

test("if_ exists") <- if_(1 == 1, (1 == 1), (1 == 2))  # nv

# ── python escape ────────────────────────────────────────────────────────────

test("python escape") <- (
    R is ++(2 * 3),
    R == 6
)  # nv
