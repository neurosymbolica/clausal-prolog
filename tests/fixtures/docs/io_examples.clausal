-double_quotes(chars)
-private([bar])
-implicit_functors
# Doc snippet fixtures for docs/io.md.
#
# The three ISO writers (spec 2026-09-06-atoms-as-cells-strings §6.7):
# write/1 is the unquoted one, writeq/1 the quoted one, and
# write_canonical/1 prints every list -- a string included -- as the '.'/2
# structure it denotes.  All three are ISO, so a STRING is the LIST of its
# characters in all three.  Each Test compares against write_to_string/2 or
# term_to_string/2, so the tables in the doc are pinned by an assertion
# rather than by eyeball.

# --8<-- [start:three_writers]
# write/1: no quotes, a string is the list of characters it is, and there
# is no space after a comma -- the ISO family is byte-comparable with other
# ISO systems.
Test("write is unquoted") <- (
    write_to_string(foo(bar, "baz"), S),
    S == "foo(bar,[b,a,z])"
)  # nv

Test("write spells a string out") <- (
    write_to_string("ab", S1),
    S1 == "[a,b]"
)  # nv

# writeq/1 adds quoting and nothing else: an atom that would not read back
# as itself is single-quoted, and the string is still the char list.
Test("writeq quotes an atom that needs it") <- (
    write_to_string('foo bar', S3B), S3B == "foo bar",
    term_to_string('foo bar', S3), S3 == "'foo bar'"
)  # nv

# "", [] and b"" are one term, so every writer prints them alike.
Test("the empty string writes as the empty list") <- (
    write_to_string("", S5), S5 == "[]",
    write_to_string([], S6), S6 == "[]",
    term_to_string("", S7), S7 == "[]",
    write_text_to_string([], S8), S8 == "[]"
)  # nv
# --8<-- [end:three_writers]

# --8<-- [start:write_family]
# The Clausal TEXT family -- write_text/1, writeln_text/1,
# write_text_to_string/2 -- prints a string as its TEXT and a char list as
# the text it spells.  This is where f-strings go.
Test("the text family prints a string as its text") <- (
    write_text_to_string('a b', W1), W1 == "a b",
    write_text_to_string("a b", W2), W2 == "a b",
    write_text_to_string(['a', 'b'], W3), W3 == "ab",
    write_text('a b'), write_text(" "), writeln_text("a b")
)  # nv

# The Clausal DISPLAY family -- print_term/1 and term_to_string/2 -- gives a
# string the SPELLING write_term(T, [quoted(true), double_quotes(true)])
# gives it, and additionally keeps the ", " after a comma that the ISO
# family drops.  An atom is quoted when it needs it and a string prints in
# double quotes, so the two kinds are distinguishable.  A list of chars IS a
# string, so it prints as one.
Test("print_term/1 and term_to_string/2 are the display family") <- (
    term_to_string('a b', Q1), Q1 == "'a b'",
    term_to_string("a b", Q2), Q2 == "\"a b\"",
    term_to_string(['a', 'b'], Q3), Q3 == "\"ab\"",
    writeq('a b'), nl(), print_term("a b")
)  # nv

# write_canonical/1 spells the '.'/2 structure a string denotes:
#     write_canonical("hi")   prints   '.'(h,'.'(i,[]))
#     write_canonical([1, 2]) prints   '.'(1,'.'(2,[]))
#     write_canonical([])     prints   []
Test("write_canonical/1 spells the cons structure") <- (
    write_canonical("hi"), nl(),
    write_canonical([1, 2]), nl(),
    write_canonical([])
)  # nv
# --8<-- [end:write_family]

# --8<-- [start:write_term]
# write_term/2 is the ISO writer with the switches named.  Both Booleans
# default to FALSE, so an option-free call is exactly write/1: a string
# prints as the LIST of char atoms it is, with no space after the comma.
#
#     write_term("abc", [])                                  prints  [a,b,c]
#     write_term("abc", [quoted(true)])                      prints  [a,b,c]
#     write_term("abc", [quoted(true), double_quotes(true)]) prints  "abc"
#     write_term('a b', [quoted(true)])                      prints  'a b'
#
# write_term(T, []) IS write/1 and write_term(T, [quoted(true)]) IS writeq/1.
# The two-option form gives a string the SPELLING term_to_string/2 gives it
# -- pinned below through term_to_string/2, which additionally keeps the
# display comma spacing -- and then the calls are shown.
Test("write_term option forms") <- (
    term_to_string("abc", T1), T1 == "\"abc\"",
    write_to_string("abc", T2), T2 == "[a,b,c]",
    write_term("abc", [quoted(true), double_quotes(true)]), nl(),
    write_term("abc", []), nl(),
    write_term('a b', [quoted(true)])
)  # nv
# --8<-- [end:write_term]

# Not part of the rendered snippet.  write_canonical/1 has no string form
# (there is no write_canonical_to_string/2), so pinning its exact output text
# means reaching the writer it uses.  That is what makes the three lines
# commented in the snippet above assertions rather than claims.
#
# CAVEAT, and the reason only atom-free terms are pinned here: a ``++``
# escape converts its arguments with ``to_python`` (spec §9.1), which unwraps
# an atom to its spelling -- so an atom inside TERM would reach
# term_canonical as a STRING and print as a char list.  Terms containing
# atoms are pinned by tests/test_writers_atoms_strings.py, which calls the
# builtin and captures stdout instead.
canonical_text(TERM, TEXT) <- (
    TEXT is ++__import__(
        "clausal.terms", fromlist=["term_canonical"]
    ).term_canonical(TERM)
)

Test("write_canonical text: a string") <- (
    canonical_text("hi", C1),
    C1 == "'.'(h,'.'(i,[]))"
)  # nv

Test("write_canonical text: a list") <- (
    canonical_text([1, 2], C2),
    C2 == "'.'(1,'.'(2,[]))"
)  # nv

Test("write_canonical text: the empty list") <- (
    canonical_text([], C3),
    C3 == "[]"
)  # nv
