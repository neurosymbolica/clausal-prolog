-double_quotes(chars)
-private([bar])
-implicit_functors
# Doc snippet fixtures for docs/io.md.
#
# The three ISO writers (spec 2026-09-06-atoms-as-cells-strings §6.7):
# write/1 is the unquoted family, writeq/1 the quoted one, and
# write_canonical/1 prints every list -- a string included -- as the '.'/2
# structure it denotes.  Each Test compares against write_to_string/2 or
# term_to_string/2, which are the same two families in string form, so the
# table in the doc is pinned by an assertion rather than by eyeball.

# --8<-- [start:three_writers]
# write/1: text comes out bare.
Test("write is unquoted") <- (
    write_to_string(foo(bar, "baz"), S),
    S == "foo(bar, baz)"
)  # nv

# writeq/1 (through term_to_string/2, its string form): an atom is quoted
# when it needs quoting, and a string prints in double quotes -- so you can
# tell the two kinds apart in the output.
Test("writeq distinguishes atom from string") <- (
    term_to_string(foo(bar, "baz"), S2),
    S2 == "foo(bar, \"baz\")"
)  # nv

Test("writeq quotes an atom that needs it") <- (
    term_to_string('foo bar', S3),
    S3 == "'foo bar'"
)  # nv

# A list of chars IS a string, so writeq prints it as one.
Test("writeq prints a char list as a string") <- (
    term_to_string(['a', 'b'], S4),
    S4 == "\"ab\""
)  # nv
# --8<-- [end:three_writers]

# --8<-- [start:write_family]
# write/1 and writeln/1 are the UNQUOTED family: text comes out bare, and an
# atom is indistinguishable from the string of the same spelling.
Test("write/1 and writeln/1 are the unquoted family") <- (
    write_to_string('a b', W1), W1 == "a b",
    write_to_string("a b", W2), W2 == "a b",
    write('a b'), write(" "), writeln("a b")
)  # nv

# writeq/1 and print_term/1 are the QUOTED family: the two kinds are
# distinguishable again.
Test("writeq/1 and print_term/1 are the quoted family") <- (
    term_to_string('a b', Q1), Q1 == "'a b'",
    term_to_string("a b", Q2), Q2 == "\"a b\"",
    writeq('a b'), nl(), print_term("a b")
)  # nv

# write_canonical/1 spells the '.'/2 structure a string denotes:
#     write_canonical("hi")   prints   '.'(h,'.'(i,[]))
#     write_canonical([1, 2]) prints   '.'(1,'.'(2,[]))
#     write_canonical([])     prints   []
Test("write_canonical/1 spells the cons structure") <- (
    write_canonical("hi"), nl(),
    write_canonical([1, 2]), nl(),
    write_canonical([])
)  # nv
# --8<-- [end:write_family]

# Not part of the rendered snippet.  write_canonical/1 has no string form
# (there is no write_canonical_to_string/2), so pinning its exact output text
# means reaching the writer it uses.  That is what makes the three lines
# commented in the snippet above assertions rather than claims.
#
# CAVEAT, and the reason only atom-free terms are pinned here: a ``++``
# escape converts its arguments with ``to_python`` (spec §9.1), which unwraps
# an atom to its spelling -- so an atom inside TERM would reach
# term_canonical as a STRING and print as a char list.  Terms containing
# atoms are pinned by tests/test_writers_atoms_strings.py, which calls the
# builtin and captures stdout instead.
canonical_text(TERM, TEXT) <- (
    TEXT is ++__import__(
        "clausal.terms", fromlist=["term_canonical"]
    ).term_canonical(TERM)
)

Test("write_canonical text: a string") <- (
    canonical_text("hi", C1),
    C1 == "'.'(h,'.'(i,[]))"
)  # nv

Test("write_canonical text: a list") <- (
    canonical_text([1, 2], C2),
    C2 == "'.'(1,'.'(2,[]))"
)  # nv

Test("write_canonical text: the empty list") <- (
    canonical_text([], C3),
    C3 == "[]"
)  # nv
