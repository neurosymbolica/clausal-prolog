# Companion tests for docs/scipy_integrate.md signature blocks.
-import_from(scipy_integrate, [Quad, Trapezoid, Simpson, ResultGet])

Test("trapezoid exists") <- (
    Trapezoid([1.0, 2.0, 3.0], R),
    DIFF is ++(abs(float(R) - 4.0)),
    DIFF < 1e-10)

Test("quad exists") <- (
    Quad(++(lambda x: x**2), 0.0, 1.0, R),
    ResultGet(R, "value", V),
    DIFF is ++(abs(float(V) - 1.0/3.0)),
    DIFF < 1e-4)
