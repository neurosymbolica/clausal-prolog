# Companion tests for docs/scipy_linalg.md signature blocks.
-import_from(scipy_linalg, [Solve, Inverse, ResultGet])

Test("solve exists") <- (
    Solve([[1.0, 0.0], [0.0, 1.0]], [1.0, 2.0], X),
    nonvar(X))

Test("inverse exists") <- (
    Inverse([[1.0, 0.0], [0.0, 2.0]], INV),
    nonvar(INV))
