# Fibonacci
#
# fib(0, 0).
# fib(1, 1).
# fib(N, R) :- N > 1, N1 is N-1, N2 is N-2,
#              fib(N1, R1), fib(N2, R2), R is R1+R2.
#
# Field names come from the declaration, not from a clause: this file
# declares none, so fib/2's fields are arg_0 and arg_1.  (The first clause
# used to read fib(N=0, RESULT=0) and that is what named them; a term is
# built positionally as of 2026-09-19 and a keyword argument in a term or a
# head is a load-time error.  Write -private([fib(n, result)]) to name them.)

-double_quotes(atom)

fib(0, 0),
fib(1, 1),
fib(N, RESULT) <- (
    N > 1,
    N1 == N - 1,
    N2 == N - 2,
    fib(N1, FIRST),
    fib(N2, SECOND),
    RESULT == FIRST + SECOND
)


test("fib 0") <- fib(0, 0)  # nv
test("fib 1") <- fib(1, 1)  # nv
test("fib 5") <- (fib(5, RESULT), RESULT == 5)  # nv
test("fib 10") <- (fib(10, RESULT), RESULT == 55)  # nv
