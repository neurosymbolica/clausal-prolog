# Z3 boolean constraint tests — exercises z3.boolean, z3.at_most, z3.at_least,
# z3.exactly.

# ── Basic boolean constraints ───────────────────────────────────────────────

OrSolve(A, B) <- (
    z3.boolean(A | B),
    z3.label([A, B]),
)

Test("boolean or has 3 solutions") <- (count_all(OrSolve(_, _), N), N == 3)

# ── At most / at least / exactly ────────────────────────────────────────────

AtMostTwo(A, B, C) <- (
    z3.boolean(A | B | C),
    z3.at_most([A, B, C], 2),
    z3.label([A, B, C]),
)

Test("at_most 2 of 3") <- (count_all(AtMostTwo(_, _, _), N), N == 6)

ExactlyOne(A, B, C) <- (
    z3.exactly([A, B, C], 1),
    z3.label([A, B, C]),
)

Test("exactly 1 of 3") <- (count_all(ExactlyOne(_, _, _), N), N == 3)

AtLeastTwo(A, B, C) <- (
    z3.at_least([A, B, C], 2),
    z3.label([A, B, C]),
)

Test("at_least 2 of 3") <- (count_all(AtLeastTwo(_, _, _), N), N == 4)
