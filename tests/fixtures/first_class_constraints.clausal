# First-class constraint tests — verifies that constraint tuples can be
# constructed as data (via is/2 unification) and passed to solvers at runtime,
# exercising the deref-before-isinstance fix in all constraint block handlers.

# ── Z3 integer ─────────────────────────────────────────────────────────────

test("z3 first-class single constraint") <- (
    C is (1 <= X <= 10),
    z3.integer(C),
    z3.label([X]),
    X >= 1, X <= 10
)  # nv

test("z3 first-class constraint tuple") <- (
    C is (1 <= X <= 10, X + Y == 7, 1 <= Y <= 10),
    z3.integer(C),
    z3.label([X, Y]),
    V is X + Y, V == 7
)  # nv

test("z3 first-class constraint count") <- (
    C is (1 <= X <= 5),
    z3.integer(C),
    count_all(z3.label([X]), N),
    N == 5
)  # nv

# ── Z3 boolean ─────────────────────────────────────────────────────────────

test("z3 first-class boolean") <- (
    C is (A | B),
    z3.boolean(C),
    count_all(z3.label([A, B]), N),
    N == 3
)  # nv

# ── PySAT ──────────────────────────────────────────────────────────────────

test("pysat first-class single clause") <- (
    C is (X ^ Y),
    pysat.cadical(C),
    pysat.count([X, Y], N),
    N == 2
)  # nv

test("pysat first-class clause tuple") <- (
    C is (X | Y, ~X | Y),
    pysat.cadical(C),
    pysat.solve([X, Y]),
    Y == 1
)  # nv

# ── CLP(Q) ─────────────────────────────────────────────────────────────────

test("clpq first-class single constraint") <- (
    C is (X == 3/4),
    clpq.rational(C),
    X == 3/4
)  # nv

test("clpq first-class constraint tuple") <- (
    C is (X + Y == 1, X - Y == 1/2),
    clpq.rational(C),
    X == 3/4,
    Y == 1/4
)  # nv

# ── CLP(R) ─────────────────────────────────────────────────────────────────

test("clpr first-class single constraint") <- (
    C is (X == 5.0),
    clpr.real(C),
    clpr.label([X])
)  # nv

test("clpr first-class constraint tuple") <- (
    C is (0 <= X <= 10, X * 2 == 6.0),
    clpr.real(C),
    clpr.label([X])
)  # nv

# ── GLOP (LP) ──────────────────────────────────────────────────────────────

test("glop first-class single constraint") <- (
    ortools.lp.var(X, 0.0, 100.0),
    C is (X <= 50),
    ortools.glop(C),
    ortools.lp.check()
)  # nv

test("glop first-class constraint tuple") <- (
    ortools.lp.var(X, 0.0, 100.0),
    ortools.lp.var(Y, 0.0, 100.0),
    C is (X + Y >= 10, X <= 50),
    ortools.glop(C),
    ortools.lp.check()
)  # nv

# ── CP-SAT ─────────────────────────────────────────────────────────────────

test("cpsat first-class comparison constraint") <- (
    ortools.cpsat.in_(X, 1, 10),
    C is (X >= 5),
    ortools.cpsat(C),
    ortools.cpsat.solve([X]),
    X >= 5
)  # nv

test("cpsat first-class arithmetic constraint") <- (
    ortools.cpsat.in_(X, 0, 10),
    ortools.cpsat.in_(Y, 0, 10),
    C is (X + Y == 7),
    ortools.cpsat(C),
    ortools.cpsat.solve([X, Y]),
    V is X + Y, V == 7
)  # nv
