# Z3 mixed theory tests — exercises multiple theories on the same trail,
# solver configuration.
#
# DEFAULT-mode source (no -double_quotes(chars)): "QF_LIA" and "timeout" are
# NAMES, so they are atoms, which is what z3.set_logic/1 and z3.set_option/2
# read (§6.4) and how docs/z3.md writes them.  The test/1 labels are the same
# atoms every other fixture in this directory uses.

# ── Integer + all_different (N-Queens style) ────────────────────────────────

four_queens(Q1, Q2, Q3, Q4) <- (
    z3.integer((
        1 <= Q1 <= 4,
        1 <= Q2 <= 4,
        1 <= Q3 <= 4,
        1 <= Q4 <= 4,
        Q1 - Q2 != 1, Q2 - Q1 != 1,
        Q1 - Q3 != 2, Q3 - Q1 != 2,
        Q1 - Q4 != 3, Q4 - Q1 != 3,
        Q2 - Q3 != 1, Q3 - Q2 != 1,
        Q2 - Q4 != 2, Q4 - Q2 != 2,
        Q3 - Q4 != 1, Q4 - Q3 != 1,
    )),
    z3.all_different([Q1, Q2, Q3, Q4]),
    z3.label([Q1, Q2, Q3, Q4]),
)

test("4-queens has 2 solutions") <- (count_all(four_queens(_, _, _, _), N), N == 2)  # nv
test("4-queens solution 1") <- four_queens(2, 4, 1, 3)  # nv
test("4-queens solution 2") <- four_queens(3, 1, 4, 2)  # nv

# ── Solver configuration ───────────────────────────────────────────────────

test("set logic QF_LIA") <- (
    z3.integer((1 <= X <= 10)),
    z3.set_logic("QF_LIA"),
    z3.check(),
)  # nv

test("set option timeout") <- (
    z3.set_option("timeout", 5000),
    z3.integer((1 <= X <= 10)),
    z3.check(),
)  # nv

# ── Algebraic datatypes ────────────────────────────────────────────────────
# The datatype, constructor and field names are all NAMES, so this whole call
# is written with atoms; it used to raise a raw z3 ArgumentError from source.

test("declare an enum datatype") <- (
    z3.declare_datatype("Color9", [("red9", []), ("green9", []), ("blue9", [])]),
)  # nv
