# Tests for runtime database predicates: assertz/1, asserta/1, retract/1

-dynamic(Color/1)

Color("red"),
Color("green"),
Color("blue"),

# AssertAndQuery/1: adds yellow dynamically then checks it exists
AssertAndQuery(X) <- (
    assertz(Color("yellow")),
    Color(X)
)

# PrependColor/1: adds violet at front then queries first result
PrependColor(X) <- (
    asserta(Color("violet")),
    Color(X)
)

# RetractRed: removes red then checks it's gone
RetractRed <- (
    retract(Color("red")),
    not Color("red")
)


Test("color red") <- Color("red")
Test("color green") <- Color("green")
Test("color blue") <- Color("blue")
Test("three colors") <- (findall(COLOR, Color(COLOR), COLORS), length(COLORS, 3))
