# Tests for runtime database predicates: Assert/1, AssertFirst/1, Retract/1

-dynamic(Color/1)

Color("red"),
Color("green"),
Color("blue"),

# AssertAndQuery/1: adds yellow dynamically then checks it exists
AssertAndQuery(X_) <- (
    Assert(Color("yellow")),
    Color(X_)
)

# PrependColor/1: adds violet at front then queries first result
PrependColor(X_) <- (
    AssertFirst(Color("violet")),
    Color(X_)
)

# RetractRed: removes red then checks it's gone
RetractRed <- (
    Retract(Color("red")),
    not Color("red")
)

