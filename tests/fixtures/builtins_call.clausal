# Tests for Call/N and CallGoal/N higher-order call predicates

# ApplyGoal/2: call a unary goal with an argument
ApplyGoal(GOAL, X) <- Call(GOAL, X)

# ApplyBinary/3: call a binary goal with two arguments
ApplyBinary(GOAL, X, Y) <- Call(GOAL, X, Y)

# Use Call/1 to invoke a goal stored in a variable
RunGoal(GOAL) <- Call(GOAL)

# Example: call member via a goal variable
MemberViaCall(X, LIST) <- (
    GOAL := (X) <- In(X, LIST),
    Call(GOAL, X)
)

# map using Call/3
DoubleViaCall(X, Y) <- (Y := X * 2)

MappedDoubles(LIST, RESULT) <- MapList(
    (X, Y) <- Call(DoubleViaCall, X, Y),
    LIST,
    RESULT,
)


Test("double via call") <- (DoubleViaCall(3, Y), Y == 6)
Test("mapped doubles") <- (MappedDoubles([1, 2, 3], RESULT), RESULT == [2, 4, 6])
Test("apply binary double") <- (ApplyBinary(DoubleViaCall, 5, RESULT), RESULT == 10)
Test("run goal lambda") <- RunGoal((() <- True))
