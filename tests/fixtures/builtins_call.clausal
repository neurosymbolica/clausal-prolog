# Tests for Call/N and CallGoal/N higher-order call predicates

# ApplyGoal/2: call a unary goal with an argument
ApplyGoal(Goal_, X_) <- Call(Goal_, X_)

# ApplyBinary/3: call a binary goal with two arguments
ApplyBinary(Goal_, X_, Y_) <- Call(Goal_, X_, Y_)

# Use Call/1 to invoke a goal stored in a variable
RunGoal(Goal_) <- Call(Goal_)

# Example: call member via a goal variable
MemberViaCall(X_, Xs_) <- (
    G_ := (X_) <- In(X_, Xs_),
    Call(G_, X_)
)

# map using Call/3
DoubleViaCall(X_, Y_) <- (Y_ := X_ * 2)

MappedDoubles(Xs_, Ys_) <- MapList(
    (X_, Y_) <- Call(DoubleViaCall, X_, Y_),
    Xs_,
    Ys_,
)


Test("double via call") <- (DoubleViaCall(3, Y_), Y_ == 6)
Test("mapped doubles") <- (MappedDoubles([1, 2, 3], Ys_), Ys_ == [2, 4, 6])
Test("apply binary double") <- (ApplyBinary(DoubleViaCall, 5, R_), R_ == 10)
Test("run goal lambda") <- RunGoal((() <- True))
