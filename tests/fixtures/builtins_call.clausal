# Tests for call/N and call_goal/N higher-order call predicates

# apply_goal/2: call a unary goal with an argument
apply_goal(GOAL, X) <- call(GOAL, X)

# apply_binary/3: call a binary goal with two arguments
apply_binary(GOAL, X, Y) <- call(GOAL, X, Y)

# Use call/1 to invoke a goal stored in a variable
run_goal(GOAL) <- call(GOAL)

# Example: call member via a goal variable
member_via_call(X, LIST) <- (
    GOAL is ((X) <- (X in LIST)),
    call(GOAL, X)
)

# map using call/3
double_via_call(X, Y) <- (Y == X * 2)

mapped_doubles(LIST, RESULT) <- maplist(
    (X, Y) <- call(double_via_call, X, Y),
    LIST,
    RESULT,
)


Test("unmapped double via call") <- (
    double_via_call(3, Y),
    Y == 6
)  # v
Test("mapped doubles") <- (
    mapped_doubles([1, 2, 3], RESULT),
    RESULT == [2, 4, 6]
)  # v
Test("apply binary double") <- (
    apply_binary(double_via_call, 5, RESULT),
    RESULT == 10
)  # v
Test("run goal lambda") <- run_goal(() <- True)  # v
