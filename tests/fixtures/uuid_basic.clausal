-import_from(py.uuid, [UUIDv4, UUIDv1, UUIDv3, UUIDv5, UUIDStr, UUIDHex, UUIDUrn, UUIDBytes, UUIDInt, UUIDVersion, UUIDFields, IsUUID])

# ── Generation ──────────────────────────────────────────────────────

Test("uuid4 generates") <- (
    UUIDv4(U),
    IsUUID(U)
)

Test("uuid1 generates") <- (
    UUIDv1(U),
    IsUUID(U)
)

Test("uuid3 deterministic") <- (
    UUIDv3("dns", "example.com", U1),
    UUIDv3("dns", "example.com", U2),
    UUIDStr(U1, S1),
    UUIDStr(U2, S2),
    S1 == S2
)

Test("uuid5 deterministic") <- (
    UUIDv5("url", "https://example.com", U1),
    UUIDv5("url", "https://example.com", U2),
    UUIDStr(U1, S1),
    UUIDStr(U2, S2),
    S1 == S2
)

# ── Conversion roundtrips ──────────────────────────────────────────

Test("uuid str roundtrip") <- (
    UUIDv4(U),
    UUIDStr(U, S),
    UUIDStr(U2, S),
    UUIDStr(U2, S2),
    S == S2
)

Test("uuid hex roundtrip") <- (
    UUIDv4(U),
    UUIDHex(U, HEX),
    UUIDHex(U2, HEX),
    UUIDHex(U2, HEX2),
    HEX == HEX2
)

Test("uuid int roundtrip") <- (
    UUIDv4(U),
    UUIDInt(U, N),
    UUIDInt(U2, N),
    UUIDInt(U2, N2),
    N == N2
)

# ── Inspection ─────────────────────────────────────────────────────

Test("uuid4 version is 4") <- (
    UUIDv4(U),
    UUIDVersion(U, 4)
)

Test("uuid3 version is 3") <- (
    UUIDv3("dns", "test", U),
    UUIDVersion(U, 3)
)

Test("uuid5 version is 5") <- (
    UUIDv5("dns", "test", U),
    UUIDVersion(U, 5)
)

Test("uuid fields decompose") <- (
    UUIDv4(U),
    UUIDFields(U, TIME_LOW, TIME_MID, TIME_HI, CLOCK_SEQ_HI, CLOCK_SEQ_LOW, NODE),
    IsUUID(U)
)
