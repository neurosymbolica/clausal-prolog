-double_quotes(chars)
-import_from(py.uuid, [uuid_v4, uuid_v1, uuid_v3, uuid_v5, uuid_str, uuid_hex, uuid_urn, uuid_bytes, uuid_int, uuid_version, uuid_fields, is_uuid])

# ── Generation ──────────────────────────────────────────────────────

Test("uuid4 generates") <- (
    uuid_v4(U),
    is_uuid(U)
)  # nv

Test("uuid1 generates") <- (
    uuid_v1(U),
    is_uuid(U)
)  # nv

Test("uuid3 deterministic") <- (
    uuid_v3("dns", "example.com", U1),
    uuid_v3("dns", "example.com", U2),
    uuid_str(U1, S1),
    uuid_str(U2, S2),
    S1 == S2
)  # nv

Test("uuid5 deterministic") <- (
    uuid_v5("url", "https://example.com", U1),
    uuid_v5("url", "https://example.com", U2),
    uuid_str(U1, S1),
    uuid_str(U2, S2),
    S1 == S2
)  # nv

# ── Conversion roundtrips ──────────────────────────────────────────

Test("uuid str roundtrip") <- (
    uuid_v4(U),
    uuid_str(U, S),
    uuid_str(U2, S),
    uuid_str(U2, S2),
    S == S2
)  # nv

Test("uuid hex roundtrip") <- (
    uuid_v4(U),
    uuid_hex(U, HEX),
    uuid_hex(U2, HEX),
    uuid_hex(U2, HEX2),
    HEX == HEX2
)  # nv

Test("uuid int roundtrip") <- (
    uuid_v4(U),
    uuid_int(U, N),
    uuid_int(U2, N),
    uuid_int(U2, N2),
    N == N2
)  # nv

# ── Inspection ─────────────────────────────────────────────────────

Test("uuid4 version is 4") <- (
    uuid_v4(U),
    uuid_version(U, 4)
)  # nv

Test("uuid3 version is 3") <- (
    uuid_v3("dns", "test", U),
    uuid_version(U, 3)
)  # nv

Test("uuid5 version is 5") <- (
    uuid_v5("dns", "test", U),
    uuid_version(U, 5)
)  # nv

Test("uuid fields decompose") <- (
    uuid_v4(U),
    uuid_fields(U, TIME_LOW_UNUSED, TIME_MID_UNUSED, TIME_HI_UNUSED, CLOCK_SEQ_HI_UNUSED, CLOCK_SEQ_LOW_UNUSED, NODE_UNUSED),
    is_uuid(U)
)  # nv
