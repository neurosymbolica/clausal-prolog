-import_from(uuid, [UUIDv4, UUIDv1, UUIDv3, UUIDv5, UuidStr, UuidHex, UuidUrn, UuidBytes, UuidInt, UuidVersion, UuidFields, IsUuid])

# ── Generation ──────────────────────────────────────────────────────

Test("uuid4 generates") <- (
    UUIDv4(U_) and
    IsUuid(U_)
)

Test("uuid1 generates") <- (
    UUIDv1(U_) and
    IsUuid(U_)
)

Test("uuid3 deterministic") <- (
    UUIDv3("dns", "example.com", U1_) and
    UUIDv3("dns", "example.com", U2_) and
    UuidStr(U1_, S1_) and
    UuidStr(U2_, S2_) and
    S1_ == S2_
)

Test("uuid5 deterministic") <- (
    UUIDv5("url", "https://example.com", U1_) and
    UUIDv5("url", "https://example.com", U2_) and
    UuidStr(U1_, S1_) and
    UuidStr(U2_, S2_) and
    S1_ == S2_
)

# ── Conversion roundtrips ──────────────────────────────────────────

Test("uuid str roundtrip") <- (
    UUIDv4(U_) and
    UuidStr(U_, S_) and
    UuidStr(U2_, S_) and
    UuidStr(U2_, S2_) and
    S_ == S2_
)

Test("uuid hex roundtrip") <- (
    UUIDv4(U_) and
    UuidHex(U_, H_) and
    UuidHex(U2_, H_) and
    UuidHex(U2_, H2_) and
    H_ == H2_
)

Test("uuid int roundtrip") <- (
    UUIDv4(U_) and
    UuidInt(U_, N_) and
    UuidInt(U2_, N_) and
    UuidInt(U2_, N2_) and
    N_ == N2_
)

# ── Inspection ─────────────────────────────────────────────────────

Test("uuid4 version is 4") <- (
    UUIDv4(U_) and
    UuidVersion(U_, 4)
)

Test("uuid3 version is 3") <- (
    UUIDv3("dns", "test", U_) and
    UuidVersion(U_, 3)
)

Test("uuid5 version is 5") <- (
    UUIDv5("dns", "test", U_) and
    UuidVersion(U_, 5)
)

Test("uuid fields decompose") <- (
    UUIDv4(U_) and
    UuidFields(U_, TL_, TM_, TH_, CSH_, CSL_, Node_) and
    IsUuid(U_)
)
