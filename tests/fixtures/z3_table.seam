# Z3 table constraint tests — exercises z3.table.

# ── Table constraint ────────────────────────────────────────────────────────
-double_quotes(atom)

table_solve(X, Y) <- (
    z3.integer((
        0 <= X <= 10,
        0 <= Y <= 10,
    )),
    z3.table([X, Y], [[1, 2], [3, 4], [5, 6]]),
    z3.label([X, Y]),
)

test("table 3 solutions") <- (count_all(table_solve(_, _), N), N == 3)  # nv
test("table first row") <- table_solve(1, 2)  # nv
test("table second row") <- table_solve(3, 4)  # nv
test("table third row") <- table_solve(5, 6)  # nv
test("table excludes others") <- (not(table_solve(2, 3)))  # nv
