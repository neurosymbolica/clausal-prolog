-table(Path/2)

Edge(1, 2),
Edge(2, 3),
Edge(3, 1),

Path(X, Y) <- Edge(X, Y)
Path(X, Y) <- (
    Edge(X, Z),
    Path(Z, Y)
)

# CheckPath/2: uses ITE with a tabled predicate as condition
CheckPath(X, RESULT) <- if_(Path(1, X), RESULT is "reachable", RESULT is "unreachable")


Test("path 1 to 2") <- Path(1, 2)  # nv
Test("path 1 to 3") <- Path(1, 3)  # nv
Test("check reachable 2") <- (CheckPath(2, RESULT), RESULT == "reachable")  # nv
Test("check unreachable 99") <- (CheckPath(99, RESULT), RESULT == "unreachable")  # nv
