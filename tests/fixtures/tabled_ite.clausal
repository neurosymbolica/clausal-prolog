-table(Path/2)

Edge(1, 2),
Edge(2, 3),
Edge(3, 1),

Path(X_, Y_) <- Edge(X_, Y_)
Path(X_, Y_) <- (
    Edge(X_, Z_),
    Path(Z_, Y_)
)

# CheckPath/2: uses ITE with a tabled predicate as condition
CheckPath(X_, R_) <- If(Path(1, X_), R_ is "reachable", R_ is "unreachable")


Test("path 1 to 2") <- Path(1, 2)
Test("path 1 to 3") <- Path(1, 3)
Test("check reachable 2") <- (CheckPath(2, R_), R_ == "reachable")
Test("check unreachable 99") <- (CheckPath(99, R_), R_ == "unreachable")
