-table(path/2)

edge(1, 2),
edge(2, 3),
edge(3, 1),

path(X, Y) <- edge(X, Y)
path(X, Y) <- (
    edge(X, Z),
    path(Z, Y)
)

# check_path/2: uses ITE with a tabled predicate as condition
check_path(X, RESULT) <- if_(path(1, X), RESULT is "reachable", RESULT is "unreachable")


test("path 1 to 2") <- path(1, 2)  # nv
test("path 1 to 3") <- path(1, 3)  # nv
test("check reachable 2") <- (check_path(2, RESULT), RESULT == "reachable")  # nv
test("check unreachable 99") <- (check_path(99, RESULT), RESULT == "unreachable")  # nv
