# Tests for type-checking predicates
#
# Note: IsFloat ends with relevant Python name; it can be called as IsFloat in .clausal
# float_/1 is now registered as IsFloat/1

# IsVar/1, IsBound/1
CheckVar(X) <- IsVar(X)
CheckNonvar(X) <- IsBound(X)

# IsStr/1, IsNumber/1, IsInt/1
CheckAtom(X) <- IsStr(X)
CheckNumber(X) <- IsNumber(X)
CheckInteger(X) <- IsInt(X)
CheckString(X) <- IsStr(X)

# IsCompound/1, IsCallable/1, IsList/1, IsGround/1
CheckCompound(X) <- IsCompound(X)
CheckCallable(X) <- IsCallable(X)
CheckList(X) <- IsList(X)
CheckGround(X) <- IsGround(X)

# Classify/2: produce a type tag for a bound value
Classify(X, "integer") <- IsInt(X)
Classify(X, "atom") <- IsStr(X)
Classify(X, "list") <- IsList(X)
Classify(X, "compound") <- IsCompound(X)


Test("is var") <- CheckVar(X)
Test("is bound") <- CheckNonvar(42)
Test("is atom") <- CheckAtom("hello")
Test("is number") <- CheckNumber(42)
Test("is integer") <- CheckInteger(5)
Test("is list") <- CheckList([1, 2, 3])
Test("is ground") <- CheckGround(42)
Test("classify integer") <- Classify(42, "integer")
Test("classify atom") <- Classify("hi", "atom")
Test("classify list") <- Classify([1, 2], "list")
