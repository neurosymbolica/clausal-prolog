# CLP(Q) doc examples — each predicate matches a code block in docs/clpq.md.

# -allow_singletons: LP/3's head functor "LP" is an ALLCAPS predicate name
# (Call.func in head-defining position), not a variable — but the classifier
# can't distinguish functor position from argument position, so it counts
# LP as a singleton variable occurrence. Renaming it would rename the
# predicate itself (tests/test_clpq.py looks it up by the literal name "LP").
-allow_singletons

# --- Two-variable linear system ---
two_var(X, Y) <- (
    in_q([X, Y], 0, 10),
    X + Y == 10,
    X == 3
)

# --- Three equations in three unknowns ---
three_var(X, Y, Z) <- (
    in_q([X, Y, Z], -100, 100),
    X + Y + Z == 6,
    X - Y == 2,
    Y - Z == 1
)

# --- Rational coefficients ---
rational_coeffs(X, Y) <- (
    in_q([X, Y], -10, 10),
    1/2 * X + 1/3 * Y == 1,
    Y == 0
)

# --- Feasibility ---
feasible(X, Y) <- (
    in_q([X, Y], 0, 100),
    X + Y <= 8,
    X <= 5,
    Y <= 6
)

# --- Infeasibility ---
infeasible(X) <- (
    in_q(X, 0, 10),
    X >= 6,
    X <= 4
)

# --- LP maximize ---
LP(X, Y, OBJ) <- (
    in_q([X, Y], 0, 1000),
    2*X + Y <= 16,
    X + 2*Y <= 11,
    X + 3*Y <= 15,
    maximize(30*X + 50*Y, OBJ)
)

# --- scheduling minimize ---
scheduling(X, Y, COST) <- (
    in_q([X, Y], 0, 100),
    X + Y >= 10,
    2*X + Y <= 30,
    X + 3*Y <= 40,
    minimize(5*X + 3*Y, COST)
)

# --- sup/inf without binding ---
sup_inf(X, LO, HI) <- (
    in_q(X, 0, 100),
    X <= 10,
    X >= 3,
    inf(X, LO),
    sup(X, HI)
)

# --- int_minimize integer optimization ---
bb_simple(X, COST) <- (
    in_q(X, 0, 10),
    X >= 3/2,
    int_minimize([X], X, COST)
)

# --- int_minimize multi-variable ---
bb_sicstus(X, Y, Z, COST) <- (
    in_q([X, Y, Z], 0, 100),
    X >= Y + Z,
    Y >= 2,
    Z >= 2,
    int_minimize([X, Y, Z], X, COST)
)
