# Z3 bitvector constraint tests — exercises z3.bitvector, z3.extract,
# z3.concat, z3.zero_extend, z3.sign_extend.

# ── Basic BV constraints ────────────────────────────────────────────────────

small_bv(X) <- (
    z3.bitvector(4, X < 3),
    z3.label([X]),
)

test("bv4 < 3 has 3 solutions") <- (count_all(small_bv(_), N), N == 3)  # nv

# ── Bitwise AND ─────────────────────────────────────────────────────────────

mask(X, R) <- (
    z3.bitvector(8, (
        X == 171,
        X & 240 == R,
    )),
    z3.label([R]),
)

test("bv mask 0xAB & 0xF0") <- (mask(_, R), R == 160)  # nv

# ── Arithmetic wraparound ───────────────────────────────────────────────────

wrap(R) <- (
    z3.bitvector(8, (
        X == 200,
        Y == 100,
        X + Y == R,
    )),
    z3.label([R]),
)

test("bv8 wraparound 200+100") <- (wrap(R), R == 44)  # nv

# ── Extract ─────────────────────────────────────────────────────────────────

upper_nibble(R) <- (
    z3.bitvector(8, X == 171),
    z3.extract(7, 4, X, R),
    z3.label([R]),
)

test("bv extract upper nibble") <- (upper_nibble(R), R == 10)  # nv

# ── Concat ──────────────────────────────────────────────────────────────────

concat_nibbles(R) <- (
    z3.bitvector(4, (
        X == 10,
        Y == 11,
    )),
    z3.concat(X, Y, R),
    z3.label([R]),
)

test("bv concat 0xA 0xB") <- (concat_nibbles(R), R == 171)  # nv

# ── Zero extend ─────────────────────────────────────────────────────────────

z_ext(R) <- (
    z3.bitvector(4, X == 5),
    z3.zero_extend(X, 4, R),
    z3.label([R]),
)

test("bv zero extend 4->8") <- (z_ext(R), R == 5)  # nv

# ── Sign extend ─────────────────────────────────────────────────────────────

s_ext(R) <- (
    z3.bitvector(4, X == 15),
    z3.sign_extend(X, 4, R),
    z3.label([R]),
)

test("bv sign extend -1 to 8bit") <- (s_ext(R), R == 255)  # nv
