# Term expansion: a variable matched INSIDE a quoted pattern must flow into
# the quoted output and register as a real, queryable fact.  Gap 2 of
# todo/term-expansion-compile-time-predicate-synthesis.md: this used to load
# with marker/1 existing but EMPTY.
-module(expansion_nested_var, [ marker(K), key(X),
                                term_expansion(A, B, S, T), stays, income ])

term_expansion(q(key(KEY)), [q(marker(KEY))], STATE, STATE) <- True

key(stays),
key(income),
