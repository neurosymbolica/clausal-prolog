# Fixture for the secondary-dispatch dropped-TRO-tail-call regression
# (todo/call-site-specialisation-protocol-questions.md Q2).
#
# Shape forces Phase 9c hierarchical dispatch: 6 clauses with head constants
# at pos 0 (3 distinct — best single index) and pos 1 (2 distinct), joint
# distinct 6 > 3 * min_gain(1.5), coverage 6/8 = 0.75 < _JOINT_COVERAGE
# THRESHOLD(0.8). OUT is a non-indexable list so the result column cannot
# become the best single index. The tail-recursive clause decrements N (a
# never-indexed position, guarded by evaluated ==) and passes K/J through, so
# an unbound-K call routes to the SIGNAL-mode fallback and the signalled tail
# call must be re-dispatched by the secondary dispatch.
-double_quotes(atom)
-module(secondary_dispatch_tro, [hop(K, J, N, OUT), hop2(K, J, N, OUT)])

hop("a", 1, N, OUT) <- (N == 0, OUT is ["a1"])
hop("b", 1, N, OUT) <- (N == 0, OUT is ["b1"])
hop("c", 1, N, OUT) <- (N == 0, OUT is ["c1"])
hop("a", 2, N, OUT) <- (N == 0, OUT is ["a2"])
hop("b", 2, N, OUT) <- (N == 0, OUT is ["b2"])
hop("c", 2, N, OUT) <- (N == 0, OUT is ["c2"])
hop(K, J, N, OUT) <- (N > 0, M is N - 1, hop(K, J, M, OUT))
hop(K_UNUSED, J_UNUSED, N, OUT) <- (N < 0, OUT is ["neg"])

# hop2: same hierarchical shape, but the recursive clause BINDS the level-0
# key — the re-dispatched tail call must land in a level-0 bucket, not the
# fallback (the other branch of the secondary TRO loop).
hop2("a", 1, N, OUT) <- (N == 0, OUT is ["a1"])
hop2("b", 1, N, OUT) <- (N == 0, OUT is ["b1"])
hop2("c", 1, N, OUT) <- (N == 0, OUT is ["c1"])
hop2("a", 2, N, OUT) <- (N == 0, OUT is ["a2"])
hop2("b", 2, N, OUT) <- (N == 0, OUT is ["b2"])
hop2("c", 2, N, OUT) <- (N == 0, OUT is ["c2"])
hop2(K_UNUSED, J_UNUSED, N, OUT) <- (N > 0, M is N - 1, hop2("a", 1, M, OUT))
hop2(K_UNUSED, J_UNUSED, N, OUT) <- (N < 0, OUT is ["neg"])
