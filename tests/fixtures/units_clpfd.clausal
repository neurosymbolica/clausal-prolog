-import_from(py.units, [
    Meter, Kilogram, Second,
    Newton, Joule, Watt,
    Volt, Ampere, Ohm,
    IsForce, IsEnergy, IsPower, IsArea, IsResistance, IsVelocity,
    IsDimensionless,
    ValueOf])

# Units + CLP(FD): label integer variables, then wrap with unit predicates
# and verify dimensional correctness.
#
# Pattern: InDomain -> constraints -> Label -> unit predicates -> checks

# Find an integer force value in 1..20 that equals 12,
# then verify it wraps to a force dimension.
Test("clpfd label as newton") <- (
    InDomain([F_INT], 1, 20),
    Label([F_INT]),
    F_INT == 12,
    Newton(F_INT, F),
    IsForce(F),
    ValueOf(F, 12)
)

# Find two distinct integers whose product is 12,
# treat them as side lengths in metres, verify area.
Test("clpfd rectangle area") <- (
    InDomain([W, H], 1, 6),
    AllDifferent([W, H]),
    Label([W, H]),
    PROD := W * H,
    PROD == 12,
    Meter(W, W_M),
    Meter(H, H_M),
    AREA := W_M * H_M,
    IsArea(AREA)
)

# Find integer voltage and current (1..20) with V/I = 4,
# wrap as Volt/Ampere, compute resistance, verify IsResistance.
Test("clpfd ohms law integer") <- (
    InDomain([V_INT, I_INT], 1, 20),
    Label([V_INT, I_INT]),
    R_INT := V_INT // I_INT,
    R_INT == 4,
    V_INT == R_INT * I_INT,
    Volt(V_INT, VOLTAGE),
    Ampere(I_INT, CURRENT),
    R := VOLTAGE / CURRENT,
    IsResistance(R)
)

# Find integer mass (1..5 kg) and speed (1..5 m/s) where mass * speed^2 == 50,
# compute kinetic energy, verify IsEnergy.
# m=2, v=5: 2*KE = 2 * 5^2 = 50 -> KE = 25 J
Test("clpfd kinetic energy") <- (
    InDomain([M_INT, V_INT], 1, 5),
    Label([M_INT, V_INT]),
    TWICE_KE := M_INT * V_INT ** 2,
    TWICE_KE == 50,
    Kilogram(M_INT, MASS),
    Meter(V_INT, D),
    Second(1, T),
    SPD := D / T,
    KE := MASS * SPD ** 2,
    HALF := KE / 2,
    IsEnergy(HALF),
    ValueOf(HALF, 25)
)

# Generate integer power values, filter those divisible by 3,
# wrap as Watt and verify IsPower.
Test("clpfd power multiple of 3") <- (
    InDomain([P_INT], 1, 30),
    Label([P_INT]),
    MOD := P_INT % 3,
    MOD == 0,
    Watt(P_INT, P),
    IsPower(P)
)

# Force F = m * a: find integer mass 1..5 and acceleration 1..5 giving F = 20 N.
# Then wrap each as a Dimensioned and recompute to verify.
Test("clpfd force equals mass times accel") <- (
    InDomain([M_INT, A_INT], 1, 5),
    Label([M_INT, A_INT]),
    F_INT := M_INT * A_INT,
    F_INT == 20,
    Newton(F_INT, F),
    IsForce(F),
    ValueOf(F, 20)
)

# Power = V^2 / R: find integers V in 1..12, R in 1..6 where V^2 / R = 12.
# V=6, R=3: 36/3 = 12.
Test("clpfd power from voltage squared") <- (
    InDomain([V_INT, R_INT], 1, 12),
    Label([V_INT, R_INT]),
    VSQUARED := V_INT ** 2,
    RATIO := VSQUARED // R_INT,
    RATIO == 12,
    VSQUARED == RATIO * R_INT,
    Volt(V_INT, VOLTAGE),
    Ohm(R_INT, RESIST),
    P := VOLTAGE * VOLTAGE / RESIST,
    IsPower(P)
)

# Dimensionless ratio: find integer numerator and denominator (1..10) where
# the ratio num/den equals 2, then verify it is dimensionless.
# Wrap as Meter/Meter so units cancel.
Test("clpfd dimensionless ratio") <- (
    InDomain([NUM, DEN], 1, 10),
    Label([NUM, DEN]),
    PROD := NUM // DEN,
    PROD == 2,
    NUM == PROD * DEN,
    Meter(NUM, D_NUM),
    Meter(DEN, D_DEN),
    RATIO := D_NUM / D_DEN,
    IsDimensionless(RATIO)
)

# Unit-mismatch guard via constraint: label F and T from the same domain,
# verify that wrapping as Newton and assigning to a Second-constrained slot
# fails (no solution), confirming constraint rejection is CLP(FD)-compatible.
Test("clpfd constraint rejects wrong unit") <- (
    not (
        InDomain([F_INT], 1, 5),
        Label([F_INT]),
        Newton(F_INT, F),
        S(Second),
        S is F
    )
)
