-implicit_atoms
-module(shallow_pred, [Color(Name, Hue)])
-shallow([Color/2])

Color("sky", "blue"),
Color("grass", "green"),
Color("sun", "yellow"),

Test("color sky") <- Color("sky", "blue")  # nv
Test("color grass") <- Color("grass", "green")  # nv
Test("color sun") <- Color("sun", "yellow")  # nv
