-double_quotes(chars)

# Edge facts
Edge(1, 2),
Edge(2, 3),
Edge(1, 3),

# Reachability: Reach(X, Y) if there is a path from X to Y
Reach(X, Y) <- Edge(X, Y)
Reach(X, Y) <- (
    Edge(X, Z),
    Reach(Z, Y)
)


test("edge 1 2") <- Edge(1, 2)  # nv
test("edge 2 3") <- Edge(2, 3)  # nv
test("reach 1 2") <- Reach(1, 2)  # nv
test("reach 1 3") <- Reach(1, 3)  # nv
test("reach 2 3") <- Reach(2, 3)  # nv
