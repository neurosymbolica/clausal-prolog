-private([hello, th])
-translations(th, {
    append(LIST, ELEMENT, NEWLIST): ต่อท้าย(รายการ, สมาชิก, รายการใหม่),
    Member(ELEMENT, LIST): สมาชิกของ(สมาชิก, รายการ),
    Greeting(NAME, MESSAGE): ทักทาย(ชื่อ, ข้อความ),
})

-translations(th, {
    nil: ว่าง,
    hello: สวัสดี,
})

Greeting(hello, "world"),
Greeting("Mike", "hi"),

Test("translate produces string") <- (
    translate(th, Greeting(hello, "world"), STRING),
    is_str(STRING)
)  # nv

Test("translate produces nonempty") <- (
    translate(th, Greeting(hello, "world"), STRING),
    length(STRING, LENGTH),
    LENGTH > 0
)  # nv
