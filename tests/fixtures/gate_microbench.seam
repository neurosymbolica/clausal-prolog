# Microbench fixture for P3-2 Task 4 fix round 1 (reviewer Important-2):
# a NON-tabled predicate that recurses over a cons-cell chain carried in
# its own INDEXED (position-0) argument.  pad1/pad2/pad3/nil/cons(_H, T)
# give depth/2 five distinct position-0 keys, comfortably crossing
# _INDEX_THRESHOLD (4), so dispatch genuinely indexes on position 0 and
# _runtime_arg_key (and the deep-groundness gate) runs once per
# recursive step -- exactly the shape the reviewer's Important-2 finding
# named.
-allow_singletons
-module(gate_microbench, [
    cons(_H, T),
    nil,
    pad1,
    pad2,
    pad3,
    depth(S, N),
])

depth(pad1, 0),
depth(pad2, 0),
depth(pad3, 0),
depth(nil, 0),
depth(cons(_H, T), N) <- (
    depth(T, N1),
    N == N1 + 1
)
