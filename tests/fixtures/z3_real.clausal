# Z3 real constraint tests — exercises z3.real, z3.minimize, z3.maximize,
# z3.entailed, z3.disentailed.

# ── Basic real constraints ──────────────────────────────────────────────────

Bounded(X) <- (
    z3.real((
        0 <= X <= 10,
    )),
    z3.label([X]),
)

test("real bounded sat") <- Bounded(_)  # nv

# ── Minimize ────────────────────────────────────────────────────────────────

test("real minimize") <- (
    z3.real((
        0 <= X <= 10,
        0 <= Y <= 10,
        2 * X + 3 * Y >= 6,
    )),
    z3.minimize(2 * X + 3 * Y, COST),
    COST == 6,
)  # nv

# ── Maximize ────────────────────────────────────────────────────────────────

test("real maximize") <- (
    z3.real((
        0 <= X <= 10,
        0 <= Y <= 10,
    )),
    z3.maximize(X + Y, COST),
    COST == 20,
)  # nv

# ── Entailment ──────────────────────────────────────────────────────────────

test("real entailed") <- (
    z3.integer((5 <= X <= 10)),
    z3.entailed(X >= 5),
)  # nv

test("real not entailed") <- (
    z3.integer((1 <= X <= 10)),
    not(z3.entailed(X >= 5)),
)  # nv

test("real disentailed") <- (
    z3.integer((5 <= X <= 10)),
    z3.disentailed(X < 5),
)  # nv
