# Kit module that publicly exports a functor `flip/2`.  Mirrors the real
# kit.query_combinators shape: the functor is declared in BOTH -private and
# -module, and defined via facts.  Importers get this module-local class.
-private([flip(EDIT, DECISION), a, b, p, q, x, y])
-module(functor_reexport_kit, [
    combine(X, Y),
    flip(EDIT, DECISION)
])

flip(a, x),
flip(b, y),
combine(p, q),
