-import_from(sklearn, [Est, Dataset, Fitted, Split, LoadDataset, Fit, Predict,
                       Score, Transform, Algorithm, Learned, Param, MakeEst,
                       FitTransform, PredictProba, DecisionFunction])

# ── Algorithm enumeration ────────────────────────────────────────────

Test("algorithm random_forest is classifier") <- (
    Algorithm("random_forest", "classifier")
)  # nv

Test("algorithm pca is transformer") <- (
    Algorithm("pca", "transformer")
)  # nv

Test("algorithm kmeans is clusterer") <- (
    Algorithm("kmeans", "clusterer")
)  # nv

# ── Dataset loading ──────────────────────────────────────────────────

Test("load iris dataset") <- (
    LoadDataset("iris", DATASET),
    DATASET is ("Dataset", X, Y)
)  # nv

# ── Fit and predict (classification) ────────────────────────────────

Test("fit and predict random forest on iris") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("random_forest", {"n_estimators": 10}), DATASET, FITTED),
    FITTED is ("Fitted", INNER, HANDLE),
    DATASET is ("Dataset", X, Y),
    Predict(FITTED, X, PREDS)
)  # nv

# ── Fit and score ────────────────────────────────────────────────────

Test("fit and score logistic regression on iris") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("logistic_regression", {"max_iter": 200}), DATASET, FITTED),
    Score(FITTED, DATASET, SCORE),
    SCORE > 0.5
)  # nv

# ── Transform (PCA) ─────────────────────────────────────────────────

Test("fit and transform pca") <- (
    LoadDataset("iris", DATASET),
    DATASET is ("Dataset", X, Y),
    Fit(Est("pca", {"n_components": 2}), ("Dataset", X, None), FITTED),
    Transform(FITTED, X, TRANSFORMED)
)  # nv

# ── FitTransform ─────────────────────────────────────────────────────

Test("fit_transform standard scaler") <- (
    LoadDataset("iris", DATASET),
    DATASET is ("Dataset", X, Y),
    FitTransform(Est("standard_scaler", {}), ("Dataset", X, None), TRANSFORMED, FITTED),
    FITTED is ("Fitted", INNER, HANDLE)
)  # nv

# ── Fit/4 (raw X, Y) ────────────────────────────────────────────────

Test("fit with raw X and Y") <- (
    LoadDataset("iris", DATASET),
    DATASET is ("Dataset", X, Y),
    Fit(Est("random_forest", {"n_estimators": 10}), X, Y, FITTED),
    Score(FITTED, DATASET, SCORE),
    SCORE > 0.5
)  # nv

# ── Learned attributes ──────────────────────────────────────────────

Test("learned feature importances") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("random_forest", {"n_estimators": 10}), DATASET, FITTED),
    Learned(FITTED, "feature_importances", IMPORTANCES)
)  # nv

Test("learned n_features_in") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("random_forest", {"n_estimators": 10}), DATASET, FITTED),
    Learned(FITTED, "n_features_in", N),
    N == 4
)  # nv

# ── Param ────────────────────────────────────────────────────────────

Test("param from est term") <- (
    Param(Est("svc", {"C": 2.0, "kernel": "rbf"}), "C", VAL),
    VAL == 2.0
)  # nv

# ── MakeEst ──────────────────────────────────────────────────────────

Test("make est fills defaults") <- (
    MakeEst("random_forest", {"n_estimators": 200}, EST_OBJ),
    EST_OBJ is ("Est", ALG, PARAMS),
    ALG == "random_forest"
)  # nv

# ── PredictProba ─────────────────────────────────────────────────────

Test("predict proba on iris") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("random_forest", {"n_estimators": 10}), DATASET, FITTED),
    DATASET is ("Dataset", X, Y),
    PredictProba(FITTED, X, PROBA)
)  # nv

# ── SVC with decision_function ───────────────────────────────────────

Test("svc decision function on iris") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("svc", {"kernel": "linear"}), DATASET, FITTED),
    DATASET is ("Dataset", X, Y),
    DecisionFunction(FITTED, X, SCORES)
)  # nv
