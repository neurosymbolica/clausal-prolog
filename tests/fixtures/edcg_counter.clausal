# EDCG counter example: multiple accumulators, passed arguments
#
# Demonstrates: counter accumulator, list accumulator, passed scale factor

-module(edcg_counter, [run_scaled(INPUT_LIST, SCALE_FACTOR, COUNT, OUTPUT_ITEMS)])

-edcg_acc(counter, _x, _in, _out, {_out == _in + _x})
-edcg_acc(items, _item, _in, _out, {_out is [_item, *_in]})
-edcg_pass(scale)

-edcg_pred(scaled_inc, 0, [counter, scale])
-edcg_pred(collect_and_count, 1, [counter, items, scale])
-edcg_pred(process_list, 1, [counter, items, scale])

# Increment counter by the scale factor
scaled_inc >> (scale / SCALE, [SCALE] // counter)

# Collect an item and increment the counter
collect_and_count(X) >> (scaled_inc, [X] // items)

# Process a list of items
process_list([]) >> ([])
process_list([X, *REST]) >> (collect_and_count(X), process_list(REST))

# Entry point: wraps EDCG call with initial values
run_scaled(INPUT_LIST, SCALE_FACTOR, COUNT, OUTPUT_ITEMS) <- (
    process_list(INPUT_LIST, _edcg_counter_in=0, _edcg_counter_out=COUNT,
                 _edcg_items_in=[], _edcg_items_out=OUTPUT_ITEMS,
                 _edcg_scale=SCALE_FACTOR)
)

Test("scaled count 3 items") <- (
    run_scaled(["a", "b", "c"], 10, COUNT, ITEMS),
    COUNT == 30,
    # Phase 2 Task 13 Liskov rule: list-of-1-char-strs may promote to
    # str — assert against the str form which is the promoted output.
    ITEMS == "cba"
)  # nv
Test("scaled count empty") <- (
    run_scaled([], 5, COUNT, ITEMS),
    COUNT == 0,
    ITEMS == []
)  # nv
