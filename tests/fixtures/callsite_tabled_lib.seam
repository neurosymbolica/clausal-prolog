# Library module for the call-site tabling-bypass regression
# (todo/call-site-specialisation-protocol-questions.md Q1).
# t_cat is TABLED, has >= _INDEX_THRESHOLD clauses and head constants at
# pos 1 — the shape that would earn a direct bucket ref at an importing
# ground call site.  The two "a" clauses both succeed for P == 1, so the
# table's answer dedup is observable: 1 solution tabled, 2 if the call
# site bypasses the tabling wrapper.
-double_quotes(atom)
-module(callsite_tabled_lib, [t_cat(P, C)])
-table(t_cat/2)

t_cat(P, "a") <- (P == 1)
t_cat(P, "a") <- (P < 2)
t_cat(P, "b") <- (P == 2)
t_cat(P, "c") <- (P == 3)
