# Later heads with a list pattern deeper than one cell: against a partial
# list ['a', *Z] they bind Z, waking a goal frozen on it before the guard
# fails (tests/test_tro_clause_order.py).
-module(tro_clause_order_lists_seam, [run_q(W, L)])
-dynamic(ev/1)
q(X, N) <- (N > 0, M is ++(N - 1), q(X, M))
q([_], N) <- (N <= 0)
q2(X, N) <- (N > 0, M is ++(N - 1), q2(X, M))
q2([_, _], N) <- (N <= 0)
q3(X, N) <- (N > 0, M is ++(N - 1), q3(X, M))
q3([_, _, *_], N) <- (N <= 0)
log(E) <- assertz(ev(E))
go('q', X) <- q(X, 2)
go('q2', X) <- q2(X, 2)
go('q3', X) <- q3(X, 2)
run_q(W, L) <- (retractall(ev(_)), not (freeze(Z, log('woke')), L0 is ['a', *Z], go(W, L0), log('answer'), fail), findall(E, ev(E), L))
