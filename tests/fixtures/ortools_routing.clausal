# OR-Tools routing integration tests

Test("tsp 4 cities optimal tour") <- (
    ortools.routing.tsp(
        [[0, 10, 15, 20],
         [10, 0, 35, 25],
         [15, 35, 0, 30],
         [20, 25, 30, 0]],
        0, TOUR, DIST),
    DIST == 80,
    length(TOUR, 5)
)  # nv

Test("tsp 3 cities triangle") <- (
    ortools.routing.tsp(
        [[0, 1, 2],
         [1, 0, 3],
         [2, 3, 0]],
        0, TOUR_UNUSED, DIST),
    DIST == 6
)  # nv

Test("vrp 2 vehicles all customers served") <- (
    ortools.routing.vrp(
        [[0, 10, 15, 20, 25],
         [10, 0, 35, 25, 30],
         [15, 35, 0, 30, 20],
         [20, 25, 30, 0, 15],
         [25, 30, 20, 15, 0]],
        [0, 5, 8, 3, 6],
        [15, 15],
        0, ROUTES, DIST_UNUSED),
    length(ROUTES, 2)
)  # nv

Test("vrptw 3 customers with time windows") <- (
    ortools.routing.vrptw(
        [[0, 10, 15, 20],
         [10, 0, 25, 30],
         [15, 25, 0, 10],
         [20, 30, 10, 0]],
        [(0, 100), (5, 30), (10, 50), (20, 70)],
        0, 1, ROUTES),
    length(ROUTES, 1)
)  # nv
