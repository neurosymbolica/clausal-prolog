-table(Fib/2)

Fib(N=0, RESULT=0),
Fib(1, 1),
Fib(N, RESULT) <- (
    N > 1,
    N1 := N - 1,
    N2 := N - 2,
    Fib(N1, A),
    Fib(N2, B),
    RESULT := A + B
)


Test("fib 0") <- Fib(0, 0)
Test("fib 1") <- Fib(1, 1)
Test("fib 5") <- (Fib(5, R_), R_ == 5)
Test("fib 10") <- (Fib(10, R_), R_ == 55)
