# The field NAMES matter here: tests/test_wfs.py resolves a reified
# kwargs goal against this predicate's registered signature.  They used
# to come from a keyword head (`fib(N=0, RESULT=0)`); that spelling was
# retired 2026-09-19, so the declaration carries them.
-double_quotes(atom)
-private([fib(N, RESULT)])

-table(fib/2)

fib(0, 0),
fib(1, 1),
fib(N, RESULT) <- (
    N > 1,
    N1 == N - 1,
    N2 == N - 2,
    fib(N1, FIRST),
    fib(N2, SECOND),
    RESULT == FIRST + SECOND
)


test("fib 0") <- fib(0, 0)  # nv
test("fib 1") <- fib(1, 1)  # nv
test("fib 5") <- (fib(5, RESULT), RESULT == 5)  # nv
test("fib 10") <- (fib(10, RESULT), RESULT == 55)  # nv
