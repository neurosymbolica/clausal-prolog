    DIFF < 1e-10)

# ── RealFFT (arity-2) ───────────────────────────────────────────────────

# forward
Test("rfft forward") <- (
    X := ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    RealFFT(X, R),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['rfft']).rfft([1.0, 2.0, 3.0, 4.0])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(R - EXPECTED))),
    DIFF < 1e-10)

# backward
Test("rfft backward") <- (
    SPEC := ++(__import__('scipy.fft', fromlist=['rfft']).rfft([1.0, 2.0, 3.0, 4.0])),
    RealFFT(X2, SPEC),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        X2 - __import__('numpy').array([1.0, 2.0, 3.0, 4.0])))),
    DIFF < 1e-10)

# both unbound
Test("rfft both unbound fails") <- (not RealFFT(_, _))

# round-trip
Test("rfft round-trip") <- (
    X := ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    RealFFT(X, R),
    RealFFT(X2, R),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)

# arity-3 with N
Test("rfft arity-3 forward") <- (
    X := ++(__import__('numpy').array([1.0, 2.0])),
    RealFFT(X, 4, R),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['rfft']).rfft([1.0, 2.0], n=4)),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(R - EXPECTED))),
    DIFF < 1e-10)

Test("rfft arity-3 round-trip") <- (
    X := ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    RealFFT(X, 4, R),
    RealFFT(X2, 4, R),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)

# ── DiscreteCosineTransform ──────────────────────────────────────────────

# forward
Test("dct forward") <- (
    X := ++(__import__('numpy').array([1.0, 2.0, 1.0])),
    DiscreteCosineTransform(X, C),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['dct']).dct([1.0, 2.0, 1.0])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(C - EXPECTED))),
    DIFF < 1e-10)

# backward
Test("dct backward") <- (
    COEFFS := ++(__import__('scipy.fft', fromlist=['dct']).dct([1.0, 2.0, 1.0])),
    DiscreteCosineTransform(X2, COEFFS),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        X2 - __import__('numpy').array([1.0, 2.0, 1.0])))),
    DIFF < 1e-10)

# both unbound
Test("dct both unbound fails") <- (not DiscreteCosineTransform(_, _))

# round-trip
Test("dct round-trip") <- (
    X := ++(__import__('numpy').array([1.0, 2.0, 1.0])),
    DiscreteCosineTransform(X, C),
    DiscreteCosineTransform(X2, C),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)

# arity-3 with type
Test("dct arity-3 type 2 round-trip") <- (
    X := ++(__import__('numpy').array([1.0, 2.0, 3.0])),
    DiscreteCosineTransform(X, 2, C),
    DiscreteCosineTransform(X2, 2, C),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)

