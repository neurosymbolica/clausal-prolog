# ── FFTShift ─────────────────────────────────────────────────────────────

# forward
Test("fftshift forward") <- (
    X := ++(__import__('numpy').array([0.0, 1.0, 2.0, 3.0])),
    FFTShift(X, S),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['fftshift']).fftshift([0.0, 1.0, 2.0, 3.0])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(S - EXPECTED))),
    DIFF < 1e-10)

# backward
Test("fftshift backward") <- (
    SHIFTED := ++(__import__('scipy.fft', fromlist=['fftshift']).fftshift([0.0, 1.0, 2.0, 3.0])),
    FFTShift(X2, SHIFTED),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        X2 - __import__('numpy').array([0.0, 1.0, 2.0, 3.0])))),
    DIFF < 1e-10)

# both unbound
Test("fftshift both unbound fails") <- (not FFTShift(_, _))

# round-trip
Test("fftshift round-trip") <- (
    X := ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    FFTShift(X, S),
    FFTShift(X2, S),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(X2 - X))),
    DIFF < 1e-10)
