-import_from(scipy_fft, [FFTransform, FFTransform2D, FFTransformND,
                          RealFFT, DiscreteCosineTransform,
                          DiscreteSineTransform, FFTShift])

# ── FFTransform (arity-2) ────────────────────────────────────────────────

# forward
Test("fft forward") <- (
    SIG := ++(__import__('numpy').array([1.0, 0.0, -1.0, 0.0])),
    FFTransform(SIG, SPEC),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['fft']).fft([1.0, 0.0, -1.0, 0.0])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(SPEC - EXPECTED))),
    DIFF < 1e-10)

# backward
Test("fft backward") <- (
    SPEC := ++(__import__('scipy.fft', fromlist=['fft']).fft([1.0, 2.0, 3.0, 4.0])),
    FFTransform(RECOVERED, SPEC),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        __import__('numpy').real(RECOVERED) - __import__('numpy').array([1.0, 2.0, 3.0, 4.0])))),
    DIFF < 1e-10)

# both unbound
Test("fft both unbound fails") <- (not FFTransform(_, _))

# round-trip
Test("fft round-trip") <- (
    SIGNAL := ++(__import__('numpy').array([1.0, 2.0, 3.0, 4.0])),
    FFTransform(SIGNAL, SPEC),
    FFTransform(RECOVERED, SPEC),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        __import__('numpy').real(RECOVERED) - SIGNAL))),
    DIFF < 1e-10)

# ── FFTransform (arity-3 with N) ─────────────────────────────────────────

# forward with N (zero-pad)
Test("fft arity-3 forward") <- (
    SIG := ++(__import__('numpy').array([1.0, 2.0])),
    FFTransform(SIG, 4, SPEC),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['fft']).fft([1.0, 2.0], n=4)),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(SPEC - EXPECTED))),
    DIFF < 1e-10)

# backward with N
Test("fft arity-3 backward") <- (
    SPEC := ++(__import__('scipy.fft', fromlist=['fft']).fft([1.0, 2.0, 3.0, 4.0])),
    FFTransform(RECOVERED, 4, SPEC),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        __import__('numpy').real(RECOVERED) - __import__('numpy').array([1.0, 2.0, 3.0, 4.0])))),
    DIFF < 1e-10)

# ── FFTransform2D ────────────────────────────────────────────────────────

# forward
Test("fft2d forward") <- (
    A := ++(__import__('numpy').array([[1.0, 2.0], [3.0, 4.0]])),
    FFTransform2D(A, F),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['fft2']).fft2([[1.0, 2.0], [3.0, 4.0]])),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(F - EXPECTED))),
    DIFF < 1e-10)

# backward
Test("fft2d backward") <- (
    SPEC := ++(__import__('scipy.fft', fromlist=['fft2']).fft2([[1.0, 2.0], [3.0, 4.0]])),
    FFTransform2D(RECOVERED, SPEC),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        __import__('numpy').real(RECOVERED) - __import__('numpy').array([[1.0, 2.0], [3.0, 4.0]])))),
    DIFF < 1e-10)

# both unbound
Test("fft2d both unbound fails") <- (not FFTransform2D(_, _))

# round-trip
Test("fft2d round-trip") <- (
    A := ++(__import__('numpy').array([[1.0, 2.0], [3.0, 4.0]])),
    FFTransform2D(A, F),
    FFTransform2D(A2, F),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(
        __import__('numpy').real(A2) - A))),
    DIFF < 1e-10)

# arity-3 with shape
Test("fft2d arity-3 forward") <- (
    A := ++(__import__('numpy').array([[1.0, 2.0], [3.0, 4.0]])),
    FFTransform2D(A, ++(tuple([4, 4])), F),
    EXPECTED := ++(__import__('scipy.fft', fromlist=['fft2']).fft2([[1.0, 2.0], [3.0, 4.0]], s=(4, 4))),
    DIFF is ++(__import__('numpy').max(__import__('numpy').abs(F - EXPECTED))),
    DIFF < 1e-10)

