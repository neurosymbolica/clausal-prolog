-import_from(sklearn, [Est, Dataset, Fitted, LoadDataset, Fit, Predict,
                       Score, Metric, CrossValScore, CrossValidate,
                       ConfusionMatrix, PredictProba, SplitData, kfold])

# ── Metric/4: classification metrics ────────────────────────────────

Test("accuracy metric") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("random_forest", {"n_estimators": 10, "random_state": 42}), DATASET, FITTED),
    DATASET is ("Dataset", X, Y),
    Predict(FITTED, X, PREDS),
    Metric("accuracy", Y, PREDS, SCORE),
    SCORE > 0.8
)  # nv

# ── Score/4 with explicit metric ─────────────────────────────────────

Test("score with accuracy metric") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("logistic_regression", {"max_iter": 200}), DATASET, FITTED),
    Score(FITTED, DATASET, "accuracy", SCORE),
    SCORE > 0.5
)  # nv

# ── Regression metrics ───────────────────────────────────────────────

Test("r2 metric on diabetes") <- (
    LoadDataset("diabetes", DATASET),
    Fit(Est("ridge", {}), DATASET, FITTED),
    DATASET is ("Dataset", X, Y),
    Predict(FITTED, X, PREDS),
    Metric("r2", Y, PREDS, SCORE)
)  # nv

Test("mse metric on diabetes") <- (
    LoadDataset("diabetes", DATASET),
    Fit(Est("ridge", {}), DATASET, FITTED),
    DATASET is ("Dataset", X, Y),
    Predict(FITTED, X, PREDS),
    Metric("mse", Y, PREDS, SCORE),
    SCORE > 0.0
)  # nv

# ── CrossValScore ────────────────────────────────────────────────────

Test("cross val score on iris") <- (
    LoadDataset("iris", DATASET),
    CrossValScore(Est("logistic_regression", {"max_iter": 200}),
                  DATASET, kfold(3), SCORES)
)  # nv

Test("cross val score with metric") <- (
    LoadDataset("iris", DATASET),
    CrossValScore(Est("logistic_regression", {"max_iter": 200}),
                  DATASET, kfold(3), "accuracy", SCORES)
)  # nv

# ── CrossValidate ────────────────────────────────────────────────────

Test("cross validate multiple metrics") <- (
    LoadDataset("iris", DATASET),
    CrossValidate(Est("logistic_regression", {"max_iter": 200}),
                  DATASET, kfold(3), ["accuracy", "f1_weighted"], RESULTS)
)  # nv

# ── ConfusionMatrix ──────────────────────────────────────────────────

Test("confusion matrix on iris") <- (
    LoadDataset("iris", DATASET),
    Fit(Est("random_forest", {"n_estimators": 10, "random_state": 42}), DATASET, FITTED),
    DATASET is ("Dataset", X, Y),
    Predict(FITTED, X, PREDS),
    ConfusionMatrix(Y, PREDS, MATRIX)
)  # nv
