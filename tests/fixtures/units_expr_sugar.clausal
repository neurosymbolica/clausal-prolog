# Deliberately kept on the deprecated TitleCase unit spelling (Metre, Second,
# Newton): it exercises the alias path in -import_from and the once-per-file
# lint.  Every other fixture uses the lowercase names.  Remove together with
# the aliases — see todo/remove-deprecated-TitleCase-unit-names-after-migration-2026-09-09.md.
-import_from(py.units, [Metre, Second, Newton])

# [1,2,3](Metre) - list with unit annotation
test("list with unit") <- (
    X is [1.0, 2.0, 3.0](Metre),
    has_units(X, Metre))  # nv

# Scalar sugar still works
test("scalar with unit") <- (
    X is 5.0(Metre),
    has_units(X, Metre))  # nv

# Variable sugar still works
test("var with unit") <- (
    V is 9.8,
    X is V(Newton),
    has_units(X, Newton))  # nv

# Compound unit on list
test("list with compound unit") <- (
    X is [0.0, 10.0, 20.0](Metre/Second),
    has_units(X, Metre/Second))  # nv
