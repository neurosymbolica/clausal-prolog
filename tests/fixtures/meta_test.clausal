Squares(NUMBERS, SQUARES) <- (
    findall(
        SQUARE,
        (in_(X, NUMBERS), SQUARE := X * X),
        SQUARES,
    )
)

Positives(NUMBERS, POSITIVES) <- (
    findall(
        X,
        (in_(X, NUMBERS), X > 0),
        POSITIVES,
    )
)

UniqueMembers(NUMBERS, UNIQUE) <- (
    setof(
        X,
        in_(X, NUMBERS),
        UNIQUE,
    )
)

AllPositive(NUMBERS) <- (
    forall(in_(X, NUMBERS), X > 0)
)


Test("squares") <- (Squares([1, 2, 3], SQUARES), SQUARES == [1, 4, 9])  # nv
Test("positives") <- (Positives([-1, 2, -3, 4], POSITIVES), POSITIVES == [2, 4])  # nv
Test("unique members") <- (UniqueMembers([1, 2, 1, 3, 2], UNIQUE), UNIQUE == [1, 2, 3])  # nv
Test("all positive") <- AllPositive([1, 2, 3])  # nv
Test("all positive fails: [1,-2,3]") <- (not AllPositive([1, -2, 3]))  # nv

# ── findall/3 direct tests (migrated from test_meta.py) ────────────────────

Test("findall basic: member of [1,2,3]") <- (
    findall(X, in_(X, [1, 2, 3]), L),
    L == [1, 2, 3]
)  # nv
Test("findall with filter: X > 1") <- (
    findall(X, (in_(X, [1, 2, 3]), X > 1), L),
    L == [2, 3]
)  # nv
Test("findall empty: no solutions yields []") <- (
    findall(X, False, L),
    L == []
)  # nv
Test("findall cartesian product") <- (
    findall(
        [X, Y],
        (in_(X, ["a", "b"]), in_(Y, [1, 2])),
        L
    ),
    L == [["a", 1], ["a", 2], ["b", 1], ["b", 2]]
)  # nv
Test("findall no side effects on outer vars") <- (
    findall(X, in_(X, [10, 20]), L),
    L == [10, 20]
)  # nv
Test("findall nested: outer + inner") <- (
    findall(
        [Y, INNER],
        (in_(Y, [10, 20]), findall(X, in_(X, [1, 2]), INNER)),
        L
    ),
    L == [[10, [1, 2]], [20, [1, 2]]]
)  # nv

# ── bagof/3 tests ──────────────────────────────────────────────────────────

Test("bagof basic") <- (
    bagof(X, in_(X, [1, 2]), L),
    L == [1, 2]
)  # nv
Test("bagof fails on empty") <- (not bagof(X, False, _))  # nv

# ── setof/3 tests ──────────────────────────────────────────────────────────

Test("setof deduplicates") <- (
    setof(X, in_(X, [1, 1, 2, 2, 3]), L),
    L == [1, 2, 3]
)  # nv
Test("setof fails on empty") <- (not setof(X, False, _))  # nv

# ── forall/2 tests ─────────────────────────────────────────────────────────

Test("forall positive elements") <- forall(in_(X, [2, 4, 6]), X > 0)  # nv
Test("forall fails with negative") <- (not forall(in_(X, [2, -1, 6]), X > 0))  # nv
Test("forall vacuously true when cond fails") <- forall(False, X > 0)  # nv
