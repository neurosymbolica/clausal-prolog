Squares(N_, Squares_) <- (
    FindAll(
        Sq_,
        (In(X_, N_) and (Sq_ := X_ * X_)),
        Squares_,
    )
)

Positives(Ns_, Pos_) <- (
    FindAll(
        X_,
        (In(X_, Ns_) and X_ > 0),
        Pos_,
    )
)

UniqueMembers(Ns_, Unique_) <- (
    SetOf(
        X_,
        In(X_, Ns_),
        Unique_,
    )
)

AllPositive(Ns_) <- (
    ForAll(In(X_, Ns_), X_ > 0)
)


Test("squares") <- (Squares([1, 2, 3], Ss_), Ss_ == [1, 4, 9])
Test("positives") <- (Positives([-1, 2, -3, 4], Pos_), Pos_ == [2, 4])
Test("unique members") <- (UniqueMembers([1, 2, 1, 3, 2], U_), U_ == [1, 2, 3])
Test("all positive") <- AllPositive([1, 2, 3])
