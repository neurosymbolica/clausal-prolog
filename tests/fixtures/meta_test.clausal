Squares(NUMBERS, SQUARES) <- (
    FindAll(
        SQUARE,
        (In(X, NUMBERS), SQUARE := X * X),
        SQUARES,
    )
)

Positives(NUMBERS, POSITIVES) <- (
    FindAll(
        X,
        (In(X, NUMBERS), X > 0),
        POSITIVES,
    )
)

UniqueMembers(NUMBERS, UNIQUE) <- (
    SetOf(
        X,
        In(X, NUMBERS),
        UNIQUE,
    )
)

AllPositive(NUMBERS) <- (
    ForAll(In(X, NUMBERS), X > 0)
)


Test("squares") <- (Squares([1, 2, 3], SQUARES), SQUARES == [1, 4, 9])
Test("positives") <- (Positives([-1, 2, -3, 4], POSITIVES), POSITIVES == [2, 4])
Test("unique members") <- (UniqueMembers([1, 2, 1, 3, 2], UNIQUE), UNIQUE == [1, 2, 3])
Test("all positive") <- AllPositive([1, 2, 3])
