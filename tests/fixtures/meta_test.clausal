Squares(N_, Squares_) <- (
    FindAll(
        Sq_,
        (In(X_, N_) and (Sq_ := X_ * X_)),
        Squares_,
    )
)

Positives(Ns_, Pos_) <- (
    FindAll(
        X_,
        (In(X_, Ns_) and X_ > 0),
        Pos_,
    )
)

UniqueMembers(Ns_, Unique_) <- (
    SetOf(
        X_,
        In(X_, Ns_),
        Unique_,
    )
)

AllPositive(Ns_) <- (
    ForAll(In(X_, Ns_), X_ > 0)
)

