-import_from(scipy_fft, [FFTransform, InverseFFT,
                          FFTransform2D, InverseFFT2D,
                          FFTransformND,
                          RealFFT, InverseRealFFT,
                          DiscreteCosineTransform, InverseDiscreteCosineTransform,
                          FFTFrequencies, RealFFTFrequencies,
                          FFTShift, InverseFFTShift])

# FFTransform of constant signal [1,1,1,1] - DC component should be 4.0
Test("fft constant signal") <- (
    FFTransform(++([1.0, 1.0, 1.0, 1.0]), RESULT) and
    DC is ++(abs(complex(RESULT[0]))) and
    DIFF is ++(abs(float(DC) - 4.0)) and
    DIFF < 1e-10)

# FFTransform round-trip: InverseFFT(FFTransform(x)) should recover x
Test("fft round trip") <- (
    X is ++([1.0, 2.0, 3.0, 4.0]) and
    FFTransform(X, SPECTRUM) and
    InverseFFT(SPECTRUM, RECOVERED) and
    ERR is ++(abs(float(RECOVERED[0].real) - 1.0)) and
    ERR < 1e-10)

# RealFFT: output length for 4-point input is 3 (n//2+1)
Test("real fft output length") <- (
    RealFFT(++([1.0, 0.0, 0.0, 0.0]), RESULT) and
    LEN is ++(len(RESULT)) and
    LEN == 3)

# FFTFrequencies: fftfreq(4) first element is 0.0, second is 0.25
Test("fft frequencies length 4") <- (
    FFTFrequencies(++(4), FREQS) and
    F0 is ++(float(FREQS[0])) and
    F1 is ++(float(FREQS[1])) and
    F0 == 0.0 and
    DIFF is ++(abs(F1 - 0.25)) and
    DIFF < 1e-10)

# RealFFTFrequencies: 8-point real FFT gives 5 frequencies, first is 0.0
Test("real fft frequencies non negative") <- (
    RealFFTFrequencies(++(8), FREQS) and
    LEN is ++(len(FREQS)) and
    LEN == 5 and
    F0 is ++(float(FREQS[0])) and
    F0 == 0.0)

# FFTShift then InverseFFTShift recovers original
Test("fft shift and inverse") <- (
    X is ++([0.0, 1.0, 2.0, 3.0]) and
    FFTShift(X, SHIFTED) and
    InverseFFTShift(SHIFTED, RECOVERED) and
    V0 is ++(float(RECOVERED[0])) and
    V0 == 0.0 and
    V1 is ++(float(RECOVERED[1])) and
    DIFF is ++(abs(V1 - 1.0)) and
    DIFF < 1e-10)

# DiscreteCosineTransform round-trip via InverseDiscreteCosineTransform
Test("dct round trip") <- (
    X is ++([1.0, 2.0, 3.0, 4.0]) and
    DiscreteCosineTransform(X, COEFFS) and
    InverseDiscreteCosineTransform(COEFFS, RECOVERED) and
    ERR is ++(abs(float(RECOVERED[0]) - 1.0)) and
    ERR < 1e-10)
