# clausal: no-collect
# A SECOND implementer of impclob_verdict/2: it imports the predicate from the
# module that DEFINES it (impclob_implements) and supplies a clause of its own.
# That would replace impclob_implements' clause for every module that can
# reach it, so the load is refused -- and the diagnostic must credit the
# clauses to impclob_implements, not to the declaration-only vocabulary.
-private([rival, elsewhere])
-module(impclob_implements_rival, [impclob_rival_check(STATUS)])
-import_from(tests.fixtures.impclob_implements, [impclob_verdict])

impclob_verdict(rival, elsewhere),

impclob_rival_check(S) <- impclob_verdict(S, C_UNUSED)
