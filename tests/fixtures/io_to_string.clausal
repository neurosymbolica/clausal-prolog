# write_to_string/2 and term_to_string/2 behavior tests.
#
# These observe the *string output* of write_to_string / term_to_string via
# clausal unification, so they can live in .clausal.  Tests that observe
# stdout side-effects remain in tests/test_io.py.

-module(io_to_string, [Test(DESC)])

# ── write_to_string/2 ─────────────────────────────────────────────────────

Test("write_to_string: plain string passthrough") <- (
    write_to_string("hello", S),
    S == "hello"
)  # nv

Test("write_to_string: integer to string") <- (
    write_to_string(42, S),
    S == "42"
)  # nv

Test("write_to_string: bound var passthrough") <- (
    X is "world",
    write_to_string(X, S),
    S == "world"
)  # nv

# ── term_to_string/2 ──────────────────────────────────────────────────────

Test("term_to_string: integer") <- (
    term_to_string(42, S),
    S == "42"
)  # nv

Test("term_to_string: string gets quoted") <- (
    term_to_string("hello", S),
    S == "'hello'"
)  # nv

Test("term_to_string: list") <- (
    term_to_string([1, 2], S),
    S == "[1, 2]"
)  # nv
