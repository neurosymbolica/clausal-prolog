# P3-3 Task 8 fix round 1 (F1): pins that the doc example
# `debug_fib <- listing(fib/2)` genuinely works end-to-end. `fib/2` here is
# `/` the ARITHMETIC operator applied to a bare predicate reference and an
# int literal -- it compiles to a runtime Div node (`fib` resolves to the
# PredicateMeta class this module binds), not the cell `('/', 'fib', 2)`.
# `_as_name_arity_indicator` (clausal/logic/builtins/io.py) recognizes that
# shape as a fourth Name/Arity indicator representation.

fib(0, 1),
fib(1, 1),
fib(N, F) <- (
    N > 1,
    N1 == N - 1,
    N2 == N - 2,
    fib(N1, F1),
    fib(N2, F2),
    F == F1 + F2
)

debug_fib_by_class() <- listing(fib)
debug_fib_by_indicator() <- listing(fib/2)
