# P3-3 Task 8 fix round 1 (F1): pins that the doc example
# `debug_fib <- listing(fib/2)` genuinely works end-to-end. `fib/2` here is
# `/` the ARITHMETIC operator applied to a bare predicate reference and an
# int literal -- it compiles to a runtime Div node (`fib` resolves to the
# PredicateMeta class this module binds), not the cell `('/', 'fib', 2)`.
# `_pi_parts` (clausal/logic/builtins/io.py) recognizes that
# shape as a fourth Name/Arity indicator representation.

fib(0, 1),
fib(1, 1),
fib(N, F) <- (
    N > 1,
    N1 == N - 1,
    N2 == N - 2,
    fib(N1, F1),
    fib(N2, F2),
    F == F1 + F2
)

# Since ruling S (2026-09-24) a bare `fib` here is the ATOM fib, and since
# the operator ruling of 2026-09-25 ("do what Scryer does") `listing(fib)` is
# type_error(predicate_indicator, fib); the class form is driven from Python
# in tests/test_listing.py.  `fib // 0` is Scryer's Name//Arity spelling (a
# DCG nonterminal indicator): it compiles to a runtime FloorDiv node and
# names fib/(0+2).
debug_fib_by_nonterminal() <- listing(fib // 0)
debug_fib_by_indicator() <- listing(fib/2)
