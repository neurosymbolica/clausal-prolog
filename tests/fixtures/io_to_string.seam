-double_quotes(chars)
# write_to_string/2 and term_to_string/2 behavior tests.
#
# These observe the *string output* of write_to_string / term_to_string via
# clausal unification, so they can live in .clausal.  Tests that observe
# stdout side-effects remain in tests/test_io.py.

-module(io_to_string, [test(DESC)])

# ── write_to_string/2 ─────────────────────────────────────────────────────

# Task 15 item 4 as amended (2026-09-07): write_to_string/2 follows write/1,
# which is ISO -- a STRING renders as the list of characters it is.  The
# passthrough rendering moved to write_text_to_string/2, pinned below.
test("write_to_string: a string spells itself out") <- (
    write_to_string("hi", S),
    S == "[h,i]"
)  # nv

test("write_to_string: integer to string") <- (
    write_to_string(42, S),
    S == "42"
)  # nv

test("write_to_string: bound var spells itself out") <- (
    X is "hi",
    write_to_string(X, S),
    S == "[h,i]"
)  # nv

# ── write_text_to_string/2 (the Clausal TEXT family) ──────────────────────

test("write_text_to_string: plain string passthrough") <- (
    write_text_to_string("hello", S),
    S == "hello"
)  # nv

test("write_text_to_string: bound var passthrough") <- (
    X is "world",
    write_text_to_string(X, S),
    S == "world"
)  # nv

test("write_text_to_string: integer to string") <- (
    write_text_to_string(42, S),
    S == "42"
)  # nv

# ── term_to_string/2 ──────────────────────────────────────────────────────

test("term_to_string: integer") <- (
    term_to_string(42, S),
    S == "42"
)  # nv

# THE FLIP (spec §6.7): the quoted writer family spells a STRING with
# DOUBLE quotes (a single-quoted token is an atom), so the rendering of
# "hello" is the six-character text "hello" wrapped in quotes.
test("term_to_string: string gets quoted") <- (
    term_to_string("hello", S),
    S is ['"', 'h', 'e', 'l', 'l', 'o', '"']
)  # nv

test("term_to_string: list") <- (
    term_to_string([1, 2], S),
    S == "[1, 2]"
)  # nv
