-double_quotes(atom)
sendmoney(S, E, N, D, M, O, R, Y) <- (
    in_domain([S, E, N, D, M, O, R, Y], 0, 9),
    all_different([S, E, N, D, M, O, R, Y]),
    S != 0,
    M != 0,
    (
        S * 1000 + E * 100 + N * 10 + D +
        (M * 1000 + O * 100 + R * 10 + E)
        ==
        M * 10000 + O * 1000 + N * 100 + E * 10 + Y
    ),
    label([S, E, N, D, M, O, R, Y]),
)

test("SEND+MORE=MONEY solution is 9567+1085=10652") <- (
    sendmoney(9, 5, 6, 7, 1, 0, 8, 2)
)  # nv

test("SEND+MORE=MONEY has exactly one solution") <- (
    findall([S, E, N, D, M, O, R, Y], sendmoney(S, E, N, D, M, O, R, Y), SOLUTIONS),
    length(SOLUTIONS, 1)
)  # nv

