-import_module(torch)
-import_from(py.torch_nn, [layer, activation, loss_fn, optimizer_type,
                            named_parameter])
-import_from(py.torch, [dtype_info, float32, float64, int64])

# --- layer registry ---

Test("layer enumerates Linear") <- (
    findall(N, layer(N, _), NS),
    in_("Linear", NS)
)  # nv

Test("layer enumerates Conv2d") <- (
    findall(N, layer(N, _), NS),
    in_("Conv2d", NS)
)  # nv

Test("layer enumerates LSTM") <- (
    findall(N, layer(N, _), NS),
    in_("LSTM", NS)
)  # nv

Test("layer lookup by name returns usable class") <- (
    layer("Linear", CLASS),
    M is ++(CLASS(10, 5)),
    named_parameter(M, "weight", _)
)  # nv

Test("layer lookup is deterministic") <- (
    layer("Conv2d", CLASS),
    layer("Conv2d", CLASS)
)  # nv

# --- activation registry ---

Test("activation enumerates ReLU") <- (
    findall(N, activation(N, _), NS),
    in_("ReLU", NS)
)  # nv

Test("activation enumerates Sigmoid and Tanh") <- (
    findall(N, activation(N, _), NS),
    in_("Sigmoid", NS),
    in_("Tanh", NS)
)  # nv

Test("activation enumerates Softmax") <- (
    findall(N, activation(N, _), NS),
    in_("Softmax", NS)
)  # nv

# --- loss_fn registry ---

Test("loss_fn enumerates CrossEntropyLoss") <- (
    findall(N, loss_fn(N, _), NS),
    in_("CrossEntropyLoss", NS)
)  # nv

Test("loss_fn enumerates MSELoss") <- (
    findall(N, loss_fn(N, _), NS),
    in_("MSELoss", NS)
)  # nv

Test("loss_fn lookup by name") <- (
    loss_fn("CrossEntropyLoss", CLASS),
    loss_fn("CrossEntropyLoss", CLASS)
)  # nv

# --- optimizer_type registry ---

Test("optimizer_type enumerates Adam") <- (
    findall(N, optimizer_type(N, _), NS),
    in_("Adam", NS)
)  # nv

Test("optimizer_type enumerates SGD") <- (
    findall(N, optimizer_type(N, _), NS),
    in_("SGD", NS)
)  # nv

Test("optimizer_type lookup by name") <- (
    optimizer_type("Adam", _)
)  # nv

# --- dtype_info ---

Test("dtype_info bits for float32") <- (
    dtype_info(float32, "bits", BITS),
    BITS == 32
)  # nv

Test("dtype_info bits for float64") <- (
    dtype_info(float64, "bits", BITS),
    BITS == 64
)  # nv

Test("dtype_info is_floating_point for float32") <- (
    dtype_info(float32, "is_floating_point", V),
    V == True
)  # nv

Test("dtype_info is_floating_point for int64") <- (
    dtype_info(int64, "is_floating_point", V),
    V == False
)  # nv

Test("dtype_info enumerate keys") <- (
    findall(K, dtype_info(float32, K, _), KEYS),
    in_("bits", KEYS),
    in_("is_floating_point", KEYS),
    in_("is_complex", KEYS)
)  # nv
