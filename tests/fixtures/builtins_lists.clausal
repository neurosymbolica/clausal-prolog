# Tests for list predicates
# Each wrapper exercises a single builtin so Python tests can call it by name.

# In/2, InCheck/2
HasMember(X, XS) <- X in XS
HasMemberCheck(X, XS) <- InCheck(X, XS)

# Append/3
Concat(A, B, C) <- Append(A, B, C)

# Split(Prefix, Suffix, Whole): Whole = Prefix ++ Suffix
Split(A, B, C) <- Append(A, B, C)

# Length/2
ListLength(XS, N) <- Length(XS, N)

# Last/2
ListLast(XS, X) <- Last(XS, X)

# Reverse/2
ListReverse(XS, YS) <- Reverse(XS, YS)

# GetItem/3 (0-based)
Get0(XS, I, X) <- GetItem(I, XS, X)

# Flatten/2
Flat(XS, YS) <- Flatten(XS, YS)

# MergeSort/2 (stable sort, keeps duplicates), Sort/2 (removes duplicates)
SortedWithDups(XS, YS) <- MergeSort(XS, YS)
SortedUnique(XS, YS) <- Sort(XS, YS)

# Permutation/2
Perms(XS, YS) <- Permutation(XS, YS)

# Select/3: select element from list leaving rest
Pick(X, XS, REST) <- Select(X, XS, REST)

# Subtract/3, Intersection/3, Union/3
ListDiff(A, B, C) <- Subtract(A, B, C)
ListInter(A, B, C) <- Intersection(A, B, C)
ListUnion(A, B, C) <- Union(A, B, C)

# ToSet/2: remove duplicates preserving order
Dedup(XS, YS) <- ToSet(XS, YS)

# SumList/2, MaxList/2, MinList/2
Total(XS, S) <- SumList(XS, S)
Maximum(XS, M) <- MaxList(XS, M)
Minimum(XS, M) <- MinList(XS, M)

# Unzip/3, PairKeys/2, PairValues/2
MakePairs(KS, VS, PS) <- Unzip(PS, KS, VS)
KeysOf(PS, KS) <- PairKeys(PS, KS)
ValuesOf(PS, VS) <- PairValues(PS, VS)

