# Tests for list predicates

# In/2, InCheck/2
HasMember(X_, Xs_) <- In(X_, Xs_)
HasMemberCheck(X_, Xs_) <- InCheck(X_, Xs_)

# Append/3
Concat(A_, B_, C_) <- Append(A_, B_, C_)

# Split(Prefix, Suffix, Whole): Whole = Prefix ++ Suffix
Split(A_, B_, C_) <- Append(A_, B_, C_)

# Length/2
ListLength(Xs_, N_) <- Length(Xs_, N_)

# Last/2
ListLast(Xs_, X_) <- Last(Xs_, X_)

# Reverse/2
ListReverse(Xs_, Ys_) <- Reverse(Xs_, Ys_)

# GetItem/3 (0-based)
Get0(Xs_, I_, X_) <- GetItem(I_, Xs_, X_)

# Flatten/2
Flat(Xs_, Ys_) <- Flatten(Xs_, Ys_)

# MergeSort/2 (stable sort, keeps duplicates), Sort/2 (removes duplicates)
SortedWithDups(Xs_, Ys_) <- MergeSort(Xs_, Ys_)
SortedUnique(Xs_, Ys_) <- Sort(Xs_, Ys_)

# Permutation/2
Perms(Xs_, Ys_) <- Permutation(Xs_, Ys_)

# Select/3: select element from list leaving rest
Pick(X_, Xs_, Rest_) <- Select(X_, Xs_, Rest_)

# Subtract/3, Intersection/3, Union/3
ListDiff(A_, B_, C_) <- Subtract(A_, B_, C_)
ListInter(A_, B_, C_) <- Intersection(A_, B_, C_)
ListUnion(A_, B_, C_) <- Union(A_, B_, C_)

# ToSet/2: remove duplicates preserving order
Dedup(Xs_, Ys_) <- ToSet(Xs_, Ys_)

# SumList/2, MaxList/2, MinList/2
Total(Xs_, S_) <- SumList(Xs_, S_)
Maximum(Xs_, M_) <- MaxList(Xs_, M_)
Minimum(Xs_, M_) <- MinList(Xs_, M_)

# Unzip/3, PairKeys/2, PairValues/2
MakePairs(Ks_, Vs_, Ps_) <- Unzip(Ps_, Ks_, Vs_)
KeysOf(Ps_, Ks_) <- PairKeys(Ps_, Ks_)
ValuesOf(Ps_, Vs_) <- PairValues(Ps_, Vs_)


Test("has member") <- HasMember(2, [1, 2, 3])
Test("append") <- (Concat([1, 2], [3, 4], R_), R_ == [1, 2, 3, 4])
Test("length") <- (ListLength([1, 2, 3], N_), N_ == 3)
Test("last") <- (ListLast([1, 2, 3], X_), X_ == 3)
Test("reverse") <- (ListReverse([1, 2, 3], R_), R_ == [3, 2, 1])
Test("get item") <- (Get0([10, 20, 30], 1, X_), X_ == 20)
Test("flatten") <- (Flat([1, [2, 3], [4, [5]]], R_), R_ == [1, 2, 3, 4, 5])
Test("sorted with dups") <- (SortedWithDups([3, 1, 2, 1], R_), R_ == [1, 1, 2, 3])
Test("sorted unique") <- (SortedUnique([3, 1, 2, 1], R_), R_ == [1, 2, 3])
Test("sum list") <- (Total([1, 2, 3, 4], S_), S_ == 10)
Test("max list") <- (Maximum([3, 1, 4, 1, 5], M_), M_ == 5)
Test("min list") <- (Minimum([3, 1, 4, 1, 5], M_), M_ == 1)
Test("dedup") <- (Dedup([1, 2, 1, 3, 2], R_), R_ == [1, 2, 3])
