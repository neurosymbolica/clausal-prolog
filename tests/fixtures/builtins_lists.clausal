# Tests for list predicates

# In/2, InCheck/2
HasMember(ELEMENT, LIST) <- In(ELEMENT, LIST)
HasMemberCheck(ELEMENT, LIST) <- InCheck(ELEMENT, LIST)

# Append/3
Concat(LEFT, RIGHT, RESULT) <- Append(LEFT, RIGHT, RESULT)

# Split(PREFIX, SUFFIX, WHOLE): WHOLE = PREFIX ++ SUFFIX
Split(PREFIX, SUFFIX, WHOLE) <- Append(PREFIX, SUFFIX, WHOLE)

# Length/2
ListLength(LIST, N) <- Length(LIST, N)

# Last/2
ListLast(LIST, ELEMENT) <- Last(LIST, ELEMENT)

# Reverse/2
ListReverse(LIST, REVERSED) <- Reverse(LIST, REVERSED)

# GetItem/3 (0-based)
Get0(LIST, INDEX, ELEMENT) <- GetItem(INDEX, LIST, ELEMENT)

# Flatten/2
Flat(LIST, RESULT) <- Flatten(LIST, RESULT)

# MergeSort/2 (stable sort, keeps duplicates), Sort/2 (removes duplicates)
SortedWithDups(LIST, RESULT) <- MergeSort(LIST, RESULT)
SortedUnique(LIST, RESULT) <- Sort(LIST, RESULT)

# Permutation/2
Perms(LIST, RESULT) <- Permutation(LIST, RESULT)

# Select/3: select element from list leaving rest
Pick(ELEMENT, LIST, REST) <- Select(ELEMENT, LIST, REST)

# Subtract/3, Intersection/3, Union/3
ListDiff(LEFT, RIGHT, RESULT) <- Subtract(LEFT, RIGHT, RESULT)
ListInter(LEFT, RIGHT, RESULT) <- Intersection(LEFT, RIGHT, RESULT)
ListUnion(LEFT, RIGHT, RESULT) <- Union(LEFT, RIGHT, RESULT)

# ToSet/2: remove duplicates preserving order
Dedup(LIST, RESULT) <- ToSet(LIST, RESULT)

# SumList/2, MaxList/2, MinList/2
Total(LIST, SUM) <- SumList(LIST, SUM)
Maximum(LIST, MAX) <- MaxList(LIST, MAX)
Minimum(LIST, MIN) <- MinList(LIST, MIN)

# Unzip/3, PairKeys/2, PairValues/2
MakePairs(KEYS, VALUES, PAIRS) <- Unzip(PAIRS, KEYS, VALUES)
KeysOf(PAIRS, KEYS) <- PairKeys(PAIRS, KEYS)
ValuesOf(PAIRS, VALUES) <- PairValues(PAIRS, VALUES)


Test("has member") <- HasMember(2, [1, 2, 3])
Test("append") <- (Concat([1, 2], [3, 4], RESULT), RESULT == [1, 2, 3, 4])
Test("length") <- (ListLength([1, 2, 3], N), N == 3)
Test("last") <- (ListLast([1, 2, 3], ELEMENT), ELEMENT == 3)
Test("reverse") <- (ListReverse([1, 2, 3], RESULT), RESULT == [3, 2, 1])
Test("get item") <- (Get0([10, 20, 30], 1, ELEMENT), ELEMENT == 20)
Test("flatten") <- (Flat([1, [2, 3], [4, [5]]], RESULT), RESULT == [1, 2, 3, 4, 5])
Test("sorted with dups") <- (SortedWithDups([3, 1, 2, 1], RESULT), RESULT == [1, 1, 2, 3])
Test("sorted unique") <- (SortedUnique([3, 1, 2, 1], RESULT), RESULT == [1, 2, 3])
Test("sum list") <- (Total([1, 2, 3, 4], SUM), SUM == 10)
Test("max list") <- (Maximum([3, 1, 4, 1, 5], MAX), MAX == 5)
Test("min list") <- (Minimum([3, 1, 4, 1, 5], MIN), MIN == 1)
Test("dedup") <- (Dedup([1, 2, 1, 3, 2], RESULT), RESULT == [1, 2, 3])
