# Tests for constraint predicates: dif/2, eq/3, dif_t/3

# dif/2 — disequality constraint
not_equal(X, Y) <- dif(X, Y)

# Use dif inside a rule: pick an element different from a given value
pick_different(X, LIST, PICKED) <- (
    PICKED in LIST,
    PICKED is not X
)

# eq/3 — reified equality: TRUTH is True if X=Y, False if dif(X,Y)
reified_eq(X, Y, TRUTH) <- eq(X, Y, TRUTH)

# dif_t/3 — reified disequality
reified_dif(X, Y, TRUTH) <- dif_t(X, Y, TRUTH)

# Use reified eq to categorize pairs
same_or_diff(X, Y, "same") <- eq(X, Y, True)
same_or_diff(X, Y, "different") <- eq(X, Y, False)


Test("not equal") <- not_equal(1, 2)  # nv
Test("pick different") <- (pick_different(1, [1, 2, 3], PICKED), PICKED == 2)  # nv
# Can the TRUTH == ... be put into the reified_... goal? Then make it a single goal body (no enclosing ()).
Test("reified eq true") <- (reified_eq(1, 1, TRUTH), TRUTH == True)  # nv
Test("reified eq false") <- (reified_eq(1, 2, TRUTH), TRUTH == False)  # nv
Test("reified dif true") <- (reified_dif(1, 2, TRUTH), TRUTH == True)  # nv
Test("same or diff same") <- same_or_diff(1, 1, "same")  # nv
Test("same or diff different") <- same_or_diff(1, 2, "different")  # nv
