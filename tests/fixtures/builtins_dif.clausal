# Tests for constraint predicates: dif/2, eq/3, dif_t/3

# dif/2 — disequality constraint
NotEqual(X, Y) <- dif(X, Y)

# Use dif inside a rule: pick an element different from a given value
PickDifferent(X, LIST, PICKED) <- (
    PICKED in LIST,
    PICKED is not X
)

# eq/3 — reified equality: TRUTH is True if X=Y, False if dif(X,Y)
ReifiedEq(X, Y, TRUTH) <- eq(X, Y, TRUTH)

# dif_t/3 — reified disequality
ReifiedDif(X, Y, TRUTH) <- dif_t(X, Y, TRUTH)

# Use reified eq to categorize pairs
SameOrDiff(X, Y, "same") <- eq(X, Y, True)
SameOrDiff(X, Y, "different") <- eq(X, Y, False)


Test("not equal") <- NotEqual(1, 2)  # nv
Test("pick different") <- (PickDifferent(1, [1, 2, 3], PICKED), PICKED == 2)  # nv
# Can the TRUTH == ... be put into the Reified... goal? Then make it a single goal body (no enclosing ()).
Test("reified eq true") <- (ReifiedEq(1, 1, TRUTH), TRUTH == True)  # nv
Test("reified eq false") <- (ReifiedEq(1, 2, TRUTH), TRUTH == False)  # nv
Test("reified dif true") <- (ReifiedDif(1, 2, TRUTH), TRUTH == True)  # nv
Test("same or diff same") <- SameOrDiff(1, 1, "same")  # nv
Test("same or diff different") <- SameOrDiff(1, 2, "different")  # nv
