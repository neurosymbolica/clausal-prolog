# Tests for higher-order list predicates: maplist/2, maplist/3, include/3, exclude/3, foldl/4
# Goals are passed as references to named predicates defined in this file.

# Helper predicates used as goals
-double_quotes(atom)

is_positive(X) <- (X > 0)

is_negative(X) <- (X < 0)

double(X, Y) <- (Y == X * 2)

add_step(NUMBER, ACCUMULATOR, NEXT) <- (NEXT == ACCUMULATOR + NUMBER)

# maplist/2 — Goal(Elem) holds for all elements
all_positive(LIST) <- maplist(is_positive, LIST)

# maplist/3 — maps each X to doubled Y
doubled(LIST, RESULT) <- maplist(double, LIST, RESULT)

# include/3 — filter keeping positives
keep_positives(LIST, RESULT) <- include(is_positive, LIST, RESULT)

# exclude/3 — remove negatives
drop_negatives(LIST, RESULT) <- exclude(is_negative, LIST, RESULT)

# foldl/4 — sum a list via fold
sum_fold(LIST, SUM) <- foldl(add_step, LIST, 0, SUM)


test("all positive") <- all_positive([1, 2, 3])  # nv
test("doubled list") <- (doubled([1, 2, 3], RESULT), RESULT == [2, 4, 6])  # nv
test("keep positives") <- (keep_positives([1, -2, 3, -4], RESULT), RESULT == [1, 3])  # nv
test("drop negatives") <- (drop_negatives([1, -2, 3, -4], RESULT), RESULT == [1, 3])  # nv
test("sum fold") <- (sum_fold([1, 2, 3, 4], SUM), SUM == 10)  # nv
