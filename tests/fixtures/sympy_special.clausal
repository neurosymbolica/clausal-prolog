-import_from(sympy_module, [Summation, ProductSym, Binomial, SymEqual, Inf])

# ── Summation/5 ──────────────────────────────────────────────────────────────

Test("sum of i from 1 to N") <- (
    Summation(I, I, 1, N, R),
    R == N*(N + 1)/2
)

Test("sum of i^2 from 1 to 5") <- (
    Summation(I**2, I, 1, 5, R),
    R == 55
)

Test("sum of constants") <- (
    Summation(3, I, 1, N, R),
    R == 3*N
)

# ── ProductSym/5 ─────────────────────────────────────────────────────────────

Test("product 1 to 5") <- (
    ProductSym(I, I, 1, 5, R),
    R == 120
)

Test("product symbolic") <- (
    ProductSym(X, X, 1, N, R),
    S is ++str(R),
    ++("factorial" in S)
)

# ── Binomial/3 ───────────────────────────────────────────────────────────────

Test("binomial 5 choose 2") <- (
    Binomial(5, 2, R),
    R == 10
)

Test("binomial 10 choose 0") <- (
    Binomial(10, 0, R),
    R == 1
)

Test("binomial 10 choose 10") <- (
    Binomial(10, 10, R),
    R == 1
)

Test("binomial symbolic") <- (
    Binomial(N, 2, R),
    R == N*(N - 1)/2
)
