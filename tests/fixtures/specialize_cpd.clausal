# Test fixture: conjunctive partial deduction (deforestation).
#
# Uses -specialize with cpd=True to produce deforested specialized predicates.
# Verifies that CPD produces correct results for natnum, graph, and counting.

-import_from(clausal.examples.metainterpreters, [Solve, SolveCount, SolveLimit])

# ── Object Programs ──────────────────────────────────────────────────────────

NatnumProgram(PROGRAM) <- (
    PROGRAM is [
        [["natnum", 0], []],
        [["natnum", ["s", X]], [["natnum", X]]]
    ]
)

GraphProgram(PROGRAM) <- (
    PROGRAM is [
        [["edge", "a", "b"], []],
        [["edge", "b", "c"], []],
        [["edge", "b", "d"], []],
        [["path", X, Y], [["edge", X, Y]]],
        [["path", X, Y], [["edge", X, Z], ["path", Z, Y]]]
    ]
)

# ── CPD Specializations ──────────────────────────────────────────────────────

-specialize(Solve, NatnumProgram, alias=CpdNatnum, cpd=True)
-specialize(Solve, GraphProgram, alias=CpdGraph, cpd=True)
-specialize(SolveCount, NatnumProgram, alias=CpdCountNatnum, cpd=True)
-specialize(SolveLimit, NatnumProgram, alias=CpdLimitNatnum, cpd=True)

# ── Natnum Tests ─────────────────────────────────────────────────────────────

test("cpd natnum(0)") <- CpdNatnum([["natnum", 0]])  # nv

test("cpd natnum(s(0))") <- CpdNatnum([["natnum", ["s", 0]]])  # nv

test("cpd natnum(s(s(s(0))))") <- CpdNatnum([["natnum", ["s", ["s", ["s", 0]]]]])  # nv

# ── Graph Tests ──────────────────────────────────────────────────────────────

test("cpd path(a,b)") <- CpdGraph([["path", "a", "b"]])  # nv

test("cpd path(a,c)") <- CpdGraph([["path", "a", "c"]])  # nv

test("cpd path(a,d)") <- CpdGraph([["path", "a", "d"]])  # nv

test("cpd edge(b,c)") <- CpdGraph([["edge", "b", "c"]])  # nv

# ── Count Tests ──────────────────────────────────────────────────────────────

test("cpd count natnum(0) = 1") <- CpdCountNatnum([["natnum", 0]], 1)  # nv

test("cpd count natnum(s(0)) = 2") <- CpdCountNatnum([["natnum", ["s", 0]]], 2)  # nv

test("cpd count natnum(s(s(0))) = 3") <- CpdCountNatnum([["natnum", ["s", ["s", 0]]]], 3)  # nv

# ── Limit Tests ──────────────────────────────────────────────────────────────

test("cpd limit natnum(s(s(0))) max=10") <- CpdLimitNatnum([["natnum", ["s", ["s", 0]]]], 10)  # nv
