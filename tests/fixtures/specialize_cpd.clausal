# Test fixture: conjunctive partial deduction (deforestation).
#
# Uses -specialize with cpd=True to produce deforested specialized predicates.
# Verifies that CPD produces correct results for natnum, graph, and counting.

-import_from(clausal.examples.metainterpreters, [Solve, SolveCount, SolveLimit])

# ── Object Programs ──────────────────────────────────────────────────────────

NatnumProgram(PROGRAM) <- (
    PROGRAM is [
        [["natnum", 0], []],
        [["natnum", ["s", X]], [["natnum", X]]]
    ]
)

GraphProgram(PROGRAM) <- (
    PROGRAM is [
        [["edge", "a", "b"], []],
        [["edge", "b", "c"], []],
        [["edge", "b", "d"], []],
        [["path", X, Y], [["edge", X, Y]]],
        [["path", X, Y], [["edge", X, Z], ["path", Z, Y]]]
    ]
)

# ── CPD Specializations ──────────────────────────────────────────────────────

-specialize(Solve, NatnumProgram, alias=CpdNatnum, cpd=True)
-specialize(Solve, GraphProgram, alias=CpdGraph, cpd=True)
-specialize(SolveCount, NatnumProgram, alias=CpdCountNatnum, cpd=True)
-specialize(SolveLimit, NatnumProgram, alias=CpdLimitNatnum, cpd=True)

# ── Natnum Tests ─────────────────────────────────────────────────────────────

Test("cpd natnum(0)") <- CpdNatnum([["natnum", 0]])

Test("cpd natnum(s(0))") <- CpdNatnum([["natnum", ["s", 0]]])

Test("cpd natnum(s(s(s(0))))") <- CpdNatnum([["natnum", ["s", ["s", ["s", 0]]]]])

# ── Graph Tests ──────────────────────────────────────────────────────────────

Test("cpd path(a,b)") <- CpdGraph([["path", "a", "b"]])

Test("cpd path(a,c)") <- CpdGraph([["path", "a", "c"]])

Test("cpd path(a,d)") <- CpdGraph([["path", "a", "d"]])

Test("cpd edge(b,c)") <- CpdGraph([["edge", "b", "c"]])

# ── Count Tests ──────────────────────────────────────────────────────────────

Test("cpd count natnum(0) = 1") <- CpdCountNatnum([["natnum", 0]], 1)

Test("cpd count natnum(s(0)) = 2") <- CpdCountNatnum([["natnum", ["s", 0]]], 2)

Test("cpd count natnum(s(s(0))) = 3") <- CpdCountNatnum([["natnum", ["s", ["s", 0]]]], 3)

# ── Limit Tests ──────────────────────────────────────────────────────────────

Test("cpd limit natnum(s(s(0))) max=10") <- CpdLimitNatnum([["natnum", ["s", ["s", 0]]]], 10)
