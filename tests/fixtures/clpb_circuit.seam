-double_quotes(atom)
-import_from(clausal.logic.clpb, [BoolEq])  # the name must resolve at compile time; BoolEq(A, B) lowers to the cell ('BoolEq', A, B)
# CLP(B) circuit integration fixture
#
# half_adder: SUM = X XOR Y, CARRY = X AND Y
# full_adder: built from two half adders
# pigeon_hole: 3 pigeons, 2 holes — unsatisfiable

half_adder(X, Y, SUM, CARRY) <- (
    sat(BoolEq(SUM, X ^ Y)),
    sat(BoolEq(CARRY, X & Y))
)

full_adder(X, Y, CARRY_IN, SUM, CARRY_OUT) <- (
    sat(BoolEq(SUM_STAGE1, X ^ Y)),
    sat(BoolEq(CARRY_STAGE1, X & Y)),
    sat(BoolEq(SUM, SUM_STAGE1 ^ CARRY_IN)),
    sat(BoolEq(CARRY_STAGE2, SUM_STAGE1 & CARRY_IN)),
    sat(BoolEq(CARRY_OUT, CARRY_STAGE1 | CARRY_STAGE2))
)

# 3 pigeons into 2 holes: each pigeon in exactly one hole,
# each hole has at most one pigeon.
# PIGEON_I_HOLE_J = pigeon I in hole J
pigeon_hole() <- (
    sat(PIGEON_1_HOLE_1 | PIGEON_1_HOLE_2),          # pigeon 1 in some hole
    sat(PIGEON_2_HOLE_1 | PIGEON_2_HOLE_2),           # pigeon 2 in some hole
    sat(PIGEON_3_HOLE_1 | PIGEON_3_HOLE_2),           # pigeon 3 in some hole
    sat(~(PIGEON_1_HOLE_1 & PIGEON_2_HOLE_1)),        # hole 1: not both pigeon 1 and 2
    sat(~(PIGEON_1_HOLE_1 & PIGEON_3_HOLE_1)),        # hole 1: not both pigeon 1 and 3
    sat(~(PIGEON_2_HOLE_1 & PIGEON_3_HOLE_1)),        # hole 1: not both pigeon 2 and 3
    sat(~(PIGEON_1_HOLE_2 & PIGEON_2_HOLE_2)),        # hole 2: not both pigeon 1 and 2
    sat(~(PIGEON_1_HOLE_2 & PIGEON_3_HOLE_2)),        # hole 2: not both pigeon 1 and 3
    sat(~(PIGEON_2_HOLE_2 & PIGEON_3_HOLE_2)),        # hole 2: not both pigeon 2 and 3
    bool_labeling([PIGEON_1_HOLE_1, PIGEON_1_HOLE_2, PIGEON_2_HOLE_1, PIGEON_2_HOLE_2, PIGEON_3_HOLE_1, PIGEON_3_HOLE_2])
)

test("half adder 0 0") <- (half_adder(0, 0, SUM, CARRY), SUM == 0, CARRY == 0)  # nv
test("half adder 1 0") <- (half_adder(1, 0, SUM, CARRY), SUM == 1, CARRY == 0)  # nv
test("half adder 1 1") <- (half_adder(1, 1, SUM, CARRY), SUM == 0, CARRY == 1)  # nv
test("full adder 1 1 1") <- (full_adder(1, 1, 1, SUM, CARRY), SUM == 1, CARRY == 1)  # nv
test("full adder 0 0 0") <- (full_adder(0, 0, 0, SUM, CARRY), SUM == 0, CARRY == 0)  # nv
