-import_from(tests.fixtures.importable_utils, [Helper, Double])

UseHelper(X, Y) <- Helper(X, Y)
UseDouble(X, RESULT) <- Double(X, RESULT)

test("use helper 2") <- (UseHelper(2, Y), Y == 4)  # nv
test("use double 3") <- (UseDouble(3, RESULT), RESULT == 6)  # nv
test("use helper 0") <- (UseHelper(0, Y), Y == 0)  # nv
