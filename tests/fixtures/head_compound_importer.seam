# Fixture for tests/test_head_match_imported_compound.py.
# Imports wrap/1 (a compound functor) from a sibling module and uses
# it in both rule-head and fact-head positions, alongside a catch-all
# clause.  A correct compiler should only fire the wrap-headed clause
# when the caller passes an actual wrap-shaped term.
-double_quotes(atom)

-import_from(tests.fixtures.head_compound_owner, [wrap, item, met, direct])
-module(head_compound_importer, [check(ITEM, RESULT),
                                 check_fact(ITEM, RESULT),
                                 check_mixed(ITEM, RESULT),
                                 check_nested(ITEM, RESULT),
                                 check_indexed(ITEM, RESULT),
                                 check_nested_fact(ITEM, RESULT),
                                 tagged(KEY, SHAPE)])

# Rule form — head contains the imported wrap compound.
# Should ONLY fire when ITEM is a wrap(_) term.
check(wrap(SUB_UNUSED), RESULT) <- (RESULT is "matched")
check(ANY_UNUSED,       "fallback"),

# Fact form (trailing-comma) — same head shape.  The fact path
# already routes correctly today via body Unify; included as the
# parity comparison.
check_fact(wrap(SUB_UNUSED), "matched"),
check_fact(ANY_UNUSED,       "fallback"),

# Mixed: rule that destructures further to bind SUB.
check_mixed(wrap(SUB), RESULT) <- (RESULT is SUB)
check_mixed(ANY_UNUSED,       "fallback"),

# Nested imported compounds — the case from the original
# clausal-thai_imm_rules report:
# ``RenderItem(item(REQ_ID, met(S), _, _), NL) <- (NL is REQ_ID)``.
# Both the outer item(_, _, _) and inner met(_) are imported compound
# functors; pattern-matching must destructure both.
check_nested(item(REQ_ID, met(SUB_UNUSED), _), RESULT) <- (RESULT is REQ_ID)
check_nested(ANY_UNUSED, "fallback"),

# Indexer-stress variant: enough rule clauses for the first-argument
# indexer (_INDEX_THRESHOLD = 4) to actually engage.  Without the
# arg_index fix the rule clauses get bucketed under ``('Call', 4)`` at
# compile time but a runtime ``wrap`` term keys to ``('wrap', 1)`` —
# the buckets never match and only the catchall fires.
check_indexed(wrap(SUB_UNUSED), R) <- (R is "first")
check_indexed(wrap(SUB_UNUSED), R) <- (R is "second")
check_indexed(item(REQ_UNUSED, S_UNUSED, D_UNUSED), R) <- (R is "item")
check_indexed(item(REQ_UNUSED, met(_), D_UNUSED), R) <- (R is "item-met")
check_indexed(ANY_UNUSED, "fallback"),

# Second-position imported-compound index.  The distinguishing key is
# arg0 (a plain string); the imported compound sits at arg1.  >= 4 fact
# clauses engage the first-argument indexer, and a query with arg0
# UNBOUND + arg1 bound to an imported compound routes dispatch onto the
# arg1 index.  The Phase-8 lift used to put an unresolved Call(LoadName
# wrap) into the bucket head whose bucket globals lacked the class, so
# head_to_match_pattern emitted MatchClass(Call) and the bucket returned
# nothing.  A correct compiler enumerates every row for the queried functor.
tagged("r1", wrap(direct)),
tagged("r2", item(direct, direct, direct)),
tagged("r3", wrap(direct)),
tagged("r4", item(direct, direct, direct)),

# Nested-compound parity baseline.  The fact form already routes
# correctly today via runtime body-Unify resolution; pairing it with
# the rule form lets the test assert dispatch equivalence on the head
# shape my fix specifically targets.  Fact clauses use bare-Var head
# vars so the body-rewrite has a captured cell to bind the marker into.
check_nested_fact(item(REQ_ID_UNUSED, met(SUB_UNUSED), _), "matched"),
check_nested_fact(ANY_UNUSED, "fallback"),
