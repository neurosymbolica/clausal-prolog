-module(iso_arithmetic, [Test/1]),

Double(X, Y) <- (Y := X * 2)

Square(X, Y) <- (Y := X * X)

TriangleNumber(N, T) <- (T := N * N + 1 // 2)

Test('addition: 1+2=3') <- (X := 1 + 2, X == 3)

Test('subtraction: 5-3=2') <- (X := 5 - 3, X == 2)

Test('multiplication: 3*4=12') <- (X := 3 * 4, X == 12)

Test('integer division: 7//2=3') <- (X := 7 // 2, X == 3)

Test('modulo: 7%2=1') <- (X := 7 % 2, X == 1)

Test('power: 2**3=8') <- (X := 2 ** 3, X == 8)

Test('negation: -3') <- (X := -3, X == -3)

Test('nested: (2+3)*4=20') <- (X := 2 + 3 * 4, X == 20)

Test('float addition: 1.5+2.5=4.0') <- (X := 1.5 + 2.5, X == 4.0)

Test('double negation: --5=5') <- (X := 5, X == 5)

Test('subtraction negative: 3-5=-2') <- (X := 3 - 5, X == -2)

Test('negative floor div: -7//2=-4') <- (X := -7 // 2, X == -4)

Test('negative mod: -7%2=1') <- (X := -7 % 2, X == 1)

Test('1 < 2') <- (1 < 2)

Test('not 2 < 1') <- (not 2 < 1)

Test('not 1 < 1') <- (not 1 < 1)

Test('1 <= 2') <- (1 <= 2)

Test('1 <= 1') <- (1 <= 1)

Test('2 > 1') <- (2 > 1)

Test('not 1 > 2') <- (not 1 > 2)

Test('2 >= 1') <- (2 >= 1)

Test('1 >= 1') <- (1 >= 1)

Test('1.5 < 2.5') <- (1.5 < 2.5)

Test('expression: 1+2 < 2+3') <- (1 + 2 < 2 + 3)

Test('expression: 1+2 <= 3') <- (1 + 2 <= 3)

Test('succ forward: succ(3,4)') <- (Succ(3, 4))

Test('succ backward: succ(X,4)=3') <- (Succ(X, 4), X == 3)

Test('succ zero: succ(0,1)') <- (Succ(0, 1))

Test('plus forward: 2+3=5') <- (Plus(2, 3, 5))

Test('plus backward x: X+3=5') <- (Plus(X, 3, 5), X == 2)

Test('plus backward y: 2+Y=5') <- (Plus(2, Y, 5), Y == 3)

Test('between check: 3 in 1..5') <- (Between(1, 5, 3))

Test('between out of range') <- (not Between(1, 5, 6))

Test('double 3 is 6') <- (Double(3, Y), Y == 6)

Test('double 0 is 0') <- (Double(0, Y), Y == 0)

Test('square 4 is 16') <- (Square(4, Y), Y == 16)

Test('square 1 is 1') <- (Square(1, Y), Y == 1)

Test('triangle 5 is 15') <- (TriangleNumber(5, T), T == 15)

Test('triangle 1 is 1') <- (TriangleNumber(1, T), T == 1)

Test('triangle 10 is 55') <- (TriangleNumber(10, T), T == 55)
