-private([a, b, hello])

-module(iso_unification, [test/1])

# library import of clausal.logic.clpfd dropped: it named only operator-spelled predicates

same_value(X, Y) <- (X is Y, '=='(X, Y))

test('atom unifies with itself') <- (_x is a, '=='(_x, a))

test('var unifies with atom') <- (_x is a, '=='(_x, a))

test('var unifies with integer') <- (_x is 42, _x == 42)

test('var unifies with list') <- (_x is [1, 2, 3], '=='(_x, [1, 2, 3]))

test('different atoms fail') <- (not (_x is a, _x is b, '=='(_x, b)))

test('list unification') <- (_x is [a], '=='(_x, [a]))

test('empty lists unify') <- (_x is [], '=='(_x, []))

test('different atoms: is not succeeds') <- (_x is a, dif(_x, b))

test('same atom: is not fails') <- (_x is a, not dif(_x, a))

test('same atom ==') <- ('=='(a, a))

test('different atoms == fails') <- (dif(a, b))

test('same integer ==') <- (42 == 42)

test('bound var == value') <- (_x is hello, '=='(_x, hello))

test('different atoms !=') <- (dif(a, b))

test('same atom != fails') <- (not dif(a, a))

test('same_value: integers') <- (same_value(42, 42))

test('same_value: strings') <- (same_value(hello, hello))

test('same_value: lists') <- (same_value([1, 2], [1, 2]))

test('integer unifies with itself') <- (X is 1, X == 1)

test('float unifies with itself') <- (X is 1.0, X == 1.0)

test('var unifies with var (aliasing)') <- (X is Y, '=='(X, Y))

test('different integers fail to unify') <- (not (X is 1, X is 2))

test('int vs float (clausal quirk): 1 is 1.0') <- (X is 1, X is 1.0)

test('list unify with var') <- (X is [1, 2, 3], '=='(X, [1, 2, 3]))

test('arithmetic term is structural: 1+2 != 3 in unify') <- (not (X is 1 + 2, X is 3))

test('var/atom is not: succeeds with constraint') <- (dif(_X_UNUSED, a))

test('different numbers: 1 is not 2') <- (dif(1, 2))

test('int == float (Python quirk)') <- (1 == 1.0)

test('two fresh vars: X == Y (CLP(FD) posts)') <- (_X_UNUSED == _Y_UNUSED)

test('same var: X == X') <- (X == X)

test('var != atom raises catchable type_error') <- (catch((dif(_X_UNUSED, a), False), _, True))

test('two fresh vars: X != Y') <- (dif(_X_UNUSED, _Y_UNUSED))

test('structural_eq: a == a') <- (structural_eq(a, a))

test('structural_eq: a != b fails') <- (not structural_eq(a, b))

test('structural_eq: 42 == 42') <- (structural_eq(42, 42))

test('structural_eq: same var') <- (X is Y, structural_eq(X, Y))

test('structural_eq: distinct unbound vars fail') <- (not structural_eq(_X_UNUSED, _Y_UNUSED))

test('structural_eq: unbound var vs atom fails') <- (not structural_eq(_X_UNUSED, a))

test('structural_eq: nested lists') <- (structural_eq([1, [2, 3]], [1, [2, 3]]))

test('structural_eq: distinct lists fail') <- (not structural_eq([1, 2], [1, 3]))

test('structural_neq: same var fails') <- (X is Y, not not structural_eq(X, Y))
