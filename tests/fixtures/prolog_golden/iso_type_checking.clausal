-private([abc, hello])

-module(iso_type_checking, [Test/1])

IsBoundNumber(X) <- (NonVar(X), Number(X))

Test('var: unbound var succeeds') <- (Var(X))

Test('var: integer fails') <- (not Var(42))

Test('var: atom fails') <- (not Var(hello))

Test('var: bound var fails') <- (X is 1, not Var(X))

Test('nonvar: integer succeeds') <- (NonVar(42))

Test('nonvar: atom succeeds') <- (NonVar(hello))

Test('nonvar: unbound var fails') <- (not NonVar(X))

Test('nonvar: bound var succeeds') <- (X is 1, NonVar(X))

Test('nonvar: list succeeds') <- (NonVar([1, 2]))

Test('atom: declared atom succeeds') <- (IsAtom(hello))

Test('atom: declared atom Abc') <- (IsAtom(abc))

Test('atom: string fails') <- (not IsAtom('hello'))

Test('atom: integer fails') <- (not IsAtom(1))

Test('atom: unbound var fails') <- (not IsAtom(X))

Test('str: plain string succeeds') <- (Atom('hello'))

Test('str: empty string succeeds') <- (Atom(''))

Test('str: declared atom fails') <- (not Atom(hello))

Test('str: integer fails') <- (not Atom(1))

Test('str: unbound var fails') <- (not Atom(X))

Test('str: list fails') <- (not Atom([]))

Test('integer: positive') <- (Integer(1))

Test('integer: zero') <- (Integer(0))

Test('integer: large') <- (Integer(100000000000000000000))

Test('integer: string fails') <- (not Integer('1'))

Test('integer: var fails') <- (not Integer(X))

Test('number: integer') <- (Number(42))

Test('number: float') <- (Number(3.14))

Test('number: string fails') <- (not Number('42'))

Test('number: var fails') <- (not Number(X))

Test('callable: declared atom') <- (IsCallable(hello))

Test('callable: string') <- (IsCallable('hello'))

Test('callable: int fails') <- (not IsCallable(42))

Test('callable: var fails') <- (not IsCallable(X))

Test('is_list: list') <- (IsList([1, 2, 3]))

Test('is_list: empty') <- (IsList([]))

Test('is_list: nested') <- (IsList([[1], [2]]))

Test('is_list: string fails') <- (not IsList(hello))

Test('is_list: int fails') <- (not IsList(42))

Test('is_list: var fails') <- (not IsList(X))

Test('ground: integer') <- (IsGround(42))

Test('ground: declared atom') <- (IsGround(abc))

Test('ground: ground list') <- (IsGround([1, 2, 3]))

Test('ground: empty list') <- (IsGround([]))

Test('ground: var fails') <- (not IsGround(X))

Test('is_bound_number: integer') <- (IsBoundNumber(42))

Test('is_bound_number: float') <- (IsBoundNumber(3.14))

Test('is_bound_number: string fails') <- (not IsBoundNumber('42'))

Test('is_bound_number: unbound fails') <- (not IsBoundNumber(X))
