-private([abc, hello])

-module(iso_type_checking, [Test/1])

IsBoundNumber(X) <- (nonvar(X), number(X))

Test('var: unbound var succeeds') <- (var(X))  # nv

Test('var: integer fails') <- (not var(42))  # nv

Test('var: atom fails') <- (not var(hello))  # nv

Test('var: bound var fails') <- (X is 1, not var(X))  # nv

Test('nonvar: integer succeeds') <- (nonvar(42))  # nv

Test('nonvar: atom succeeds') <- (nonvar(hello))  # nv

Test('nonvar: unbound var fails') <- (not nonvar(X))  # nv

Test('nonvar: bound var succeeds') <- (X is 1, nonvar(X))  # nv

Test('nonvar: list succeeds') <- (nonvar([1, 2]))  # nv

Test('atom: declared atom succeeds') <- (atom(hello))  # nv

Test('atom: declared atom Abc') <- (atom(abc))  # nv

Test('atom: string fails') <- (not atom('hello'))  # nv

Test('atom: integer fails') <- (not atom(1))  # nv

Test('atom: unbound var fails') <- (not atom(X))  # nv

Test('str: plain string succeeds') <- (atom('hello'))  # nv

Test('str: empty string succeeds') <- (atom(''))  # nv

Test('str: declared atom fails') <- (not atom(hello))  # nv

Test('str: integer fails') <- (not atom(1))  # nv

Test('str: unbound var fails') <- (not atom(X))  # nv

Test('str: list fails') <- (not atom([]))  # nv

Test('integer: positive') <- (integer(1))  # nv

Test('integer: zero') <- (integer(0))  # nv

Test('integer: large') <- (integer(100000000000000000000))  # nv

Test('integer: string fails') <- (not integer('1'))  # nv

Test('integer: var fails') <- (not integer(X))  # nv

Test('number: integer') <- (number(42))  # nv

Test('number: float') <- (number(3.14))  # nv

Test('number: string fails') <- (not number('42'))  # nv

Test('number: var fails') <- (not number(X))  # nv

Test('callable: declared atom') <- (callable_(hello))  # nv

Test('callable: string') <- (callable_('hello'))  # nv

Test('callable: int fails') <- (not callable_(42))  # nv

Test('callable: var fails') <- (not callable_(X))  # nv

Test('is_list: list') <- (is_list([1, 2, 3]))  # nv

Test('is_list: empty') <- (is_list([]))  # nv

Test('is_list: nested') <- (is_list([[1], [2]]))  # nv

Test('is_list: string fails') <- (not is_list(hello))  # nv

Test('is_list: int fails') <- (not is_list(42))  # nv

Test('is_list: var fails') <- (not is_list(X))  # nv

Test('ground: integer') <- (ground(42))  # nv

Test('ground: declared atom') <- (ground(abc))  # nv

Test('ground: ground list') <- (ground([1, 2, 3]))  # nv

Test('ground: empty list') <- (ground([]))  # nv

Test('ground: var fails') <- (not ground(X))  # nv

Test('is_bound_number: integer') <- (IsBoundNumber(42))  # nv

Test('is_bound_number: float') <- (IsBoundNumber(3.14))  # nv

Test('is_bound_number: string fails') <- (not IsBoundNumber('42'))  # nv

Test('is_bound_number: unbound fails') <- (not IsBoundNumber(X))  # nv
