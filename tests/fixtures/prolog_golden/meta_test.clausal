Squares(_numbers, _squares) <- (FindAll(_square, In(X, _numbers), _square := X * X, _squares))

Positives(_numbers, _positives) <- (FindAll(X, In(X, _numbers), X > 0, _positives))

UniqueMembers(_numbers, _unique) <- (SetOf(X, In(X, _numbers), _unique))

AllPositive(_numbers) <- (ForAll(In(X, _numbers), X > 0))

Test('squares') <- (Squares([1, 2, 3], _squares), _squares == [1, 4, 9])

Test('positives') <- (Positives([-1, 2, -3, 4], _positives), _positives == [2, 4])

Test('unique members') <- (UniqueMembers([1, 2, 1, 3, 2], _unique), _unique == [1, 2, 3])

Test('all positive') <- (AllPositive([1, 2, 3]))
