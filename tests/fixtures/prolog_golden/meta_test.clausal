Squares(numbers_, squares_) <- (FindAll(square_, In(X, numbers_), square_ := X * X, squares_))

Positives(numbers_, positives_) <- (FindAll(X, In(X, numbers_), X > 0, positives_))

UniqueMembers(numbers_, unique_) <- (SetOf(X, In(X, numbers_), unique_))

AllPositive(numbers_) <- (ForAll(In(X, numbers_), X > 0))

Test('squares') <- (Squares([1, 2, 3], squares_), squares_ == [1, 4, 9])

Test('positives') <- (Positives([-1, 2, -3, 4], positives_), positives_ == [2, 4])

Test('unique members') <- (UniqueMembers([1, 2, 1, 3, 2], unique_), unique_ == [1, 2, 3])

Test('all positive') <- (AllPositive([1, 2, 3]))
