-private([a, b, bird, cat, chases, dog, hello, likes, sees, the, world])

-module(dcg_grammar, [sentence/2, noun_phrase/2, verb_phrase/2, greeting/2, digit/3, ab/2, look_ahead/3, not_a/2, expr_dcg/3, valid_sentence/1])

greeting() >> ([hello, world])

noun_phrase() >> (([the, dog] or ([the, cat] or [a, bird])))

verb_phrase() >> (([chases] or ([sees] or [likes])))

sentence() >> ('noun_phrase', 'verb_phrase', 'noun_phrase')

digit(DIGIT) >> ([DIGIT], {DIGIT >= 0}, {DIGIT <= 9})

ab() >> ([a], 'ab')

ab() >> ([b], 'ab')

ab() >> ([])

(look_ahead(TOKEN), [TOKEN]) >> ([TOKEN])

not_a() >> (not [a], [_X_UNUSED])

valid_sentence(SENTENCE) <- (phrase('sentence', SENTENCE))

expr_dcg(EXPRESSION) >> ([EXPRESSION], {EXPRESSION is EXPRESSION + 0})

test('valid sentence') <- (valid_sentence([the, dog, chases, the, cat]))

test('greeting') <- (phrase('greeting', [hello, world]))

test('noun phrase dog') <- (phrase('noun_phrase', [the, dog]))

test('verb phrase chases') <- (phrase('verb_phrase', [chases]))

test('digit 3') <- (phrase(digit(3), [3]))
