# Tests for higher-order list predicates: MapList/2, MapList/3, Filter/3, Exclude/3, FoldLeft/4
# Goals are passed as references to named predicates defined in this file.

# Helper predicates used as goals

IsPositive(X) <- (X > 0)

IsNegative(X) <- (X < 0)

Double(X, Y) <- (Y := X * 2)

AddStep(NUMBER, ACCUMULATOR, NEXT) <- (NEXT := ACCUMULATOR + NUMBER)

# MapList/2 — Goal(Elem) holds for all elements
AllPositive(LIST) <- MapList(IsPositive, LIST)

# MapList/3 — maps each X to doubled Y
Doubled(LIST, RESULT) <- MapList(Double, LIST, RESULT)

# Filter/3 — filter keeping positives
KeepPositives(LIST, RESULT) <- Filter(IsPositive, LIST, RESULT)

# Exclude/3 — remove negatives
DropNegatives(LIST, RESULT) <- Exclude(IsNegative, LIST, RESULT)

# FoldLeft/4 — sum a list via fold
SumFold(LIST, SUM) <- FoldLeft(AddStep, LIST, 0, SUM)


Test("all positive") <- AllPositive([1, 2, 3])
Test("doubled list") <- (Doubled([1, 2, 3], RESULT), RESULT == [2, 4, 6])
Test("keep positives") <- (KeepPositives([1, -2, 3, -4], RESULT), RESULT == [1, 3])
Test("drop negatives") <- (DropNegatives([1, -2, 3, -4], RESULT), RESULT == [1, 3])
Test("sum fold") <- (SumFold([1, 2, 3, 4], SUM), SUM == 10)
