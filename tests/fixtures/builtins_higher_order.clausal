# Tests for higher-order list predicates: maplist/2, maplist/3, include/3, exclude/3, foldl/4
# Goals are passed as references to named predicates defined in this file.

# Helper predicates used as goals

IsPositive(X) <- (X > 0)

IsNegative(X) <- (X < 0)

Double(X, Y) <- (Y := X * 2)

AddStep(NUMBER, ACCUMULATOR, NEXT) <- (NEXT := ACCUMULATOR + NUMBER)

# maplist/2 — Goal(Elem) holds for all elements
AllPositive(LIST) <- maplist(IsPositive, LIST)

# maplist/3 — maps each X to doubled Y
Doubled(LIST, RESULT) <- maplist(Double, LIST, RESULT)

# include/3 — filter keeping positives
KeepPositives(LIST, RESULT) <- include(IsPositive, LIST, RESULT)

# exclude/3 — remove negatives
DropNegatives(LIST, RESULT) <- exclude(IsNegative, LIST, RESULT)

# foldl/4 — sum a list via fold
SumFold(LIST, SUM) <- foldl(AddStep, LIST, 0, SUM)


Test("all positive") <- AllPositive([1, 2, 3])  # nv
Test("doubled list") <- (Doubled([1, 2, 3], RESULT), RESULT == [2, 4, 6])  # nv
Test("keep positives") <- (KeepPositives([1, -2, 3, -4], RESULT), RESULT == [1, 3])  # nv
Test("drop negatives") <- (DropNegatives([1, -2, 3, -4], RESULT), RESULT == [1, 3])  # nv
Test("sum fold") <- (SumFold([1, 2, 3, 4], SUM), SUM == 10)  # nv
