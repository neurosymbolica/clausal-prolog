# Fibonacci
#
# fib(0, 0).
# fib(1, 1).
# fib(N, R) :- N > 1, N1 is N-1, N2 is N-2,
#              fib(N1, R1), fib(N2, R2), R is R1+R2.
#
# The first clause uses keyword syntax (N_=0, R_=0) to establish field
# names; subsequent clauses can use positional args mapped to those names.


fib(N_=0, R_=0),
fib(1, 1),
fib(N_, R_) <- (
    N_ > 1,
    N1_ is N_ - 1,
    N2_ is N_ - 2,
    fib(N1_, A_),
    fib(N2_, B_),
    R_ is A_ + B_
)
