# Fibonacci
#
# Fib(0, 0).
# Fib(1, 1).
# Fib(N, R) :- N > 1, N1 is N-1, N2 is N-2,
#              Fib(N1, R1), Fib(N2, R2), R is R1+R2.
#
# The first clause uses keyword syntax (N=0, RESULT=0) to establish field
# names; subsequent clauses can use positional args mapped to those names.


Fib(N=0, RESULT=0),
Fib(1, 1),
Fib(N, RESULT) <- (
    N > 1,
    N1 := N - 1,
    N2 := N - 2,
    Fib(N1, FIRST),
    Fib(N2, SECOND),
    RESULT := FIRST + SECOND
)


Test("fib 0") <- Fib(0, 0)
Test("fib 1") <- Fib(1, 1)
Test("fib 5") <- (Fib(5, RESULT), RESULT == 5)
Test("fib 10") <- (Fib(10, RESULT), RESULT == 55)
