# Owner of impord_verdict/2, spelled with ITS OWN field names.
#
# Downstream fixtures declare the same functor with DIFFERENT field names and
# also -import_from it, in both textual orderings — see
# todo/functor-field-name-mismatch-diagnostic.md.
-private([ok, no, cited, uncited])
-module(impord_vocab, [impord_verdict(OUTCOME, CITES)])

impord_verdict(ok, cited),
impord_verdict(no, uncited),
