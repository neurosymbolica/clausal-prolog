-import_module(jax)
-import_from(py.jax, [array, shape, array_list, null])
-import_from(py.jax_sharding, [
    jax_device, local_device,
    device_count, local_device_count,
    device_id, device_platform, device_of,
    make_mesh, mesh_shape, mesh_axis_names, mesh_devices,
    partition_spec, named_sharding, single_device_sharding,
    sharding, device_put,
    is_committed, is_fully_addressable, is_deleted
])

# --- Device enumeration ---

Test("jax_device finds at least one") <- (
    findall(D, jax_device(D), DS),
    length(DS, N),
    N >= 1
)  # nv

Test("device_count matches enumeration") <- (
    findall(D, jax_device(D), DS),
    length(DS, N),
    device_count(M),
    N == M
)  # nv

Test("local_device finds at least one") <- (
    findall(D, local_device(D), DS),
    length(DS, N),
    N >= 1
)  # nv

Test("local_device_count matches") <- (
    findall(D, local_device(D), DS),
    length(DS, N),
    local_device_count(M),
    N == M
)  # nv

Test("jax_device check mode") <- (
    jax_device(D),
    jax_device(D)         # second call checks D is a device
)  # nv

Test("device_id forward") <- (
    jax_device(D),
    device_id(D, ID),
    ID == 0
)  # nv

Test("device_id reverse") <- (
    device_id(D, 0),
    device_platform(D, "cpu")
)  # nv

Test("device_id enumerates all pairs when unbound") <- (
    findall(ID, device_id(_D, ID), IDS),
    device_count(N),
    length(IDS, N)
)  # nv

Test("device_platform is cpu on CI") <- (
    jax_device(D),
    device_platform(D, P),
    P == "cpu"
)  # nv

# --- device_of on a freshly-made array ---

Test("device_of returns a Device") <- (
    array([1.0, 2.0, 3.0], A),
    device_of(A, D),
    device_id(D, 0)
)  # nv

# --- Mesh ---

Test("make_mesh creates 1x mesh") <- (
    make_mesh([1], ["x"], MESH),
    mesh_axis_names(MESH, NAMES),
    NAMES == ("x",)
)  # nv

Test("mesh_shape check mode with dict literal") <- (
    make_mesh([1], ["x"], MESH),
    mesh_shape(MESH, {"x": 1})
)  # nv

Test("mesh_shape reach-through by key") <- (
    make_mesh([1], ["x"], MESH),
    mesh_shape(MESH, S),
    V is ++(S["x"]),
    V == 1
)  # nv

Test("mesh_devices has length matching mesh size") <- (
    make_mesh([1], ["x"], MESH),
    mesh_devices(MESH, DEVS),
    length(DEVS, 1)
)  # nv

# DEVS should be a plain list — pattern-match the first element.
# Clausal uses Python splat syntax [HEAD, *TAIL], not Prolog's [H | T].
# On a single-device CI host the mesh has exactly one device, so [D] /
# [D, *_REST] both match — prefer the splat form for portability to
# multi-device hosts.
Test("mesh_devices list pattern match") <- (
    make_mesh([1], ["x"], MESH),
    mesh_devices(MESH, [D, *_REST]),
    device_platform(D, "cpu")
)  # nv

# --- PartitionSpec and sharding construction ---

Test("partition_spec single axis") <- (
    partition_spec(["x"], P),
    partition_spec(AXES, P),
    AXES == ["x"]
)  # nv

Test("partition_spec with None unsharded") <- (
    partition_spec(["x", null], P),
    partition_spec(AXES, P),
    AXES == ["x", null]
)  # nv

Test("named_sharding construction succeeds") <- (
    make_mesh([1], ["x"], MESH),
    partition_spec(["x"], P),
    named_sharding(MESH, P, S),
    S != null
)  # nv

Test("named_sharding equal when built from equal mesh/spec") <- (
    make_mesh([1], ["x"], MESH1),
    make_mesh([1], ["x"], MESH2),
    partition_spec(["x"], P),
    named_sharding(MESH1, P, S1),
    named_sharding(MESH2, P, S2),
    S1 == S2
)  # nv

Test("single_device_sharding construction") <- (
    jax_device(D),
    single_device_sharding(D, S),
    S != null
)  # nv

# --- sharding/2 in query mode ---

Test("sharding query on fresh array") <- (
    array([1.0, 2.0, 3.0], A),
    sharding(A, S),
    S != null
)  # nv

# --- device_put ---

Test("device_put to specific device") <- (
    array([1.0, 2.0, 3.0], A),
    jax_device(D),
    device_put(A, D, A2),
    shape(A2, [3]),
    device_of(A2, D2),
    device_id(D2, 0)
)  # nv

Test("device_put preserves values") <- (
    array([1.0, 2.0, 3.0], A),
    jax_device(D),
    device_put(A, D, A2),
    array_list(A2, [1.0, 2.0, 3.0])
)  # nv

Test("device_put with named sharding") <- (
    array([[1.0, 2.0], [3.0, 4.0]], A),
    make_mesh([1], ["x"], MESH),
    partition_spec(["x"], P),
    named_sharding(MESH, P, NS),
    device_put(A, NS, A2),
    shape(A2, [2, 2])
)  # nv

Test("device_put with single-device sharding") <- (
    array([1.0, 2.0], A),
    jax_device(D),
    single_device_sharding(D, SDS),
    device_put(A, SDS, A2),
    array_list(A2, [1.0, 2.0])
)  # nv

# --- Check predicates ---

Test("is_fully_addressable on fresh array") <- (
    array([1.0, 2.0, 3.0], A),
    is_fully_addressable(A)
)  # nv

Test("is_committed after device_put") <- (
    array([1.0, 2.0, 3.0], A),
    jax_device(D),
    device_put(A, D, A2),
    is_committed(A2)
)  # nv

Test("is_deleted false on live array") <- (
    array([1.0, 2.0, 3.0], A),
    not is_deleted(A)
)  # nv
