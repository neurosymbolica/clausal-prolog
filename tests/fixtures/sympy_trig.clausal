-import_from(py.sympy, [TrigSimp, ExpandTrig, Simplify,
                             sin, cos, tan, exp, log, SymEqual])

# ── TrigSimp/2 ───────────────────────────────────────────────────────────────

Test("trig simp pythagorean") <- (
    TrigSimp(sin(X)**2 + cos(X)**2, R),
    R == 1
)

Test("trig simp double angle") <- (
    TrigSimp(2 * sin(X) * cos(X), R),
    R == sin(2*X)
)

# ── ExpandTrig/2 ─────────────────────────────────────────────────────────────

Test("expand trig sum") <- (
    ExpandTrig(sin(X + Y), R),
    R == sin(X)*cos(Y) + sin(Y)*cos(X)
)

Test("expand trig double") <- (
    ExpandTrig(cos(2*X), R),
    R == 2*cos(X)**2 - 1
)

# ── Mixed: trig + calculus ───────────────────────────────────────────────────

Test("simplify exp log") <- (
    Simplify(exp(log(X)), R),
    R == X
)
