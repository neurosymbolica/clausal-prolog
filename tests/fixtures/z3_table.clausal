# Z3 table constraint tests — exercises z3.table.

# ── Table constraint ────────────────────────────────────────────────────────

-implicit_atoms
TableSolve(X, Y) <- (
    z3.integer((
        0 <= X <= 10,
        0 <= Y <= 10,
    )),
    z3.table([X, Y], [[1, 2], [3, 4], [5, 6]]),
    z3.label([X, Y]),
)

Test("table 3 solutions") <- (count_all(TableSolve(_, _), N), N == 3)  # nv
Test("table first row") <- TableSolve(1, 2)  # nv
Test("table second row") <- TableSolve(3, 4)  # nv
Test("table third row") <- TableSolve(5, 6)  # nv
Test("table excludes others") <- (not(TableSolve(2, 3)))  # nv
