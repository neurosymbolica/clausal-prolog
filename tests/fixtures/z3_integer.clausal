# Z3 integer constraint tests — exercises z3.integer, z3.label, z3.check,
# z3.all_different, z3.maximize, z3.minimize, z3.optimize_label via the
# full Clausal compiler and runtime.

# ── Basic constraint posting and labeling ───────────────────────────────────

Solve(X, Y) <- (
    z3.integer((
        1 <= X <= 3,
        1 <= Y <= 3,
        X + Y == 4,
    )),
    z3.label([X, Y]),
)

Test("integer solve x+y=4") <- (Solve(X, Y), X == 1, Y == 3)
Test("integer solve x+y=4 second") <- (Solve(X, Y), X == 2, Y == 2)
Test("integer solve x+y=4 third") <- (Solve(X, Y), X == 3, Y == 1)
Test("integer solve count") <- (count_all(Solve(_, _), N), N == 3)

# ── Chained comparison domain ───────────────────────────────────────────────

Domain(X) <- (
    z3.integer((0 <= X <= 4)),
    z3.label([X]),
)

Test("integer domain 0..4") <- (count_all(Domain(_), N), N == 5)

# ── Inequality ──────────────────────────────────────────────────────────────

NotTwo(X) <- (
    z3.integer((
        0 <= X <= 3,
        X != 2,
    )),
    z3.label([X]),
)

Test("integer neq") <- (count_all(NotTwo(_), N), N == 3)
Test("integer neq excludes 2") <- (not(NotTwo(2)))

# ── Arithmetic expression ───────────────────────────────────────────────────

DoubleIs4(X) <- (
    z3.integer((
        0 <= X <= 10,
        X * 2 == 4,
    )),
    z3.label([X]),
)

Test("integer 2x=4") <- (DoubleIs4(X), X == 2)

# ── All different ───────────────────────────────────────────────────────────

AllDiff(X, Y, Z) <- (
    z3.integer((
        1 <= X <= 3,
        1 <= Y <= 3,
        1 <= Z <= 3,
    )),
    z3.all_different([X, Y, Z]),
    z3.label([X, Y, Z]),
)

Test("all_different 6 solutions") <- (count_all(AllDiff(_, _, _), N), N == 6)

# ── Satisfiability check ───────────────────────────────────────────────────

Test("z3 check sat") <- (
    z3.integer((1 <= X <= 10)),
    z3.check(),
)

Test("z3 check unsat") <- (
    z3.integer((
        X >= 10,
        X <= 5,
    )),
    not(z3.check()),
)

# ── Maximize / minimize ────────────────────────────────────────────────────

Test("z3 maximize") <- (
    z3.integer((
        0 <= X <= 10,
        0 <= Y <= 10,
        X + Y <= 10,
    )),
    z3.maximize(X + Y, COST),
    COST == 10,
)

Test("z3 minimize") <- (
    z3.integer((0 <= X <= 10)),
    z3.minimize(X, COST),
    COST == 0,
)

# ── Optimize + label ───────────────────────────────────────────────────────

Schedule(T1, T2, T3, COST) <- (
    z3.integer((
        0 <= T1 <= 100,
        0 <= T2 <= 100,
        0 <= T3 <= 100,
        T1 + 5 <= T2,
        T2 + 3 <= T3,
    )),
    z3.optimize_label([T1, T2, T3], T3, COST, "minimize"),
)

Test("schedule minimize") <- (Schedule(T1, T2, T3, COST), T1 == 0, T2 == 5, T3 == 8, COST == 8)
