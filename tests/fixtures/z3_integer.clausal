-double_quotes(chars)
# Z3 integer constraint tests — exercises z3.integer, z3.label, z3.check,
# z3.all_different, z3.maximize, z3.minimize, z3.optimize_label via the
# full Clausal compiler and runtime.

# ── Basic constraint posting and labeling ───────────────────────────────────

solve(X, Y) <- (
    z3.integer((
        1 <= X <= 3,
        1 <= Y <= 3,
        X + Y == 4,
    )),
    z3.label([X, Y]),
)

test("integer solve x+y=4") <- (solve(X, Y), X == 1, Y == 3)  # nv
test("integer solve x+y=4 second") <- (solve(X, Y), X == 2, Y == 2)  # nv
test("integer solve x+y=4 third") <- (solve(X, Y), X == 3, Y == 1)  # nv
test("integer solve count") <- (count_all(solve(_, _), N), N == 3)  # nv

# ── Chained comparison domain ───────────────────────────────────────────────

domain(X) <- (
    z3.integer((0 <= X <= 4)),
    z3.label([X]),
)

test("integer domain 0..4") <- (count_all(domain(_), N), N == 5)  # nv

# ── Inequality ──────────────────────────────────────────────────────────────

not_two(X) <- (
    z3.integer((
        0 <= X <= 3,
        X != 2,
    )),
    z3.label([X]),
)

test("integer neq") <- (count_all(not_two(_), N), N == 3)  # nv
test("integer neq excludes 2") <- (not(not_two(2)))  # nv

# ── Arithmetic expression ───────────────────────────────────────────────────

double_is4(X) <- (
    z3.integer((
        0 <= X <= 10,
        X * 2 == 4,
    )),
    z3.label([X]),
)

test("integer 2x=4") <- (double_is4(X), X == 2)  # nv

# ── All different ───────────────────────────────────────────────────────────

all_diff(X, Y, Z) <- (
    z3.integer((
        1 <= X <= 3,
        1 <= Y <= 3,
        1 <= Z <= 3,
    )),
    z3.all_different([X, Y, Z]),
    z3.label([X, Y, Z]),
)

test("all_different 6 solutions") <- (count_all(all_diff(_, _, _), N), N == 6)  # nv

# ── Satisfiability check ───────────────────────────────────────────────────

test("z3 check sat") <- (
    z3.integer((1 <= X <= 10)),
    z3.check(),
)  # nv

test("z3 check unsat") <- (
    z3.integer((
        X >= 10,
        X <= 5,
    )),
    not(z3.check()),
)  # nv

# ── Maximize / minimize ────────────────────────────────────────────────────

test("z3 maximize") <- (
    z3.integer((
        0 <= X <= 10,
        0 <= Y <= 10,
        X + Y <= 10,
    )),
    z3.maximize(X + Y, COST),
    COST == 10,
)  # nv

test("z3 minimize") <- (
    z3.integer((0 <= X <= 10)),
    z3.minimize(X, COST),
    COST == 0,
)  # nv

# ── Optimize + label ───────────────────────────────────────────────────────

schedule(T1, T2, T3, COST) <- (
    z3.integer((
        0 <= T1 <= 100,
        0 <= T2 <= 100,
        0 <= T3 <= 100,
        T1 + 5 <= T2,
        T2 + 3 <= T3,
    )),
    z3.optimize_label([T1, T2, T3], T3, COST, "minimize"),
)

test("schedule minimize") <- (schedule(T1, T2, T3, COST), T1 == 0, T2 == 5, T3 == 8, COST == 8)  # nv
