-import_from(scipy_optimize, [Minimize, MinimizeScalar, Root, RootScalar,
    LinearProgram, CurveFit, NonlinearLeastSquares, ResultGet])

# Minimize quadratic: x^2, starting from [3.0], minimum near [0.0]
Test("minimize quadratic bfgs") <- (
    Minimize(++(lambda x: float(x[0]**2)), ++([3.0]), RESULT) and
    ResultGet(RESULT, 'x', X) and
    ABS is ++(abs(float(X[0]))) and
    ABS < 1e-3)

# MinimizeScalar: (x-2)^2, minimum at x=2
Test("minimize scalar brent") <- (
    MinimizeScalar(++(lambda x: (x - 2.0)**2), RESULT) and
    ResultGet(RESULT, 'x', X) and
    DIFF is ++(abs(float(X) - 2.0)) and
    DIFF < 1e-4)

# MinimizeScalar with method
Test("minimize scalar with method") <- (
    MinimizeScalar(++(lambda x: (x - 1.5)**2), 'brent', RESULT) and
    ResultGet(RESULT, 'x', X) and
    DIFF is ++(abs(float(X) - 1.5)) and
    DIFF < 1e-4)

# RootScalar: x^2 - 4 = 0, root at x=2
Test("root scalar bisect") <- (
    RootScalar(++(lambda x: x**2 - 4.0), 'bisect', ++([1.0, 3.0]), RESULT) and
    ResultGet(RESULT, 'root', R) and
    DIFF is ++(abs(float(R) - 2.0)) and
    DIFF < 1e-6)

# Root: [x^2 - 4], starting from [1.0]
Test("root system") <- (
    Root(++(lambda x: [x[0]**2 - 4.0]), ++([1.0]), RESULT) and
    ResultGet(RESULT, 'x', X) and
    DIFF is ++(abs(float(X[0]) - 2.0)) and
    DIFF < 1e-6)

# LinearProgram: min -x s.t. x <= 3 -> x=3
Test("linear program 1d") <- (
    LinearProgram(++([-1.0]), ++([[1.0]]), ++([3.0]), RESULT) and
    ResultGet(RESULT, 'x', X) and
    DIFF is ++(abs(float(X[0]) - 3.0)) and
    DIFF < 1e-6)

# CurveFit: fit a*x+b to [0,1,2] -> [1,3,5], popt ~= [2, 1]
Test("curve fit linear") <- (
    CurveFit(++(lambda x, a, b: a*x + b),
             ++([0.0, 1.0, 2.0]),
             ++([1.0, 3.0, 5.0]),
             ++([1.0, 0.0]),
             RESULT) and
    ResultGet(RESULT, 'popt', P) and
    SLOPE is ++(abs(float(P[0]) - 2.0)) and
    SLOPE < 1e-4)

# NonlinearLeastSquares: residuals [x0-3, x1-4], minimum at [3,4]
Test("nonlinear least squares") <- (
    NonlinearLeastSquares(++(lambda x: [x[0] - 3.0, x[1] - 4.0]), ++([0.0, 0.0]), RESULT) and
    ResultGet(RESULT, 'x', X) and
    DIFF is ++(abs(float(X[0]) - 3.0) + abs(float(X[1]) - 4.0)) and
    DIFF < 1e-4)

# ResultGet: success field
Test("result get success") <- (
    Minimize(++(lambda x: float(x[0]**2)), ++([1.0]), RESULT) and
    ResultGet(RESULT, 'success', S) and
    S == True)
