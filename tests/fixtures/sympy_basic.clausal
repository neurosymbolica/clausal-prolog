-import_from(sympy_module, [Simplify, Expand, Factor, Solve, SolveAll,
                             Diff, Integrate, Limit, Series, Subs,
                             FreeVars, SymEqual, SymStr, Inf,
                             Sym, ToSympy, FromSympy])

# SymPy integration — native Clausal terms. No Sym(), no ++() for math.
# Results use == for symbolic comparison (SymExpr.__eq__ handles it).

# ── Simplify/2 ───────────────────────────────────────────────────────────────

Test("simplify cancellation") <- Simplify(X**2 + 2*X + 1 - (X + 1)**2, 0)

Test("simplify fraction") <- (
    Simplify((X**2 - 1) / (X - 1), R),
    R == X + 1
)

# ── Expand/2 ─────────────────────────────────────────────────────────────────

Test("expand square") <- (
    Expand((X + 1)**2, R),
    R == X**2 + 2*X + 1
)

Test("expand product") <- (
    Expand((X + 1) * (X - 1), R),
    R == X**2 - 1
)

Test("expand cube") <- (
    Expand((X + 1)**3, R),
    R == X**3 + 3*X**2 + 3*X + 1
)

# ── Factor/2 ─────────────────────────────────────────────────────────────────

Test("factor diff of squares") <- (
    Factor(X**2 - 1, R),
    R == (X - 1) * (X + 1)
)

Test("factor quadratic") <- (
    Factor(X**2 + 5*X + 6, R),
    R == (X + 2) * (X + 3)
)

# ── Solve/3: nondeterministic ────────────────────────────────────────────────

Test("solve linear") <- (
    Solve(2*X - 6, X, S),
    S == 3
)

Test("solve quadratic +2") <- (
    Solve(X**2 - 4, X, S),
    S == 2
)

Test("solve quadratic -2") <- (
    Solve(X**2 - 4, X, S),
    S == -2
)

# ── SolveAll/3 ───────────────────────────────────────────────────────────────

Test("solve all quadratic") <- (
    SolveAll(X**2 - 9, X, SOLS),
    S is ++sorted(SOLS),
    S == [-3, 3]
)

Test("solve all cubic") <- (
    SolveAll(X**3 - X, X, SOLS),
    S is ++sorted(SOLS),
    S == [-1, 0, 1]
)

# ── Diff/2,3 ─────────────────────────────────────────────────────────────────

Test("diff power rule") <- (
    Diff(X**3, X, R),
    R == 3*X**2
)

Test("diff constant") <- (
    Diff(5*X**0, X, R),
    R == 0
)

Test("diff sum") <- (
    Diff(X**2 + 3*X + 1, X, R),
    R == 2*X + 3
)

Test("diff partial") <- (
    Diff(X*Y + X**2, X, R),
    R == Y + 2*X
)

# ── Integrate/2,3 ────────────────────────────────────────────────────────────

Test("integrate power") <- (
    Integrate(X**2, X, R),
    R == X**3 / 3
)

Test("integrate sum") <- (
    Integrate(3*X**2 + 2*X, X, R),
    R == X**3 + X**2
)

# ── Limit/4 ──────────────────────────────────────────────────────────────────

Test("limit x→0 of x+1") <- (
    Limit(X + 1, X, 0, R),
    R == 1
)

Test("limit 1/x at inf") <- (
    Inf(INF),
    Limit(1/X, X, INF, R),
    R == 0
)

# ── Series/4 ─────────────────────────────────────────────────────────────────

Test("series 1/(1-x) to 4") <- (
    Series(1/(1-X), X, 4, R),
    R == 1 + X + X**2 + X**3
)

# ── SymEqual/2 still works for explicit use ─────────────────────────────────

Test("sym_equal reflexive") <- (
    SymEqual(
        X**2 + 1,
        1 + X**2
    )
)
Test("sym_equal nontrivial") <- (
    SymEqual(
        (X + 1)**2 - X**2,
        2*X + 1
    )
)

# ── == with SymExpr does symbolic comparison ────────────────────────────────

Test("== reorder") <- (
    Expand(X*Y, R),
    R == Y*X
)

# ── SymStr/2 — readable string output ───────────────────────────────────────

Test("sym_str constant") <- (
    SymStr(42, S),
    S == "42"
)

Test("sym_str expression") <- (
    SymStr(X**2 + 1, S),
    ++("**2" in S)
)

# ── Chaining — pipe results between predicates ──────────────────────────────

Test("expand then factor roundtrip") <- (
    Expand((X + 2) * (X + 3), EXP),
    Factor(EXP, F),
    F == (X + 2) * (X + 3)
)

Test("diff then integrate roundtrip") <- (
    Diff(X**4, X, D),
    Integrate(D, X, I),
    I == X**4
)

Test("solve then verify") <- (
    Solve(X**2 - 16, X, S),
    V is ++(S**2),
    V == 16
)

# ── Multivariate ────────────────────────────────────────────────────────────

Test("expand multivar") <- (
    Expand((X + Y)**2, R),
    R == X**2 + 2*X*Y + Y**2
)

# ── Sym/2 still works when you want named symbols ──────────────────────────

Test("sym named") <- (
    Sym("x", X),
    EXPR is ++(X**2 + 1),
    S is ++str(EXPR),
    S == "x**2 + 1"
)

# ── FreeVars/2 ───────────────────────────────────────────────────────────────

Test("free vars none") <- (
    FreeVars(42, V),
    V == []
)
