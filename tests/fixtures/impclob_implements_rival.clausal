# clausal: no-collect
# A SECOND implementer of the same declaration-only vocabulary functor.  If
# impclob_implements has already been loaded, the clauses on the shared class
# are ITS work, not impclob_decl_vocab's — the diagnostic must say so rather
# than crediting them to the (clause-free) vocabulary module.
-private([rival, elsewhere])
-module(impclob_implements_rival, [impclob_rival_check(STATUS)])
-import_from(tests.fixtures.impclob_decl_vocab, [impclob_verdict])

impclob_verdict(rival, elsewhere),

impclob_rival_check(S) <- impclob_verdict(S, C_UNUSED)
