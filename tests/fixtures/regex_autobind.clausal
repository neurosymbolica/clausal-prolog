-double_quotes(chars)
-import_from(py.re, [match, search, findall])

# -allow_singletons: every clause head parameter here is a regex named-group
# name (?P<NAME>...) referenced only via the group-name STRING inside the
# pattern; the singleton lint can't see that second reference (it's not an
# ast.Name), so it misreads every auto-bind parameter as unused.
-allow_singletons

# Regex auto-binding — ALLCAPS group names auto-bind to clause variables.

# ── Basic auto-binding ──────────────────────────────────────────────────────

parse_date(S, YEAR, MONTH, DAY) <- match(r"(?P<YEAR>\d{4})-(?P<MONTH>\d{2})-(?P<DAY>\d{2})", S)

test("auto-bind date parsing") <- (
    parse_date("2026-03-16", Y, M, D) and
    Y == "2026" and M == "03" and D == "16"
)  # nv

test("auto-bind no match fails") <- (not parse_date("not-a-date", _, _, _))  # nv

# ── Auto-bind constrains already-bound variables ────────────────────────────

is_year(S, YEAR) <- match(r"(?P<YEAR>\d{4})-\d{2}-\d{2}", S)

test("auto-bind output") <- (is_year("2026-03-16", Y) and Y == "2026")  # nv
test("auto-bind constrains correct") <- is_year("2026-03-16", "2026")  # nv
test("auto-bind constrains wrong fails") <- (not is_year("2026-03-16", "1999"))  # nv

# ── Auto-bind with search ──────────────────────────────────────────────────

find_tag(TEXT, TAG) <- search(r"<(?P<TAG>\w+)>", TEXT)

test("auto-bind search") <- (find_tag("text <bold> more", T) and T == "bold")  # nv

# ── Single group ────────────────────────────────────────────────────────────

first_word(S, WORD) <- match(r"(?P<WORD>\w+)", S)

test("auto-bind single group") <- (first_word("hello world", W) and W == "hello")  # nv

# ── Many groups ─────────────────────────────────────────────────────────────

parse_url(S, SCHEME, HOST, PORT, PATH) <- match(r"(?P<SCHEME>https?)://(?P<HOST>[^:/]+):(?P<PORT>\d+)(?P<PATH>/\S*)", S)

test("auto-bind many groups") <- (
    parse_url("https://example.com:8080/api/v1", S, H, P, PA) and
    S == "https" and H == "example.com" and P == "8080" and PA == "/api/v1"
)  # nv

# ── Leading-underscore groups ──────────────────────────────────────────────

extract_word(S, _word) <- match(r"(?P<_word>\w+)", S)

test("leading underscore auto-bind") <- (extract_word("hello world", W) and W == "hello")  # nv

# ── Mixed ALLCAPS and lowercase groups ──────────────────────────────────────

parse_log(LINE, LEVEL) <- match(r"(?P<timestamp>\S+)\s+(?P<LEVEL>INFO|WARN|ERROR):\s+(?P<msg>.*)", LINE)

test("selective binding ALLCAPS only") <- (parse_log("2026-03-16 ERROR: disk full", L) and L == "ERROR")  # nv

# ── Lowercase regex-only groups (backreferences) ───────────────────────────

has_repeated(S) <- search(r"(?P<word>\w+)\s+(?P=word)", S)

test("lowercase groups for backrefs") <- has_repeated("the the cat")  # nv
test("lowercase groups no repeat fails") <- (not has_repeated("the cat sat"))  # nv

# ── Optional groups bind None ──────────────────────────────────────────────

opt_parse(S, A, B) <- match(r"(?P<A>\d+)(?:-(?P<B>\d+))?", S)

test("optional group both present") <- (opt_parse("42-99", A, B) and A == "42" and B == "99")  # nv
test("optional group absent binds None") <- (opt_parse("42", A, B) and A == "42" and B is None)  # nv

# ── Typo in group name ──────────────────────────────────────────────────────
# (Tested in Python test_regex.py — requires is_var() check not available as builtin)

# ── Practical: log parser ──────────────────────────────────────────────────

parse_log_full(LINE, LEVEL, MSG) <- match(r"(?P<LEVEL>INFO|WARN|ERROR):\s*(?P<MSG>.*)", LINE)

test("log parser compact") <- (
    parse_log_full("ERROR: disk full", L, M) and
    L == "ERROR" and M == "disk full"
)  # nv

# ── Practical: backtracking + regex ─────────────────────────────────────────

line("2026-03-16 INFO started"),
line("2026-03-16 ERROR disk full"),
line("2026-03-16 INFO stopped"),

error_message(MSG) <- (
    line(L) and
    match(r"\S+ ERROR\s+(?P<MSG>.*)", L)
)

test("backtracking with regex") <- (error_message(M) and M == "disk full")  # nv

# ── Practical: tokenizer via findall ─────────────────────────────────────

token(S, T) <- findall(r"[a-zA-Z_]\w*|\d+|[+\-*/=]", S, T)

test("tokenizer first token") <- (token("x = 42 + y", T) and T == "x")  # nv
