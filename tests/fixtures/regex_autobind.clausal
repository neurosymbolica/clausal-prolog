-import_from(py.re, [Match, Search, FindAll])

# Regex auto-binding — ALLCAPS group names auto-bind to clause variables.

# ── Basic auto-binding ──────────────────────────────────────────────────────

ParseDate(S, YEAR, MONTH, DAY) <- Match(r"(?P<YEAR>\d{4})-(?P<MONTH>\d{2})-(?P<DAY>\d{2})", S)

Test("auto-bind date parsing") <- (
    ParseDate("2026-03-16", Y, M, D) and
    Y == "2026" and M == "03" and D == "16"
)

Test("auto-bind no match fails") <- (not ParseDate("not-a-date", _, _, _))

# ── Auto-bind constrains already-bound variables ────────────────────────────

IsYear(S, YEAR) <- Match(r"(?P<YEAR>\d{4})-\d{2}-\d{2}", S)

Test("auto-bind output") <- (IsYear("2026-03-16", Y) and Y == "2026")
Test("auto-bind constrains correct") <- IsYear("2026-03-16", "2026")
Test("auto-bind constrains wrong fails") <- (not IsYear("2026-03-16", "1999"))

# ── Auto-bind with Search ──────────────────────────────────────────────────

FindTag(TEXT, TAG) <- Search(r"<(?P<TAG>\w+)>", TEXT)

Test("auto-bind search") <- (FindTag("text <bold> more", T) and T == "bold")

# ── Single group ────────────────────────────────────────────────────────────

FirstWord(S, WORD) <- Match(r"(?P<WORD>\w+)", S)

Test("auto-bind single group") <- (FirstWord("hello world", W) and W == "hello")

# ── Many groups ─────────────────────────────────────────────────────────────

ParseUrl(S, SCHEME, HOST, PORT, PATH) <- Match(r"(?P<SCHEME>https?)://(?P<HOST>[^:/]+):(?P<PORT>\d+)(?P<PATH>/\S*)", S)

Test("auto-bind many groups") <- (
    ParseUrl("https://example.com:8080/api/v1", S, H, P, PA) and
    S == "https" and H == "example.com" and P == "8080" and PA == "/api/v1"
)

# ── Trailing-underscore groups ──────────────────────────────────────────────

ExtractWord(S, word_) <- Match(r"(?P<word_>\w+)", S)

Test("trailing underscore auto-bind") <- (ExtractWord("hello world", W) and W == "hello")

# ── Mixed ALLCAPS and lowercase groups ──────────────────────────────────────

ParseLog(LINE, LEVEL) <- Match(r"(?P<timestamp>\S+)\s+(?P<LEVEL>INFO|WARN|ERROR):\s+(?P<msg>.*)", LINE)

Test("selective binding ALLCAPS only") <- (ParseLog("2026-03-16 ERROR: disk full", L) and L == "ERROR")

# ── Lowercase regex-only groups (backreferences) ───────────────────────────

HasRepeated(S) <- Search(r"(?P<word>\w+)\s+(?P=word)", S)

Test("lowercase groups for backrefs") <- HasRepeated("the the cat")
Test("lowercase groups no repeat fails") <- (not HasRepeated("the cat sat"))

# ── Optional groups bind None ──────────────────────────────────────────────

OptParse(S, A, B) <- Match(r"(?P<A>\d+)(?:-(?P<B>\d+))?", S)

Test("optional group both present") <- (OptParse("42-99", A, B) and A == "42" and B == "99")
Test("optional group absent binds None") <- (OptParse("42", A, B) and A == "42" and B is None)

# ── Typo in group name ──────────────────────────────────────────────────────
# (Tested in Python test_regex.py — requires is_var() check not available as builtin)

# ── Practical: log parser ──────────────────────────────────────────────────

ParseLogFull(LINE, LEVEL, MSG) <- Match(r"(?P<LEVEL>INFO|WARN|ERROR):\s*(?P<MSG>.*)", LINE)

Test("log parser compact") <- (
    ParseLogFull("ERROR: disk full", L, M) and
    L == "ERROR" and M == "disk full"
)

# ── Practical: backtracking + regex ─────────────────────────────────────────

Line("2026-03-16 INFO started"),
Line("2026-03-16 ERROR disk full"),
Line("2026-03-16 INFO stopped"),

ErrorMessage(MSG) <- (
    Line(L) and
    Match(r"\S+ ERROR\s+(?P<MSG>.*)", L)
)

Test("backtracking with regex") <- (ErrorMessage(M) and M == "disk full")

# ── Practical: tokenizer via FindAll ─────────────────────────────────────

Token(S, T) <- FindAll(r"[a-zA-Z_]\w*|\d+|[+\-*/=]", S, T)

Test("tokenizer first token") <- (Token("x = 42 + y", T) and T == "x")
