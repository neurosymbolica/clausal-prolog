# Tests for term inspection predicates: functor/3, arg/3, unpack/2

# functor/3 — decompose mode: extract functor name and arity
GetFunctor(TERM, FUNCTOR, ARITY) <- functor(TERM, FUNCTOR, ARITY)

# functor/3 — construct mode: build compound from name and arity
BuildTerm(FUNCTOR, ARITY, TERM) <- functor(TERM, FUNCTOR, ARITY)

# arg/3 — extract nth argument (1-based)
FirstArg(TERM, ARG) <- arg(1, TERM, ARG)
SecondArg(TERM, ARG) <- arg(2, TERM, ARG)

# unpack/2 — decompose term to list
TermToList(TERM, LIST) <- unpack(TERM, LIST)

# unpack/2 — construct term from list
ListToTerm(LIST, TERM) <- unpack(TERM, LIST)


# F088/F089/F090/F091 (audit 2026-06-13): under ISO cons-cell, list
# inputs decompose as cons-cells; P3-1 Task 5 (§1b/R2) RETIRES the
# str~char-list cons rule, so str inputs no longer follow it -- a str
# is atomic (its own functor, arity 0):
#   functor("hello", F, A)  → F="hello", A=0  (str is its own atom)
#   functor("", F, A)       → F="[]", A=0     (empty / nil atom, unaffected)
#   arg(1, [a,b,c], X)      → X=a             (head, list unaffected)
#   arg(2, [a,b,c], X)      → X=[b,c]         (cons-cell tail, list unaffected)
#   unpack("foo", L)        → L=["foo"]       (str is its own atom, was [".","f","oo"])
Test("functor str is its own atom") <- (GetFunctor("hello", FUNCTOR, ARITY), FUNCTOR == "hello", ARITY == 0)  # nv
Test("functor empty str nil") <- (GetFunctor("", FUNCTOR, ARITY), FUNCTOR == "[]", ARITY == 0)  # nv
Test("functor number") <- (GetFunctor(42, FUNCTOR, ARITY), FUNCTOR == 42, ARITY == 0)  # nv A09-F027: constant is its own functor name
Test("arg list head") <- (FirstArg([10, 20, 30], ARG), ARG == 10)  # nv
Test("arg list tail") <- (SecondArg([10, 20, 30], ARG), ARG == [20, 30])  # nv
Test("term to list str is its own atom") <- (TermToList("foo", LIST), LIST == ["foo"])  # nv
Test("list to term atom") <- (ListToTerm(["bar"], TERM), TERM == "bar")  # nv
