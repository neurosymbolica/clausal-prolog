# Tests for term inspection predicates: Functor/3, Arg/3, Unpack/2

# Functor/3 — decompose mode: extract functor name and arity
GetFunctor(T_, F_, A_) <- Functor(T_, F_, A_)

# Functor/3 — construct mode: build compound from name and arity
BuildTerm(F_, A_, T_) <- Functor(T_, F_, A_)

# Arg/3 — extract nth argument (1-based)
FirstArg(T_, A_) <- Arg(1, T_, A_)
SecondArg(T_, A_) <- Arg(2, T_, A_)

# Unpack/2 — decompose term to list
TermToList(T_, L_) <- Unpack(T_, L_)

# Unpack/2 — construct term from list
ListToTerm(L_, T_) <- Unpack(T_, L_)


Test("functor atom") <- (GetFunctor("hello", F_, A_), F_ == "hello", A_ == 0)
Test("functor number") <- (GetFunctor(42, F_, A_), F_ == "42", A_ == 0)
Test("arg list first") <- (FirstArg([10, 20, 30], A_), A_ == 10)
Test("arg list second") <- (SecondArg([10, 20, 30], A_), A_ == 20)
Test("term to list atom") <- (TermToList("foo", L_), L_ == ["foo"])
Test("list to term atom") <- (ListToTerm(["bar"], T_), T_ == "bar")
