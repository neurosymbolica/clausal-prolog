# Tests for term inspection predicates: functor/3, arg/3, unpack/2

# functor/3 — decompose mode: extract functor name and arity
GetFunctor(TERM, FUNCTOR, ARITY) <- functor(TERM, FUNCTOR, ARITY)

# functor/3 — construct mode: build compound from name and arity
BuildTerm(FUNCTOR, ARITY, TERM) <- functor(TERM, FUNCTOR, ARITY)

# arg/3 — extract nth argument (1-based)
FirstArg(TERM, ARG) <- arg(1, TERM, ARG)
SecondArg(TERM, ARG) <- arg(2, TERM, ARG)

# unpack/2 — decompose term to list
TermToList(TERM, LIST) <- unpack(TERM, LIST)

# unpack/2 — construct term from list
ListToTerm(LIST, TERM) <- unpack(TERM, LIST)


Test("functor atom") <- (GetFunctor("hello", FUNCTOR, ARITY), FUNCTOR == "hello", ARITY == 0)  # nv
Test("functor number") <- (GetFunctor(42, FUNCTOR, ARITY), FUNCTOR == "42", ARITY == 0)  # nv
Test("arg list first") <- (FirstArg([10, 20, 30], ARG), ARG == 10)  # nv
Test("arg list second") <- (SecondArg([10, 20, 30], ARG), ARG == 20)  # nv
Test("term to list atom") <- (TermToList("foo", LIST), LIST == ["foo"])  # nv
Test("list to term atom") <- (ListToTerm(["bar"], TERM), TERM == "bar")  # nv
