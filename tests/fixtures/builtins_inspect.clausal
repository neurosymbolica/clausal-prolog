# Tests for term inspection predicates: functor/3, arg/3, unpack/2

# functor/3 — decompose mode: extract functor name and arity
get_functor(TERM, FUNCTOR, ARITY) <- functor(TERM, FUNCTOR, ARITY)

# functor/3 — construct mode: build compound from name and arity
build_term(FUNCTOR, ARITY, TERM) <- functor(TERM, FUNCTOR, ARITY)

# arg/3 — extract nth argument (1-based)
first_arg(TERM, ARG) <- arg(1, TERM, ARG)
second_arg(TERM, ARG) <- arg(2, TERM, ARG)

# unpack/2 — decompose term to list
term_to_list(TERM, LIST) <- unpack(TERM, LIST)

# unpack/2 — construct term from list
list_to_term(LIST, TERM) <- unpack(TERM, LIST)


# F088/F089/F090/F091 (audit 2026-06-13): under ISO cons-cell, list
# inputs decompose as cons-cells; P3-1 Task 5 (§1b/R2) RETIRES the
# str~char-list cons rule, so str inputs no longer follow it -- a str
# is atomic (its own functor, arity 0):
#   functor("hello", F, A)  → F="hello", A=0  (str is its own atom)
#   functor("", F, A)       → F="[]", A=0     (empty / nil atom, unaffected)
#   arg(1, [a,b,c], X)      → X=a             (head, list unaffected)
#   arg(2, [a,b,c], X)      → X=[b,c]         (cons-cell tail, list unaffected)
#   unpack("foo", L)        → L=["foo"]       (str is its own atom, was [".","f","oo"])
test("functor str is its own atom") <- (get_functor("hello", FUNCTOR, ARITY), FUNCTOR == "hello", ARITY == 0)  # nv
# THE FLIP: "" is the ATOM with the empty spelling in this (default
# ``-double_quotes(atom)``) module, and an atom is its own functor at
# arity 0.  The empty STRING, which decomposes as the empty list does, is
# spelled [] here.
test("functor empty atom") <- (get_functor("", FUNCTOR, ARITY), FUNCTOR is "", ARITY == 0)  # nv
test("functor empty list nil") <- (get_functor([], FUNCTOR2, ARITY2), FUNCTOR2 is '[]', ARITY2 == 0)  # nv
test("functor number") <- (get_functor(42, FUNCTOR, ARITY), FUNCTOR == 42, ARITY == 0)  # nv A09-F027: constant is its own functor name
test("arg list head") <- (first_arg([10, 20, 30], ARG), ARG == 10)  # nv
test("arg list tail") <- (second_arg([10, 20, 30], ARG), ARG == [20, 30])  # nv
test("term to list str is its own atom") <- (term_to_list("foo", LIST), LIST == ["foo"])  # nv
test("list to term atom") <- (list_to_term(["bar"], TERM), TERM == "bar")  # nv
