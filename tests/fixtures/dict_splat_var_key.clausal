# Fixture for tests/test_dict_splat_var_key.py.
# A splat dict {**OLD, K: V} whose key K is bound in the SAME clause frame
# as the literal.  Before the fix K reached dict construction as the Var
# object, so the built dict was keyed by the variable and get(OUT, <value>)
# missed.  $dict_key now derefs the computed key at construction time.
-module(dict_splat_var_key, [splat_var_key(GOT), splat_literal_key(GOT),
                             splat_headarg_key(KEY, VAL, GOT)])

# Same-frame bound var key (the bug shape).
splat_var_key(GOT) <- (
    K is "age",
    OUT is {**{"name": "x"}, K: 20},
    get(OUT, "age", GOT)
)

# Literal key (control — always worked).
splat_literal_key(GOT) <- (
    OUT is {**{"name": "x"}, "age": 20},
    get(OUT, "age", GOT)
)

# Key arriving via a head arg (control — the pre-fix call-boundary workaround).
splat_headarg_key(KEY, VAL, GOT) <- (
    OUT is {**{"name": "x"}, KEY: VAL},
    get(OUT, KEY, GOT)
)
