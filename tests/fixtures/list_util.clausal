# V3-5: Extended list predicates — fixture tests

# ── take/3 ───────────────────────────────────────────────────────────────────
-double_quotes(atom)

test("take basic") <- (take(2, [1, 2, 3, 4], RESULT), RESULT == [1, 2])  # nv
test("take zero") <- (take(0, [1, 2, 3], RESULT), RESULT == [])  # nv
test("take more than length") <- (take(10, [1, 2], RESULT), RESULT == [1, 2])  # nv
test("take from empty") <- (take(3, [], RESULT), RESULT == [])  # nv

# ── drop/3 ───────────────────────────────────────────────────────────────────

test("drop basic") <- (drop(2, [1, 2, 3, 4], RESULT), RESULT == [3, 4])  # nv
test("drop zero") <- (drop(0, [1, 2, 3], RESULT), RESULT == [1, 2, 3])  # nv
test("drop all") <- (drop(3, [1, 2, 3], RESULT), RESULT == [])  # nv
test("drop more than length") <- (drop(10, [1, 2], RESULT), RESULT == [])  # nv

# ── split_at/4 ────────────────────────────────────────────────────────────────

test("split_at middle") <- (split_at(2, [1, 2, 3, 4], LEFT, RIGHT), LEFT == [1, 2], RIGHT == [3, 4])  # nv
test("split_at zero") <- (split_at(0, [1, 2, 3], LEFT, RIGHT), LEFT == [], RIGHT == [1, 2, 3])  # nv
test("split_at end") <- (split_at(3, [1, 2, 3], LEFT, RIGHT), LEFT == [1, 2, 3], RIGHT == [])  # nv
test("split_at beyond") <- (split_at(10, [1, 2], LEFT, RIGHT), LEFT == [1, 2], RIGHT == [])  # nv

# ── zip_/3 ────────────────────────────────────────────────────────────────────

test("zip equal") <- (zip_([1, 2, 3], ["a", "b", "c"], RESULT), RESULT == ['-'(1, "a"), '-'(2, "b"), '-'(3, "c")])  # nv
test("zip unequal") <- (zip_([1, 2], ["a", "b", "c"], RESULT), RESULT == ['-'(1, "a"), '-'(2, "b")])  # nv
test("zip empty") <- (zip_([], [1, 2], RESULT), RESULT == [])  # nv

# ── replicate/3 ──────────────────────────────────────────────────────────────

# F053 (C9 audit, option A): a list of CHAR elements promotes to a str
# result.  THE FLIP (2026-09-06-atoms-as-cells-strings): "x" is the char ATOM
# x in this ``-double_quotes(atom)`` module, and the promoted
# result is the STRING "xxx" — which is the list ["x", "x", "x"] of char
# atoms, and that is how this module can spell it.  The comparison is ``is``
# (unification), not ``==``: ``==`` is ARITHMETIC equality (ISO =:=), whose
# ground non-numeric fallback is Python ``==``, and Python does not know
# that a str and its char list are one term.
test("replicate basic") <- (replicate(3, "x", RESULT), RESULT is ["x", "x", "x"])  # nv
test("replicate zero") <- (replicate(0, "x", RESULT), RESULT is [])  # nv
test("replicate one") <- (replicate(1, 42, RESULT), RESULT == [42])  # nv

# ── split_with/3 ──────────────────────────────────────────────────────────────

test("split_with basic") <- (split_with(0, [1, 2, 0, 3, 4], RESULT), RESULT == [[1, 2], [3, 4]])  # nv
test("split_with no sep") <- (split_with(0, [1, 2, 3], RESULT), RESULT == [[1, 2, 3]])  # nv
test("split_with consecutive") <- (split_with(0, [1, 0, 0, 2], RESULT), RESULT == [[1], [], [2]])  # nv

# ── take_while/3 ──────────────────────────────────────────────────────────────

is_positive(X) <- (X > 0)

test("take_while basic") <- (take_while(is_positive, [1, 2, -3, 4], RESULT), RESULT == [1, 2])  # nv
test("take_while none match") <- (take_while(is_positive, [-1, 2, 3], RESULT), RESULT == [])  # nv
test("take_while all match") <- (take_while(is_positive, [1, 2, 3], RESULT), RESULT == [1, 2, 3])  # nv

# ── drop_while/3 ──────────────────────────────────────────────────────────────

test("drop_while basic") <- (drop_while(is_positive, [1, 2, -3, 4], RESULT), RESULT == [-3, 4])  # nv
test("drop_while none match") <- (drop_while(is_positive, [-1, 2, 3], RESULT), RESULT == [-1, 2, 3])  # nv
test("drop_while all match") <- (drop_while(is_positive, [1, 2, 3], RESULT), RESULT == [])  # nv

# ── span/4 ───────────────────────────────────────────────────────────────────

test("span basic") <- (span(is_positive, [1, 2, -3, 4], MATCHING, REST), MATCHING == [1, 2], REST == [-3, 4])  # nv

# ── group_by/3 ─────────────────────────────────────────────────────────────────

identity(X, X) <- True

test("group_by identity") <- (group_by(identity, [1, 1, 2, 2, 2, 3], RESULT), RESULT == [[1, 1], [2, 2, 2], [3]])  # nv

# ── sort_by/3 ─────────────────────────────────────────────────────────────────

my_neg(X, Y) <- (Y is ++(-X))

test("sort_by negate") <- (sort_by(my_neg, [1, 3, 2], RESULT), RESULT == [3, 2, 1])  # nv
test("sort_by empty") <- (sort_by(my_neg, [], RESULT), RESULT == [])  # nv

# ── max_by/3 ──────────────────────────────────────────────────────────────────

test("max_by negate") <- (max_by(my_neg, [3, 1, 2], RESULT), RESULT == 1)  # nv
test("max_by single") <- (max_by(identity, [42], RESULT), RESULT == 42)  # nv

# ── min_by/3 ──────────────────────────────────────────────────────────────────

test("min_by negate") <- (min_by(my_neg, [3, 1, 2], RESULT), RESULT == 3)  # nv
test("min_by single") <- (min_by(identity, [42], RESULT), RESULT == 42)  # nv

# ── filter_map/3 ──────────────────────────────────────────────────────────────

double_positive(X, Y) <- (X > 0, Y is ++(X * 2))

test("filter_map basic") <- (filter_map(double_positive, [1, -2, 3, -4], RESULT), RESULT == [2, 6])  # nv
test("filter_map all pass") <- (filter_map(double_positive, [1, 2, 3], RESULT), RESULT == [2, 4, 6])  # nv
test("filter_map none pass") <- (filter_map(double_positive, [-1, -2], RESULT), RESULT == [])  # nv
