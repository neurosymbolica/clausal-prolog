# V3-5: Extended list predicates — fixture tests

# ── take/3 ───────────────────────────────────────────────────────────────────

Test("take basic") <- (take(2, [1, 2, 3, 4], RESULT), RESULT == [1, 2])  # nv
Test("take zero") <- (take(0, [1, 2, 3], RESULT), RESULT == [])  # nv
Test("take more than length") <- (take(10, [1, 2], RESULT), RESULT == [1, 2])  # nv
Test("take from empty") <- (take(3, [], RESULT), RESULT == [])  # nv

# ── drop/3 ───────────────────────────────────────────────────────────────────

Test("drop basic") <- (drop(2, [1, 2, 3, 4], RESULT), RESULT == [3, 4])  # nv
Test("drop zero") <- (drop(0, [1, 2, 3], RESULT), RESULT == [1, 2, 3])  # nv
Test("drop all") <- (drop(3, [1, 2, 3], RESULT), RESULT == [])  # nv
Test("drop more than length") <- (drop(10, [1, 2], RESULT), RESULT == [])  # nv

# ── split_at/4 ────────────────────────────────────────────────────────────────

Test("split_at middle") <- (split_at(2, [1, 2, 3, 4], LEFT, RIGHT), LEFT == [1, 2], RIGHT == [3, 4])  # nv
Test("split_at zero") <- (split_at(0, [1, 2, 3], LEFT, RIGHT), LEFT == [], RIGHT == [1, 2, 3])  # nv
Test("split_at end") <- (split_at(3, [1, 2, 3], LEFT, RIGHT), LEFT == [1, 2, 3], RIGHT == [])  # nv
Test("split_at beyond") <- (split_at(10, [1, 2], LEFT, RIGHT), LEFT == [1, 2], RIGHT == [])  # nv

# ── zip_/3 ────────────────────────────────────────────────────────────────────

Test("zip equal") <- (zip_([1, 2, 3], ["a", "b", "c"], RESULT), RESULT == [[1, "a"], [2, "b"], [3, "c"]])  # nv
Test("zip unequal") <- (zip_([1, 2], ["a", "b", "c"], RESULT), RESULT == [[1, "a"], [2, "b"]])  # nv
Test("zip empty") <- (zip_([], [1, 2], RESULT), RESULT == [])  # nv

# ── replicate/3 ──────────────────────────────────────────────────────────────

Test("replicate basic") <- (replicate(3, "x", RESULT), RESULT == "xxx")  # nv — F053 (C9 audit, option A): 1-char str elem → str result
Test("replicate zero") <- (replicate(0, "x", RESULT), RESULT == "")  # nv — F053: zero copies of 1-char str → ""
Test("replicate one") <- (replicate(1, 42, RESULT), RESULT == [42])  # nv

# ── split_with/3 ──────────────────────────────────────────────────────────────

Test("split_with basic") <- (split_with(0, [1, 2, 0, 3, 4], RESULT), RESULT == [[1, 2], [3, 4]])  # nv
Test("split_with no sep") <- (split_with(0, [1, 2, 3], RESULT), RESULT == [[1, 2, 3]])  # nv
Test("split_with consecutive") <- (split_with(0, [1, 0, 0, 2], RESULT), RESULT == [[1], [], [2]])  # nv

# ── take_while/3 ──────────────────────────────────────────────────────────────

IsPositive(X) <- (X > 0)

Test("take_while basic") <- (take_while(IsPositive, [1, 2, -3, 4], RESULT), RESULT == [1, 2])  # nv
Test("take_while none match") <- (take_while(IsPositive, [-1, 2, 3], RESULT), RESULT == [])  # nv
Test("take_while all match") <- (take_while(IsPositive, [1, 2, 3], RESULT), RESULT == [1, 2, 3])  # nv

# ── drop_while/3 ──────────────────────────────────────────────────────────────

Test("drop_while basic") <- (drop_while(IsPositive, [1, 2, -3, 4], RESULT), RESULT == [-3, 4])  # nv
Test("drop_while none match") <- (drop_while(IsPositive, [-1, 2, 3], RESULT), RESULT == [-1, 2, 3])  # nv
Test("drop_while all match") <- (drop_while(IsPositive, [1, 2, 3], RESULT), RESULT == [])  # nv

# ── span/4 ───────────────────────────────────────────────────────────────────

Test("span basic") <- (span(IsPositive, [1, 2, -3, 4], MATCHING, REST), MATCHING == [1, 2], REST == [-3, 4])  # nv

# ── group_by/3 ─────────────────────────────────────────────────────────────────

Identity(X, X) <- True

Test("group_by identity") <- (group_by(Identity, [1, 1, 2, 2, 2, 3], RESULT), RESULT == [[1, 1], [2, 2, 2], [3]])  # nv

# ── sort_by/3 ─────────────────────────────────────────────────────────────────

MyNeg(X, Y) <- (Y is ++(-X))

Test("sort_by negate") <- (sort_by(MyNeg, [1, 3, 2], RESULT), RESULT == [3, 2, 1])  # nv
Test("sort_by empty") <- (sort_by(MyNeg, [], RESULT), RESULT == [])  # nv

# ── max_by/3 ──────────────────────────────────────────────────────────────────

Test("max_by negate") <- (max_by(MyNeg, [3, 1, 2], RESULT), RESULT == 1)  # nv
Test("max_by single") <- (max_by(Identity, [42], RESULT), RESULT == 42)  # nv

# ── min_by/3 ──────────────────────────────────────────────────────────────────

Test("min_by negate") <- (min_by(MyNeg, [3, 1, 2], RESULT), RESULT == 3)  # nv
Test("min_by single") <- (min_by(Identity, [42], RESULT), RESULT == 42)  # nv

# ── filter_map/3 ──────────────────────────────────────────────────────────────

DoublePositive(X, Y) <- (X > 0, Y is ++(X * 2))

Test("filter_map basic") <- (filter_map(DoublePositive, [1, -2, 3, -4], RESULT), RESULT == [2, 6])  # nv
Test("filter_map all pass") <- (filter_map(DoublePositive, [1, 2, 3], RESULT), RESULT == [2, 4, 6])  # nv
Test("filter_map none pass") <- (filter_map(DoublePositive, [-1, -2], RESULT), RESULT == [])  # nv
