# Library module for exception propagation through a direct bucket ref:
# the "b" bucket throws. NOTE: the bucket-ref walker only sees top-level
# body goals, so the throwing call must sit in an intermediate predicate of
# the importing module — a call nested inside catch(...) is never
# specialised.
-double_quotes(atom)
-module(callsite_throw_lib, [throw_cat(P, C)])

throw_cat(P, "a") <- (P == 1)
throw_cat(P, "b") <- (P == 2, throw("boom"))
throw_cat(P, "c") <- (P == 3)
throw_cat(P, "d") <- (P == 4)
throw_cat(P, "e") <- (P == 5)
