SafeQueens(N, QS) <- (
    InDomain(QS, 1, N),
    AllDifferent(QS),
    Label(QS),
    CheckDiagonals(QS),
)

CheckDiagonals([]),

CheckDiagonals([Q, *REST]) <- (
    SafeFrom(Q, REST, 1),
    CheckDiagonals(REST),
)

SafeFrom(Q, [], D),

SafeFrom(Q, [H, *T], D) <- (
    Q != H,
    (DIFF1 := Q - H),
    (DIFF2 := H - Q),
    DIFF1 != D,
    DIFF2 != D,
    (D1 := D + 1),
    SafeFrom(Q, T, D1),
)

