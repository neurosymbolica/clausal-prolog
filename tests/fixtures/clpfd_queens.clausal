SafeQueens(N_, Qs_) <- (
    InDomain(Qs_, 1, N_)
    and AllDifferent(Qs_)
    and Label(Qs_)
    and CheckDiagonals(Qs_)
)

CheckDiagonals([]),

CheckDiagonals([Q_, *Rest_]) <- (
    SafeFrom(Q_, Rest_, 1)
    and CheckDiagonals(Rest_)
)

SafeFrom(Q_, [], D_),

SafeFrom(Q_, [H_, *T_], D_) <- (
    Q_ != H_
    and (Diff1_ := Q_ - H_)
    and (Diff2_ := H_ - Q_)
    and Diff1_ != D_
    and Diff2_ != D_
    and (D1_ := D_ + 1)
    and SafeFrom(Q_, T_, D1_)
)


Test("queens 1") <- (Length(Qs_, 1), SafeQueens(1, Qs_), Length(Qs_, 1))
Test("queens 4 valid") <- (Length(Qs_, 4), SafeQueens(4, Qs_), Length(Qs_, 4))
