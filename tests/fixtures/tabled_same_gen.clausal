-table(Sg/2)

Parent(1, 2),
Parent(1, 3),
Parent(2, 4),
Parent(2, 5),
Parent(3, 5),
Parent(3, 6),

Sg(X, Y) <- (X is Y)
Sg(X, Y) <- (
    Parent(P, X),
    Sg(P, Q),
    Parent(Q, Y)
)


Test("sg same") <- Sg(1, 1)
Test("sg cousins of 4") <- (
    FindAll(Y_, Sg(4, Y_), Ys_),
    Sort(Ys_, Sorted_),
    In(5, Sorted_),
    In(6, Sorted_)
)
