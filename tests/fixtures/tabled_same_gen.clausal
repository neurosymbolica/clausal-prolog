-table(Sg/2)

Parent(1, 2),
Parent(1, 3),
Parent(2, 4),
Parent(2, 5),
Parent(3, 5),
Parent(3, 6),

Sg(X, Y) <- (X is Y)
Sg(X, Y) <- (
    Parent(P, X),
    Sg(P, Q),
    Parent(Q, Y)
)


Test("sg same") <- Sg(1, 1)  # nv
Test("sg cousins of 4") <- (
    findall(TARGET, Sg(4, TARGET), TARGETS),
    sort(TARGETS, SORTED),
    in_(5, SORTED),
    in_(6, SORTED)
)  # nv
