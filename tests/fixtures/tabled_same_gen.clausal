-double_quotes(atom)
-table(sg/2)

parent(1, 2),
parent(1, 3),
parent(2, 4),
parent(2, 5),
parent(3, 5),
parent(3, 6),

sg(X, Y) <- (X is Y)
sg(X, Y) <- (
    parent(P, X),
    sg(P, Q),
    parent(Q, Y)
)


test("sg same") <- sg(1, 1)  # nv
test("sg cousins of 4") <- (
    findall(TARGET, sg(4, TARGET), TARGETS),
    sort(TARGETS, SORTED),
    in_(5, SORTED),
    in_(6, SORTED)
)  # nv

# ── Reflexive sg(X,X) for all 6 nodes ─────────────────────────────────────
test("sg reflexive 2") <- sg(2, 2)  # nv
test("sg reflexive 3") <- sg(3, 3)  # nv
test("sg reflexive 4") <- sg(4, 4)  # nv
test("sg reflexive 5") <- sg(5, 5)  # nv
test("sg reflexive 6") <- sg(6, 6)  # nv

# ── Cross-pair same-generation ────────────────────────────────────────────
test("sg siblings 2 and 3") <- sg(2, 3)  # nv
test("sg cousins 4 and 6") <- sg(4, 6)  # nv
test("sg shared-parent 4 and 5") <- sg(4, 5)  # nv

# ── Different generations ─────────────────────────────────────────────────
test("sg root vs grandchild fails: 1,4") <- (not sg(1, 4))  # nv
test("sg parent vs child fails: 2,4") <- (not sg(2, 4))  # nv
