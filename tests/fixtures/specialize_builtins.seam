# Test fixture: specialize MIs with object programs containing builtins.
#
# Phase 3: object programs whose body goals include builtins (gt, sub, mul,
# add) that are not part of the object program.  The specializer adds a
# catch-all clause that dispatches unknown goals through _SolveGoal.
-double_quotes(atom)

-import_from(clausal.examples.metainterpreters, [solve, solve_count, solve_limit])

# ── Object Program: factorial ────────────────────────────────────────────────
#
# factorial(0, 1).
# factorial(N, R) :- gt(N, 0), sub(N, 1, N1), factorial(N1, R1), mul(N, R1, R).

factorial_program(PROGRAM) <- (
    PROGRAM is [
        [["factorial", 0, 1], []],
        [["factorial", N, R], [
            ["gt", N, 0],
            ["sub", N, 1, N1],
            ["factorial", N1, R1],
            ["mul", N, R1, R]
        ]]
    ]
)

# ── Object Program: even ─────────────────────────────────────────────────────
#
# even(0).
# even(N) :- gte(N, 2), sub(N, 2, N1), even(N1).

even_program(PROGRAM) <- (
    PROGRAM is [
        [["even", 0], []],
        [["even", N], [
            ["gte", N, 2],
            ["sub", N, 2, N1],
            ["even", N1]
        ]]
    ]
)

# ── Specializations ──────────────────────────────────────────────────────────

-specialize(solve, factorial_program, alias=solve_factorial)
-specialize(solve_count, factorial_program, alias=solve_count_factorial)
-specialize(solve_limit, factorial_program, alias=solve_limit_factorial)
-specialize(solve, even_program, alias=solve_even)

# ── Tests: solve_factorial ────────────────────────────────────────────────────

test("solve factorial(0, 1)") <- (
    solve_factorial([["factorial", 0, 1]])
)  # nv

test("solve factorial(1, 1)") <- (
    solve_factorial([["factorial", 1, 1]])
)  # nv

test("solve factorial(3, 6)") <- (
    solve_factorial([["factorial", 3, 6]])
)  # nv

test("solve factorial(5, 120)") <- (
    solve_factorial([["factorial", 5, 120]])
)  # nv

# ── Tests: solve_count_factorial ───────────────────────────────────────────────

test("count factorial(0, 1) = 1 step") <- (
    solve_count_factorial([["factorial", 0, 1]], 1)
)  # nv

# ── Tests: solve_limit_factorial ───────────────────────────────────────────────

test("limit factorial(0, 1) depth 1") <- (
    solve_limit_factorial([["factorial", 0, 1]], 1)
)  # nv

test("limit factorial(1, 1) depth 20") <- (
    solve_limit_factorial([["factorial", 1, 1]], 20)
)  # nv

test("limit factorial(3, 6) depth 30") <- (
    solve_limit_factorial([["factorial", 3, 6]], 30)
)  # nv

# ── Tests: solve_even ─────────────────────────────────────────────────────────

test("solve even(0)") <- (
    solve_even([["even", 0]])
)  # nv

test("solve even(2)") <- (
    solve_even([["even", 2]])
)  # nv

test("solve even(4)") <- (
    solve_even([["even", 4]])
)  # nv

test("solve not even(1)") <- (
    not solve_even([["even", 1]])
)  # nv

test("solve not even(3)") <- (
    not solve_even([["even", 3]])
)  # nv
