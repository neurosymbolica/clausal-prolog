# predicates

# Extract the 'name' key from any dict that has it.
# TODO: Discuss syntax: PERSON["name"] is NAME
get_name(PERSON, NAME) <- SubDict({"name": NAME}, PERSON)

# Succeed if PERSON has role == "admin".
is_admin(PERSON) <- SubDict({"role": "admin"}, PERSON)

# Update a single field using DictPut.
update_field(KEY, VALUE, OLD, NEW) <- DictPut(KEY, VALUE, OLD, NEW)

# Enumerate all key-value pairs of a dict.
dict_member(KEY, DICT, VALUE) <- ((KEY, VALUE) in DICT)

# Enumerate keys of a dict.
dict_key(KEY, DICT) <- (KEY in DICT)

# Build a new dict from OLD with an extra key, using splat sugar.
splat_update(OLD, KEY, VALUE, NEW) <- (NEW is {**OLD, KEY: VALUE})

# Compute the intersection of two sets.
set_common(SET1, SET2, INTERSECTION) <- SetIntersection(SET1, SET2, INTERSECTION)

# Enumerate elements of a set.
set_member(ELEMENT, SET) <- GenSet(ELEMENT, SET)

Test("get name") <- (get_name({"name": "Alice"}, NAME), NAME == "Alice")
Test("is admin") <- is_admin({"role": "admin"})
Test("dict member") <- (dict_member("x", {"x": 1, "y": 2}, VALUE), VALUE == 1)
Test("set member") <- set_member(2, {1, 2, 3})
Test("set common has 2") <- (set_common({1, 2, 3}, {2, 3, 4}, INTERSECTION), set_member(2, INTERSECTION))
Test("set common has 3") <- (set_common({1, 2, 3}, {2, 3, 4}, INTERSECTION), set_member(3, INTERSECTION))
