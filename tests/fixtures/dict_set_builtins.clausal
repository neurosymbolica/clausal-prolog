# predicates

# Extract the 'name' key from any dict that has it.
# TODO: Discuss syntax: PERSON["name"] is NAME
get_name(PERSON, NAME) <- sub_dict({"name": NAME}, PERSON)

# Succeed if PERSON has role == "admin".
is_admin(PERSON) <- sub_dict({"role": "admin"}, PERSON)

# Update a single field using dict_put.
update_field(KEY, VALUE, OLD, NEW) <- dict_put(KEY, VALUE, OLD, NEW)

# Enumerate all key-value pairs of a dict.
dict_member(KEY, DICT, VALUE) <- ((KEY, VALUE) in DICT)

# Enumerate keys of a dict.
dict_key(KEY, DICT) <- (KEY in DICT)

# Build a new dict from OLD with an extra key, using splat sugar.
splat_update(OLD, KEY, VALUE, NEW) <- (NEW is {**OLD, KEY: VALUE})

# Compute the intersection of two sets.
set_common(SET1, SET2, INTERSECTION) <- set_intersection(SET1, SET2, INTERSECTION)

# Enumerate elements of a set.
set_member(ELEMENT, SET) <- gen_set(ELEMENT, SET)

Test("get name") <- (get_name({"name": "Alice"}, NAME), NAME == "Alice")  # nv
Test("is admin") <- is_admin({"role": "admin"})  # nv
Test("dict member") <- (dict_member("x", {"x": 1, "y": 2}, VALUE), VALUE == 1)  # nv
Test("set member") <- set_member(2, {1, 2, 3})  # nv
Test("set common has 2") <- (set_common({1, 2, 3}, {2, 3, 4}, INTERSECTION), set_member(2, INTERSECTION))  # nv
Test("set common has 3") <- (set_common({1, 2, 3}, {2, 3, 4}, INTERSECTION), set_member(3, INTERSECTION))  # nv

# ── is_dict/1 ──────────────────────────────────────────────────────────────

Test("is_dict: empty dict") <- is_dict({})  # nv
Test("is_dict: populated dict") <- is_dict({"a": 1})  # nv
Test("is_dict: atom fails") <- (not is_dict("hello"))  # nv
Test("is_dict: set fails") <- (not is_dict({1, 2}))  # nv
Test("is_dict: var fails") <- (not is_dict(X_UNUSED))  # nv

# ── dict_size/2 ────────────────────────────────────────────────────────────

Test("dict_size: empty") <- (dict_size({}, N), N == 0)  # nv
Test("dict_size: three") <- (
    dict_size({"a": 1, "b": 2, "c": 3}, N),
    N == 3
)  # nv

# ── dict_keys/2, dict_values/2 ─────────────────────────────────────────────

Test("dict_keys: sorted order") <- (
    dict_keys({"b": 2, "a": 1, "c": 3}, KS),
    KS == ["a", "b", "c"]
)  # nv
Test("dict_values: in key order") <- (
    dict_values({"b": 2, "a": 1, "c": 3}, VS),
    VS == [1, 2, 3]
)  # nv

# ── dict_pairs/2 ───────────────────────────────────────────────────────────

# dict_pairs: .clausal surface literal handling is awkward for tuples;
# behavior test stays in tests/test_dict_set_builtins.py.

# ── dict_get/3 ─────────────────────────────────────────────────────────────

Test("dict_get: existing key") <- (
    dict_get("a", {"a": 1, "b": 2}, V),
    V == 1
)  # nv
Test("dict_get: missing key fails") <- (
    not dict_get("z", {"a": 1}, _)
)  # nv

# ── dict_put/4 ─────────────────────────────────────────────────────────────

Test("dict_put: new key adds") <- (
    dict_put("c", 3, {"a": 1, "b": 2}, NEW),
    dict_get("c", NEW, V),
    V == 3
)  # nv
Test("dict_put: overwrites existing") <- (
    dict_put("a", 99, {"a": 1, "b": 2}, NEW),
    dict_get("a", NEW, V),
    V == 99
)  # nv

# ── is_set/1, set_size/2 ──────────────────────────────────────────────────

Test("is_set: empty set constructed from list") <- (
    set_list(SET1, []),
    is_set(SET1)
)  # nv
Test("is_set: populated") <- is_set({1, 2, 3})  # nv
Test("set_size: three") <- (set_size({1, 2, 3}, N), N == 3)  # nv
Test("set_size: duplicate-free") <- (set_size({1, 1, 2}, N), N == 2)  # nv

# ── set_list/2 ─────────────────────────────────────────────────────────────

Test("set_list: set → sorted list") <- (
    set_list({3, 1, 2}, LIST),
    LIST == [1, 2, 3]
)  # nv
Test("set_list: list → set") <- (
    set_list(SET, [1, 2, 3]),
    set_size(SET, N),
    N == 3
)  # nv

# ── set_union/3, set_intersection/3, set_subtract/3 ────────────────────────

Test("set_union: combines elements") <- (
    set_union({1, 2}, {2, 3}, U),
    set_list(U, L),
    L == [1, 2, 3]
)  # nv
Test("set_intersection: common elements") <- (
    set_intersection({1, 2, 3}, {2, 3, 4}, I),
    set_list(I, L),
    L == [2, 3]
)  # nv
Test("set_subtract: removes second from first") <- (
    set_subtract({1, 2, 3}, {2, 4}, D),
    set_list(D, L),
    L == [1, 3]
)  # nv

# ── set_subset/2, set_disjoint/2 ───────────────────────────────────────────

Test("set_subset: true") <- set_subset({1, 2}, {1, 2, 3})  # nv
Test("set_subset: false") <- (not set_subset({1, 4}, {1, 2, 3}))  # nv
Test("set_disjoint: true") <- set_disjoint({1, 2}, {3, 4})  # nv
Test("set_disjoint: false") <- (not set_disjoint({1, 2}, {2, 3}))  # nv

# ── set_add/3, set_remove/3 ────────────────────────────────────────────────

Test("set_add: adds element") <- (
    set_add(4, {1, 2, 3}, NEW),
    set_list(NEW, L),
    L == [1, 2, 3, 4]
)  # nv
Test("set_remove: removes element") <- (
    set_remove(2, {1, 2, 3}, NEW),
    set_list(NEW, L),
    L == [1, 3]
)  # nv
