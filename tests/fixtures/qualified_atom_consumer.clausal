-private([ok])
# Consumes qualified_atom_vocab both ways:
#   -import_from  → bare `euro` (the real atom), used to build the stored fact
#   -import_module → qualified `qualified_atom_vocab.euro` in TERM position
# The qualified form in a term must resolve to the SAME atom as the imported bare
# one, so the query below unifies against the fact.
-import_from(qualified_atom_vocab, [euro])
-import_module(qualified_atom_vocab)

stored(euro),

qualified_matches_imported(R) <- (stored(qualified_atom_vocab.euro), R is ok)
imported_control(R) <- (stored(euro), R is ok)

# Reverse direction: a qualified atom in a fact HEAD must construct the real
# atom too, so a query with the imported bare atom matches it.
stored_head(qualified_atom_vocab.euro),
head_qualified_matches(R) <- (stored_head(euro), R is ok)
