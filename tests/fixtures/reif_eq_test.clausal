# Test fixture for eq/3 builtin integration
# Simple wrapper that calls eq/3

CheckEq(X, Y, TRUTH) <- eq(X, Y, TRUTH)


Test("eq true") <- (CheckEq(1, 1, TRUTH), TRUTH == True)
Test("eq false") <- (CheckEq(1, 2, TRUTH), TRUTH == False)
Test("eq string same") <- (CheckEq("a", "a", TRUTH), TRUTH == True)
