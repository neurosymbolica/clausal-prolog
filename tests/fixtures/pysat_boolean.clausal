# PySAT Boolean satisfiability tests — exercises pysat.cadical, pysat.solve,
# pysat.check, pysat.count, pysat.at_most, pysat.at_least, pysat.exactly.

# ── Basic constraint blocks ─────────────────────────────────────────────────

XorSolve(X, Y) <- (
    pysat.cadical(X ^ Y),
    pysat.solve([X, Y]),
)

test("xor 2 solutions") <- (count_all(XorSolve(_, _), N), N == 2)  # nv
test("xor solution 0,1") <- XorSolve(0, 1)  # nv
test("xor solution 1,0") <- XorSolve(1, 0)  # nv

AndSolve(X, Y) <- (
    pysat.cadical(X & Y),
    pysat.solve([X, Y]),
)

test("and forces both 1") <- (AndSolve(X, Y), X == 1, Y == 1)  # nv
test("and 1 solution") <- (count_all(AndSolve(_, _), N), N == 1)  # nv

OrSolve(X, Y) <- (
    pysat.cadical(X | Y),
    pysat.solve([X, Y]),
)

test("or 3 solutions") <- (count_all(OrSolve(_, _), N), N == 3)  # nv
test("or excludes 0,0") <- (not(OrSolve(0, 0)))  # nv

# ── Negation ────────────────────────────────────────────────────────────────

NegSolve(X) <- (
    pysat.cadical(~X),
    pysat.solve([X]),
)

test("not forces 0") <- (NegSolve(X), X == 0)  # nv

# ── Equality / disequality ──────────────────────────────────────────────────

EqSolve(X, Y) <- (
    pysat.cadical(X == Y),
    pysat.solve([X, Y]),
)

test("eq 2 solutions") <- (count_all(EqSolve(_, _), N), N == 2)  # nv
test("eq 0,0") <- EqSolve(0, 0)  # nv
test("eq 1,1") <- EqSolve(1, 1)  # nv

NeqSolve(X, Y) <- (
    pysat.cadical(X != Y),
    pysat.solve([X, Y]),
)

test("neq 2 solutions") <- (count_all(NeqSolve(_, _), N), N == 2)  # nv
test("neq 0,1") <- NeqSolve(0, 1)  # nv
test("neq 1,0") <- NeqSolve(1, 0)  # nv

# ── Unsatisfiable ───────────────────────────────────────────────────────────

test("unsat x and not x") <- (
    pysat.cadical(X & ~X),
    not(pysat.check()),
)  # nv

# ── Combined disjunctions ──────────────────────────────────────────────────

ForcesY(X, Y) <- (
    pysat.cadical((
        X | Y,
        ~X | Y,
    )),
    pysat.solve([X, Y]),
)

test("combined forces Y=1") <- (ForcesY(_, Y), Y == 1)  # nv
test("combined 2 solutions") <- (count_all(ForcesY(_, _), N), N == 2)  # nv

# ── Counting ────────────────────────────────────────────────────────────────

test("count xor") <- (
    pysat.cadical(X ^ Y),
    pysat.count([X, Y], N),
    N == 2,
)  # nv

test("count or") <- (
    pysat.cadical(X | Y),
    pysat.count([X, Y], N),
    N == 3,
)  # nv

# ── Cardinality ─────────────────────────────────────────────────────────────

AtMostOneSolve(X, Y, Z) <- (
    pysat.at_most([X, Y, Z], 1),
    pysat.solve([X, Y, Z]),
)

test("at_most 1 of 3: 4 solutions") <- (count_all(AtMostOneSolve(_, _, _), N), N == 4)  # nv

AtLeastTwoSolve(X, Y, Z) <- (
    pysat.at_least([X, Y, Z], 2),
    pysat.solve([X, Y, Z]),
)

test("at_least 2 of 3: 4 solutions") <- (count_all(AtLeastTwoSolve(_, _, _), N), N == 4)  # nv

ExactlyTwoSolve(X, Y, Z) <- (
    pysat.exactly([X, Y, Z], 2),
    pysat.solve([X, Y, Z]),
)

test("exactly 2 of 3: 3 solutions") <- (count_all(ExactlyTwoSolve(_, _, _), N), N == 3)  # nv

ExactlyZero(X, Y) <- (
    pysat.exactly([X, Y], 0),
    pysat.solve([X, Y]),
)

test("exactly 0: both false") <- (ExactlyZero(X, Y), X == 0, Y == 0)  # nv
test("exactly 0: 1 solution") <- (count_all(ExactlyZero(_, _), N), N == 1)  # nv

# ── Pigeonhole (UNSAT) ─────────────────────────────────────────────────────

test("pigeonhole 3-into-2 unsat") <- (
    # Each pigeon in at least one hole
    pysat.at_least([P1H1, P1H2], 1),
    pysat.at_least([P2H1, P2H2], 1),
    pysat.at_least([P3H1, P3H2], 1),
    # Each hole has at most one pigeon
    pysat.at_most([P1H1, P2H1, P3H1], 1),
    pysat.at_most([P1H2, P2H2, P3H2], 1),
    not(pysat.check()),
)  # nv

# ── Combined cardinality + clauses ──────────────────────────────────────────

ExactlyOneCombined(X, Y, Z) <- (
    pysat.cadical(X | Y | Z),
    pysat.at_most([X, Y, Z], 1),
    pysat.solve([X, Y, Z]),
)

test("combined exactly-one 3 solutions") <- (count_all(ExactlyOneCombined(_, _, _), N), N == 3)  # nv

# ── Graph coloring (integration) ───────────────────────────────────────────

# 3-color a triangle: nodes A, B, C with edges A-B, B-C, A-C
# Each node has vars for R, G, B; exactly one color per node,
# adjacent nodes can't share a color.

TriangleColor(AR, AG, AB, BR, BG, BB, CR, CG, CB) <- (
    pysat.exactly([AR, AG, AB], 1),
    pysat.exactly([BR, BG, BB], 1),
    pysat.exactly([CR, CG, CB], 1),
    # A-B: different colors
    pysat.cadical((
        ~AR | ~BR,
        ~AG | ~BG,
        ~AB | ~BB,
    )),
    # B-C: different colors
    pysat.cadical((
        ~BR | ~CR,
        ~BG | ~CG,
        ~BB | ~CB,
    )),
    # A-C: different colors
    pysat.cadical((
        ~AR | ~CR,
        ~AG | ~CG,
        ~AB | ~CB,
    )),
    pysat.solve([AR, AG, AB, BR, BG, BB, CR, CG, CB]),
)

test("triangle coloring 6 solutions") <- (count_all(TriangleColor(_, _, _, _, _, _, _, _, _), N), N == 6)  # nv
