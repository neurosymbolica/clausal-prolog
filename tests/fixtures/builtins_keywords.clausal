# Tests for keyword-term introspection predicates: vary/3, extend/3, unbound_keys/2, signature/3

# vary/3 — copy a term with field overrides
# (Uses Python dict as overrides; requires a predicate with known fields.)
# Example: copy a point with its x replaced
UpdateX(POINT, NEW_X, UPDATED) <- vary({"x": NEW_X}, POINT, UPDATED)

# unbound_keys/2 — find which fields are still unbound vars
FreeFields(TERM, KEYS) <- unbound_keys(TERM, KEYS)

# signature/3 — reflect the registered parameter names for a predicate
PredParams(NAME, ARITY, PARAMS) <- signature(NAME, ARITY, PARAMS)


# A keyword predicate for testing vary/unbound_keys/signature
Vec(x=0, y=0),
Vec(x=1, y=2),
Vec(x=3, y=4),

Test("signature vec fields") <- (PredParams("Vec", 2, PARAMS), length(PARAMS, 2))  # nv
Test("free fields unbound y") <- (FreeFields(Vec(x=1), KEYS), in_("y", KEYS))  # nv
Test("vary vec x") <- (
    UpdateX(Vec(x=1, y=2), 99, UPDATED),
    UPDATED == Vec(x=99, y=2)
)  # nv
