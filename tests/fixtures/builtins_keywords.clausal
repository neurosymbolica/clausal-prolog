# Tests for keyword-term introspection predicates: vary/3, extend/3, unbound_keys/2, signature/3

# vary/3 — copy a term with field overrides
# (Uses Python dict as overrides; requires a predicate with known fields.)
# Example: copy a point with its x replaced
update_x(POINT, NEW_X, UPDATED) <- vary({"x": NEW_X}, POINT, UPDATED)

# unbound_keys/2 — find which fields are still unbound vars
free_fields(TERM, KEYS) <- unbound_keys(TERM, KEYS)

# signature/3 — reflect the registered parameter names for a predicate
pred_params(NAME, ARITY, PARAMS) <- signature(NAME, ARITY, PARAMS)


# A predicate whose fields are NAMED, for testing vary/unbound_keys/
# signature.  The names come from the declaration: the keyword-head
# spelling `vec(x=0, y=0)` that used to carry them was retired
# 2026-09-19 (a term is built positionally), and the field names these
# builtins address are unaffected by that.
-private([vec(x, y)])

vec(0, 0),
vec(1, 2),
vec(3, 4),

# THE FLIP (spec §6.4): the name positions of signature/3 and
# unbound_keys/2 speak ATOMS, so the literals here are atoms — this file
# is in the default `-double_quotes(atom)` mode on purpose.
test("signature vec fields") <- (pred_params("vec", 2, PARAMS), PARAMS == ["x", "y"])  # nv
test("free fields unbound y") <- (free_fields(vec(1, Y_UNUSED), KEYS), "y" in KEYS)  # nv
test("vary vec x") <- (
    update_x(vec(1, 2), 99, UPDATED),
    UPDATED == vec(99, 2)
)  # nv
