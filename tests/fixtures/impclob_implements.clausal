# DEFINES and exports impclob_verdict/2.  It used to import the name from the
# declaration-only impclob_decl_vocab and supply its clauses there -- the
# "vocabulary-implements" idiom, dropped 2026-09-24.  This is the migration
# the refusal's remedy names: the definition lives in the implementing
# module, and users import it from here (impclob_verdict_user.clausal).
-private([ok, cited])
-module(impclob_implements, [impclob_verdict(STATUS, CITATION), impclob_check(STATUS)])

impclob_verdict(ok, cited),

impclob_check(S) <- impclob_verdict(S, C_UNUSED)
