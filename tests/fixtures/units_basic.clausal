-import_from(py.units, [
    Meter, Kilogram, Second, Ampere, Kelvin,
    Kilometer, Centimeter, Gram, Minute, Hour,
    Newton, Joule, Watt, Hertz,
    Volt, Ampere, Ohm, Coulomb,
    Bar, Dimensionless, Dimensioned,
    IsLength, IsArea, IsVolume, IsMass, IsTime,
    IsVelocity, IsAcceleration, IsForce, IsEnergy, IsPower,
    IsPressure, IsFrequency, IsVoltage, IsResistance, IsCharge,
    IsDimensionless, IsDimensioned,
    ValueOf, DimensionOf, MakeDimensioned, StripDimensions,
    SpeedOfLight, StandardGravity])

# SI base unit constructors: roundtrip via forward + reverse mode
# Each test:
#   1. Forward mode: build a ground Dimensioned from a number
#   2. Reverse mode: extract the number back via the same predicate
#   3. Cross-checks the result against a value built with n(Unit) sugar

Test("meter roundtrip") <- (
    Meter(5, PARTIAL),
    Meter(VAL_, PARTIAL),
    VAL_ == 5,
    PARTIAL == 5(Meter)
)

Test("Var in value") <- (
    Meter(42, MV),
    Meter(VAL, MV),
    VAL == 42
)

Test("kilogram roundtrip") <- (
    Kilogram(70, PARTIAL),
    Kilogram(VAL_, PARTIAL),
    VAL_ == 70,
    PARTIAL == 70(Kilogram)
)

Test("second roundtrip") <- (
    Second(60, PARTIAL),
    Second(VAL_, PARTIAL),
    VAL_ == 60,
    PARTIAL == 60(Second)
)

Test("kelvin roundtrip") <- (
    Kelvin(300, PARTIAL),
    Kelvin(VAL_, PARTIAL),
    VAL_ == 300,
    PARTIAL == 300(Kelvin)
)

Test("newton roundtrip") <- (
    Newton(9.8, PARTIAL),
    Newton(VAL_, PARTIAL),
    VAL_ == 9.8,
    PARTIAL == 9.8(Newton)
)

Test("joule roundtrip") <- (
    Joule(100, PARTIAL),
    Joule(VAL_, PARTIAL),
    VAL_ == 100,
    PARTIAL == 100(Joule)
)

Test("hertz roundtrip") <- (
    Hertz(440, PARTIAL),
    Hertz(VAL_, PARTIAL),
    VAL_ == 440,
    PARTIAL == 440(Hertz)
)

Test("ohm roundtrip") <- (
    Ohm(10, PARTIAL),
    Ohm(VAL_, PARTIAL),
    VAL_ == 10,
    PARTIAL == 10(Ohm)
)

Test("volt roundtrip") <- (
    Volt(230, PARTIAL),
    Volt(VAL_, PARTIAL),
    VAL_ == 230,
    PARTIAL == 230(Volt)
)

Test("coulomb roundtrip") <- (
    Coulomb(3, PARTIAL),
    Coulomb(VAL_, PARTIAL),
    VAL_ == 3,
    PARTIAL == 3(Coulomb)
)

# Reverse mode: extract numeric value via unit predicate

Test("meter reverse") <- (
    D := 7(Meter),
    Meter(X, D),
    X == 7
)

Test("centimeter roundtrip") <- (
    Centimeter(200, D),
    Centimeter(X, D),
    ERR := ++(abs(X - 200.0)),
    ERR < 1.0e-9
)

# Scaled unit constructors: check stored value via unit pred in reverse

Test("kilometer stores as meters") <- (
    D := 1(Kilometer),
    Meter(1000.0, D)
)

Test("gram stores as kilograms") <- (
    D := 1000(Gram),
    Kilogram(1.0, D)
)

Test("minute stores as seconds") <- (
    D := 5(Minute),
    Second(300.0, D)
)

Test("hour stores as seconds") <- (
    D := 2(Hour),
    Second(7200.0, D)
)

# Arithmetic: check results by unification with named unit pred

Test("velocity from distance over time") <- (
    D := 100(Meter),
    T := 10(Second),
    V := D / T,
    ValueOf(V, 10.0),
    IsVelocity(V)
)

Test("acceleration from velocity over time") <- (
    D := 20(Meter),
    T := 2(Second),
    V := D / T,
    A := V / T,
    ValueOf(A, 5.0),
    IsAcceleration(A)
)

Test("force from mass times acceleration") <- (
    D := 20(Meter),
    T := 2(Second),
    V := D / T,
    A := V / T,
    M := 3(Kilogram),
    F := M * A,
    Newton(15.0, F)
)

Test("area from side squared") <- (
    SIDE := 4(Meter),
    AREA := SIDE ** 2,
    ValueOf(AREA, 16),
    IsArea(AREA)
)

Test("volume from side cubed") <- (
    SIDE := 2(Meter),
    VOL := SIDE ** 3,
    ValueOf(VOL, 8),
    IsVolume(VOL)
)

Test("add two forces") <- (
    TOTAL := 3(Newton) + 7(Newton),
    Newton(10, TOTAL)
)

Test("subtract forces") <- (
    DIFF := 10(Newton) - 4(Newton),
    Newton(6, DIFF)
)

Test("scale force by scalar") <- (
    F2 := 5(Newton) * 3,
    Newton(15, F2)
)

Test("dims cancel in division") <- (
    RATIO := 50(Meter) / 10(Meter),
    Dimensionless(5.0, RATIO)
)

Test("ohms law") <- (
    R := 12(Volt) / 3(Ampere),
    Ohm(4.0, R)
)

Test("power from current squared times resistance") <- (
    I := 2(Ampere),
    RES := 5(Ohm),
    P := I * I * RES,
    Watt(20, P)
)

Test("watt joule per second") <- (
    P := 3600(Joule) / 60(Second),
    Watt(60.0, P)
)

Test("kinetic energy") <- (
    M := 4(Kilogram),
    SPD := 3(Meter) / 1(Second),
    KE := M * SPD ** 2,
    HALF := KE / 2,
    ERR is ++(abs(HALF.value - 18.0)),
    ERR < 1.0e-9,
    IsEnergy(HALF)
)

Test("bar stores as pascals") <- (
    D := 1(Bar),
    ERR is ++(abs(D.value - 100000.0)),
    ERR < 1.0e-6,
    IsPressure(D)
)

Test("make dimensioned from dict") <- (
    DIMS := ++{Kilogram: 1, Meter: 1, Second: -2},
    MakeDimensioned(10, DIMS, D),
    Newton(10, D)
)

# Physical constants used in expressions via ++

Test("rest energy e=mc2") <- (
    E := ++(Kilogram(1) * SpeedOfLight ** 2),
    IsEnergy(E),
    ERR is ++(abs(E.value - 8.987551787368176e+16)),
    ERR < 1.0e6
)

Test("weight from standard gravity") <- (
    W := ++(Kilogram(70) * StandardGravity),
    IsForce(W),
    ERR is ++(abs(W.value - 686.4655)),
    ERR < 1.0e-3
)

# Dimension type checks: one predicate each

Test("isdimensioned") <- IsDimensioned(1(Newton))

Test("isdimensionless on plain number") <- IsDimensionless(42)

Test("dimensionless roundtrip") <- (
    Dimensionless(5.0, PARTIAL),
    Dimensionless(VAL_, PARTIAL),
    VAL_ == 5.0,
    PARTIAL == ++(Dimensioned(5.0, {}))
)

Test("islength") <- IsLength(1(Meter))

Test("ismass") <- IsMass(1(Kilogram))

Test("istime") <- IsTime(1(Second))

Test("isfrequency") <- IsFrequency(1(Hertz))

Test("isforce") <- IsForce(1(Newton))

Test("isenergy") <- IsEnergy(1(Joule))

Test("ispower") <- IsPower(1(Watt))

Test("ispressure") <- IsPressure(1(Bar))

Test("isvoltage") <- IsVoltage(1(Volt))

Test("isresistance") <- IsResistance(1(Ohm))

Test("ischarge") <- IsCharge(1(Coulomb))

Test("valueof and stripdimensions") <- (
    F := 9.8(Newton),
    ValueOf(F, 9.8),
    StripDimensions(F, 9.8)
)

# Unit constraint sugar: X(Unit) posts an AttVar constraint on X

Test("constraint accepts matching unit") <- (
    F(Newton),
    F is 9.8(Newton),
    IsForce(F)
)

Test("constraint rejects wrong unit") <- (
    not (F(Newton), F is 1(Second))
)

Test("constraint propagates through arithmetic") <- (
    D(Meter),
    T(Second),
    D is 100(Meter),
    T is 10(Second),
    V := D / T,
    IsVelocity(V)
)

# Dimensionless n() sugar: 42() produces Dimensioned(42, {})

Test("dimensionless integer sugar") <- (
    D := 42(),
    IsDimensionless(D),
    ValueOf(D, 42)
)

Test("dimensionless float sugar") <- (
    D := 3.14(),
    IsDimensionless(D),
    ERR := ++(abs(D.value - 3.14)),
    ERR < 1.0e-12
)

Test("dimensionless sugar equals Dimensionless pred") <- (
    D1 := 7(),
    Dimensionless(7, D2),
    D1 == D2
)

Test("dimensionless sugar not a length") <- (
    D := 5(),
    not IsLength(D)
)

Test("dimensionless sugar not a force") <- (
    D := 9.8(),
    not IsForce(D)
)

Test("dimensionless via isdimensionless") <- IsDimensionless(0())

Test("dimensionless arithmetic via escape") <- (
    S := ++(Dimensioned(3, {}) + Dimensioned(2, {})),
    IsDimensionless(S),
    ValueOf(S, 5)
)

Test("dimensionless ratio from division") <- (
    RATIO := 50(Meter) / 10(Meter),
    IsDimensionless(RATIO),
    D := 5.0(),
    RATIO == D
)

# Unit mismatch detection via AttVar constraint system
# These use X(Unit) to post a constraint; assigning the wrong unit produces no solution.

Test("constraint rejects metre for second slot") <- (
    not (X (Second), X is 100(Meter))
)

Test("constraint rejects newton for kilogram slot") <- (
    not (M (Kilogram), M is 9.8 (Newton))
)

Test("constraint rejects joule for watt slot") <- (
    not (P (Watt), P is 1(Joule))
)

Test("two constraints conflict") <- (
    not (X (Meter), X(Second))
)

Test("constraint accepts correct unit after arithmetic") <- (
    V(Meter),
    V is 5 (Meter),
    IsLength(V)
)

# Catch/2 and CatchRecover/3: Python exceptions are ClassName(Msg) terms,
# identical in shape to logic throw terms — no python_error wrapper needed.

Test("catch add mismatch") <- Catch(
    1 (Meter) + 1 (Second),
    UnitsMismatch(_)
)

Test("catch no error transparent") <- (
    Catch(
        R := 6 (Meter) / 2 (Second),
        _
    ),
    IsVelocity(R),
    ValueOf(R, 3.0)
)

Test("catch extracts message is string") <- (
    Catch(
        5 (Meter) + 2 (Kilogram),
        UnitsMismatch(MSG)
    ),
    ++(isinstance(MSG, str))
)

Test("catchrecover runs recovery") <- CatchRecover(
    1 (Meter) + 1 (Second),
    UnitsMismatch(_),
    1 == 1
)

Test("catchrecover binds message") <- (
    CatchRecover(
        5 (Meter) + 2 (Kilogram),
        UnitsMismatch(MSG),
        ++(isinstance(MSG, str))
    )
)
