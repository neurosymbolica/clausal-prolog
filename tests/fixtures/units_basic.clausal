-import_from(py.units, [
    metre, kilogram, second, ampere, kelvin,
    kilometer, centimeter, gram, minute, hour,
    newton, joule, watt, hertz, pascal,
    volt, ampere, ohm, coulomb,
    bar, Quantity, dimensionless,
    strip_units, dimension_of, make_quantity,
    SpeedOfLight, StandardGravity])

# SI base unit constructors: build with n(Unit) sugar, extract with strip_units

test("meter roundtrip") <- strip_units(5(metre), 5)  # nv
test("kilogram roundtrip") <- strip_units(70(kilogram), 70)  # nv
test("second roundtrip") <- strip_units(60(second), 60)  # nv
test("kelvin roundtrip") <- strip_units(300(kelvin), 300)  # nv
test("newton roundtrip") <- strip_units(9.8(newton), 9.8)  # nv
test("joule roundtrip") <- strip_units(100(joule), 100)  # nv
test("hertz roundtrip") <- strip_units(440(hertz), 440)  # nv
test("ohm roundtrip") <- strip_units(10(ohm), 10)  # nv
test("volt roundtrip") <- strip_units(230(volt), 230)  # nv
test("coulomb roundtrip") <- strip_units(3(coulomb), 3)  # nv

test("centimeter roundtrip") <- (
    eval_(200(centimeter), D),
    strip_units(D, RAW),
    ERR is ++(abs(RAW - 2.0)),
    ERR < 1.0e-9
)  # nv

# Scaled unit constructors: check stored value via equality with SI unit

test("kilometer stores as meters") <- (
    eval_(1(kilometer), D),
    D == 1000.0(metre)
)  # nv

test("gram stores as kilograms") <- (
    eval_(1000(gram), D),
    D == 1.0(kilogram)
)  # nv

test("minute stores as seconds") <- (
    eval_(5(minute), D),
    D == 300.0(second)
)  # nv

test("hour stores as seconds") <- (
    eval_(2(hour), D),
    D == 7200.0(second)
)  # nv

# Arithmetic: check results by unification with n(Unit)

test("velocity from distance over time") <- (
    eval_(100(metre), D),
    eval_(10(second), T),
    eval_(D / T, V),
    strip_units(V, 10.0),
    has_units(V, metre/second)
)  # nv

test("acceleration from velocity over time") <- (
    eval_(20(metre), D),
    eval_(2(second), T),
    eval_(D / T, V),
    eval_(V / T, A),
    strip_units(A, 5.0),
    has_units(A, metre/second**2)
)  # nv

test("force from mass times acceleration") <- (
    eval_(20(metre), D),
    eval_(2(second), T),
    eval_(D / T, V),
    eval_(V / T, A),
    eval_(3(kilogram), M),
    eval_(M * A, F),
    F == 15.0(newton)
)  # nv

test("area from side squared") <- (
    eval_(4(metre), SIDE),
    eval_(SIDE ** 2, AREA),
    strip_units(AREA, 16),
    has_units(AREA, metre**2)
)  # nv

test("volume from side cubed") <- (
    eval_(2(metre), SIDE),
    eval_(SIDE ** 3, VOL),
    strip_units(VOL, 8),
    has_units(VOL, metre**3)
)  # nv

test("add two forces") <- (
    eval_(3(newton) + 7(newton), TOTAL),
    TOTAL == 10(newton)
)  # nv

test("subtract forces") <- (
    eval_(10(newton) - 4(newton), DIFF),
    DIFF == 6(newton)
)  # nv

test("scale force by scalar") <- (
    eval_(5(newton) * 3, F2),
    F2 == 15(newton)
)  # nv

test("dims cancel in division") <- (
    eval_(50(metre) / 10(metre), RATIO),
    RATIO == 5.0()
)  # nv

test("ohms law") <- (
    eval_(12(volt) / 3(ampere), R),
    R == 4.0(ohm)
)  # nv

test("power from current squared times resistance") <- (
    eval_(2(ampere), I),
    eval_(5(ohm), RES),
    eval_(I * I * RES, P),
    P == 20(watt)
)  # nv

test("watt joule per second") <- (
    eval_(3600(joule) / 60(second), P),
    P == 60.0(watt)
)  # nv

test("kinetic energy") <- (
    eval_(4(kilogram), M),
    eval_(3(metre) / 1(second), SPD),
    eval_(M * SPD ** 2, KE),
    eval_(KE / 2, HALF),
    ERR is ++(abs(HALF.value - 18.0)),
    ERR < 1.0e-9,
    has_units(HALF, joule)
)  # nv

test("bar stores as pascals") <- (
    eval_(1(bar), D),
    ERR is ++(abs(D.value - 100000.0)),
    ERR < 1.0e-6,
    has_units(D, pascal)
)  # nv

test("make dimensioned from dict") <- (
    DIMS is ++{kilogram: 1, metre: 1, second: -2},
    make_quantity(10, DIMS, D),
    D == 10(newton)
)  # nv

# Physical constants used in expressions via ++

test("rest energy e=mc2") <- (
    E is ++(kilogram(1) * SpeedOfLight ** 2),
    has_units(E, joule),
    ERR is ++(abs(E.value - 8.987551787368176e+16)),
    ERR < 1.0e6
)  # nv

test("weight from standard gravity") <- (
    W is ++(kilogram(70) * StandardGravity),
    has_units(W, newton),
    ERR is ++(abs(W.value - 686.4655)),
    ERR < 1.0e-3
)  # nv

# Dimension type checks via has_units

test("dimensionless roundtrip") <- (
    eval_(5.0(), PARTIAL),
    strip_units(PARTIAL, VALUE),
    VALUE == 5.0,
    PARTIAL == ++(Quantity(5.0, {}))
)  # nv

test("islength") <- (eval_(1(metre), Q), has_units(Q, metre))  # nv

test("ismass") <- (eval_(1(kilogram), Q), has_units(Q, kilogram))  # nv

test("istime") <- (eval_(1(second), Q), has_units(Q, second))  # nv

test("isfrequency") <- (eval_(1(hertz), Q), has_units(Q, hertz))  # nv

test("isforce") <- (eval_(1(newton), Q), has_units(Q, newton))  # nv

test("isenergy") <- (eval_(1(joule), Q), has_units(Q, joule))  # nv

test("ispower") <- (eval_(1(watt), Q), has_units(Q, watt))  # nv

test("ispressure") <- (eval_(1(bar), Q), has_units(Q, pascal))  # nv

test("isvoltage") <- (eval_(1(volt), Q), has_units(Q, volt))  # nv

test("isresistance") <- (eval_(1(ohm), Q), has_units(Q, ohm))  # nv

test("ischarge") <- (eval_(1(coulomb), Q), has_units(Q, coulomb))  # nv

test("valueof and stripdimensions") <- (
    eval_(9.8(newton), F),
    strip_units(F, 9.8),
    strip_units(F, 9.8)
)  # nv

# X(Unit) in expression position: wraps a runtime value in a Quantity.
# has_units(X, Unit) is the explicit goal for dimension checks and constraints.

test("var construction sugar") <- (
    eval_(9.8, N),
    eval_(N(newton), F),
    has_units(F, newton),
    strip_units(F, 9.8)
)  # nv

test("constraint accepts matching unit") <- (
    has_units(F, newton),
    F is 9.8(newton),
    has_units(F, newton)
)  # nv

test("constraint rejects wrong unit") <- (
    not (has_units(F, newton), F is 1(second))
)  # nv

test("constraint propagates through arithmetic") <- (
    has_units(D, metre),
    has_units(T, second),
    D is 100(metre),
    T is 10(second),
    eval_(D / T, V),
    has_units(V, metre/second)
)  # nv

# Compound unit expressions: has_units(X, metre**2), has_units(X, metre/second), etc.
# The transformer auto-wraps compound unit args in PyThunk.

test("area check via compound expr") <- (
    eval_(4(metre) ** 2, A),
    has_units(A, metre**2)
)  # nv

test("area constraint via compound expr") <- (
    has_units(A, metre**2),
    eval_(4(metre) ** 2, A)
)  # nv

test("velocity check via compound expr") <- (
    eval_(10(metre) / 1(second), V),
    has_units(V, metre/second)
)  # nv

test("velocity constraint via compound expr") <- (
    has_units(V, metre/second),
    eval_(10(metre) / 1(second), V)
)  # nv

test("acceleration check via compound expr") <- (
    eval_(9.8(metre) / 1(second) ** 2, A),
    has_units(A, metre/second**2)
)  # nv

test("force compound dims check") <- (
    eval_(9.8(newton), F),
    has_units(F, kilogram*metre/second**2)
)  # nv

test("compound dims constraint rejects wrong unit") <- (
    not (has_units(A, metre**2), A is 5(metre))
)  # nv

# dimensionless n() sugar: 42() produces Quantity(42, {})

test("dimensionless integer sugar") <- (
    eval_(42(), D),
    has_units(D, dimensionless),
    strip_units(D, 42)
)  # nv

test("dimensionless float sugar") <- (
    eval_(3.14(), D),
    has_units(D, dimensionless),
    ERR is ++(abs(D.value - 3.14)),
    ERR < 1.0e-12
)  # nv

test("dimensionless sugar equals dimensionless pred") <- (
    eval_(7(), D1),
    D2 is ++(Quantity(7, {})),
    D1 == D2
)  # nv

test("dimensionless sugar not a length") <- (
    eval_(5(), D),
    not has_units(D, metre)
)  # nv

test("dimensionless sugar not a force") <- (
    eval_(9.8(), D),
    not has_units(D, newton)
)  # nv

test("dimensionless via dimensionless check") <- (eval_(0(), D), has_units(D, dimensionless))  # nv

test("dimensionless arithmetic via escape") <- (
    S is ++(Quantity(3, {}) + Quantity(2, {})),
    has_units(S, dimensionless),
    strip_units(S, 5)
)  # nv

test("dimensionless ratio from division") <- (
    eval_(50(metre) / 10(metre), RATIO),
    has_units(RATIO, dimensionless),
    eval_(5.0(), D),
    RATIO == D
)  # nv

# Unit mismatch detection via AttVar constraint system

test("constraint rejects metre for second slot") <- (
    not (has_units(X, second), X is 100(metre))
)  # nv

test("constraint rejects newton for kilogram slot") <- (
    not (has_units(M, kilogram), M is 9.8(newton))
)  # nv

test("constraint rejects joule for watt slot") <- (
    not (has_units(P, watt), P is 1(joule))
)  # nv

test("two constraints conflict") <- (
    not (has_units(X, metre), has_units(X, second))
)  # nv

test("constraint accepts correct unit after arithmetic") <- (
    has_units(V, metre),
    V is 5(metre),
    has_units(V, metre)
)  # nv

# catch/3 and Python exceptions: UnitsMismatch raised from ++ escapes is
# catchable as UnitsMismatch(Msg) — ClassName(Message) compound form.

test("catch add mismatch") <- (
    catch(
        ++(metre(1) + second(1)),
        UnitsMismatch(_),
        1 == 1
    )
)  # nv

test("catch mul no error") <- (
    catch(
        ++(metre(3) * second(2)),
        UnitsMismatch(_),
        1 == 2
    )
)  # nv

test("catch extracts message") <- (
    catch(
        ++(metre(5) + kilogram(2)),
        UnitsMismatch(MSG),
        MSG == MSG
    )
)  # nv
