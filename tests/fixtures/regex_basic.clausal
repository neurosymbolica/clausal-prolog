-double_quotes(chars)
-import_from(py.re, [match, search, replace, split, findall])

# Regex predicates — basic tests: match, search, replace, split, findall.

# ── match/2: boolean test ───────────────────────────────────────────────────

test("match digits") <- match(r"\d+", "123")  # nv
test("match rejects non-digits") <- (not match(r"\d+", "abc"))  # nv
test("match anchored at start") <- (match(r"\d+", "123abc") and (not match(r"\d+", "abc123")))  # nv
test("match full via dollar") <- (match(r"\d+$", "123") and (not match(r"\d+$", "123abc")))  # nv
test("match email") <- match(r"[^@]+@[^@]+\.[^@]+", "a@b.com")  # nv

# ── match/3: explicit group extraction ──────────────────────────────────────

test("match named groups") <- (
    match(r"(?P<year>\d{4})-(?P<month>\d{2})", "2026-03", G) and
    Y is ++G["year"] and
    M is ++G["month"] and
    Y == "2026" and M == "03"
)  # nv

test("match positional groups") <- (
    match(r"(\d+)-(\d+)", "42-99", G) and
    A is ++G[0] and B is ++G[1] and
    A == "42" and B == "99"
)  # nv

test("match no match fails") <- (not match(r"\d+", "abc", _))  # nv

# ── match/2: auto-binding via ALLCAPS groups ────────────────────────────────

test("auto-bind YEAR") <- (
    YEAR_UNUSED is "2026" and
    match(r"(?P<YEAR>\d{4})-\d{2}", "2026-03")
)  # nv

# ── search/2: unanchored ────────────────────────────────────────────────────

test("search finds in middle") <- search(r"\d+", "abc123def")  # nv
test("search rejects absent pattern") <- (not search(r"\d+", "abcdef"))  # nv

test("search explicit groups") <- (
    search(r"(?P<key>\w+)=(?P<val>\w+)", "foo bar=baz", G) and
    K is ++G["key"] and V is ++G["val"] and
    K == "bar" and V == "baz"
)  # nv

# ── replace/4 ───────────────────────────────────────────────────────────────

test("replace whitespace") <- (replace(r"\s+", " ", "a  b   c", R) and R == "a b c")  # nv
test("replace remove digits") <- (replace(r"\d+", "", "a1b2c3", R) and R == "abc")  # nv
test("replace backreference") <- (replace(r"(\w+)", r"[\1]", "hi lo", R) and R == "[hi] [lo]")  # nv

# ── split/3 ─────────────────────────────────────────────────────────────────

test("split comma") <- (split(r",\s*", "a, b, c", F) and F == ["a", "b", "c"])  # nv
test("split whitespace") <- (split(r"\s+", "x y z", F) and F == ["x", "y", "z"])  # nv

# ── findall/3 ────────────────────────────────────────────────────────────

test("findall digits") <- (
    findall(r"\d+", "a1b23c456", D) and D == "1"
)  # nv

test("findall no matches fails") <- (not findall(r"\d+", "abc", _))  # nv

# ── Edge cases ──────────────────────────────────────────────────────────────

test("match empty string") <- match(r"^$", "")  # nv
test("match unicode") <- match(r"^\w+$", "café")  # nv
test("search parens") <- (search(r"\(.*?\)", "f(x)") and (not search(r"\(.*?\)", "fx")))  # nv
test("search vs match") <- ((not match(r"\d+", "abc123")) and search(r"\d+", "abc123"))  # nv

# ── Dynamic patterns ───────────────────────────────────────────────────────

test("dynamic match") <- match(f"^{"hello"}", "hello world")  # nv
test("dynamic pattern variable") <- (PAT is r"\d+", match(PAT, "42"))  # nv
