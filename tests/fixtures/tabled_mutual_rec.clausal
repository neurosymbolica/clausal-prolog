-table(ReachA/2)
-table(ReachB/2)

LinkA(1, 2),
LinkA(3, 4),
LinkB(2, 3),
LinkB(4, 1),

ReachA(X, Y) <- LinkA(X, Y)
ReachA(X, Y) <- (
    ReachB(X, Z),
    LinkA(Z, Y)
)

ReachB(X, Y) <- LinkB(X, Y)
ReachB(X, Y) <- (
    ReachA(X, Z),
    LinkB(Z, Y)
)


Test("reach a 1 2") <- ReachA(1, 2)
Test("reach b 2 3") <- ReachB(2, 3)
Test("reach a transitive 1 4") <- ReachA(1, 4)
Test("reach b transitive 2 1") <- ReachB(2, 1)
