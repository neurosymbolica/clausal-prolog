# Test fixture: specialize SolveLimit with natnum program.

-import_from(clausal.examples.metainterpreters, [SolveLimit])

NatnumProgram(PROGRAM) <- (
    PROGRAM is [
        [["natnum", 0], []],
        [["natnum", ["s", X]], [["natnum", X]]]
    ]
)

-specialize(SolveLimit, NatnumProgram, alias=SolveLimitNatnum)

# ── Tests ─────────────────────────────────────────────────────────────────────

Test("limit natnum(0) depth 1 ok") <- (
    SolveLimitNatnum([["natnum", 0]], 1)
)

Test("limit natnum(s(0)) depth 1 fails") <- (
    not SolveLimitNatnum([["natnum", ["s", 0]]], 1)
)

Test("limit natnum(s(0)) depth 2 ok") <- (
    SolveLimitNatnum([["natnum", ["s", 0]]], 2)
)

Test("limit natnum(s(s(0))) depth 2 fails") <- (
    not SolveLimitNatnum([["natnum", ["s", ["s", 0]]]], 2)
)

Test("limit natnum(s(s(0))) depth 3 ok") <- (
    SolveLimitNatnum([["natnum", ["s", ["s", 0]]]], 3)
)
