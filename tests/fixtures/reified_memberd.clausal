# memberd/2: deterministic membership via reified ITE
# This is the key example from Neumerkel & Kral (arXiv:1607.01590, §6).
# Ground queries are deterministic (no leftover choicepoints).
# Partial queries explore both branches with correct constraints.

memberd(X_, [E_, *Es_]) <- (
    If(X_ is not E_, memberd(X_, Es_), True)
)
