-import_from(py.torch, [tensor, randn, shape, tensor_list, zeros, ones])
-import_from(py.torch_functional, [
    leaky_relu, elu, selu, gelu, silu, mish, hardswish, hardsigmoid,
    conv1d, conv2d, conv3d,
    max_pool1d, max_pool2d, avg_pool1d, avg_pool2d,
    adaptive_avg_pool1d, adaptive_avg_pool2d,
    batch_norm, layer_norm, normalize,
    cross_entropy, mse_loss, l1_loss, nll_loss, binary_cross_entropy,
    dropout
])

# ═══════════════════════════════════════════════════════════════════════════
# Activations
# ═══════════════════════════════════════════════════════════════════════════

Test("leaky_relu default") <- (
    tensor([-1.0, 0.0, 1.0], T),
    leaky_relu(T, R),
    shape(R, [3])
)

Test("leaky_relu custom slope") <- (
    tensor([-1.0, 0.0, 1.0], T),
    leaky_relu(T, 0.2, R),
    shape(R, [3])
)

Test("elu default") <- (
    tensor([-1.0, 0.0, 1.0], T),
    elu(T, R),
    shape(R, [3])
)

Test("elu custom alpha") <- (
    tensor([-1.0, 0.0, 1.0], T),
    elu(T, 2.0, R),
    shape(R, [3])
)

Test("selu") <- (
    tensor([-1.0, 0.0, 1.0], T),
    selu(T, R),
    shape(R, [3])
)

Test("gelu") <- (
    tensor([-1.0, 0.0, 1.0], T),
    gelu(T, R),
    shape(R, [3])
)

Test("silu") <- (
    tensor([-1.0, 0.0, 1.0], T),
    silu(T, R),
    shape(R, [3])
)

Test("mish") <- (
    tensor([-1.0, 0.0, 1.0], T),
    mish(T, R),
    shape(R, [3])
)

Test("hardswish") <- (
    tensor([-1.0, 0.0, 1.0], T),
    hardswish(T, R),
    shape(R, [3])
)

Test("hardsigmoid") <- (
    tensor([-1.0, 0.0, 1.0], T),
    hardsigmoid(T, R),
    shape(R, [3])
)

# Activations preserve positive values
Test("gelu positive passthrough") <- (
    tensor([2.0], T),
    gelu(T, R),
    tensor_list(R, [V]),
    V > 1.9
)

# ═══════════════════════════════════════════════════════════════════════════
# Convolutions
# ═══════════════════════════════════════════════════════════════════════════

Test("conv1d shape") <- (
    randn([1, 1, 5], INPUT),
    randn([1, 1, 3], WEIGHT),
    conv1d(INPUT, WEIGHT, OUTPUT),
    shape(OUTPUT, [1, 1, 3])
)

Test("conv2d shape") <- (
    randn([1, 1, 5, 5], INPUT),
    randn([1, 1, 3, 3], WEIGHT),
    conv2d(INPUT, WEIGHT, OUTPUT),
    shape(OUTPUT, [1, 1, 3, 3])
)

Test("conv2d with padding") <- (
    randn([1, 1, 5, 5], INPUT),
    randn([1, 1, 3, 3], WEIGHT),
    conv2d(INPUT, WEIGHT, {"padding": 1}, OUTPUT),
    shape(OUTPUT, [1, 1, 5, 5])
)

Test("conv2d with stride") <- (
    randn([1, 1, 6, 6], INPUT),
    randn([1, 1, 3, 3], WEIGHT),
    conv2d(INPUT, WEIGHT, {"stride": 2}, OUTPUT),
    shape(OUTPUT, [1, 1, 2, 2])
)

Test("conv3d shape") <- (
    randn([1, 1, 5, 5, 5], INPUT),
    randn([1, 1, 3, 3, 3], WEIGHT),
    conv3d(INPUT, WEIGHT, OUTPUT),
    shape(OUTPUT, [1, 1, 3, 3, 3])
)

# ═══════════════════════════════════════════════════════════════════════════
# Pooling
# ═══════════════════════════════════════════════════════════════════════════

Test("max_pool1d") <- (
    randn([1, 1, 6], INPUT),
    max_pool1d(INPUT, 2, OUTPUT),
    shape(OUTPUT, [1, 1, 3])
)

Test("max_pool2d") <- (
    randn([1, 1, 4, 4], INPUT),
    max_pool2d(INPUT, 2, OUTPUT),
    shape(OUTPUT, [1, 1, 2, 2])
)

Test("max_pool2d with stride") <- (
    randn([1, 1, 6, 6], INPUT),
    max_pool2d(INPUT, 3, {"stride": 2}, OUTPUT),
    shape(OUTPUT, [1, 1, 2, 2])
)

Test("avg_pool1d") <- (
    randn([1, 1, 6], INPUT),
    avg_pool1d(INPUT, 2, OUTPUT),
    shape(OUTPUT, [1, 1, 3])
)

Test("avg_pool2d") <- (
    randn([1, 1, 4, 4], INPUT),
    avg_pool2d(INPUT, 2, OUTPUT),
    shape(OUTPUT, [1, 1, 2, 2])
)

Test("adaptive_avg_pool1d") <- (
    randn([1, 1, 10], INPUT),
    adaptive_avg_pool1d(INPUT, 5, OUTPUT),
    shape(OUTPUT, [1, 1, 5])
)

Test("adaptive_avg_pool2d") <- (
    randn([1, 1, 10, 10], INPUT),
    adaptive_avg_pool2d(INPUT, [3, 3], OUTPUT),
    shape(OUTPUT, [1, 1, 3, 3])
)

# ═══════════════════════════════════════════════════════════════════════════
# Normalization
# ═══════════════════════════════════════════════════════════════════════════

Test("batch_norm shape preserved") <- (
    randn([2, 3, 4], INPUT),
    zeros([3], MEAN),
    ones([3], VAR),
    batch_norm(INPUT, MEAN, VAR, OUTPUT),
    shape(OUTPUT, [2, 3, 4])
)

Test("layer_norm shape preserved") <- (
    randn([2, 3, 4], INPUT),
    layer_norm(INPUT, [4], OUTPUT),
    shape(OUTPUT, [2, 3, 4])
)

Test("layer_norm multi-dim") <- (
    randn([2, 3, 4], INPUT),
    layer_norm(INPUT, [3, 4], OUTPUT),
    shape(OUTPUT, [2, 3, 4])
)

Test("normalize default") <- (
    randn([3, 4], INPUT),
    normalize(INPUT, OUTPUT),
    shape(OUTPUT, [3, 4])
)

Test("normalize with dim") <- (
    randn([3, 4], INPUT),
    normalize(INPUT, {"dim": 0}, OUTPUT),
    shape(OUTPUT, [3, 4])
)

# ═══════════════════════════════════════════════════════════════════════════
# Loss functions
# ═══════════════════════════════════════════════════════════════════════════

Test("cross_entropy") <- (
    randn([3, 5], LOGITS),
    tensor([0, 2, 1], TARGETS),
    cross_entropy(LOGITS, TARGETS, LOSS),
    shape(LOSS, [])
)

Test("cross_entropy with reduction") <- (
    randn([3, 5], LOGITS),
    tensor([0, 2, 1], TARGETS),
    cross_entropy(LOGITS, TARGETS, {"reduction": "none"}, LOSS),
    shape(LOSS, [3])
)

Test("mse_loss") <- (
    tensor([1.0, 2.0, 3.0], PRED),
    tensor([1.0, 2.0, 3.0], TARGET),
    mse_loss(PRED, TARGET, LOSS),
    tensor_list(LOSS, V),
    V < 0.001
)

Test("mse_loss nonzero") <- (
    tensor([1.0, 2.0, 3.0], PRED),
    tensor([2.0, 3.0, 4.0], TARGET),
    mse_loss(PRED, TARGET, LOSS),
    tensor_list(LOSS, V),
    V > 0.9
)

Test("l1_loss") <- (
    tensor([1.0, 2.0, 3.0], PRED),
    tensor([1.0, 2.0, 3.0], TARGET),
    l1_loss(PRED, TARGET, LOSS),
    tensor_list(LOSS, V),
    V < 0.001
)

Test("nll_loss") <- (
    tensor([[-0.5, -1.0, -2.0], [-0.3, -0.8, -1.5]], INPUT),
    tensor([0, 1], TARGET),
    nll_loss(INPUT, TARGET, LOSS),
    shape(LOSS, [])
)

Test("binary_cross_entropy") <- (
    tensor([0.5, 0.5, 0.5], PRED),
    tensor([1.0, 0.0, 1.0], TARGET),
    binary_cross_entropy(PRED, TARGET, LOSS),
    shape(LOSS, [])
)

# ═══════════════════════════════════════════════════════════════════════════
# Dropout
# ═══════════════════════════════════════════════════════════════════════════

Test("dropout eval mode") <- (
    tensor([1.0, 2.0, 3.0], T),
    dropout(T, R),
    # In eval mode (training=False), dropout is identity
    tensor_list(R, [1.0, 2.0, 3.0])
)

Test("dropout with opts") <- (
    tensor([1.0, 2.0, 3.0], T),
    dropout(T, {"p": 0.5, "training": False}, R),
    tensor_list(R, [1.0, 2.0, 3.0])
)
