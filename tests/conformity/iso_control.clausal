# ISO Prolog conformity: control constructs
#
# ISO §7.8 — conjunction, disjunction, negation, true, fail
#
# Clausal equivalents:
#   ,/2 → and        ;/2 → or        \+/1 → not
#
# Not available:
#   cut (!), if-then-else (->)

-module(iso_control, [Test(DESC)])

-private([
    Choose(X, Y, R),
    SafeMax(X, Y, M),
    a, b, c, d
])

# Multi-clause disjunction: Choose/3 picks either argument.
Choose(X, _, X),
Choose(_, Y, Y),

# If-then-else pattern via or+not (no -> in clausal).
SafeMax(X, Y, X) <- (X >= Y)
SafeMax(X, Y, Y) <- (Y > X)

# ── Conjunction (and) ────────────────────────────────────────────────────────

Test("conjunction binds two vars") <- (
    _x is 1,
    _y is 2,
    _x == 1,
    _y == 2
)
Test("conjunction fails if first fails") <- (not (a is b and _x is 1))
Test("conjunction fails if second fails") <- (not (_x is 1 and a is b))
Test("triple conjunction") <- (
    _x is 1,
    _y is 2,
    _z is 3,
    _x + _y + _z == 6
)

# ── Disjunction (or) ────────────────────────────────────────────────────────

Test("disjunction first succeeds") <- (_x is 1 or _x is 2)
Test("disjunction first fails, second succeeds") <- (a is b or _x is 1)
Test("disjunction both fail") <- (not (a is b or c is d))

# ── Negation as failure (not) ────────────────────────────────────────────────

Test("not: failed unification succeeds") <- (not (1 is 2))
Test("not: successful unification fails") <- (not (not (1 is 1)))
Test("not: member absent") <- (not in_(d, [a, b, c]))
Test("not: member present fails") <- (not (not in_(b, [a, b, c])))
Test("double negation: not not (1=1)") <- (not (not (1 is 1)))

# ── Combining control constructs ─────────────────────────────────────────────

Test("and + or: (X=1 and Y=a) or (X=2 and Y=b)") <- (
    (_x is 1 and _y is a) or (_x is 2 and _y is b)
)
Test("not + member: d not in list") <- (
    not in_(d, [a, b, c])
)
Test("conjunction + negation") <- (
    _x is 5,
    not (_x is 3),
    _x == 5
)

# ── Multi-clause predicates (Choose/3) ─────────────────────────────────────

Test("choose picks first") <- Choose(1, 2, 1)
Test("choose picks second") <- Choose(1, 2, 2)
Test("choose with atoms") <- Choose(a, b, a)

# ── If-then-else via SafeMax/3 ────────────────────────────────────────────

Test("safe_max: first is larger") <- (
    SafeMax(5, 3, _m),
    _m == 5
)
Test("safe_max: second is larger") <- (
    SafeMax(2, 7, _m),
    _m == 7
)
Test("safe_max: equal") <- (
    SafeMax(4, 4, _m),
    _m == 4
)
