# ISO Prolog conformity: type-checking predicates
#
# ISO §8.3 — var/1, nonvar/1, atom/1, integer/1, float/1, number/1,
#            compound/1, callable/1
#
# Differences from ISO:
#   atom/1 tests for Python str (not Prolog atom symbol)
#   float/1 spelled float_/1 — cannot be tested in .clausal (trailing _ = Var)
#   bool excluded from integer/1, number/1
#   [] is a list, not an atom
#
# Limitations in .clausal syntax:
#   - float_ no longer has trailing underscore issue (convention changed to leading underscore).
#     However, float_ tests still use Python test file for other reasons.
#   - Negative literals like -1 are parsed as Negate(1), not as int.
#     Tests needing negative int args must use Python test file.
#   - Complex Python types (bool, complex) can't be tested directly.

-module(iso_type_checking, [Test(DESC)])

-private([
    IsBoundNumber(X),
    Hello, Abc
])

# Succeeds when X is bound to a number (integer or float).
IsBoundNumber(X) <- (
    nonvar(X),
    number(X)
)

# ── var/1 ────────────────────────────────────────────────────────────────────

Test("var: unbound var succeeds") <- var(_x)
Test("var: integer fails") <- (not var(42))
Test("var: atom fails") <- (not var(Hello))
Test("var: bound var fails") <- (
    _x is 1,
    not var(_x)
)

# ── nonvar/1 ─────────────────────────────────────────────────────────────────

Test("nonvar: integer succeeds") <- nonvar(42)
Test("nonvar: atom succeeds") <- nonvar(Hello)
Test("nonvar: unbound var fails") <- (not nonvar(_x))
Test("nonvar: bound var succeeds") <- (
    _x is 1,
    nonvar(_x)
)
Test("nonvar: list succeeds") <- nonvar([1, 2])

# ── atom/1 ──────────────────────────────────────────────────────────────────

Test("atom: declared atom succeeds") <- atom(Hello)
Test("atom: declared atom Abc") <- atom(Abc)
Test("atom: string fails") <- (not atom("hello"))
Test("atom: integer fails") <- (not atom(1))
Test("atom: unbound var fails") <- (not atom(_x))

# ── is_str/1 ───────────────────────────────────────────────────────────────────

Test("str: plain string succeeds") <- is_str("hello")
Test("str: empty string succeeds") <- is_str("")
Test("str: declared atom fails") <- (not is_str(Hello))
Test("str: integer fails") <- (not is_str(1))
Test("str: unbound var fails") <- (not is_str(_x))
Test("str: list fails") <- (not is_str([]))

# ── integer/1 ────────────────────────────────────────────────────────────────────

Test("integer: positive") <- integer(1)
Test("integer: zero") <- integer(0)
Test("integer: large") <- integer(100000000000000000000)
Test("integer: string fails") <- (not integer("1"))
Test("integer: var fails") <- (not integer(_x))
# Note: integer(-1), integer(True/False) tested in Python test file

# ── float_/1 ─────────────────────────────────────────────────────────────────
# Note: float_ can be tested in .clausal (not a logic variable name)

# ── number/1 ─────────────────────────────────────────────────────────────────

Test("number: integer") <- number(42)
Test("number: float") <- number(3.14)
Test("number: string fails") <- (not number("42"))
Test("number: var fails") <- (not number(_x))

# ── callable_/1 (declared atoms) ─────────────────────────────────────────────

Test("callable: declared atom") <- callable_(Hello)
Test("callable: string") <- callable_("hello")
Test("callable: int fails") <- (not callable_(42))
Test("callable: var fails") <- (not callable_(_x))

# ── is_list/1 ────────────────────────────────────────────────────────────────────

Test("is_list: list") <- is_list([1, 2, 3])
Test("is_list: empty") <- is_list([])
Test("is_list: nested") <- is_list([[1], [2]])
Test("is_list: string fails") <- (not is_list(Hello))
Test("is_list: int fails") <- (not is_list(42))
Test("is_list: var fails") <- (not is_list(_x))

# ── ground/1 ─────────────────────────────────────────────────────────────────

Test("ground: integer") <- ground(42)
Test("ground: declared atom") <- ground(Abc)
Test("ground: ground list") <- ground([1, 2, 3])
Test("ground: empty list") <- ground([])
Test("ground: var fails") <- (not ground(_x))

# ── IsBoundNumber/1 (private helper) ─────────────────────────────────────────

Test("is_bound_number: integer") <- IsBoundNumber(42)
Test("is_bound_number: float") <- IsBoundNumber(3.14)
Test("is_bound_number: string fails") <- (not IsBoundNumber("42"))
Test("is_bound_number: unbound fails") <- (not IsBoundNumber(_x))
