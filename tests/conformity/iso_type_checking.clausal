# ISO Prolog conformity: type-checking predicates
#
# ISO §8.3 — var/1, nonvar/1, atom/1, integer/1, float/1, number/1,
#            compound/1, callable/1
#
# Differences from ISO:
#   atom/1 tests for Python str (not Prolog atom symbol)
#   float/1 spelled float_/1 — cannot be tested in .clausal (trailing _ = Var)
#   bool excluded from integer/1, number/1
#   [] is a list, not an atom
#
# Limitations in .clausal syntax:
#   - float_/1 has trailing underscore so it's parsed as a logic variable.
#     float_ tests must use Python test file.
#   - Negative literals like -1 are parsed as Negate(1), not as int.
#     Tests needing negative int args must use Python test file.
#   - Complex Python types (bool, complex) can't be tested directly.

-module(iso_type_checking, [test(DESC)])

-private([
    is_bound_number(X),
    hello, abc
])

# Succeeds when X is bound to a number (integer or float).
is_bound_number(X) <- (
    IsBound(X),
    IsNumber(X)
)

# ── IsVar/1 ────────────────────────────────────────────────────────────────────

test("var: unbound var succeeds") <- IsVar(X_)
test("var: integer fails") <- (not IsVar(42))
test("var: atom fails") <- (not IsVar(hello))
test("var: bound var fails") <- (
    X_ is 1,
    not IsVar(X_)
)

# ── IsBound/1 ─────────────────────────────────────────────────────────────────

test("nonvar: integer succeeds") <- IsBound(42)
test("nonvar: atom succeeds") <- IsBound(hello)
test("nonvar: unbound var fails") <- (not IsBound(X_))
test("nonvar: bound var succeeds") <- (
    X_ is 1,
    IsBound(X_)
)
test("nonvar: list succeeds") <- IsBound([1, 2])

# ── IsStr/1 ───────────────────────────────────────────────────────────────────

test("atom: string succeeds") <- IsStr(hello)
test("atom: empty string succeeds") <- IsStr("")
test("atom: integer fails") <- (not IsStr(1))
test("atom: unbound var fails") <- (not IsStr(X_))
test("atom: list fails") <- (not IsStr([]))

# ── IsInt/1 ────────────────────────────────────────────────────────────────────

test("integer: positive") <- IsInt(1)
test("integer: zero") <- IsInt(0)
test("integer: large") <- IsInt(100000000000000000000)
test("integer: string fails") <- (not IsInt("1"))
test("integer: var fails") <- (not IsInt(X_))
# Note: IsInt(-1), IsInt(True/False) tested in Python test file

# ── IsFloat/1 ─────────────────────────────────────────────────────────────────
# Note: IsFloat can be tested in .clausal (no longer a trailing-underscore name)

# ── IsNumber/1 ─────────────────────────────────────────────────────────────────

test("number: integer") <- IsNumber(42)
test("number: float") <- IsNumber(3.14)
test("number: string fails") <- (not IsNumber("42"))
test("number: var fails") <- (not IsNumber(X_))

# ── IsStr/1 (string alias) ────────────────────────────────────────────────────

test("string: str succeeds") <- IsStr(hello)
test("string: empty str") <- IsStr("")
test("string: int fails") <- (not IsStr(42))
test("string: var fails") <- (not IsStr(X_))

# ── IsList/1 ────────────────────────────────────────────────────────────────────

test("is_list: list") <- IsList([1, 2, 3])
test("is_list: empty") <- IsList([])
test("is_list: nested") <- IsList([[1], [2]])
test("is_list: string fails") <- (not IsList(hello))
test("is_list: int fails") <- (not IsList(42))
test("is_list: var fails") <- (not IsList(X_))

# ── IsGround/1 ─────────────────────────────────────────────────────────────────

test("ground: integer") <- IsGround(42)
test("ground: string") <- IsGround(abc)
test("ground: ground list") <- IsGround([1, 2, 3])
test("ground: empty list") <- IsGround([])
test("ground: var fails") <- (not IsGround(X_))

# ── is_bound_number/1 (private helper) ─────────────────────────────────────

test("is_bound_number: integer") <- is_bound_number(42)
test("is_bound_number: float") <- is_bound_number(3.14)
test("is_bound_number: string fails") <- (not is_bound_number("42"))
test("is_bound_number: unbound fails") <- (not is_bound_number(X_))
