# ISO Prolog conformity: list operations
#
# Prolog's member/2 corresponds to 'in' / 'not in' in clausal.
# member/2 also available as a callable builtin.
#
# Differences from Prolog:
#   Lists are Python lists, not cons-pairs
#   No partial lists
#   sort/2 removes duplicates (like ISO sort/2)
#   msort/2 preserves duplicates

-module(iso_list_operations, [Test(DESC)])

-private([
    Palindrome(XS),
    SortedAsc(XS),
    IsPermutation(XS, YS),
    a, b, c, d, x
])

# A palindrome reads the same forwards and backwards.
Palindrome(XS) <- reverse(XS, XS)

# Check that a list is in ascending order.
SortedAsc(XS=[]),
SortedAsc([_]),
SortedAsc([A, B, *REST]) <- (
    A <= B,
    SortedAsc([B, *REST])
)

# Two lists are permutations iff they have equal length and equal sorted form.
IsPermutation(XS, YS) <- (
    length(XS, N),
    length(YS, N),
    sort(XS, S),
    sort(YS, S)
)

# ── in / not in (membership) ─────────────────────────────────────────────────

Test("in: found") <- (b in [a, b, c])
Test("in: not found") <- (not (d in [a, b, c]))
Test("in: empty list fails") <- (not (x in []))
Test("in: integer") <- (2 in [1, 2, 3])
Test("not in: absent") <- (d not in [a, b, c])
Test("not in: present fails") <- (not (b not in [a, b, c]))
Test("not in: empty list") <- (x not in [])

# ── in_/2 (callable builtin) ──────────────────────────────────────────────────

Test("member: found") <- in_(b, [a, b, c])
Test("member: not found") <- (not in_(d, [a, b, c]))
Test("member: empty fails") <- (not in_(x, []))
Test("memberchk: found") <- in_check(b, [a, b, c])
Test("memberchk: not found") <- (not in_check(d, [a, b, c]))

# ── append/3 ──────────────────────────────────────────────────────────────────

Test("append two lists") <- append([1, 2], [3, 4], [1, 2, 3, 4])
Test("append empty left") <- append([], [1, 2], [1, 2])
Test("append empty right") <- append([1, 2], [], [1, 2])
Test("append both empty") <- append([], [], [])
Test("append binds result") <- (
    append([1], [2], _r),
    _r == [1, 2]
)

# ── length/2 ──────────────────────────────────────────────────────────────────

Test("length of 3") <- length([a, b, c], 3)
Test("length empty") <- length([], 0)
Test("length one") <- length([42], 1)
Test("length binds") <- (
    length([1, 2, 3], _n),
    _n == 3
)

# ── last/2 ────────────────────────────────────────────────────────────────────

Test("last element") <- last([1, 2, 3], 3)
Test("last singleton") <- last([42], 42)
Test("last empty fails") <- (not last([], _))

# ── reverse/2 ────────────────────────────────────────────────────────────────

Test("reverse list") <- reverse([1, 2, 3], [3, 2, 1])
Test("reverse empty") <- reverse([], [])
Test("reverse singleton") <- reverse([42], [42])
Test("reverse involution") <- (
    reverse([1, 2, 3], _r),
    reverse(_r, _rr),
    _rr == [1, 2, 3]
)

# ── get_item/3 (0-based) ────────────────────────────────────────────────────────

Test("nth0 first") <- get_item(0, [a, b, c], a)
Test("nth0 last") <- get_item(2, [a, b, c], c)
Test("nth1 first") <- get_item(0, [a, b, c], a)
Test("nth1 last") <- get_item(2, [a, b, c], c)
Test("nth0 out of range") <- (not get_item(5, [a, b], _))
Test("nth1 zero fails") <- (not get_item(-1, [a, b], _))

# ── sort/2 and msort/2 ───────────────────────────────────────────────────

Test("sort removes dups") <- sort([3, 1, 2, 1], [1, 2, 3])
Test("sort already sorted") <- sort([1, 2, 3], [1, 2, 3])
Test("sort empty") <- sort([], [])
Test("msort preserves dups") <- msort([3, 1, 2, 1], [1, 1, 2, 3])
Test("sort strings") <- sort([c, a, b], [a, b, c])

# ── flatten/2 ────────────────────────────────────────────────────────────────

Test("flatten nested") <- flatten([1, [2, [3]], 4], [1, 2, 3, 4])
Test("flatten already flat") <- flatten([1, 2, 3], [1, 2, 3])
Test("flatten empty") <- flatten([], [])

# ── select/3 ─────────────────────────────────────────────────────────────────

Test("select element") <- select(2, [1, 2, 3], [1, 3])
Test("select first") <- select(1, [1, 2, 3], [2, 3])
Test("select not found") <- (not select(9, [1, 2, 3], _))

# ── set operations ───────────────────────────────────────────────────────────

Test("subtract") <- subtract([1, 2, 3, 4], [2, 4], [1, 3])
Test("intersection") <- intersection([1, 2, 3], [2, 3, 4], [2, 3])
Test("union") <- union([1, 2], [2, 3], [1, 2, 3])
Test("list_to_set") <- list_to_set([1, 2, 1, 3, 2], [1, 2, 3])

# ── aggregates ───────────────────────────────────────────────────────────────

Test("sum_list") <- sum_list([1, 2, 3, 4], 10)
Test("sum_list empty") <- sum_list([], 0)
Test("max_list") <- max_list([3, 1, 4, 1, 5], 5)
Test("min_list") <- min_list([3, 1, 4, 1, 5], 1)
Test("max_list singleton") <- max_list([42], 42)

# ── palindrome/1 (private helper) ──────────────────────────────────────────

Test("palindrome: empty") <- Palindrome([])
Test("palindrome: single") <- Palindrome([1])
Test("palindrome: aba") <- Palindrome([1, 2, 1])
Test("palindrome: abba") <- Palindrome([1, 2, 2, 1])
Test("not palindrome: ab") <- (not Palindrome([1, 2]))

# ── sorted_asc/1 (private helper) ──────────────────────────────────────────

Test("sorted_asc: empty") <- SortedAsc([])
Test("sorted_asc: single") <- SortedAsc([1])
Test("sorted_asc: ascending") <- SortedAsc([1, 2, 3])
Test("sorted_asc: not descending") <- (not SortedAsc([3, 2, 1]))
Test("sorted_asc: equal elements") <- SortedAsc([2, 2, 2])

# ── is_permutation/2 (private helper) ──────────────────────────────────────

Test("is_permutation: same list") <- IsPermutation([1, 2, 3], [1, 2, 3])
Test("is_permutation: reordered") <- IsPermutation([3, 1, 2], [1, 2, 3])
Test("not permutation: different lengths") <- (not IsPermutation([1, 2], [1, 2, 3]))
Test("is_permutation: empty") <- IsPermutation([], [])
