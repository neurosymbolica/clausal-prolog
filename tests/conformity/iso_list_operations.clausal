# ISO Prolog conformity: list operations
#
# Prolog's member/2 corresponds to 'in' / 'not in' in clausal.
# member/2 also available as a callable builtin.
#
# Differences from Prolog:
#   Lists are Python lists, not cons-pairs
#   No partial lists
#   sort/2 removes duplicates (like ISO sort/2)
#   msort/2 preserves duplicates

-module(iso_list_operations, [test(DESC)])

-private([
    palindrome(XS),
    sorted_asc(XS),
    is_permutation(XS, YS),
    a, b, c, d, x
])

# A palindrome reads the same forwards and backwards.
palindrome(XS) <- reverse(XS, XS)

# Check that a list is in ascending order.
sorted_asc(XS=[]),
sorted_asc([_]),
sorted_asc([A, B, *REST]) <- (
    A <= B,
    sorted_asc([B, *REST])
)

# Two lists are permutations iff they have equal length and equal sorted form.
is_permutation(XS, YS) <- (
    length(XS, N),
    length(YS, N),
    sort(XS, S),
    sort(YS, S)
)

# ── in / not in (membership) ─────────────────────────────────────────────────

test("in: found") <- (b in [a, b, c])  # nv
test("in: not found") <- (not (d in [a, b, c]))  # nv
test("in: empty list fails") <- (not (x in []))  # nv
test("in: integer") <- (2 in [1, 2, 3])  # nv
test("not in: absent") <- (d not in [a, b, c])  # nv
test("not in: present fails") <- (not (b not in [a, b, c]))  # nv
test("not in: empty list") <- (x not in [])  # nv

# ── in_/2 (callable builtin) ──────────────────────────────────────────────────

test("member: found") <- in_(b, [a, b, c])  # nv
test("member: not found") <- (not in_(d, [a, b, c]))  # nv
test("member: empty fails") <- (not in_(x, []))  # nv
test("memberchk: found") <- in_check(b, [a, b, c])  # nv
test("memberchk: not found") <- (not in_check(d, [a, b, c]))  # nv

# ── append/3 ──────────────────────────────────────────────────────────────────

test("append two lists") <- append([1, 2], [3, 4], [1, 2, 3, 4])  # nv
test("append empty left") <- append([], [1, 2], [1, 2])  # nv
test("append empty right") <- append([1, 2], [], [1, 2])  # nv
test("append both empty") <- append([], [], [])  # nv
test("append binds result") <- (
    append([1], [2], _r),
    '=='(_r, [1, 2])
)  # nv

# ── length/2 ──────────────────────────────────────────────────────────────────

test("length of 3") <- length([a, b, c], 3)  # nv
test("length empty") <- length([], 0)  # nv
test("length one") <- length([42], 1)  # nv
test("length binds") <- (
    length([1, 2, 3], _n),
    _n == 3
)  # nv

# ── last/2 ────────────────────────────────────────────────────────────────────

test("last element") <- last([1, 2, 3], 3)  # nv
test("last singleton") <- last([42], 42)  # nv
test("last empty fails") <- (not last([], _))  # nv

# ── reverse/2 ────────────────────────────────────────────────────────────────

test("reverse list") <- reverse([1, 2, 3], [3, 2, 1])  # nv
test("reverse empty") <- reverse([], [])  # nv
test("reverse singleton") <- reverse([42], [42])  # nv
test("reverse involution") <- (
    reverse([1, 2, 3], _r),
    reverse(_r, _rr),
    '=='(_rr, [1, 2, 3])
)  # nv

# ── list_item/3 (0-based) ────────────────────────────────────────────────────────

test("nth0 first") <- list_item(0, [a, b, c], a)  # nv
test("nth0 last") <- list_item(2, [a, b, c], c)  # nv
test("nth1 first") <- list_item(0, [a, b, c], a)  # nv
test("nth1 last") <- list_item(2, [a, b, c], c)  # nv
test("nth0 out of range") <- (not list_item(5, [a, b], _))  # nv
test("nth1 zero fails") <- (not list_item(-1, [a, b], _))  # nv

# ── sort/2 and msort/2 ───────────────────────────────────────────────────

test("sort removes dups") <- sort([3, 1, 2, 1], [1, 2, 3])  # nv
test("sort already sorted") <- sort([1, 2, 3], [1, 2, 3])  # nv
test("sort empty") <- sort([], [])  # nv
test("msort preserves dups") <- msort([3, 1, 2, 1], [1, 1, 2, 3])  # nv
test("sort strings") <- sort([c, a, b], [a, b, c])  # nv

# ── flatten/2 ────────────────────────────────────────────────────────────────

test("flatten nested") <- flatten([1, [2, [3]], 4], [1, 2, 3, 4])  # nv
test("flatten already flat") <- flatten([1, 2, 3], [1, 2, 3])  # nv
test("flatten empty") <- flatten([], [])  # nv

# ── select/3 ─────────────────────────────────────────────────────────────────

test("select element") <- select(2, [1, 2, 3], [1, 3])  # nv
test("select first") <- select(1, [1, 2, 3], [2, 3])  # nv
test("select not found") <- (not select(9, [1, 2, 3], _))  # nv

# ── set operations ───────────────────────────────────────────────────────────

test("subtract") <- subtract([1, 2, 3, 4], [2, 4], [1, 3])  # nv
test("intersection") <- intersection([1, 2, 3], [2, 3, 4], [2, 3])  # nv
test("union") <- union([1, 2], [2, 3], [1, 2, 3])  # nv
test("list_to_set") <- list_to_set([1, 2, 1, 3, 2], [1, 2, 3])  # nv

# ── aggregates ───────────────────────────────────────────────────────────────

test("sum_list") <- sum_list([1, 2, 3, 4], 10)  # nv
test("sum_list empty") <- sum_list([], 0)  # nv
test("max_list") <- max_list([3, 1, 4, 1, 5], 5)  # nv
test("min_list") <- min_list([3, 1, 4, 1, 5], 1)  # nv
test("max_list singleton") <- max_list([42], 42)  # nv

# ── palindrome/1 (private helper) ──────────────────────────────────────────

test("palindrome: empty") <- palindrome([])  # nv
test("palindrome: single") <- palindrome([1])  # nv
test("palindrome: aba") <- palindrome([1, 2, 1])  # nv
test("palindrome: abba") <- palindrome([1, 2, 2, 1])  # nv
test("not palindrome: ab") <- (not palindrome([1, 2]))  # nv

# ── sorted_asc/1 (private helper) ──────────────────────────────────────────

test("sorted_asc: empty") <- sorted_asc([])  # nv
test("sorted_asc: single") <- sorted_asc([1])  # nv
test("sorted_asc: ascending") <- sorted_asc([1, 2, 3])  # nv
test("sorted_asc: not descending") <- (not sorted_asc([3, 2, 1]))  # nv
test("sorted_asc: equal elements") <- sorted_asc([2, 2, 2])  # nv

# ── is_permutation/2 (private helper) ──────────────────────────────────────

test("is_permutation: same list") <- is_permutation([1, 2, 3], [1, 2, 3])  # nv
test("is_permutation: reordered") <- is_permutation([3, 1, 2], [1, 2, 3])  # nv
test("not permutation: different lengths") <- (not is_permutation([1, 2], [1, 2, 3]))  # nv
test("is_permutation: empty") <- is_permutation([], [])  # nv

# ── enumeration cases (migrated from test_iso_list_operations.py) ──────────

test("in_ enumerates [1,2,3]") <- (
    findall(X, in_(X, [1, 2, 3]), L),
    '=='(L, [1, 2, 3])
)  # nv
test("in_ with duplicates [a,b,a]") <- (
    findall(X, in_(X, [a, b, a]), L),
    '=='(L, [a, b, a])
)  # nv
test("in enumerates [1,2,3]") <- (
    findall(X, X in [1, 2, 3], L),
    '=='(L, [1, 2, 3])
)  # nv
test("append split mode") <- (
    findall([X, Y], append(X, Y, [1, 2, 3]), L),
    '=='(L, [[[], [1, 2, 3]], [[1], [2, 3]], [[1, 2], [3]], [[1, 2, 3], []]])
)  # nv
test("list_item second element") <- list_item(1, [a, b, c], b)  # nv
test("last empty yields no solutions") <- (
    findall(X, last([], X), L),
    '=='(L, [])
)  # nv

# ── permutation/2 ──────────────────────────────────────────────────────────

test("permutation of [1,2,3] yields 6") <- (
    findall(P, permutation([1, 2, 3], P), L),
    length(L, 6),
    [1, 2, 3] in L,
    [3, 2, 1] in L
)  # nv
test("permutation of [] is [[]]") <- (
    findall(P, permutation([], P), L),
    '=='(L, [[]])
)  # nv
test("permutation of [42] is [[42]]") <- (
    findall(P, permutation([42], P), L),
    '=='(L, [[42]])
)  # nv

# ── select/3 success shapes ────────────────────────────────────────────────

test("select(2,[1,2,3],[1,3])") <- (
    select(2, [1, 2, 3], R),
    '=='(R, [1, 3])
)  # nv
test("select(1,[1,2,3],[2,3])") <- (
    select(1, [1, 2, 3], R),
    '=='(R, [2, 3])
)  # nv
