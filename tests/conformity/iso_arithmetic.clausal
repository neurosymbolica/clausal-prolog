# ISO Prolog conformity: arithmetic evaluation and comparison
#
# ISO §8.6 — is/2 (== in clausal)
# ISO §8.7 — arithmetic comparison (<, <=, >, >=)
#
# Differences from ISO:
#   == posts an arithmetic constraint (Prolog: is), clausal 'is' = unification
#   -7 // 2 = -4 (Python floor), some Prologs = -3 (truncate)
#   -7 % 2 = 1 (Python floor mod), some Prologs = -1
-double_quotes(atom)

-module(iso_arithmetic, [test(DESC)])

-private([
    double(X, Y),
    square(X, Y),
    triangle_number(N, T)
])

# Arithmetic helper predicates.
double(X, Y) <- (Y == X * 2)
square(X, Y) <- (Y == X * X)
triangle_number(N, T) <- (T == N * (N + 1) // 2)

# ── == (arithmetic evaluation) ───────────────────────────────────────────────

test("addition: 1+2=3") <- (1 + 2 == 3)  # nv
test("subtraction: 5-3=2") <- (5 - 3 == 2)  # nv
test("multiplication: 3*4=12") <- (3 * 4 == 12)  # nv
test("integer division: 7//2=3") <- (7 // 2 == 3)  # nv
test("modulo: 7%2=1") <- (7 % 2 == 1)  # nv
test("power: 2**3=8") <- (2 ** 3 == 8)  # nv
test("negation: -3") <- (-3 == -3)  # nv
test("nested: (2+3)*4=20") <- ((2 + 3) * 4 == 20)  # nv
test("float addition: 1.5+2.5=4.0") <- (1.5 + 2.5 == 4.0)  # nv
test("double negation: --5=5") <- (-(-5) == 5)  # nv
test("subtraction negative: 3-5=-2") <- (3 - 5 == -2)  # nv
test("negative floor div: -7//2=-4") <- (-7 // 2 == -4)  # nv
test("negative mod: -7%2=1") <- (-7 % 2 == 1)  # nv

# ── Arithmetic comparison ────────────────────────────────────────────────────

test("1 < 2") <- (1 < 2)  # nv
test("not 2 < 1") <- (not (2 < 1))  # nv
test("not 1 < 1") <- (not (1 < 1))  # nv
test("1 <= 2") <- (1 <= 2)  # nv
test("1 <= 1") <- (1 <= 1)  # nv
test("2 > 1") <- (2 > 1)  # nv
test("not 1 > 2") <- (not (1 > 2))  # nv
test("2 >= 1") <- (2 >= 1)  # nv
test("1 >= 1") <- (1 >= 1)  # nv
test("1.5 < 2.5") <- (1.5 < 2.5)  # nv
test("expression: 1+2 < 2+3") <- (1 + 2 < 2 + 3)  # nv
test("expression: 1+2 <= 3") <- (1 + 2 <= 3)  # nv

# ── Arithmetic builtins ──────────────────────────────────────────────────────

test("succ forward: succ(3,4)") <- succ(3, 4)  # nv
test("succ backward: succ(X,4)=3") <- (
    succ(_x, 4),
    _x == 3
)  # nv
test("succ zero: succ(0,1)") <- succ(0, 1)  # nv
test("plus forward: 2+3=5") <- plus(2, 3, 5)  # nv
test("plus backward x: X+3=5") <- (
    plus(_x, 3, 5),
    _x == 2
)  # nv
test("plus backward y: 2+Y=5") <- (
    plus(2, _y, 5),
    _y == 3
)  # nv
test("between check: 3 in 1..5") <- between(1, 5, 3)  # nv
test("between out of range") <- (not between(1, 5, 6))  # nv
test("between generates 1..5") <- (
    findall(X, between(1, 5, X), L),
    '=='(L, [1, 2, 3, 4, 5])
)  # nv
test("abs_ of -5 is 5") <- (
    abs_(-5, X),
    X == 5
)  # nv
test("max_ 3 7 is 7") <- (
    max_(3, 7, X),
    X == 7
)  # nv
test("min_ 3 7 is 3") <- (
    min_(3, 7, X),
    X == 3
)  # nv

# ── == evaluation modes ──────────────────────────────────────────────────────

test("eval binds var: X == 42") <- (
    X == 42,
    X == 42
)  # nv
test("eval check: 3 == 1+2") <- (3 == 1 + 2)  # nv
test("eval check fails: 4 == 1+2") <- (not (4 == 1 + 2))  # nv
test("mixed int/float: 1 + 2.0 == 3.0") <- (1 + 2.0 == 3.0)  # nv
test("large integer: 10^100 + 1") <- (
    X == 10 ** 100,
    (X + 1) == (10 ** 100 + 1)
)  # nv
test("mixed int/float compare: not 1 < 1.0") <- (not (1 < 1.0))  # nv
test("mixed int/float compare: 1 <= 1.0") <- (1 <= 1.0)  # nv

# ── Private helper predicates ──────────────────────────────────────────────

test("double 3 is 6") <- (
    double(3, _y),
    _y == 6
)  # nv
test("double 0 is 0") <- (
    double(0, _y),
    _y == 0
)  # nv
test("square 4 is 16") <- (
    square(4, _y),
    _y == 16
)  # nv
test("square 1 is 1") <- (
    square(1, _y),
    _y == 1
)  # nv
test("triangle 5 is 15") <- (
    triangle_number(5, _t),
    _t == 15
)  # nv
test("triangle 1 is 1") <- (
    triangle_number(1, _t),
    _t == 1
)  # nv
test("triangle 10 is 55") <- (
    triangle_number(10, _t),
    _t == 55
)  # nv

# ── sign/2 (V2-12) ──────────────────────────────────────────────────────────

test("sign positive") <- (sign(42, S), S == 1)  # nv
test("sign negative") <- (sign(-7, S), S == -1)  # nv
test("sign zero") <- (sign(0, S), S == 0)  # nv
test("sign float negative") <- (sign(-3.14, S), S == -1)  # nv
test("sign unbound fails") <- (not sign(_x_UNUSED, _))  # nv
test("sign check mode: correct") <- sign(5, 1)  # nv
test("sign check mode: wrong fails") <- (not sign(5, -1))  # nv

# ── gcd/3 (V2-12) ───────────────────────────────────────────────────────────

test("gcd 12 8 = 4") <- (gcd(12, 8, G), G == 4)  # nv
test("gcd coprime 7 13 = 1") <- (gcd(7, 13, G), G == 1)  # nv
test("gcd with zero: gcd(0, 5) = 5") <- (gcd(0, 5, G), G == 5)  # nv
test("gcd negative: gcd(-12, 8) = 4") <- (gcd(-12, 8, G), G == 4)  # nv
test("gcd unbound fails") <- (not gcd(_x_UNUSED, 8, _))  # nv

# ── divmod_/4 (V2-12) ───────────────────────────────────────────────────────

test("divmod 17 5 = (3, 2)") <- (divmod_(17, 5, Q, R), Q == 3, R == 2)  # nv
test("divmod exact 10 5 = (2, 0)") <- (divmod_(10, 5, Q, R), Q == 2, R == 0)  # nv
test("divmod by zero fails") <- (not divmod_(10, 0, _, _))  # nv
test("divmod negative: -7 // 2 = -4, -7 % 2 = 1 (Python floor)") <- (
    divmod_(-7, 2, Q, R),
    Q == -4, R == 1
)  # nv
test("divmod unbound fails") <- (not divmod_(_x_UNUSED, 5, _, _))  # nv
test("divmod check mode: correct") <- divmod_(17, 5, 3, 2)  # nv
test("divmod check mode: wrong r fails") <- (not divmod_(17, 5, 3, 99))  # nv
