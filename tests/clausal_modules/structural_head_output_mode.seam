# Fixture for structural head literals in OUTPUT (var-query) mode.
#
# Follow-up to the equality-vs-unification audit: structural head args
# (Compound / functor-instance / nested compound / list) are hoisted at assert
# time into a fresh Var + prepended Unify, so a caller that passes an unbound
# Var in that position must BIND it to the full structural term — exactly as for
# the atomic head literals covered by numeric_head_literal.seam. These were
# the "known gap" in todo/audit-tests-input-output-mode-coverage.md.
-double_quotes(atom)

-private([point(X, Y), rgb(R, G, B), line(A, B)])

# Compound head literal.
pt(point(1, 2)) <- True

# functor-instance head literal.
col(rgb(255, 0, 0)) <- True

# Nested compound in a multi-arg head (second arg is a ground discriminant).
seg(line(point(0, 0), point(3, 4)), "diag") <- True

# List head literal.
lst([1, 2, 3]) <- True

# Two clauses so output-mode is genuinely relational (multiple solutions).
shape(point(0, 0)) <- True
shape(point(9, 9)) <- True
