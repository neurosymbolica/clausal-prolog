# Term inspection predicates (V2-13)
#
# copy_term/2, term_variables/2, numbervars/3

# CopyFresh/2 — copy a term, returning the fresh copy
CopyFresh(TERM, COPY) <- copy_term(TERM, COPY)

# HasNoVars/1 — succeed if term contains no unbound vars
HasNoVars(TERM) <- (
    term_variables(TERM, VARS),
    VARS is []
)

# CountVars/2 — count unbound vars in a term
CountVars(TERM, COUNT) <- (
    term_variables(TERM, VARS),
    length(VARS, COUNT)
)

# NumberAndCount/3 — number vars starting from START, return END
NumberAndCount(TERM, START, END) <- numbervars(TERM, START, END)

# CopyShared/3 — copy a compound f(X, X); the two fresh vars should be identical
CopyShared(TERM, FIRST, SECOND) <- (
    copy_term(TERM, COPY),
    arg(1, COPY, FIRST),
    arg(2, COPY, SECOND)
)

# VarList/2 — collect vars from a list
VarList(LIST, VARS) <- term_variables(LIST, VARS)


# ── Test clauses (migrated from test_term_inspection.py) ──────────────────

Test("copy_term: ground atom copies as-is") <- (
    copy_term("hello", C),
    C == "hello"
)  # nv

Test("copy_term: ground integer copies as-is") <- (
    copy_term(42, C),
    C == 42
)  # nv

Test("copy_term: ground list copies as-is") <- (
    copy_term([1, 2, 3], C),
    C == [1, 2, 3]
)  # nv

Test("term_variables: ground integer has no vars") <- HasNoVars(42)  # nv

Test("term_variables: ground atom has no vars") <- HasNoVars("hello")  # nv

Test("term_variables: ground list has no vars") <- HasNoVars([1, 2, 3])  # nv

Test("term_variables: single unbound var yields length 1") <- (
    CountVars(X_UNUSED, N),
    N == 1
)  # nv

Test("term_variables: bound var not collected") <- (
    X is 42,
    CountVars(X, N),
    N == 0
)  # nv

Test("term_variables: ground list with no vars") <- (
    CountVars([1, 2, 3], N),
    N == 0
)  # nv
