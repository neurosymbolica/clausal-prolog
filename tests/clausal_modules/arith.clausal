# Arithmetic predicates
#
# Factorial/2, MaxOf/3, AbsDiff/3

Factorial(N=0, RESULT=1),
Factorial(N, RESULT) <- (
    N > 0,
    N1 := N - 1,
    Factorial(N1, R1),
    RESULT := N * R1
)

MaxOf(X, Y, MAX) <- (
    X >= Y,
    MAX is X
)
MaxOf(X, Y, MAX) <- (
    Y > X,
    MAX is Y
)

AbsDiff(X, Y, DIFF) <- (
    X >= Y,
    DIFF := X - Y
)
AbsDiff(X, Y, DIFF) <- (
    Y > X,
    DIFF := Y - X
)
