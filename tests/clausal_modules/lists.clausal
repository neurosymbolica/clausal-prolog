# List predicates
#
# Length/2

Length(LIST=[], N=0),
Length([HEAD, *TAIL], N) <- (
    Length(TAIL, N1),
    N := N1 + 1
)

# Append/3 — standard list concatenation: Append(Xs, Ys, Zs)
# repeated Var HEAD in clause 2 (positions 1 and 3)

Append(LHS=[], RHS=RHS, TOGETHER=RHS),
Append([HEAD, *TAIL], RHS, [HEAD, *REST]) <- (
    Append(TAIL, RHS, REST)
)

# Last/2

Last([LAST], LAST),
Last([_, *TAIL], LAST) <- (
    Last(TAIL, LAST)
)
