# List predicates
#
# length/2

length(LIST=[], N=0),
length([HEAD, *TAIL], N) <- (
    length(TAIL, N1),
    N == N1 + 1
)

# append/3 — repeated Var HEAD in head positions 1 and 3

append([], ELEM, [ELEM]),
append([HEAD, *TAIL], ELEM, [HEAD, *TAIL_WITH_ELEM]) <- (
    append(TAIL, ELEM, TAIL_WITH_ELEM)
)

# last/2

last([LAST], LAST),
last([_, *TAIL], LAST) <- (
    last(TAIL, LAST)
)
