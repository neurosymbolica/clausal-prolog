# List predicates
#
# length/2

length(L_=[], N_=0),
length([H_, *T_], N_) <- (
    length(T_, N1_),
    N_ is N1_ + 1
)

# append/3 — repeated Var H_ in head positions 1 and 3

append([], B_, B_),
append([H_, *T_], B_, [H_, *R_]) <- (
    append(T_, B_, R_)
)

# last/2

last([X_], X_),
last([H_, *T_], X_) <- (
    last(T_, X_)
)
