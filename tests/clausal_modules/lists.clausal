# List predicates
#
# length/2

length(LIST=[], N=0),
length([HEAD, *TAIL], N) <- (
    length(TAIL, N1),
    N is N1 + 1
)

# append/3 — repeated Var HEAD in head positions 1 and 3

append([], B, B),
append([HEAD, *TAIL], B, [HEAD, *RESULT]) <- (
    append(TAIL, B, RESULT)
)

# last/2

last([X], X),
last([HEAD, *TAIL], X) <- (
    last(TAIL, X)
)
