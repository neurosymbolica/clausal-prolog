# List predicates
#
# length/2

length(LIST=[], N=0),
length([HEAD, *TAIL], N) <- (
    length(TAIL, N1),
    N := N1 + 1
)

# append/3 — standard list concatenation: append(Xs, Ys, Zs)
# repeated Var HEAD in clause 2 (positions 1 and 3)

append(LHS=[], RHS=TOGETHER, TOGETHER=TOGETHER),
append([HEAD, *TAIL], RHS, [HEAD, *REST]) <- (
    append(TAIL, RHS, REST)
)

# last/2

last([LAST], LAST),
last([_, *TAIL], LAST) <- (
    last(TAIL, LAST)
)
