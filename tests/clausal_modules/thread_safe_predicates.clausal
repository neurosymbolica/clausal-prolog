# Thread-safe predicate patterns
#
# These predicates are pure (no side effects, no assert/retract) and
# therefore safe for concurrent queries from multiple threads.
# The tests verify correctness; concurrency stress tests are in
# tests/test_free_threading.py.

# ── Pure list predicates ─────────────────────────────────────────────────────

MyAppend([], YS, YS),
MyAppend([H, *XS], YS, [H, *ZS]) <- MyAppend(XS, YS, ZS)

MyLength([], 0),
MyLength([_, *T], N) <- (MyLength(T, N1) and N == N1 + 1)

MyMember(X, [X, *_]),
MyMember(X, [_, *T]) <- MyMember(X, T)

# ── Pure arithmetic ──────────────────────────────────────────────────────────

MyFact(0, 1),
MyFact(N, F) <- (
    N > 0,
    N1 == N - 1,
    MyFact(N1, F1),
    F == N * F1
)

# ── Graph traversal (acyclic — no tabling needed) ────────────────────────────

GEdge("a", "b"),
GEdge("b", "c"),
GEdge("c", "d"),
GEdge("b", "d")

GPath(X, Y) <- GEdge(X, Y)
GPath(X, Y) <- (GEdge(X, Z) and GPath(Z, Y))

# ── Tests ────────────────────────────────────────────────────────────────────

# List operations
test("append nil-nil") <- (MyAppend([], [], R) and R is [])  # nv
test("append nil-list") <- (MyAppend([], [1, 2], R) and R is [1, 2])  # nv
test("append list-list") <- (MyAppend([1, 2], [3, 4], R) and R is [1, 2, 3, 4])  # nv
test("length empty") <- (MyLength([], N) and N == 0)  # nv
test("length three") <- (MyLength([1, 2, 3], N) and N == 3)  # nv
test("member first") <- MyMember(1, [1, 2, 3])  # nv
test("member last") <- MyMember(3, [1, 2, 3])  # nv
test("member all") <- (
    findall(X, MyMember(X, [10, 20, 30]), BAG) and BAG is [10, 20, 30]
)  # nv

# Arithmetic
test("factorial 0") <- (MyFact(0, F) and F == 1)  # nv
test("factorial 5") <- (MyFact(5, F) and F == 120)  # nv
test("factorial 10") <- (MyFact(10, F) and F == 3628800)  # nv

# Graph
test("direct edge") <- GPath("a", "b")  # nv
test("transitive path") <- GPath("a", "d")  # nv
test("reachable b from a") <- GPath("a", "b")  # nv
test("reachable c from a") <- GPath("a", "c")  # nv
