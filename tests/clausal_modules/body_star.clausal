# Body-position star deconstruction predicates — Phase 5 test fixtures

# HeadTail/3 — deconstruct a list into head and tail in the body
HeadTail(LIST, HEAD, TAIL) <- (
    [HEAD, *TAIL] is LIST
)

# InitLast/3 — split off the last element using trailing star
InitLast(LIST, INIT, LAST) <- (
    [*INIT, LAST] is LIST
)

# Sandwich/4 — extract first, middle, and last
Sandwich(LIST, HEAD, MID, TAIL) <- (
    [HEAD, *MID, TAIL] is LIST
)

# CaptureBody/2 — star-only body deconstruction (identity)
CaptureBody(LIST, ALL) <- (
    [*ALL] is LIST
)

# SumTail/2 — deconstruct then use result in subsequent goal
SumTail(LIST, TAIL_LENGTH) <- (
    [_, *TAIL] is LIST,
    length(TAIL, TAIL_LENGTH)
)

# Second/2 — two consecutive body deconstructions
Second(LIST, X) <- (
    [_, *T] is LIST,
    [X, *_] is T
)

# WrapUnwrap/2 — construct then deconstruct
WrapUnwrap(X, Y) <- (
    LIST is [X, 99],
    [Y, _] is LIST
)

# BodySplit/3 — multi-star body deconstruction
BodySplit(LIST, A, B) <- (
    [*A, *B] is LIST
)
