# Higher-order list predicates with lambdas
#
# maplist/2, maplist/3, include/3, exclude/3, foldl/4

# doubles/2 — double each element via maplist/3 + lambda
-double_quotes(atom)
doubles(XS, YS) <- maplist(((X, Y) <- (Y == X * 2)), XS, YS)

# all_positive/1 — check all positive via maplist/2 + lambda
all_positive(XS) <- maplist((X <- (X > 0)), XS)

# keep_positive/2 — filter positive via include/3
keep_positive(XS, PS) <- include((X <- (X > 0)), XS, PS)

# remove_negative/2 — filter out negative via exclude/3
remove_negative(XS, RS) <- exclude((X <- (X < 0)), XS, RS)

# sum_list_fold/2 — sum via foldl/4
sum_list_fold(XS, S) <- foldl(((E, A, R) <- (R == A + E)), XS, 0, S)

# product_list/2 — product via foldl/4
product_list(XS, P) <- foldl(((E, A, R) <- (R == A * E)), XS, 1, P)

# squares/2 — square each element via maplist/3
squares(XS, YS) <- maplist(((X, Y) <- (Y == X * X)), XS, YS)

# keep_even/2 — filter even numbers via include
keep_even(XS, ES) <- include((X <- (X % 2 == 0)), XS, ES)

# remove_even/2 — filter out even numbers via exclude
remove_even(XS, OS) <- exclude((X <- (X % 2 == 0)), XS, OS)

# negate_list/2 — negate each element
negate_list(XS, YS) <- maplist(((X, Y) <- (Y == 0 - X)), XS, YS)

# count_fold/2 — count elements via foldl (ignore element, just increment)
count_fold(XS, N) <- foldl(((ELEM_UNUSED, A, R) <- (R == A + 1)), XS, 0, N)

# max_fold/3 — find max starting from an initial value
max_fold(XS, INIT, M) <- foldl(((E, A, R) <- (
    (E >= A and R is E) or (A > E and R is A)
)), XS, INIT, M)


# ── Test clauses (migrated from test_clausal_modules.py::TestHigherOrder*) ─

test("doubles 1..3") <- (doubles([1, 2, 3], R), R == [2, 4, 6])  # nv
test("doubles empty") <- (doubles([], R), R == [])  # nv
test("doubles negative") <- (doubles([-1, 0, 5], R), R == [-2, 0, 10])  # nv

test("HO all_positive succeeds") <- all_positive([1, 2, 3])  # nv
test("HO all_positive fails") <- (not all_positive([1, -2, 3]))  # nv
test("HO all_positive empty (vacuously true)") <- all_positive([])  # nv

test("keep_positive mixed") <- (keep_positive([1, -2, 3, -4], R), R == [1, 3])  # nv
test("keep_positive none") <- (keep_positive([-1, -2], R), R == [])  # nv
test("keep_positive all") <- (keep_positive([5, 10], R), R == [5, 10])  # nv

test("remove_negative mixed") <- (remove_negative([1, -2, 3, -4], R), R == [1, 3])  # nv
test("remove_negative none") <- (remove_negative([1, 2, 3], R), R == [1, 2, 3])  # nv

test("sum_list_fold 1..3 = 6") <- (sum_list_fold([1, 2, 3], R), R == 6)  # nv
test("sum_list_fold empty = 0") <- (sum_list_fold([], R), R == 0)  # nv
test("sum_list_fold single = 42") <- (sum_list_fold([42], R), R == 42)  # nv

test("product_list 2 3 4 = 24") <- (product_list([2, 3, 4], R), R == 24)  # nv
test("product_list empty = 1") <- (product_list([], R), R == 1)  # nv
test("product_list with zero = 0") <- (product_list([5, 0, 3], R), R == 0)  # nv

test("HO squares") <- (squares([1, 2, 3, 4], R), R == [1, 4, 9, 16])  # nv

test("keep_even") <- (keep_even([1, 2, 3, 4, 5, 6], R), R == [2, 4, 6])  # nv
test("keep_even none") <- (keep_even([1, 3, 5], R), R == [])  # nv

test("remove_even") <- (remove_even([1, 2, 3, 4, 5], R), R == [1, 3, 5])  # nv

test("negate_list") <- (negate_list([1, -2, 3], R), R == [-1, 2, -3])  # nv
test("negate_list empty") <- (negate_list([], R), R == [])  # nv

test("count_fold 4") <- (count_fold([10, 20, 30, 40], R), R == 4)  # nv
test("count_fold empty = 0") <- (count_fold([], R), R == 0)  # nv

test("max_fold 9") <- (max_fold([3, 7, 2, 9, 1], 0, R), R == 9)  # nv
test("max_fold single") <- (max_fold([5], 0, R), R == 5)  # nv
test("max_fold init wins") <- (max_fold([1, 2], 100, R), R == 100)  # nv
