# Exception handling tests (V2-14)
#
# throw/1, catch/3, halt/0, halt/1

# ── Basic throw and catch ────────────────────────────────────────────────────

# catch_all/2 — variable catcher matches any thrown term
catch_all(TERM, CAUGHT) <- (
    catch(
        throw(TERM),
        CAUGHT,
        True
    )
)

# safe_result/2 — catch a specific error, return fallback
safe_result(GOAL_VALUE, RESULT) <- (
    catch(
        (RESULT is GOAL_VALUE),
        _,
        RESULT is "error",
    )
)

# throw_if_zero/1 — throws "division_by_zero" if input is 0
throw_if_zero(0) <- throw("division_by_zero")
throw_if_zero(N) <- (N is not 0)

# safe_recip/2 — safe reciprocal with catch
safe_recip(N, RESULT) <- (
    catch(
        (throw_if_zero(N) and eval_(1 / N, RESULT)),
        "division_by_zero",
        RESULT is 0,
    )
)

# ── Nested catch ─────────────────────────────────────────────────────────────

# inner_miss/1 — inner catch only handles "inner"; outer catches the rest
inner_miss(RESULT) <- (
    catch(
        catch(
            throw("outer_problem"),
            "inner_only",
            RESULT is "inner_caught",
        ),
        ERROR,
        RESULT is ERROR,
    )
)

# inner_hit/1 — inner catch handles the exact error
inner_hit(RESULT) <- (
    catch(
        catch(
            throw("inner_problem"),
            "inner_problem",
            RESULT is "inner_caught",
        ),
        _,
        RESULT is "outer_caught",
    )
)

# ── Dead child generator recovery (critical regression test) ─────────────────
#
# Scenario: parent tries INPUT=0 first (which causes risky to throw),
# then backtracks and tries INPUT=1 (which should succeed normally).
# This verifies that after catch handles the exception from the first
# attempt, the second attempt creates fresh generators — no dead child
# reuse.

# risky/2 — fails on 0, succeeds on nonzero
risky(0, _) <- throw("zero_error")
risky(INPUT, OUTPUT) <- ((INPUT is not 0) and (OUTPUT == INPUT * 10))

# try_risky/2 — wraps risky in catch; on error, RESULT stays unbound (fails)
try_risky(INPUT, RESULT) <- (
    catch(
        risky(INPUT, RESULT),
        "zero_error",
        False,
    )
)

# parent/1 — tries 0 first (catch swallows error, recovery fails),
#             then backtracks to 1 (succeeds)
parent(RESULT) <- (
    in_(INPUT, [0, 1]) and try_risky(INPUT, RESULT)
)

# ── Catch with successful goal (no exception) ───────────────────────────────

# catch_no_throw/1 — goal succeeds without throwing; catch is transparent
catch_no_throw(RESULT) <- (
    catch(
        RESULT is "normal",
        _,
        RESULT is "recovery",
    )
)

# catch_multiple/1 — goal with multiple solutions inside catch
catch_multiple(RESULT) <- (
    catch(
        in_(RESULT, [10, 20, 30]),
        _,
        False,
    )
)

# ── Tests ────────────────────────────────────────────────────────────────────

test("catch variable catcher") <- (catch_all(42, CAUGHT) and CAUGHT is 42)  # nv
test("catch string term") <- (catch_all("oops", CAUGHT) and CAUGHT is "oops")  # nv
test("safe reciprocal of 2") <- (safe_recip(2, R) and R == 0.5)  # nv
test("safe reciprocal of 0") <- (safe_recip(0, R) and R is 0)  # nv
test("throw if zero throws") <- (
    catch(throw_if_zero(0), "division_by_zero", True)
)  # nv
test("throw if zero passes") <- throw_if_zero(1)  # nv
test("inner catch misses - outer catches") <- (
    inner_miss(R) and R is "outer_problem"
)  # nv
test("inner catch hits") <- (inner_hit(R) and R is "inner_caught")  # nv

# The critical dead-child-generator test
test("parent backtracks after catch failure") <- (
    parent(RESULT) and RESULT is 10
)  # nv

test("catch is transparent when no throw") <- (
    catch_no_throw(R) and R is "normal"
)  # nv
test("catch with multiple solutions") <- (
    findall(X, catch_multiple(X), BAG) and BAG is [10, 20, 30]
)  # nv
test("safe result passes through") <- (
    safe_result(42, R) and R is 42
)  # nv
