# Meta-predicate tests
#
# findall/3, bagof/3, setof/3, forall/2 as compiler special forms

# Squares/2 — square each element via findall
Squares(NS, SQUARES) <- (
    findall(
        SQ,
        (in_(X, NS) and (SQ := X * X)),
        SQUARES,
    )
)

# Positives/2 — filter positive elements via findall
Positives(NS, POS) <- (
    findall(
        X,
        (in_(X, NS) and X > 0),
        POS,
    )
)

# UniqueMembers/2 — deduplicate via setof
UniqueMembers(NS, UNIQUE) <- (
    setof(
        X,
        in_(X, NS),
        UNIQUE,
    )
)

# AllPositive/1 — universal quantification via forall
AllPositive(NS) <- (
    forall(in_(X, NS), X > 0)
)

# SumSquares/2 — nested: findall squares then sum
SumSquares(NS, TOTAL) <- (
    Squares(NS, SQS),
    sum_list(SQS, TOTAL)
)

# Evens/2 — filter even elements via findall with modulo
Evens(NS, ES) <- (
    findall(
        X,
        (in_(X, NS) and X % 2 == 0),
        ES,
    )
)

# CountSolutions/2 — count number of list elements via findall + length
CountSolutions(NS, COUNT) <- (
    findall(X, in_(X, NS), BAG),
    length(BAG, COUNT)
)

# Pairs/3 — cartesian product via findall
Pairs(XS1, XS2, RESULT) <- (
    findall(
        [A, B],
        (in_(A, XS1) and in_(B, XS2)),
        RESULT,
    )
)

# AllMembers/2 — forall: every element of first list is in second list
AllMembers(SUB1, SUPER1) <- (
    forall(in_(X, SUB1), in_(X, SUPER1))
)

# BagPositives/2 — bagof (fails on empty)
BagPositives(NS, POS) <- (
    bagof(
        X,
        (in_(X, NS) and X > 0),
        POS,
    )
)
