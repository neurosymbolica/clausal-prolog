# Meta-predicate tests
#
# findall/3, bagof/3, setof/3, forall/2 as compiler special forms

# Squares/2 — square each element via findall
Squares(NS, SQUARES) <- (
    findall(
        SQ,
        (in_(X, NS) and (SQ := X * X)),
        SQUARES,
    )
)

# Positives/2 — filter positive elements via findall
Positives(NS, POS) <- (
    findall(
        X,
        (in_(X, NS) and X > 0),
        POS,
    )
)

# UniqueMembers/2 — deduplicate via setof
UniqueMembers(NS, UNIQUE) <- (
    setof(
        X,
        in_(X, NS),
        UNIQUE,
    )
)

# AllPositive/1 — universal quantification via forall
AllPositive(NS) <- (
    forall(in_(X, NS), X > 0)
)

# SumSquares/2 — nested: findall squares then sum
SumSquares(NS, TOTAL) <- (
    Squares(NS, SQS),
    sum_list(SQS, TOTAL)
)

# Evens/2 — filter even elements via findall with modulo
Evens(NS, ES) <- (
    findall(
        X,
        (in_(X, NS) and X % 2 == 0),
        ES,
    )
)

# CountSolutions/2 — count number of list elements via findall + length
CountSolutions(NS, COUNT) <- (
    findall(X, in_(X, NS), BAG),
    length(BAG, COUNT)
)

# Pairs/3 — cartesian product via findall
Pairs(XS1, XS2, RESULT) <- (
    findall(
        [A, B],
        (in_(A, XS1) and in_(B, XS2)),
        RESULT,
    )
)

# AllMembers/2 — forall: every element of first list is in second list
AllMembers(SUB1, SUPER1) <- (
    forall(in_(X, SUB1), in_(X, SUPER1))
)

# BagPositives/2 — bagof (fails on empty)
BagPositives(NS, POS) <- (
    bagof(
        X,
        (in_(X, NS) and X > 0),
        POS,
    )
)


# ── Test clauses (migrated from test_clausal_modules.py::TestMeta*) ──────

Test("squares basic") <- (Squares([1, 2, 3], R), R == [1, 4, 9])  # nv
Test("squares empty") <- (Squares([], R), R == [])  # nv
Test("squares single") <- (Squares([5], R), R == [25])  # nv
Test("squares negative") <- (Squares([-2, 3], R), R == [4, 9])  # nv

Test("positives mixed") <- (Positives([-1, 2, -3, 4], R), R == [2, 4])  # nv
Test("positives all negative") <- (Positives([-1, -2, -3], R), R == [])  # nv
Test("positives all positive") <- (Positives([1, 2, 3], R), R == [1, 2, 3])  # nv
Test("positives with zero") <- (Positives([0, 1, -1], R), R == [1])  # nv

Test("unique dedup") <- (UniqueMembers([1, 2, 1, 3, 2], R), R == [1, 2, 3])  # nv
Test("unique already unique") <- (UniqueMembers([5, 10, 15], R), R == [5, 10, 15])  # nv
Test("unique single") <- (UniqueMembers([7, 7, 7], R), R == [7])  # nv

Test("all_positive succeeds") <- AllPositive([1, 2, 3])  # nv
Test("all_positive fails") <- (not AllPositive([1, -2, 3]))  # nv
Test("all_positive empty (vacuously true)") <- AllPositive([])  # nv

Test("sum_squares 1..3 = 14") <- (SumSquares([1, 2, 3], R), R == 14)  # nv
Test("sum_squares empty = 0") <- (SumSquares([], R), R == 0)  # nv

Test("evens 1..6") <- (Evens([1, 2, 3, 4, 5, 6], R), R == [2, 4, 6])  # nv
Test("evens none") <- (Evens([1, 3, 5], R), R == [])  # nv

Test("count_solutions 3") <- (CountSolutions([10, 20, 30], R), R == 3)  # nv
Test("count_solutions empty = 0") <- (CountSolutions([], R), R == 0)  # nv

Test("pairs cartesian") <- (
    Pairs(["a", "b"], [1, 2], R),
    R == [["a", 1], ["a", 2], ["b", 1], ["b", 2]]
)  # nv
Test("pairs empty first") <- (Pairs([], [1, 2], R), R == [])  # nv
Test("pairs empty second") <- (Pairs(["a"], [], R), R == [])  # nv

Test("all_members subset") <- AllMembers([1, 2], [1, 2, 3])  # nv
Test("all_members not subset") <- (not AllMembers([1, 4], [1, 2, 3]))  # nv
Test("all_members empty sub") <- AllMembers([], [1, 2, 3])  # nv

Test("bag_positives present") <- (BagPositives([-1, 2, -3, 4], R), R == [2, 4])  # nv
Test("bag_positives fails on none") <- (not BagPositives([-1, -2, -3], _))  # nv
