# Family relationships
#
# parent/2 facts + ancestor/2 rules + sibling/2 rule

parent(Parent_="tom", Child_="bob"),
parent("tom", "liz"),
parent("bob", "ann"),
parent("bob", "pat"),

ancestor(X_, Y_) <- parent(X_, Y_)
ancestor(X_, Y_) <- (
    parent(X_, Z_),
    ancestor(Z_, Y_)
)

sibling(X_, Y_) <- (
    parent(Z_, X_),
    parent(Z_, Y_),
    X_ != Y_
)
