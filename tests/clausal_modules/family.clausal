# Family relationships
#
# parent/2 facts + ancestor/2 rules + sibling/2 rule

parent("tom", "bob"),
parent("tom", "liz"),
parent("bob", "ann"),
parent("bob", "pat"),

ancestor(X, Y) <- parent(X, Y)
ancestor(X, Y) <- (
    parent(X, Z),
    ancestor(Z, Y)
)

sibling(PERSON, SIBLING) <- (
    PERSON is not SIBLING,
    parent(PARENT, PERSON),
    parent(PARENT, SIBLING),
)
