# Family relationships
#
# parent/2 facts + ancestor/2 rules + sibling/2 rule

parent(PARENT="tom", CHILD="bob"),
parent("tom", "liz"),
parent("bob", "ann"),
parent("bob", "pat"),

ancestor(X, Y) <- parent(X, Y)
ancestor(X, Y) <- (
    parent(X, Z),
    ancestor(Z, Y)
)

sibling(X, Y) <- (
    parent(Z, X),
    parent(Z, Y),
    X is not Y
)
