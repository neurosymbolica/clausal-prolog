# Arithmetic predicates
#
# factorial/2, max_of/3, abs_diff/3

factorial(0, 1),
factorial(N, RESULT) <- (
    N > 0,
    N1 == N - 1,
    factorial(N1, R1),
    RESULT == N * R1
)

max_of(X, Y, MAX) <- (
    X >= Y,
    MAX is X
)
max_of(X, Y, MAX) <- (
    Y > X,
    MAX is Y
)

abs_diff(X, Y, DIFF) <- (
    X >= Y,
    DIFF == X - Y
)
abs_diff(X, Y, DIFF) <- (
    Y > X,
    DIFF == Y - X
)
