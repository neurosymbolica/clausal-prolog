# Reified predicates library (V2-8 Phase B; Scryer's library(reif), 2026-09-30)
#
# memberd_t/3: reified deterministic membership
# From Neumerkel & Kral (arXiv:1607.01590, §7):
#   memberd_t(X, Es, T) — T is True if X is a member of Es, False otherwise.
#   Ground queries are deterministic (no leftover choicepoints).
#   Uses eq/3 (reified equality) and if_/3 (reified branching).
#
# The rest of Scryer's reif.pl export list, with Scryer's meaning:
# tfilter/3, tpartition/4, tmember/2, tmember_t/3 and cond_t/3.  Scryer
# writes each as ``if_(call(C, X), Then, Else)``: if_/3 calls its condition
# with one more argument, the truth value, and branches on it -- an unbound
# truth value is instantiation_error, anything but true/false
# type_error(boolean, T).  The seam's if_ has the same meaning since the
# 2026-10-01 ruling (a closure condition is called with T appended); the
# bodies below predate it and spell the reified call and the check out,
# then branch on the (now ground) truth value -- the same thing.  (=)/3 and
# dif/3 are engine builtins; a WRITTEN if_/3 goal, and (',')/3 and (;)/3
# in its condition, are lowered by the native front end
# (clausal/tools/iso_l3.py); if_/3 at the end of this file is the same
# meaning as a predicate, for a meta-called if_.
#
# tfilter/3 and tpartition/4 are ALSO engine builtins, committed to each
# call's first truth value.  A .pl file that imports library(reif) takes
# these (Scryer's, every answer) instead.

-private([boolean, conj, disj, qual, leaf])

# The closures belong to the CALLER (Scryer's meta_predicate declarations):
# a closure is resolved in the module that passed it, not here.
-meta_predicate(tfilter(2, '?', '?'))
-meta_predicate(tpartition(2, '?', '?', '?'))
-meta_predicate(tmember(2, '?'))
-meta_predicate(tmember_t(2, '?', '?'))
-meta_predicate(cond_t(1, 0, '?'))
-meta_predicate(if_(1, 0, 0))

memberd_t(_x, _es, _t) <- l_memberd_t(_es, _x, _t)

l_memberd_t([], _, False),
l_memberd_t([_e, *_es], _x, _t) <- (
    if_(_x is _e, _t is True, l_memberd_t(_es, _x, _t))
)

# tfilter(C_2, [E|Es], Fs0) :-
#     if_(call(C_2, E), Fs0 = [E|Fs], Fs0 = Fs), tfilter(C_2, Es, Fs).
tfilter(_, [], []),
tfilter(C, [E, *ES], FS0) <- (
    call(C, E, T), must_be(boolean, T),
    if_(T is True, FS0 is [E, *FS], FS0 is FS),
    tfilter(C, ES, FS)
)

# tpartition(P_2, Xs, Ts, Fs) :- i_tpartition(Xs, P_2, Ts, Fs).
tpartition(P, XS, TS, FS) <- i_tpartition(XS, P, TS, FS)

i_tpartition([], _, [], []),
i_tpartition([X, *XS], P, TS0, FS0) <- (
    call(P, X, T), must_be(boolean, T),
    if_(T is True, (TS0 is [X, *TS], FS0 is FS),
                   (FS0 is [X, *FS], TS0 is TS)),
    i_tpartition(XS, P, TS, FS)
)

# tmember(P_2, [X|Xs]) :- if_(call(P_2, X), true, tmember(P_2, Xs)).
tmember(P, [X, *XS]) <- (
    call(P, X, T), must_be(boolean, T),
    if_(T is True, True, tmember(P, XS))
)

# tmember_t(P_2, [X|Xs], T) :- if_(call(P_2, X), T = true, tmember_t(P_2, Xs, T)).
tmember_t(_, [], False),
tmember_t(P, [X, *XS], T) <- (
    call(P, X, T0), must_be(boolean, T0),
    if_(T0 is True, T is True, tmember_t(P, XS, T))
)

# cond_t(If_1, Then_0, T) :- if_(If_1, (Then_0, T = true), T = false).
cond_t(C, G, T) <- (
    call(C, T0), must_be(boolean, T0),
    if_(T0 is True, (call(G), T is True), T is False)
)

# if_/3 as a PREDICATE, for the goals the compiler never sees: call(if_(...)),
# G = if_(...), G, call(if_, C, T, E), a lambda whose body is an if_.  A
# written if_ goal is still compiled in place (clausal/tools/iso_l3.py,
# ``_if``); this is the same meaning, Scryer's reif.pl:
#
#   if_(If_1, Then_0, Else_0) :-
#       call(If_1, T),
#       ( T == true -> call(Then_0) ; T == false -> call(Else_0)
#       ; nonvar(T) -> throw(error(type_error(boolean, T), _))
#       ; throw(error(instantiation_error, _)) ).
#   ','(A_1, B_1, T) :- if_(A_1, call(B_1, T), T = false).
#   ;(A_1, B_1, T) :- if_(A_1, T = true, call(B_1, T)).
#
# The engine cannot export (',')/3 and (;)/3 (a name that is no identifier
# is not importable), so reif_truth/2 unfolds a conjunction and a
# disjunction itself, as those two clauses do; a module-qualified condition
# (the meta_predicate declaration qualifies it with the caller's module)
# carries the module down to each conjunct.  Undetermined truth values give
# every answer in the condition's own order, as in Scryer.

'if_'(IF, THEN, ELSE) <- (
    reif_truth(IF, T), must_be(boolean, T),
    if_(T is True, call(THEN), call(ELSE))
)

reif_truth(C, T) <- (reif_shape(C, S), reif_truth(S, C, T))

reif_truth(conj, C, T) <- (arg(1, C, A), arg(2, C, B), reif_and(A, B, T))
reif_truth(disj, C, T) <- (arg(1, C, A), arg(2, C, B), reif_or(A, B, T))
reif_truth(qual, C, T) <- (arg(1, C, M), arg(2, C, G), reif_qualified(M, G, T))
reif_truth(leaf, C, T) <- call(C, T)

reif_qualified(M, G, T) <- (reif_shape(G, S), reif_qualified(S, M, G, T))

reif_qualified(conj, M, G, T) <- (
    arg(1, G, A), arg(2, G, B), reif_and(':'(M, A), ':'(M, B), T)
)
reif_qualified(disj, M, G, T) <- (
    arg(1, G, A), arg(2, G, B), reif_or(':'(M, A), ':'(M, B), T)
)
reif_qualified(qual, _, G, T) <- reif_truth(G, T)
reif_qualified(leaf, M, G, T) <- call(':'(M, G), T)

reif_and(A, B, T) <- (
    reif_truth(A, T0), must_be(boolean, T0),
    if_(T0 is True, reif_truth(B, T), T is False)
)

reif_or(A, B, T) <- (
    reif_truth(A, T0), must_be(boolean, T0),
    if_(T0 is True, T is True, reif_truth(B, T))
)

# The shape of a condition, decided without binding it: an unbound one is a
# leaf (call/2 then raises instantiation_error, as Scryer's if_ does).
reif_shape(C, leaf) <- var(C)
reif_shape(C, S) <- (nonvar(C), functor(C, N, A), reif_functor_shape(N, A, S))

reif_functor_shape(N, A, S) <- (
    if_(A is 2,
        if_(N is ',', S is conj,
            if_(N is ';', S is disj,
                if_(N is ':', S is qual, S is leaf))),
        S is leaf)
)
