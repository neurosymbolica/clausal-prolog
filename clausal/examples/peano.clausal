-module(peano, [
    Nat(N),
    PeanoAdd(X, Y, Z),
    PeanoMul(X, Y, Z),
    Leq(X, Y),
    PeanoToInt(N, I),
    IntToPeano(I, N)
])

# Natural numbers as nested lists: 0 = [], succ(N) = [N].

Nat(N=[]),
Nat([N]) <- Nat(N)

PeanoAdd(X=[], Y=[], Z=[]),
PeanoAdd([], Y, Y),
PeanoAdd([X], Y, [Z]) <- PeanoAdd(X, Y, Z)

PeanoMul(X=[], Y=[], Z=[]),
PeanoMul([], _, []),
PeanoMul([X], Y, Z) <- (
    PeanoMul(X, Y, Z1),
    PeanoAdd(Y, Z1, Z)
)

Leq(X=[], Y=[]),
Leq([], _),
Leq([X], [Y]) <- Leq(X, Y)

PeanoToInt(N=[], I=0),
PeanoToInt([N], I) <- (
    PeanoToInt(N, I1),
    I == I1 + 1
)

IntToPeano(I=0, N=[]),
IntToPeano(I, [N]) <- (
    I > 0,
    I1 == I - 1,
    IntToPeano(I1, N)
)

# ── Tests ────────────────────────────────────────────────────────────────────────

Test("zero is nat") <- Nat([])
Test("one is nat") <- Nat([[]])
Test("two is nat") <- Nat([[[]]])
Test("peano [] = 0") <- PeanoToInt([], 0)
Test("peano [[]] = 1") <- PeanoToInt([[]], 1)
Test("peano [[[]]] = 2") <- PeanoToInt([[[]]], 2)
Test("peano [[[[]]]] = 3") <- PeanoToInt([[[[]]]], 3)
Test("int 0 = []") <- IntToPeano(0, [])
Test("int 1 = [[]]") <- IntToPeano(1, [[]])
Test("int 2 = [[[]]]") <- IntToPeano(2, [[[]]])
Test("0 + 0 = 0") <- PeanoAdd([], [], [])
Test("0 + 1 = 1") <- PeanoAdd([], [[]], [[]])
Test("1 + 1 = 2") <- PeanoAdd([[]], [[]], [[[]]])
Test("1 + 2 = 3") <- (
    IntToPeano(1, ONE),
    IntToPeano(2, TWO),
    IntToPeano(3, THREE),
    PeanoAdd(ONE, TWO, THREE)
)
Test("0 * 1 = 0") <- PeanoMul([], [[]], [])
Test("1 * 1 = 1") <- PeanoMul([[]], [[]], [[]])
Test("2 * 2 = 4") <- (
    IntToPeano(2, TWO),
    IntToPeano(4, FOUR),
    PeanoMul(TWO, TWO, FOUR)
)
Test("0 <= 0") <- Leq([], [])
Test("0 <= 1") <- Leq([], [[]])
Test("1 <= 2") <- Leq([[]], [[[]]])
Test("not 2 <= 1") <- (not Leq([[[]]], [[]]))
