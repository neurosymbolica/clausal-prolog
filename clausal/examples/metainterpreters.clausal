# Meta-interpreters for clausal.
#
# Ported from Markus Triska's "A Couple of Meta-interpreters in Prolog"
# (https://www.metalevel.at/acomip/).
#
# Object-level terms are represented as lists:
#   atom        → a Python value (string, int, etc.)
#   f(A, B)     → ["f", A, B]
#   s(X)        → ["s", X]
#
# A clause is [Head, BodyGoals] where BodyGoals is a list of goals.
# A program is a list of clauses.

-module(metainterpreters, [
    Solve(GOALS, PROGRAM),
    SolveCount(GOALS, PROGRAM, COUNT),
    SolveLimit(GOALS, PROGRAM, MAX_DEPTH),
    SolveIterativeDeepening(GOALS, PROGRAM),
    SolveTree(GOALS, PROGRAM, TREE),
    MatchClause(GOAL, BODY, PROGRAM)
])

# ── Object Programs ──────────────────────────────────────────────────────────

# natnum(0).
# natnum(s(X)) :- natnum(X).
NatnumProgram(PROGRAM) <- (
    PROGRAM is [
        [["natnum", 0], []],
        [["natnum", ["s", X]], [["natnum", X]]]
    ]
)

# edge(a,b). edge(b,c). edge(b,d).
# path(X,Y) :- edge(X,Y).
# path(X,Y) :- edge(X,Z), path(Z,Y).
GraphProgram(PROGRAM) <- (
    PROGRAM is [
        [["edge", "a", "b"], []],
        [["edge", "b", "c"], []],
        [["edge", "b", "d"], []],
        [["path", X, Y], [["edge", X, Y]]],
        [["path", X, Y], [["edge", X, Z], ["path", Z, Y]]]
    ]
)

# Cyclic graph: recursive clause listed FIRST so naive DFS loops.
# edge(a,b). edge(b,a).
# path(X,Y) :- edge(X,Z), path(Z,Y).   ← tried first → infinite loop
# path(X,Y) :- edge(X,Y).
CyclicProgram(PROGRAM) <- (
    PROGRAM is [
        [["edge", "a", "b"], []],
        [["edge", "b", "a"], []],
        [["path", X, Y], [["edge", X, Z], ["path", Z, Y]]],
        [["path", X, Y], [["edge", X, Y]]]
    ]
)

# ── Helper: clause matching ──────────────────────────────────────────────────

# MatchClause(Goal, FreshBody, Program)
# Find a clause in Program whose head unifies with Goal.
# Returns the body with fresh variables (via CopyTerm).
MatchClause(GOAL, FRESH_BODY, PROGRAM) <- (
    In(CLAUSE, PROGRAM),
    CopyTerm(CLAUSE, [FRESH_HEAD, FRESH_BODY]),
    GOAL is FRESH_HEAD
)

# ── 1. Vanilla Meta-Interpreter ──────────────────────────────────────────────
#
# List-based, tail-recursive (mi_list2 from the article).
# Processes a goal list: for each goal, find a matching clause, prepend its
# body to the remaining goals, and continue.

Solve([], _PROGRAM),
Solve([GOAL, *GOALS], PROGRAM) <- (
    MatchClause(GOAL, BODY, PROGRAM),
    Append(BODY, GOALS, ALL_GOALS),
    Solve(ALL_GOALS, PROGRAM)
)

# ── 2. Inference-Counting Meta-Interpreter ───────────────────────────────────
#
# SolveCount(Goals, Program, Count) — Count is the total number of
# clause resolution steps performed.

SolveCount([], _PROGRAM, 0),
SolveCount([GOAL, *GOALS], PROGRAM, COUNT) <- (
    MatchClause(GOAL, BODY, PROGRAM),
    Append(BODY, GOALS, ALL_GOALS),
    SolveCount(ALL_GOALS, PROGRAM, SUB_COUNT),
    COUNT := SUB_COUNT + 1
)

# ── 3. Depth-Limited Meta-Interpreter ────────────────────────────────────────
#
# SolveLimit(Goals, Program, MaxDepth) — fails if the number of resolution
# steps exceeds MaxDepth.  Each clause resolution consumes one unit of depth.

SolveLimit([], _PROGRAM, _MAX),
SolveLimit([GOAL, *GOALS], PROGRAM, MAX) <- (
    MAX > 0,
    MAX1 := MAX - 1,
    MatchClause(GOAL, BODY, PROGRAM),
    Append(BODY, GOALS, ALL_GOALS),
    SolveLimit(ALL_GOALS, PROGRAM, MAX1)
)

# ── 4. Iterative Deepening Meta-Interpreter ──────────────────────────────────
#
# Tries increasing depth limits until a proof is found.
# This is a complete search strategy — it will find a solution if one exists,
# even for programs where naive DFS would loop.

SolveIterativeDeepening(GOALS, PROGRAM) <- (
    Between(0, 1000, DEPTH),
    SolveLimit(GOALS, PROGRAM, DEPTH)
)

# ── 5. Proof Tree Meta-Interpreter ──────────────────────────────────────────
#
# SolveTree(Goals, Program, Tree) — Tree is a list of proof nodes.
# Each node is [Goal, SubTree] where SubTree is the proof for the
# clause body that was used to resolve Goal.

SolveTree([], _PROGRAM, []),
SolveTree([GOAL, *GOALS], PROGRAM, [[GOAL, BODY_TREE], *GOALS_TREE]) <- (
    MatchClause(GOAL, BODY, PROGRAM),
    SolveTree(BODY, PROGRAM, BODY_TREE),
    SolveTree(GOALS, PROGRAM, GOALS_TREE)
)

# ── Tests ────────────────────────────────────────────────────────────────────

# -- Vanilla MI: natural numbers --

Test("solve natnum(0)") <- (
    NatnumProgram(P),
    Solve([["natnum", 0]], P)
)

Test("solve natnum(s(0))") <- (
    NatnumProgram(P),
    Solve([["natnum", ["s", 0]]], P)
)

Test("solve natnum(s(s(0)))") <- (
    NatnumProgram(P),
    Solve([["natnum", ["s", ["s", 0]]]], P)
)

# -- Vanilla MI: graph reachability --

Test("solve edge(a,b)") <- (
    GraphProgram(P),
    Solve([["edge", "a", "b"]], P)
)

Test("solve path(a,b) direct") <- (
    GraphProgram(P),
    Solve([["path", "a", "b"]], P)
)

Test("solve path(a,c) transitive") <- (
    GraphProgram(P),
    Solve([["path", "a", "c"]], P)
)

Test("solve path(a,d) transitive") <- (
    GraphProgram(P),
    Solve([["path", "a", "d"]], P)
)

Test("solve no path(c,a)") <- (
    GraphProgram(P),
    not Solve([["path", "c", "a"]], P)
)

# -- Inference counting --

Test("count natnum(0) = 1 step") <- (
    NatnumProgram(P),
    SolveCount([["natnum", 0]], P, 1)
)

Test("count natnum(s(0)) = 2 steps") <- (
    NatnumProgram(P),
    SolveCount([["natnum", ["s", 0]]], P, 2)
)

Test("count natnum(s(s(0))) = 3 steps") <- (
    NatnumProgram(P),
    SolveCount([["natnum", ["s", ["s", 0]]]], P, 3)
)

Test("count edge(a,b) = 1 step") <- (
    GraphProgram(P),
    SolveCount([["edge", "a", "b"]], P, 1)
)

Test("count path(a,b) direct = 2 steps") <- (
    GraphProgram(P),
    SolveCount([["path", "a", "b"]], P, 2)
)

Test("count path(a,c) = 4 steps") <- (
    GraphProgram(P),
    SolveCount([["path", "a", "c"]], P, 4)
)

# -- Depth-limited MI --

Test("limit natnum(s(0)) depth 1 fails") <- (
    NatnumProgram(P),
    not SolveLimit([["natnum", ["s", 0]]], P, 1)
)

Test("limit natnum(s(0)) depth 2 succeeds") <- (
    NatnumProgram(P),
    SolveLimit([["natnum", ["s", 0]]], P, 2)
)

Test("limit natnum(s(s(0))) depth 2 fails") <- (
    NatnumProgram(P),
    not SolveLimit([["natnum", ["s", ["s", 0]]]], P, 2)
)

Test("limit natnum(s(s(0))) depth 3 succeeds") <- (
    NatnumProgram(P),
    SolveLimit([["natnum", ["s", ["s", 0]]]], P, 3)
)

Test("limit path(a,c) depth 3 fails") <- (
    GraphProgram(P),
    not SolveLimit([["path", "a", "c"]], P, 3)
)

Test("limit path(a,c) depth 4 succeeds") <- (
    GraphProgram(P),
    SolveLimit([["path", "a", "c"]], P, 4)
)

# -- Iterative deepening: completes where naive DFS would loop --

Test("iterative deepening on cyclic graph") <- (
    CyclicProgram(P),
    SolveIterativeDeepening([["path", "a", "b"]], P)
)

Test("iterative deepening path(a,c) acyclic") <- (
    GraphProgram(P),
    SolveIterativeDeepening([["path", "a", "c"]], P)
)

# -- Proof tree MI --

Test("tree natnum(0)") <- (
    NatnumProgram(P),
    SolveTree([["natnum", 0]], P, TREE),
    TREE is [[["natnum", 0], []]]
)

Test("tree natnum(s(0)) has nested proof") <- (
    NatnumProgram(P),
    SolveTree([["natnum", ["s", 0]]], P, TREE),
    TREE is [[["natnum", ["s", 0]], [[["natnum", 0], []]]]]
)

Test("tree edge(a,b) is leaf") <- (
    GraphProgram(P),
    SolveTree([["edge", "a", "b"]], P, TREE),
    TREE is [[["edge", "a", "b"], []]]
)

Test("tree path(a,b) direct") <- (
    GraphProgram(P),
    SolveTree([["path", "a", "b"]], P, TREE),
    TREE is [[["path", "a", "b"], [[["edge", "a", "b"], []]]]]
)

Test("tree path(a,c) transitive") <- (
    GraphProgram(P),
    SolveTree([["path", "a", "c"]], P, TREE),
    TREE is [
        [["path", "a", "c"], [
            [["edge", "a", "b"], []],
            [["path", "b", "c"], [
                [["edge", "b", "c"], []]
            ]]
        ]]
    ]
)

Test("tree natnum(s(s(0))) depth 2") <- (
    NatnumProgram(P),
    SolveTree([["natnum", ["s", ["s", 0]]]], P, TREE),
    TREE is [
        [["natnum", ["s", ["s", 0]]], [
            [["natnum", ["s", 0]], [
                [["natnum", 0], []]
            ]]
        ]]
    ]
)
