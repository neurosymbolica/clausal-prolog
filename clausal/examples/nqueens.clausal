-module(nqueens, [
    Queens(N, QS)
])

-private([
    numlist(LOW, HIGH, NS),
    Safe(QS),
    NoAttack(Q, QS, D)
])

# ── Queens/2 — find a safe placement of N queens ──────────────────────────────

Queens(N, QS) <- (
    numlist(1, N, COLS),
    permutation(COLS, QS),
    Safe(QS)
)

# ── numlist/3 — generate [Low..High] ──────────────────────────────────────────

numlist(LOW=0, HIGH=0, NS=[]),

numlist(LOW, HIGH, []) <- (LOW > HIGH)

numlist(LOW, HIGH, [LOW, *REST]) <- (
    LOW <= HIGH,
    NEXT == LOW + 1,
    numlist(NEXT, HIGH, REST)
)

# ── Safe/1 — no two queens attack each other diagonally ───────────────────────

Safe(QS=[]),

Safe([Q, *QS]) <- (
    NoAttack(Q, QS, 1),
    Safe(QS)
)

# ── NoAttack/3 — queen Q doesn't attack any queen in QS at distance D+ ───────

NoAttack(Q=0, QS=[], D=0),

NoAttack(_, [], _),

NoAttack(Q, [Q1, *QS], D) <- (
    DIFF1 == Q1 - Q,
    DIFF2 == Q - Q1,
    DIFF1 != D,
    DIFF2 != D,
    D1 == D + 1,
    NoAttack(Q, QS, D1)
)

# ── Tests ──────────────────────────────────────────────────────────────────────

test("numlist 1 to 3") <- numlist(1, 3, [1, 2, 3])
test("numlist 1 to 1") <- numlist(1, 1, [1])
test("numlist empty when low > high") <- numlist(5, 3, [])

test("empty board is safe") <- Safe([])
test("single queen is safe") <- Safe([1])
test("[2,4,1,3] is safe") <- Safe([2, 4, 1, 3])
test("[1,2] is unsafe") <- (not Safe([1, 2]))
test("[1,3] is safe (no diagonal)") <- Safe([1, 3])

test("no queens, no attack") <- NoAttack(1, [], 1)
test("1-queens") <- Queens(1, [1])
test("4-queens has a solution") <- Queens(4, _)

# 4-queens solution 1:
#
#   . Q . .      row 1: queen in column 2
#   . . . Q      row 2: queen in column 4
#   Q . . .      row 3: queen in column 1
#   . . Q .      row 4: queen in column 3
#
test("4-queens solution 1") <- (
    Queens(4, QS),
    QS is [2, 4, 1, 3]
)

# 4-queens solution 2:
#
#   . . Q .      row 1: queen in column 3
#   Q . . .      row 2: queen in column 1
#   . . . Q      row 3: queen in column 4
#   . Q . .      row 4: queen in column 2
#
test("4-queens solution 2") <- (
    Queens(4, QS),
    QS is [3, 1, 4, 2]
)
