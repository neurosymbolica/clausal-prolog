-module(map_coloring, [
    Colorable(Coloring)
])

-private([
    Red, Green, Blue, Yellow,
    Wa, Nt, Sa, Qld, Nsw, Vic, Tas,
    Color(C),
    Adjacent(X, Y)
])

# Four-color map coloring for Australia.

Color(C=Red),
Color(Green),
Color(Blue),
Color(Yellow),

Adjacent(X=Wa,  Y=Nt),
Adjacent(Wa,  Sa),
Adjacent(Nt,  Sa),
Adjacent(Nt,  Qld),
Adjacent(Sa,  Qld),
Adjacent(Sa,  Nsw),
Adjacent(Sa,  Vic),
Adjacent(Qld, Nsw),
Adjacent(Nsw, Vic),

Colorable(COLORING) <- (
    Color(WA_C),
    Color(NT_C),
    Color(SA_C),
    Color(Q_C),
    Color(NSW_C),
    Color(V_C),
    Color(T_C),
    WA_C is not NT_C,
    WA_C is not SA_C,
    NT_C is not SA_C,
    NT_C is not Q_C,
    SA_C is not Q_C,
    SA_C is not NSW_C,
    SA_C is not V_C,
    Q_C is not NSW_C,
    NSW_C is not V_C,
    COLORING is [
        [Wa, WA_C], [Nt, NT_C], [Sa, SA_C],
        [Qld, Q_C], [Nsw, NSW_C], [Vic, V_C], [Tas, T_C]
    ]
)

# ── Tests ────────────────────────────────────────────────────────────────────────

Test("red is a color") <- Color(Red)
Test("green is a color") <- Color(Green)
Test("blue is a color") <- Color(Blue)
Test("yellow is a color") <- Color(Yellow)
Test("purple is not a color") <- (not Color("purple"))
Test("wa adjacent to nt") <- Adjacent(Wa, Nt)
Test("wa adjacent to sa") <- Adjacent(Wa, Sa)
Test("nsw adjacent to vic") <- Adjacent(Nsw, Vic)
Test("a coloring exists") <- Colorable(_)
Test("coloring has 7 regions") <- (Colorable(COLORING), Length(COLORING, 7))
Test("wa and nt get different colors") <- (
    Colorable(COLORING),
    In([Wa, WA_C], COLORING),
    In([Nt, NT_C], COLORING),
    WA_C is not NT_C
)
Test("sa and qld get different colors") <- (
    Colorable(COLORING),
    In([Sa, SA_C], COLORING),
    In([Qld, Q_C], COLORING),
    SA_C is not Q_C
)
