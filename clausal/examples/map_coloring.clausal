-module(map_coloring, [
    Colorable(COLORING)
])

-private([
    Red, Green, Blue, Yellow,
    WesternAustralia, NorthernTerritory, SouthAustralia,
    Queensland, NewSouthWales, Victoria, Tasmania,
    Color(C),
    Adjacent(X, Y),
    ColorOf(REGION, C, COLORING)
])

# Four-color map coloring for Australia.

Color(C=Red),
Color(Green),
Color(Blue),
Color(Yellow),

Adjacent(X=WesternAustralia,  Y=NorthernTerritory),
Adjacent(WesternAustralia,    SouthAustralia),
Adjacent(NorthernTerritory,   SouthAustralia),
Adjacent(NorthernTerritory,   Queensland),
Adjacent(SouthAustralia,      Queensland),
Adjacent(SouthAustralia,      NewSouthWales),
Adjacent(SouthAustralia,      Victoria),
Adjacent(Queensland,          NewSouthWales),
Adjacent(NewSouthWales,       Victoria),

ColorOf(REGION, C, COLORING) <- in_([REGION, C], COLORING)

Colorable(COLORING) <- (
    Color(WA_COLOR),
    Color(NT_COLOR),
    Color(SA_COLOR),
    Color(QLD_COLOR),
    Color(NSW_COLOR),
    Color(VIC_COLOR),
    Color(TAS_COLOR),
    COLORING is [
        [WesternAustralia,   WA_COLOR],
        [NorthernTerritory,  NT_COLOR],
        [SouthAustralia,     SA_COLOR],
        [Queensland,         QLD_COLOR],
        [NewSouthWales,      NSW_COLOR],
        [Victoria,           VIC_COLOR],
        [Tasmania,           TAS_COLOR]
    ],
    forall(Adjacent(REGION_X, REGION_Y), (
        ColorOf(REGION_X, COLOR_OF_REGION_X, COLORING),
        ColorOf(REGION_Y, COLOR_OF_REGION_Y, COLORING),
        COLOR_OF_REGION_X is not COLOR_OF_REGION_Y
    ))
)

# ── Tests ────────────────────────────────────────────────────────────────────────

Test("red is a color") <- Color(Red)
Test("green is a color") <- Color(Green)
Test("blue is a color") <- Color(Blue)
Test("yellow is a color") <- Color(Yellow)
Test("purple is not a color") <- (not Color("purple"))
Test("wa adjacent to nt") <- Adjacent(WesternAustralia, NorthernTerritory)
Test("wa adjacent to sa") <- Adjacent(WesternAustralia, SouthAustralia)
Test("nsw adjacent to vic") <- Adjacent(NewSouthWales, Victoria)
Test("a coloring exists") <- Colorable(_)
Test("coloring has 7 regions") <- (Colorable(COLORING), length(COLORING, 7))
Test("wa and nt get different colors") <- (
    Colorable(COLORING),
    in_([WesternAustralia, WA_COLOR], COLORING),
    in_([NorthernTerritory, NT_COLOR], COLORING),
    WA_COLOR is not NT_COLOR
)
Test("sa and qld get different colors") <- (
    Colorable(COLORING),
    in_([SouthAustralia, SA_COLOR], COLORING),
    in_([Queensland, QLD_COLOR], COLORING),
    SA_COLOR is not QLD_COLOR
)
