-module(map_coloring, [
    colorable(COLORING)
])

-private([
    color(C),
    adjacent(X, Y),
    color_of(REGION, C, COLORING),
    red, green, blue, yellow,
    western_australia, northern_territory, south_australia,
    queensland, new_south_wales, victoria, tasmania
])

# Four-color map coloring for Australia.

color(red),
color(green),
color(blue),
color(yellow),

adjacent(western_australia,  northern_territory),
adjacent(western_australia,    south_australia),
adjacent(northern_territory,   south_australia),
adjacent(northern_territory,   queensland),
adjacent(south_australia,      queensland),
adjacent(south_australia,      new_south_wales),
adjacent(south_australia,      victoria),
adjacent(queensland,          new_south_wales),
adjacent(new_south_wales,       victoria),

color_of(REGION, C, COLORING) <- in_([REGION, C], COLORING)

colorable(COLORING) <- (
    color(WA_COLOR),
    color(NT_COLOR),
    color(SA_COLOR),
    color(QLD_COLOR),
    color(NSW_COLOR),
    color(VIC_COLOR),
    color(TAS_COLOR),
    COLORING is [
        [western_australia,   WA_COLOR],
        [northern_territory,  NT_COLOR],
        [south_australia,     SA_COLOR],
        [queensland,         QLD_COLOR],
        [new_south_wales,      NSW_COLOR],
        [victoria,           VIC_COLOR],
        [tasmania,           TAS_COLOR]
    ],
    forall(adjacent(REGION_X, REGION_Y), (
        color_of(REGION_X, COLOR_OF_REGION_X, COLORING),
        color_of(REGION_Y, COLOR_OF_REGION_Y, COLORING),
        COLOR_OF_REGION_X is not COLOR_OF_REGION_Y
    ))
)

# ── Tests ────────────────────────────────────────────────────────────────────────

test("red is a color") <- color(red)
test("green is a color") <- color(green)
test("blue is a color") <- color(blue)
test("yellow is a color") <- color(yellow)
test("purple is not a color") <- (not color('purple'))
test("wa adjacent to nt") <- adjacent(western_australia, northern_territory)
test("wa adjacent to sa") <- adjacent(western_australia, south_australia)
test("nsw adjacent to vic") <- adjacent(new_south_wales, victoria)
test("a coloring exists") <- colorable(_)
test("coloring has 7 regions") <- (colorable(COLORING), length(COLORING, 7))
test("wa and nt get different colors") <- (
    colorable(COLORING),
    in_([western_australia, WA_COLOR], COLORING),
    in_([northern_territory, NT_COLOR], COLORING),
    WA_COLOR is not NT_COLOR
)
test("sa and qld get different colors") <- (
    colorable(COLORING),
    in_([south_australia, SA_COLOR], COLORING),
    in_([queensland, QLD_COLOR], COLORING),
    SA_COLOR is not QLD_COLOR
)
