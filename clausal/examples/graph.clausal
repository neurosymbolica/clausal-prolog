:- module(graph, [path/3, reachable/2, connected/2]).

% Sample directed graph.

edge(1, 2).

edge(2, 3).

edge(3, 4).

edge(4, 5).

edge(2, 5).

edge(5, 6).

edge(6, 3).

% Path finding with cycle detection via visited set.

path(X, Y, Path) :-
    path_acc(X, Y, [X], Path).

path_acc(0, 0, [], []).

path_acc(X, X, _, [X]).

path_acc(X, Y, Visited, [X|Rest]) :-
    edge(X, Z),
    \+ member(Z, Visited),
    path_acc(Z, Y, [Z|Visited], Rest).

reachable(X, Y) :-
    path(X, Y, _).

connected(X, Y) :-
    edge(X, Y).

connected(X, Y) :-
    edge(Y, X).

% -- Tests ---------------------------------------------------------------------

test("edge 1->2 exists") :-
    edge(1, 2).

test("edge 2->3 exists") :-
    edge(2, 3).

test("1 reaches 5") :-
    reachable(1, 5).

test("1 reaches 6") :-
    reachable(1, 6).

test("1 reaches 4") :-
    reachable(1, 4).

test("2 reaches 6") :-
    reachable(2, 6).

test("5 cannot reach 1") :-
    \+ reachable(5, 1).

test("connected 1-2") :-
    connected(1, 2).

test("connected 2-1") :-
    connected(2, 1).

test("path 1 to 5 via shortcut") :-
    path(1, 5, [1, 2, 5]).

test("path starts with source") :-
    path(1, 6, Path),
    Path = [1|_].

test("path 2 to 6 terminates despite cycle") :-
    path(2, 6, _).

:- end_module(graph).
