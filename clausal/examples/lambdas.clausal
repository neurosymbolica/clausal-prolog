-module(lambdas, [
    ApplyVal(RESULT, VAL),
    AddOne(X, Y),
    AddZ(Z, X, RESULT),
    DoubleVal(X, Y),
    ZeroArg(RESULT),
    Transform(X, Y),
    CaptureTwo(A, B, X, RESULT),
    ApplyPred(X, Y),
    AllColors(COLORS)
])

-private([
    Helper(X, Y),
    Color(C)
])

# ── Basic lambdas ────────────────────────────────────────────────────────────

# Identity via call_goal — the simplest lambda.
ApplyVal(RESULT, VAL) <- CallGoal((X <- (RESULT is X)), VAL)

# Arithmetic in lambda body.
AddOne(X, Y) <- CallGoal((V <- (Y := V + 1)), X)

# Two-argument lambda.
DoubleVal(X, Y) <- CallGoal(((A, B) <- (B := A * 2)), X, Y)

# Zero-argument lambda.
ZeroArg(RESULT) <- CallGoal((() <- (RESULT is 42)))

# ── Variable capture ─────────────────────────────────────────────────────────

# Capture one variable from enclosing clause.
AddZ(Z, X, RESULT) <- CallGoal((V <- (RESULT := V + Z)), X)

# Capture two variables from enclosing clause.
CaptureTwo(A, B, X, RESULT) <- (
    CallGoal((V <- (RESULT := V + A + B)), X)
)

# ── Conjunction body ─────────────────────────────────────────────────────────

# Lambda with multi-step conjunction: T := V + 1, R := T * 2
Transform(X, Y) <- CallGoal(((V, R) <- ((T := V + 1) and (R := T * 2))), X, Y)

# ── Predicate calls from lambdas ─────────────────────────────────────────────

# Helper predicate called from within a lambda.
Helper(X, Y) <- (Y := X * 10)

ApplyPred(X, Y) <- CallGoal((V <- (Helper(V, Y))), X)

# ── Multi-solution via find_all ──────────────────────────────────────────────

Color("red"),
Color("green"),
Color("blue"),

AllColors(COLORS) <- (
    FindAll(C, Color(C), COLORS)
)

# ── Tests ────────────────────────────────────────────────────────────────────

# Basic
Test("apply_val 42") <- ApplyVal(42, 42)
Test("apply_val string") <- ApplyVal("hello", "hello")
Test("add_one 5") <- AddOne(5, 6)
Test("add_one -1") <- AddOne(-1, 0)
Test("double_val 5") <- DoubleVal(5, 10)
Test("zero_arg 42") <- ZeroArg(42)

# Capture
Test("add_z 3+10") <- AddZ(3, 10, 13)
Test("add_z 0+7") <- AddZ(0, 7, 7)
Test("capture_two 10+20+5") <- CaptureTwo(10, 20, 5, 35)

# Conjunction
Test("transform 5 -> 12") <- Transform(5, 12)
Test("transform 0 -> 2") <- Transform(0, 2)

# Predicate call
Test("apply_pred 3 -> 30") <- ApplyPred(3, 30)
Test("apply_pred 0 -> 0") <- ApplyPred(0, 0)

# Multi-solution
Test("all_colors") <- AllColors(["red", "green", "blue"])
