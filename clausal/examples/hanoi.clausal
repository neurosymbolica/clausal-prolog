-module(hanoi, [
    Hanoi(N, From, To, Via, Moves)
])
-private([Center, Left, Right])

Hanoi(0, _, _, _, []),
Hanoi(N, FROM, TO, VIA, MOVES) <- (
    N > 0,
    N1 == N - 1,
    Hanoi(N1, FROM, VIA, TO, MOVES1),
    Hanoi(N1, VIA, TO, FROM, MOVES2),
    append(MOVES1, [[FROM, TO]], MID),
    append(MID, MOVES2, MOVES)
)

# ── Tests ────────────────────────────────────────────────────────────────────────

Test("0 disks = no moves") <- Hanoi(0, Left, Right, Center, [])
Test("1 disk") <- Hanoi(1, Left, Right, Center, [[Left, Right]])
Test("2 disks") <- Hanoi(2, Left, Right, Center, [
    [Left, Center],
    [Left, Right],
    [Center, Right]
])
Test("3 disks") <- Hanoi(3, Left, Right, Center, [
    [Left, Right],
    [Left, Center],
    [Right, Center],
    [Left, Right],
    [Center, Left],
    [Center, Right],
    [Left, Right]
])
