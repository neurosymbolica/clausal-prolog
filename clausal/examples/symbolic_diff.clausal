-module(symbolic_diff, [
    d(Expr, Var, Derivative)
])

# Symbolic differentiation using operator-node terms:
#   (E1 + E2), (E1 * E2), (E ** N)
# This has been rewritten with regular terms instead of lists containing strings, there may be issues

# d(x)/dx = 1
d(EXPR=0, VAR=0, DERIV=0),
d(X, X, 1),

# Constant number: d(c)/dx = 0
d(C, _, 0) <- number(C)

# Different variable: d(y)/dx = 0
d(Y, X, 0) <- (
    string(Y),
    Y is not X
)

# Sum: d(a+b)/dx = da/dx + db/dx
d(A + B, X, DA + DB) <- (
    d(A, X, DA),
    d(B, X, DB)
)

# Product (Leibniz rule): d(a*b)/dx = a*db + b*da
d(A * B, X, A * DB + B * DA) <- (
    d(A, X, DA),
    d(B, X, DB)
)

# Power rule: d(e^n)/dx = n * e^(n-1) * de/dx
d(E ** N, X, N * (E ** N1) * DE) <- (
    number(N),
    N1 := N - 1,
    d(E, X, DE)
)

# ── Tests ────────────────────────────────────────────────────────────────────────

test("dx/dx = 1") <- d("x", "x", 1)
test("d(5)/dx = 0") <- d(5, "x", 0)
test("d(3)/dy = 0") <- d(3, "y", 0)
test("d(y)/dx = 0") <- d("y", "x", 0)
test("d(x+x)/dx = 1+1") <- d("x" + "x", "x", 1 + 1)
test("d(x+5)/dx = 1+0") <- d("x" + 5, "x", 1 + 0)
test("d(x*x)/dx = x*1 + x*1") <- d("x" * "x", "x", "x" * 1 + "x" * 1)
test("d(x^2)/dx = 2*x^1*1") <- d("x" ** 2, "x", 2 * ("x" ** 1) * 1)
test("d(x^3)/dx = 3*x^2*1") <- d("x" ** 3, "x", 3 * ("x" ** 2) * 1)
test("d(3*x)/dx = 3*1 + x*0") <- d(3 * "x", "x", 3 * 1 + "x" * 0)
