-module(symbolic_diff, [
    x, y,
    d(EXPR, VAR, DERIV)
])

# Symbolic differentiation.
# Arithmetic operators (+, *, **) are structural terms in clause heads and
# predicate call arguments — they are matched/constructed, not evaluated.

# d(x)/dx = 1
d(EXPR=0, VAR=0, DERIV=0),
d(X, X, 1),

# Constant number: d(c)/dx = 0
d(C, _, 0) <- number(C)

# Different variable: d(y)/dx = 0
d(Y, X, 0) <- (
    string(Y),
    Y is not X
)

# Sum: d(a+b)/dx = da/dx + db/dx
d(A + B, X, DA + DB) <- (
    d(A, X, DA),
    d(B, X, DB)
)

# Product (Leibniz rule): d(a*b)/dx = a*db + b*da
d(A * B, X, A*DB + B*DA) <- (
    d(A, X, DA),
    d(B, X, DB)
)

# Power rule: d(e^n)/dx = n * e^(n-1) * de/dx
d(E ** N, X, N * E**N1 * DE) <- (
    number(N),
    N1 := N - 1,
    d(E, X, DE)
)

# ── Tests ────────────────────────────────────────────────────────────────────────

test("dx/dx = 1") <- d(x, x, 1)
test("d(5)/dx = 0") <- d(5, x, 0)
test("d(3)/dy = 0") <- d(3, y, 0)
test("d(y)/dx = 0") <- d(y, x, 0)
test("d(x+x)/dx") <- d(x + x, x, 1 + 1)
test("d(x+5)/dx") <- d(x + 5, x, 1 + 0)
test("d(x*x)/dx") <- d(x * x, x, x*1 + x*1)
test("d(x^2)/dx") <- d(x**2, x, 2 * x**1 * 1)
test("d(x^3)/dx") <- d(x**3, x, 3 * x**2 * 1)
test("d(3*x)/dx") <- d(3 * x, x, 3*1 + x*0)
