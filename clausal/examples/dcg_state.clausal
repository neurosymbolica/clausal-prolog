# DCG State Threading
#
# DCGs are a general state-passing mechanism. The difference-list pair can
# carry any state encoded as a single-element list [State]. Terminals read
# state, pushback writes it back, and phrase/3 sets initial/final state.
#
# See also: metalevel.at/prolog/dcg

-module(dcg_state, [state(_s, _s0, S_2), state2(_s0, _s, S0_2, S_2), inc(_s0, _s), double(_s0, _s), count3(_s0, _s), inc_then_double(_s0, _s), count_leaves(_t, _s0, _s), num_leaves(_t, _n), push(_x, _s0, _s), push_all(_xs, _s0, _s), collect_items(_xs, _r)])

# ── State helpers ──────────────────────────────────────────────────────────
#
# These two nonterminals are the core of state-passing DCGs. Copy them
# into any module that needs state threading.

# state/1: Read current state (passthrough — state is not modified).
(state(_s), [_s]) >> ([_s])

# state/2: Read old state _s0, replace with _s.
(state2(_s0, _s), [_s]) >> ([_s0])

# ── Counter ────────────────────────────────────────────────────────────────
#
# Increment a counter threaded through phrase/3:
#   phrase(count3, [0], [_n])  →  _n = 3

inc >> (state(_n0), {_n == _n0 + 1}, state2(_, _n))
double >> (state(_n0), {_n == _n0 * 2}, state2(_, _n))

count3 >> (inc, inc, inc)
inc_then_double >> (inc, double)

# ── Tree leaf counting ─────────────────────────────────────────────────────
#
# Trees represented as "leaf" or [Left, Right].
#   num_leaves(["leaf", "leaf"], _n)  →  _n = 2
#   num_leaves(["leaf", ["leaf", "leaf"]], _n)  →  _n = 3

count_leaves("leaf") >> (state(_n0), {_n == _n0 + 1}, state2(_, _n))
count_leaves([_l, _r]) >> (count_leaves(_l), count_leaves(_r))

num_leaves(_t, _n) <- phrase(count_leaves(_t), [0], [_n])

# ── Accumulator ────────────────────────────────────────────────────────────
#
# Collect items from a list into an accumulator via state threading.
#   phrase(push_all([1, 2, 3]), [[]], Rest_)  →  Rest_ = [[3, 2, 1]]

push(_x) >> (state(_acc0), {_acc is [_x, *_acc0]}, state2(_, _acc))

push_all([]) >> ([])
push_all([_x, *_xs]) >> (push(_x), push_all(_xs))

collect_items(_xs, _r) <- phrase(push_all(_xs), [[]], [_r])
