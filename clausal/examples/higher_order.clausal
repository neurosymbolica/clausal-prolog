-module(higher_order, [
    Doubles(XS, YS),
    AllPositive(XS),
    KeepPositive(XS, PS),
    RemoveNegative(XS, RS),
    SumListFold(XS, S),
    ProductList(XS, P),
    Squares(XS, YS),
    KeepEven(XS, ES),
    RemoveEven(XS, OS),
    NegateList(XS, YS),
    CountFold(XS, N),
    MaxFold(XS, INIT, M)
])

# ── maplist/3 — transform each element ───────────────────────────────────────

# Double every element.
Doubles(XS, YS) <- maplist(((X, Y) <- (Y := X * 2)), XS, YS)

# Square every element.
Squares(XS, YS) <- maplist(((X, Y) <- (Y := X * X)), XS, YS)

# Negate every element.
NegateList(XS, YS) <- maplist(((X, Y) <- (Y := 0 - X)), XS, YS)

# ── maplist/2 — check predicate on each element ──────────────────────────────

# Check all elements are positive.
AllPositive(XS) <- maplist((X <- (X > 0)), XS)

# ── include/3 — keep matching elements ────────────────────────────────────────

# Keep positive elements.
KeepPositive(XS, PS) <- include((X <- (X > 0)), XS, PS)

# Keep even elements.
KeepEven(XS, ES) <- include((X <- (X % 2 == 0)), XS, ES)

# ── exclude/3 — remove matching elements ─────────────────────────────────────

# Remove negative elements (keep zero and positive).
RemoveNegative(XS, RS) <- exclude((X <- (X < 0)), XS, RS)

# Remove even elements (keep odd).
RemoveEven(XS, OS) <- exclude((X <- (X % 2 == 0)), XS, OS)

# ── foldl/4 — left fold ────────────────────────────────────────────────────

# sum_ via fold.
SumListFold(XS, S) <- foldl(((E, A, R) <- (R := A + E)), XS, 0, S)

# Product via fold.
ProductList(XS, P) <- foldl(((E, A, R) <- (R := A * E)), XS, 1, P)

# Count elements via fold.
CountFold(XS, N) <- foldl(((ELEM, A, R) <- (R := A + 1)), XS, 0, N)

# max_ via fold with initial value.
MaxFold(XS, INIT, M) <- foldl(((E, A, R) <- (
    (E >= A, R is E) or (A > E, R is A)
)), XS, INIT, M)

# ── Tests ─────────────────────────────────────────────────────────────────────

# maplist/3
Test("doubles [1,2,3]") <- Doubles([1, 2, 3], [2, 4, 6])
Test("doubles empty") <- Doubles([], [])
Test("doubles negative") <- Doubles([-1, 0, 5], [-2, 0, 10])
Test("squares [1,2,3,4]") <- Squares([1, 2, 3, 4], [1, 4, 9, 16])
Test("negate [1,-2,3]") <- NegateList([1, -2, 3], [-1, 2, -3])
Test("negate empty") <- NegateList([], [])

# maplist/2
Test("all positive pass") <- AllPositive([1, 2, 3])
Test("all positive fail") <- (not AllPositive([1, -2, 3]))
Test("all positive empty") <- AllPositive([])

# include/3
Test("keep positive") <- KeepPositive([1, -2, 3, -4], [1, 3])
Test("keep positive none") <- KeepPositive([-1, -2], [])
Test("keep positive all") <- KeepPositive([5, 10], [5, 10])
Test("keep even") <- KeepEven([1, 2, 3, 4, 5, 6], [2, 4, 6])
Test("keep even none") <- KeepEven([1, 3, 5], [])

# exclude/3
Test("remove negative") <- RemoveNegative([1, -2, 3, -4], [1, 3])
Test("remove negative none present") <- RemoveNegative([1, 2, 3], [1, 2, 3])
Test("remove even") <- RemoveEven([1, 2, 3, 4, 5], [1, 3, 5])

# foldl/4
Test("sum fold") <- SumListFold([1, 2, 3], 6)
Test("sum fold empty") <- SumListFold([], 0)
Test("sum fold single") <- SumListFold([42], 42)
Test("product fold") <- ProductList([2, 3, 4], 24)
Test("product fold empty") <- ProductList([], 1)
Test("product fold with zero") <- ProductList([5, 0, 3], 0)
Test("count fold") <- CountFold([10, 20, 30, 40], 4)
Test("count fold empty") <- CountFold([], 0)
Test("max fold") <- MaxFold([3, 7, 2, 9, 1], 0, 9)
Test("max fold single") <- MaxFold([5], 0, 5)
Test("max fold init wins") <- MaxFold([1, 2], 100, 100)
